---
import { Download } from '@lucide/astro';

const documents = [
  { label: 'PDF', size: '832,358 bytes', extension: 'pdf' },
  { label: 'Editable Word (DOCX)', size: '221,908 bytes', extension: 'docx' },
];
---

<ul class="vision-downloads" role="list">
  {documents.map(({ label, size, extension }) => (
    <li>
      <a href={`/downloads/app-composer/completed-vision-20261120.${extension}`} download={`App-Composer-Completed-Vision-20261120.${extension}`}>
        <Download size={18} aria-hidden="true" />
        <span>Download {label} <small>{size}</small></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .vision-downloads {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    border-top: 1px solid var(--color-border);
  }

  li {
    margin: 0;
    border-bottom: 1px solid var(--color-border);
  }

  a {
    display: flex;
    align-items: center;
    gap: .75rem;
    min-height: 3rem;
    padding-block: .65rem;
  }

  small {
    color: var(--color-muted);
    font-size: .85rem;
    font-weight: 400;
    white-space: nowrap;
  }
</style>
