---
import Base from '../layouts/Base.astro';
import { resources, resourceById, renderResource } from '../lib/resource-library';
interface Props { selectedId?: string }
const { selectedId } = Astro.props;
const selected = resourceById(selectedId ?? '') ?? resources[0];
const canonical = 'https://composer.loftwah.com' + (selectedId ? `/resources/${selected.id}` : '/resources');
const download = `/resources/${selected.id}.md`;
const shareName = selected.id === 'change' || selected.id === 'incident' ? `${selected.id}-og.png` : 'resources-og.png';
---
<Base canonical={canonical} title={`${selected.title} — Runbooks & resources`} description="Take a useful operating kit with you: complete change and incident runbooks, pipelines, hooks, editable diagrams and a printable cheatsheet." shareImage={`https://composer.loftwah.com/resources/v1/${shareName}`} shareType="image/png" shareAlt={`${selected.title}: complete runbook and working files from App Composer.`}>
  <section class="resource-opening" aria-labelledby="resources-title">
    <div><p class="resource-edition">Runbooks & resources · Edition 01</p><h1 id="resources-title">Good work.<br/>Worth keeping.</h1><p class="lede">Choose a job. Take the instructions, examples and files into the project you already have.</p><p><a href="/setup">Starting a project? Set it up first</a> · <a href="/prompts">Just the prompts</a></p></div>
    <a class="kit-preview" href="/resources/v1/starter-kit.zip" download data-resource-action="download" data-resource-id="kit" aria-label="Download the complete operating starter kit ZIP"><img src="/resources/v1/kit-preview.png" alt="Preview of the actual one-page operating cheatsheet: inspect, change, verify and continue." width="900" height="640"/><span>Take the whole kit <span aria-hidden="true">↗</span><small>ZIP · Markdown, PDF, diagrams & runnable examples</small></span></a>
  </section>
  <div class="resource-workspace">
    <div><label class="resource-search" for="resource-search">Find a resource<input id="resource-search" type="search" placeholder="Change, incident, hook…" /></label><button id="resource-reset" type="button" class="secondary">Clear search</button><p id="resource-search-status" role="status" class="small"></p><nav class="resource-jobs" aria-label="Choose a resource">{resources.map((resource, index) => <a href={`/resources/${resource.id}#resource`} data-resource-action="choice" data-resource-id={resource.id} aria-current={selected.id === resource.id ? 'page' : undefined}><span class="resource-number">0{index + 1}</span><span>{resource.label}<small>{resource.title}</small></span></a>)}</nav></div>
    <section class="resource-detail" aria-labelledby="resource">
      <p class="resource-edition">Your selected resource</p>
      <h2 id="resource" tabindex="-1">{selected.title}</h2>
      <p class="resource-outcome">{selected.outcome}</p>
      <div class="resource-actions"><a class="button" href={download} download data-resource-action="download" data-resource-id={selected.id}>Download Markdown</a><button data-resource-id={selected.id} id="resource-copy" type="button" class="secondary">Copy runbook</button><a href={`/prompts#${selected.id}`}>Personalise the prompt</a></div>
      <p id="resource-status" class="small" role="status" aria-live="polite">Template: answer the labelled prompt fields before use. No account or model call required.</p>
      <dl class="resource-facts"><div><dt>What you need</dt><dd>{selected.needs}</dd></div><div><dt>What is supported</dt><dd>{selected.scope}</dd></div></dl>
      <ol class="resource-steps">{selected.steps.map(step => <li>{step}</li>)}</ol>
      <details><summary>Failure, recovery & companion files</summary><p>{selected.recovery}</p><ul>{selected.files.map(file => <li><a href={`/resources/v1/${file}`} download data-resource-action="download" data-resource-id={selected.id}>{file}</a></li>)}</ul><p>{selected.id === "change" && <><a href="/resources/v1/examples/field-notes-example.md" data-resource-action="example_open" data-resource-id="change">View the tested change example</a> · </>}<a href="/resources/v1/operating-cheatsheet.pdf">Open the printable cheatsheet</a> · <a href="/resources/v1/starter-kit.zip" download data-resource-action="download" data-resource-id="kit">Download all files</a></p></details>
      <details id="resource-fallback"><summary>Read or select the complete Markdown</summary><label for="resource-text">Complete runbook and prompt template</label><textarea id="resource-text" readonly rows="16">{renderResource(selected.id)}</textarea><p class="small">If copying is unavailable, select this text and use your device’s Copy action, or download the Markdown.</p></details>
    </section>
  </div>
  <p class="resource-provenance small">Edition 1 · Reviewed 2026/10/24 · Fictional local examples. A template, download or local fixture is separate from a provider connection or a successful production operation. <a href="/release">Release evidence</a>.</p>
  <details class="small"><summary>About resource activity counts</summary><p>Choices, successful clipboard copies and file/example link activations contribute daily totals. A link activation does not prove a completed download or successful operation. Counts contain no entered text or visitor identifiers and expire after 35 days. <a href={selectedId ? `/resources/${selected.id}?analytics=off#resource` : "/resources?analytics=off#resource"}>Browse without activity counts</a>.</p></details>
</Base>
<script>
  import { installResourceActions, recordResourceAction } from "../browser/resource-actions";
  installResourceActions();
  const search = document.querySelector<HTMLInputElement>('#resource-search');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.resource-jobs a')];
  const searchStatus = document.querySelector<HTMLElement>('#resource-search-status');
  function filterResources() {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    let count = 0;
    for (const link of links) {
      link.hidden = !(link.textContent?.toLocaleLowerCase().includes(query));
      if (!link.hidden) count++;
    }
    if (searchStatus) searchStatus.textContent = count ? `${count} resources` : 'No matching resource. Clear the search to see all five.';
  }
  search?.addEventListener('input', filterResources);
  document.querySelector('#resource-reset')?.addEventListener('click', () => {
    if (search) search.value = '';
    filterResources(); search?.focus();
  });
  const button = document.querySelector<HTMLButtonElement>('#resource-copy');
  const text = document.querySelector<HTMLTextAreaElement>('#resource-text');
  const status = document.querySelector<HTMLElement>('#resource-status');
  button?.addEventListener('click', async () => {
    if (!text || !status) return;
    try {
      await navigator.clipboard.writeText(text.value);
      recordResourceAction(button?.dataset.resourceId, "copy");
      status.textContent = 'Runbook copied, including the complete prompt template and continuation instructions.';
    } catch {
      const fallback = document.querySelector<HTMLDetailsElement>('#resource-fallback');
      if (fallback) fallback.open = true;
      text.focus(); text.select();
      status.textContent = 'Copy is unavailable. The complete text is selected below; use your device’s Copy action or download Markdown.';
    }
  });
</script>
<style>
  .resource-detail h2 {
    scroll-margin-top: 24px;
  }

  .resource-opening{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;padding-bottom:40px}.resource-edition{font-size:.85rem;font-weight:650;color:var(--color-accent);margin:0 0 16px}.resource-opening h1{font-size:clamp(3rem,5.5vw,5rem);margin:0 0 20px;max-width:12ch}.resource-opening .lede{font-size:1.2rem;max-width:38ch}.kit-preview{display:block;background:#fc5b05;color:#17181b;overflow:hidden}.kit-preview img{display:block;width:100%;height:auto}.kit-preview>span{display:block;padding:15px 24px 20px;font:600 1.25rem Space,sans-serif;border-top:1px solid #17181b}.kit-preview>span>span{float:right}.kit-preview small{display:block;font:400 .8rem/1.5 system-ui;margin-top:6px}.resource-workspace{display:grid;grid-template-columns:270px minmax(0,1fr);gap:48px;border-top:1px solid var(--color-border);padding-top:32px}.resource-jobs{display:block;align-self:start}.resource-jobs a{display:flex;gap:18px;padding:19px 12px;border-bottom:1px solid var(--color-border);min-height:76px}.resource-jobs a[aria-current]{outline:2px solid var(--color-accent);outline-offset:-2px;background:var(--color-selected)}.resource-number{color:var(--color-accent);font-family:Space,sans-serif}.resource-jobs a[hidden]{display:none}.resource-search{margin-top:0}.resource-jobs small{display:block;color:var(--color-muted);font-size:.8rem;font-weight:400;margin-top:3px}.resource-detail{min-width:0;scroll-margin-top:24px}.resource-detail h2{font-size:clamp(2rem,3.4vw,3rem);margin:0 0 16px;max-width:26ch}.resource-outcome{font-size:1.15rem;max-width:58ch}.resource-actions{display:flex;gap:14px 20px;flex-wrap:wrap;align-items:center;margin:24px 0 12px}.resource-actions>a:last-child{font-size:.9rem;color:var(--color-accent)}.resource-facts{margin:24px 0;display:grid;grid-template-columns:1fr 1fr;gap:24px;padding-block:22px;border-block:1px solid var(--color-border)}.resource-facts dt{font-weight:650;margin-bottom:8px}.resource-facts dd{margin:0;color:var(--color-muted);font-size:.92rem}.resource-steps{padding-left:24px;max-width:76ch}.resource-steps li{padding-left:8px;margin-bottom:19px}.resource-steps li::marker{color:var(--color-accent);font-weight:650}.resource-detail details{padding-block:18px;border-top:1px solid var(--color-border)}.resource-detail summary{font-weight:600;cursor:pointer}.resource-detail textarea{font:14px/1.6 ui-monospace,monospace;min-height:360px}.resource-provenance{margin:40px 0 0;border-top:1px solid var(--color-border);padding-top:20px}
  @media(max-width:850px){.resource-opening{gap:24px}.resource-workspace{grid-template-columns:210px minmax(0,1fr);gap:24px}.resource-facts{grid-template-columns:1fr;gap:18px}}
  @media(max-width:600px){.resource-opening{grid-template-columns:1fr;gap:22px}.resource-opening h1{font-size:3rem}.kit-preview{max-width:420px}.resource-workspace{grid-template-columns:1fr;gap:28px}.resource-jobs{display:flex;flex-wrap:wrap;gap:8px}.resource-jobs a{padding:10px 12px;min-height:48px;border:1px solid var(--color-border);align-items:center}.resource-jobs a[aria-current]{outline-width:2px}.resource-jobs small,.resource-number{display:none}.resource-detail .button,.resource-detail button{padding-inline:16px}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
  @media print{.resource-opening,.resource-jobs,.resource-actions,.resource-provenance{display:none}.resource-workspace{display:block;border:0}.resource-detail{color:#17181b}.resource-steps{max-width:none}}
</style>
