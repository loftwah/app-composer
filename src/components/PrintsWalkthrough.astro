---
import { printsAfterlightVideo } from '../lib/prints-video.mjs';
import { ArrowDownToLine } from '@lucide/astro';

const { eager = false, clip = printsAfterlightVideo } = Astro.props;
---

<figure>
  <video controls playsinline preload={eager ? 'metadata' : 'none'} poster={clip.poster} width={clip.width} height={clip.height} aria-label={clip.title}>
    <source src={clip.src} type="video/mp4" />
    <track kind="captions" label="English" srclang="en" src={clip.captions} default />
  </video>
  <figcaption>
    <span>{clip.duration} seconds · Captions · Native Rune capture · {clip.version}</span>
    <a href={clip.src} download><ArrowDownToLine size={17} aria-hidden="true" /> Download MP4</a>
  </figcaption>
</figure>
<details>
  <summary>Read the walkthrough</summary>
  <ol>{clip.transcript.map((step: string) => <li>{step}</li>)}</ol>
</details>

<style>
  figure { margin: 0; }
  video { display: block; width: 100%; height: auto; border: 1px solid var(--color-border); border-radius: 12px; background: #19151f; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0 12px; margin-top: 6px; color: var(--color-muted); font-size: .88rem; }
  figcaption a { display: inline-flex; min-height: 44px; align-items: center; gap: 6px; color: var(--prints-accent, var(--color-accent)); }
  details { margin-top: 4px; color: var(--color-muted); }
  summary { display: list-item; width: fit-content; min-height: 44px; align-content: center; color: var(--prints-accent, var(--color-accent)); cursor: pointer; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--prints-accent, var(--color-accent)); outline-offset: 3px; }
  ol { max-width: 70ch; padding-inline-start: 1.35rem; margin: 3px 0 0; }
  li + li { margin-top: 7px; }
</style>
