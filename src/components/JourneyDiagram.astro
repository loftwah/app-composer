---
interface Props { kind: 'composer' | 'state' }
const { kind } = Astro.props;
const text = kind === 'composer' ? 'Get Ready prepares tools, accounts and an HTTPS app. Init saves settings. Your agent builds and deploys. Compose connects apps through data and actions. Own retains source, updates and recovery.' : 'On your device, a fictional assistant document is encrypted with an owner-held passphrase. You retain the encrypted export. Separately, you review and consent to copying selected memories to a provider. The passphrase never crosses.';
import dimensions from '../../public/diagrams/journey-dimensions.json';
const size=dimensions[kind];
---
<figure class="journey-diagram">
{(['dark','light'] as const).map(theme=><picture class={`diagram-${theme}`}><source media="(max-width:1000px)" srcset={`/diagrams/${kind}-journey-mobile-${theme}.svg`} width={size.mobile.width} height={size.mobile.height}/><img src={`/diagrams/${kind}-journey-${theme}.svg`} width={size.desktop.width} height={size.desktop.height} alt={text} loading="lazy" decoding="async"/></picture>)}
<figcaption>{kind === 'composer' ? 'The full product journey. The stage notes below distinguish working features from remaining work.' : 'The fictional proof: local encryption, separate key ownership and a reviewed clipboard handoff.'} <a href={`/diagrams/${kind}-journey.d2`}>Editable D2 diagram</a></figcaption>
</figure>
