---
import { ArrowDownToLine, ArrowUpRight, Clipboard } from '@lucide/astro';
import { printsFirstSteps as paths } from '../lib/prints-first-steps.mjs';

const shares = '/prints-desktop/workflow-share-20261125/';
const posters = [
  { label: 'Your files. Your desk.', file: 'local.jpg', alt: 'A safety-orange lens projects a tiny paper coastline on a desk beside a storage drive.' },
  { label: 'Give your agent a library.', file: 'agent.jpg', alt: 'A small orange lens-shaped robot inspects a folded paper coastline with a magnifier.' },
  { label: 'One Worker. Two formats.', file: 'worker.jpg', alt: 'An orange mechanical press sends two paper coastlines down separate rails.' },
];

---
<section class="paths" id="paths" aria-labelledby="paths-title">
  <header>
    <h2 id="paths-title">How do you want to work?</h2>
    <p>Pick a first step. Each recipe has a prompt you can copy into the agent or image tool you already use.</p>
    <a class="share-link" href={shares + 'prompts.md'} download>Download all six prompts <ArrowDownToLine size={16} aria-hidden="true" /></a>
  </header>
  <div class="path-list">
    {paths.map(({ key, title, detail, href, action, prompt }) => (
      <details>
        <summary>{title}</summary>
        <div class="path-body">
          <p>{detail}</p>
          <a href={href}>{action} <ArrowUpRight size={15} aria-hidden="true" /></a>
          <label for={`prints-prompt-${key}`}>Ready-to-use prompt</label>
          <textarea id={`prints-prompt-${key}`} rows="6">{prompt}</textarea>
          <button type="button" data-copy-target={`prints-prompt-${key}`} hidden><Clipboard size={16} aria-hidden="true" /> Copy prompt</button>
          <p role="status" data-copy-status></p>
        </div>
      </details>
    ))}
  </div>
  <details class="workflow-shares">
    <summary>Share a workflow</summary>
    <a class="share-link" href={shares + 'prints-workflow-social-kit.zip'} download>Download the workflow pack <ArrowDownToLine size={16} aria-hidden="true" /></a>
    <ul aria-label="Workflow share posters">
      {posters.map(({ label, file, alt }) => <li>
        <a href={shares + file} download><img src={shares + file} alt={alt} width="1080" height="1350" loading="lazy" decoding="async" /><span>{label} <ArrowDownToLine size={15} aria-hidden="true" /></span></a>
      </li>)}
    </ul>
  </details>
</section>
<style>
  .paths { margin-block: clamp(30px,6vw,76px); }
  .paths header { max-width: 680px; margin-bottom: 20px; }
  .path-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 30px; }
  .path-list details { min-width: 0; align-self: start; border-block-start: 1px solid var(--color-border); }
  .path-list summary { cursor: pointer; min-height: 50px; padding-block: 12px; font-size: clamp(1.08rem,2vw,1.26rem); font-weight: 700; }
  .path-list summary::marker { color: #f48120; }
  .path-body { padding: 0 0 18px; }
  .path-body p { margin-bottom: 6px; }
  .path-body a { display: inline-flex; align-items: center; min-height: 44px; gap: 5px; font-weight: 650; }
  .path-body label { display: block; margin-block: 8px 4px; color: var(--color-muted); font-size: .875rem; }
  .path-body textarea { box-sizing: border-box; display: block; width: 100%; padding: 10px; resize: vertical; font: inherit; background: var(--color-surface); color: var(--color-foreground); border: 1px solid var(--color-border); border-radius: 5px; }
  .path-body button { display: inline-flex; align-items: center; min-height: 44px; gap: 6px; margin-top: 7px; padding: 0 10px; border: 1px solid var(--color-border); color: var(--color-foreground); background: var(--color-surface); cursor: pointer; border-radius: 5px; }
  .path-body button[hidden] { display: none; }
  .share-link { display: inline-flex; min-height: 44px; align-items: center; gap: 6px; font-weight: 650; }
  .workflow-shares { margin-top: 14px; border-block-start: 1px solid var(--color-border); }
  .workflow-shares summary { cursor: pointer; min-height: 44px; padding-block: 10px; font-weight: 700; }
  .workflow-shares ul { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,160px),1fr)); gap: 12px; padding: 0; list-style: none; }
  .workflow-shares a { font-weight: 650; }
  .workflow-shares img { width: 100%; height: auto; display: block; border-radius: 5px; }
  .workflow-shares li span { display: flex; min-height: 44px; align-items: center; gap: 6px; }
  @media (max-width: 720px) { .path-list { grid-template-columns: minmax(0,1fr); } }
</style>
