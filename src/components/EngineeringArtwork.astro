---
import { ArrowUpRight } from '@lucide/astro';
import { engineeringAtlasArchive, engineeringArtwork } from '../lib/engineering-artwork.mjs';
---

<section class="engineering-artwork" aria-labelledby="diagram-artwork" data-engineering-artwork>
  <div class="engineering-heading">
    <div>
      <h2 id="diagram-artwork">From the drawing board</h2>
      <p>Share the artwork or open the editable diagram behind it.</p>
    </div>
    <a href={engineeringAtlasArchive} download>Download all 31 diagrams</a>
  </div>
  <div class="engineering-pieces">
    {engineeringArtwork.map((piece) => (
      <figure>
        <a href={piece.image} download aria-label={`Download artwork for ${piece.title}`}>
          <img src={piece.image} alt={piece.alt} width="1200" height="630" loading="lazy" decoding="async" />
        </a>
        <figcaption>
          <a href={`/diagrams#diagram-${piece.id}`}>{piece.title} <ArrowUpRight size={15} aria-hidden="true" /></a>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .engineering-artwork { max-width: 65rem; margin-block: 0.5rem 2.4rem; padding-block: 1.2rem; border-block: 1px solid var(--color-border); }
  .engineering-heading { display: flex; align-items: end; justify-content: space-between; gap: 0.4rem 1.5rem; flex-wrap: wrap; margin-block-end: 0.8rem; }
  .engineering-heading h2 { margin: 0; scroll-margin-block-start: 6rem; font-size: clamp(1.45rem, 2.4vw, 2.25rem); }
  .engineering-heading p { color: var(--color-muted); margin: 0.25rem 0 0; }
  .engineering-heading > a, figcaption a { display: inline-flex; align-items: center; gap: 0.25rem; min-height: 44px; }
  .engineering-pieces { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.65rem 1rem; }
  figure { min-width: 0; margin: 0; }
  figure > a { display: block; border-radius: 0.5rem; overflow: clip; }
  img { display: block; width: 100%; height: auto; }
  figcaption a { font-weight: 650; }
  @media (max-width: 640px) {
    .engineering-pieces { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    figure:first-child { grid-column: 1 / -1; }
    figcaption a { font-size: 0.87rem; line-height: 1.25; }
  }
</style>
