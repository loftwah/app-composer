---
import { ArrowDownToLine, ArrowUpRight } from '@lucide/astro';
import { briefingShareArtwork, visionShareArtwork } from '../lib/site-share-artwork.mjs';

const assets = '/downloads/app-composer/share-kit-20261120';
const cards = [
  { ...briefingShareArtwork, title: 'From Idea to Operation', href: '/pitch/briefing' },
  { ...visionShareArtwork, title: 'Build it. Keep it running.', href: '/pitch/vision' },
];
---

<section class="share-kit" id="briefing-cards" aria-labelledby="briefing-cards-title">
  <header>
    <div>
      <h2 id="briefing-cards-title">App Composer share kit</h2>
      <p>Two campaign covers, ready-to-post copy and audio prompts for the briefing and product vision.</p>
    </div>
    <a href={`${assets}/app-composer-share-kit.zip`} download><ArrowDownToLine size={18} aria-hidden="true" /> Download the kit</a>
  </header>
  <div class="share-kit-cards">
    {cards.map(({ path, alt, title, href }) => (
      <figure>
        <a href={href} aria-label={`Open ${title}`}><img src={path} alt={alt} width="1200" height="630" loading="lazy" decoding="async" /></a>
        <figcaption>
          <a href={href}>{title} <ArrowUpRight size={15} aria-hidden="true" /></a>
          <a href={path} download aria-label={`Download JPG for ${title}`}>Download JPG</a>
        </figcaption>
      </figure>
    ))}
  </div>
  <nav aria-label="Text production files">
    <a href={`${assets}/share-copy.txt`} download>Post copy and URLs</a>
    <a href={`${assets}/keep-it-running.md`} download>Suno lyrics and styles</a>
    <a href={`${assets}/audio-production.md`} download>ElevenLabs scripts and cues</a>
  </nav>
</section>

<style>
  .share-kit { max-width: 65rem; margin: 1rem 0 2.35rem; padding-block: 1rem; border-block: 1px solid var(--color-border); scroll-margin-block-start: 5.5rem; }
  header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0 1.2rem; margin-bottom: .7rem; }
  h2 { font-size: clamp(1.45rem, 3vw, 2.15rem); margin: 0; }
  p { margin: .25rem 0; color: var(--color-muted); }
  .share-kit-cards { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .65rem 1rem; }
  figure { margin: 0; min-width: 0; }
  img { display: block; width: 100%; height: auto; border-radius: .5rem; }
  figcaption, nav { display: flex; flex-wrap: wrap; gap: 0 1rem; }
  a { display: inline-flex; align-items: center; gap: .35rem; }
  header > a, figcaption a, nav a { min-height: 44px; font-weight: 600; }
  @media (max-width: 570px) {
    figcaption a, nav a { line-height: 1.2; font-size: .87rem; }
  }
</style>
