---
// The server card and public page use the exact same publication. A download
// remains available without JavaScript; local QR/copy controls enhance it.
interface Props {
  slug: string;
  revision: number;
  url: string;
  title: string;
  description: string;
  imagePath: string;
  imageUrl: string;
  imageAlt: string;
}
const {slug, revision, url, title, description, imagePath, imageUrl, imageAlt} = Astro.props;
// Text is data even inside a JSON script element. Escaping '<' prevents an
// authored title such as '</script>' from changing the surrounding HTML.
const payload = JSON.stringify({slug, revision, url, title, description, imagePath, imageUrl}).replaceAll('<', '\\u003c');
---
<section class="stack-share" data-stack-share>
  <h2>Share this stack</h2>
  <p class="small">The card shows published revision {revision}. The QR code opens <a class="stack-share-url" href={url}>{url}</a>.</p>
  <div class="stack-share-layout">
    <a class="stack-share-preview" href={imagePath} aria-label={`Open the full share card for ${title}`}>
      <img src={imagePath} alt={imageAlt} width="1200" height="630" loading="lazy" />
    </a>
    <div class="actions">
      <a class="button" href={imagePath} download={`${slug}-share-card-1200x630.png`} data-stack-card>Download share card</a>
      <button type="button" class="secondary" hidden data-stack-copy>Copy stack link</button>
      <button type="button" class="secondary" hidden data-stack-qr>Download QR code</button>
      <button type="button" class="secondary" hidden data-stack-native>Share stack</button>
    </div>
  </div>
  <p role="status" aria-live="polite" class="small" data-stack-share-status></p>
  <label class="stack-share-fallback" data-stack-share-fallback hidden>
    Published address
    <input readonly aria-label="Published stack address" />
  </label>
  <script type="application/json" data-stack-share-data set:html={payload} />
</section>
<script is:inline type="module" src="/brand/stack-share.mjs"></script>
<style>
  .stack-share{margin:36px 0 0;padding:24px 0;border-top:1px solid var(--color-border);max-width:64rem}
  .stack-share h2{font-size:1.3rem;margin:0 0 10px}
  .stack-share-layout{display:grid;grid-template-columns:minmax(0,30rem) minmax(0,1fr);gap:24px;align-items:start;margin-top:20px}
  .stack-share-preview{display:block;line-height:0;border:1px solid var(--color-border);border-radius:8px;overflow:hidden}
  .stack-share-preview img{display:block;width:100%;height:auto}
  .stack-share .actions{margin:0;align-items:start}
  .stack-share .actions>*{max-width:100%}
  .stack-share-url{overflow-wrap:anywhere;font-weight:600}
  .stack-share-fallback{display:grid;gap:6px;margin-top:14px;max-width:34rem}
  .stack-share-fallback[hidden]{display:none}
  @media(max-width:40rem){.stack-share-layout{grid-template-columns:minmax(0,1fr);gap:18px}}
</style>
