---
import Base from '../layouts/Base.astro';

interface Props {
  view: 'artwork' | 'films' | 'stacks' | 'examples';
  title: string;
  description: string;
  noindex: boolean;
  shareImage?: string;
  shareAlt?: string;
}
const { view, ...page } = Astro.props;
---

<Base {...page}>
  <div class="share-library">
    <header class="wall-heading">
      <h1>Share</h1>
      <nav aria-label="Share sections">
        <a href="/share" aria-current={view === 'artwork' ? 'page' : undefined}>Artwork</a>
        <a href="/share?view=films" aria-current={view === 'films' ? 'page' : undefined}>Films</a>
        <a href="/share?view=stacks" aria-current={view === 'stacks' ? 'page' : undefined}>Creator stacks</a>
        <a href="/share/examples" aria-current={view === 'examples' ? 'page' : undefined}>Examples</a>
      </nav>
    </header>
    <slot />
  </div>
</Base>

<style>
  :global(main:has(> .share-library)) {
    max-width: none;
    padding: clamp(1rem, 2vw, 2rem) clamp(0.75rem, 1.8vw, 2rem) 4rem;
  }
  .wall-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: clamp(1.25rem, 4vw, 4rem);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .wall-heading h1 { margin: 0 0 0.4rem; font-size: clamp(2.5rem, 4vw, 4.2rem); line-height: 1.04; }
  .wall-heading nav { display: flex; flex-wrap: wrap; gap: 0 clamp(0.9rem, 3vw, 2rem); }
  .wall-heading nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 2px solid transparent;
    color: var(--color-muted);
    font-weight: 650;
  }
  .wall-heading nav a:hover, .wall-heading nav a[aria-current] { color: var(--color-foreground); }
  .wall-heading nav a[aria-current] { border-color: var(--color-accent); }
</style>
