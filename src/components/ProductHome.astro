---
import Base from '../layouts/Base.astro';
import { ArrowRight, Play } from '@lucide/astro';
import { apps } from '../lib/apps';
import instance from '../../config/instance.json';
// The homepage is the product's front door. Owner configuration adds one instance
// note and a link to the owner's profile; it never replaces the product identity,
// explanation or metadata.
const ownerInstance = instance.enabled ? instance : null;
const appById = (id: string) => {
  const app = apps.find((entry) => entry.id === id);
  if (!app) throw new Error(`Unknown app in the homepage: ${id}`);
  return app;
};
const paperwork = appById('paperwork');
const linkCheck = appById('linkcheck');
const hereThere = appById('guestbook');
const linkarooie = appById('showcase');
const launchKit = appById('launch-kit');
const captured = (date: string) =>
  new Date(date + 'T00:00:00Z').toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'App Composer',
  url: 'https://composer.loftwah.com/',
};
---

<Base
  title="App Composer — build apps with your agent on Cloudflare"
  description="Bring the app you need. Your agent builds it with you on Cloudflare, and the source, the data and the admin stay yours. Start with Get Ready, shape it in Init or copy a prompt straight to your agent."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

  <div class="composer-home">
    <section class="home-hero" aria-labelledby="home-heading">
      <div class="home-hero-copy">
        <h1 id="home-heading">Make software.<br />Keep it yours.</h1>
        <p class="home-lede">Bring the app you need. Your agent builds it with you on Cloudflare, and the source, the data and the admin stay yours.</p>
        <div class="home-hero-actions">
          <a class="button" href="/ready">Start with Get Ready <ArrowRight size={20} aria-hidden="true" /></a>
        </div>
        <a class="home-quick" href="/prompts">
          <span class="home-quick-label">TLDR just give me the prompts <ArrowRight size={20} aria-hidden="true" /></span>
          <span class="home-quick-note">Copy a complete request for your agent. No account, no setup.</span>
        </a>
        <a class="home-agent-link" href="/agent"><span>Point your existing agent here</span> <ArrowRight size={16} aria-hidden="true" /></a>
        <p class="home-look">Looking around needs no account. Building uses your own GitHub source and Cloudflare account, with your agent doing the work.</p>
      </div>

      <figure class="home-proof">
        <div class="home-proof-bar">
          <img src="/brand/composer-mark-reverse-20261022b.svg" width="22" height="22" alt="" />
          <span>Real apps, running now</span>
        </div>
        <div class="home-proof-grid">
          <a class="home-proof-main" href={paperwork.href}>
            <img
              src={paperwork.preview}
              width="1440"
              height="1100"
              alt={paperwork.previewAlt}
              fetchpriority="high"
              decoding="async"
            />
            <span><strong>Paperwork</strong> PDF editor</span>
          </a>
          <a href={linkCheck.href}>
            <picture>
              <source type="image/webp" srcset={`${linkCheck.preview} 960w, ${linkCheck.previewWide} 1440w`} sizes="(max-width: 700px) 90vw, 300px" />
              <img src={linkCheck.preview} width="960" height="640" alt={linkCheck.previewAlt} loading="lazy" decoding="async" />
            </picture>
            <span><strong>Link Check</strong> Site review</span>
          </a>
          <a href={hereThere.href}>
            <picture>
              <source type="image/webp" srcset={`${hereThere.preview} 960w, ${hereThere.previewWide} 1440w`} sizes="(max-width: 700px) 90vw, 300px" />
              <img src={hereThere.preview} width="960" height="640" alt={hereThere.previewAlt} loading="lazy" decoding="async" />
            </picture>
            <span><strong>Here / there</strong> Visitor book</span>
          </a>
        </div>
        <figcaption>
          Actual screens from the deployed apps, captured {captured(paperwork.previewCaptured)} and {captured(linkCheck.previewCaptured)}. The app illustrations elsewhere are artwork, not screens.
        </figcaption>
      </figure>
    </section>

    <section class="home-paths" aria-labelledby="paths-heading">
      <h2 id="paths-heading">What are you here to do?</h2>
      <div class="home-paths-list">
        <article>
          <h3>Try a working app</h3>
          <p>{apps.length} independent apps: a browser PDF editor, a site review, a moderated visitor book and more. Open one without an account.</p>
          <p class="home-path-action"><a href="/apps">Open the app library <ArrowRight size={17} aria-hidden="true" /></a></p>
        </article>
        <article>
          <h3>Build with your agent</h3>
          <p>Get Ready checks the tools, source and Cloudflare account. Init turns the idea into a brief your agent implements.</p>
          <p class="home-path-action"><a href="/ready">Prepare the environment <ArrowRight size={17} aria-hidden="true" /></a><a class="home-path-more" href="/init">Shape it in Init</a></p>
        </article>
        <article>
          <h3>Run it with a team</h3>
          <p>Approve contributions, read private briefs and see what visitors actually did, without a second dashboard to maintain.</p>
          <p class="home-path-action"><a href="/manage">See the owner side <ArrowRight size={17} aria-hidden="true" /></a><a class="home-path-more" href="/platform">Internal platform</a></p>
        </article>
      </div>
    </section>

    <section class="home-made" aria-labelledby="made-heading">
      <div class="home-section-heading">
        <div>
          <h2 id="made-heading">Built here, running now.</h2>
          <p>Each app keeps its own source, data and release. These are its actual interfaces and exports.</p>
        </div>
        <a href="/apps">Browse all {apps.length} apps <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="home-made-list">
        <article>
          <a class="home-made-art" href="/launch-kit" aria-label="Open Launch Kit">
            <img src="/launch-kit/cards/river-typography.png" width="1200" height="630" alt="River, a fictional profile card typeset with Launch Kit." loading="lazy" decoding="async" />
          </a>
          <h3><a href="/launch-kit">A profile card from your own artwork</a></h3>
          <p>Launch Kit also prepares app icons and share images, then exports a package you can check before it ships.</p>
          <a class="home-made-action" href="/launch-kit">Open Launch Kit <ArrowRight size={16} aria-hidden="true" /></a>
        </article>
        <article>
          <a class="home-made-art" href="/platform/demo">
            <img src="/demos/platform-native-25dc7589-b3cd5894/overview-poster.jpg" width="1600" height="1200" alt="Recorded native application screens from the fictional two-team walkthrough." loading="lazy" decoding="async" />
            <span class="home-made-play"><Play size={16} aria-hidden="true" /> Watch</span>
          </a>
          <h3><a href="/platform/demo">From a team request to a working app</a></h3>
          <p>Recorded end to end with fictional teams: request an app, review the contribution and update it.</p>
          <a class="home-made-action" href="/platform/demo">Watch the team journey <ArrowRight size={16} aria-hidden="true" /></a>
        </article>
        <article>
          <a class="home-made-art" href={linkarooie.href} aria-label="Open Linkarooie">
            <picture>
              <source type="image/webp" srcset={`${linkarooie.preview} 960w, ${linkarooie.previewWide} 1440w`} sizes="(max-width: 700px) 90vw, 390px" />
              <img src={linkarooie.preview} width="960" height="640" alt={linkarooie.previewAlt} loading="lazy" decoding="async" />
            </picture>
          </a>
          <h3><a href={linkarooie.href}>Links and approved photos on one page</a></h3>
          <p>Linkarooie features photos from Here / there and drops them when the source goes private.</p>
          <a class="home-made-action" href={linkarooie.href}>Open Linkarooie <ArrowRight size={16} aria-hidden="true" /></a>
        </article>
      </div>
    </section>

    {ownerInstance && (
      <section class="home-instance" aria-labelledby="instance-heading">
        <h2 id="instance-heading">Installed in this instance</h2>
        <p>{ownerInstance.name} — {ownerInstance.description}</p>
        <a href={ownerInstance.profile}>Open {ownerInstance.owner}’s Linkarooie profile <ArrowRight size={16} aria-hidden="true" /></a>
      </section>
    )}

    <section class="home-briefing" aria-labelledby="briefing-heading">
      <div class="home-briefing-copy">
        <p class="home-briefing-kicker"><span>Briefing</span> · 22 October 2026</p>
        <h2 id="briefing-heading">When PHP broke, Australia felt it.</h2>
        <p>Two critical flaws in the PHP runtime took Australian government sites offline as a precaution. Patching is urgent; the longer lesson is how these systems are built and run.</p>
        <a class="home-briefing-link" href="/php2shell">Read the Australia briefing <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <a class="home-briefing-art" href="/php2shell" aria-label="Read the PHP2Shell Australia briefing">
        <img class="home-briefing-wide" src="/brand/campaign/php2shell-australia-20261022b-1200x630.webp" width="1200" height="630" alt="Flat orange and white PHP2Shell briefing graphic: the App Composer mark, the headline PHP2Shell. Australia felt it., and facts about the critical PHP flaws, Australian service disruption and Cloudflare's early WAF response." decoding="sync" />
        <img class="home-briefing-square" src="/brand/campaign/php2shell-australia-20261022b-1080x1080.webp" width="1080" height="1080" alt="Flat orange and white PHP2Shell briefing graphic: the App Composer mark, the headline PHP2Shell. Australia felt it., and facts about the critical PHP flaws, Australian service disruption and Cloudflare's early WAF response." loading="lazy" decoding="sync" />
      </a>
    </section>

    <section class="home-depth" aria-labelledby="depth-heading">
      <div class="home-depth-intro">
        <h2 id="depth-heading">Go deeper when you need it.</h2>
        <p>App Composer is an agent-operated studio built around EmDash and Cloudflare. The technical detail, the build story and the release evidence live on their own pages.</p>
      </div>
      <div class="home-depth-links">
        <div>
          <h3>Build</h3>
          <ul>
            <li><a href="/prompts">Prompt library</a></li>
            <li><a href="/init">Init</a></li>
            <li><a href="/setup">Set up your project</a></li>
            <li><a href="/learn">Learn the workflow</a></li>
          </ul>
        </div>
        <div>
          <h3>Understand</h3>
          <ul>
            <li><a href="/architecture">How it works</a></li>
            <li><a href="/guide">Platform &amp; service guide</a></li>
            <li><a href="/building">Build story</a></li>
            <li><a href="/diagrams">Diagram atlas</a></li>
            <li><a href="/release">Release evidence</a></li>
          </ul>
        </div>
        <div>
          <h3>Teams and creators</h3>
          <ul>
            <li><a href="/platform">Internal platform</a></li>
            <li><a href="/studio">Creator stacks</a></li>
            <li><a href="/activity">Analytics &amp; reports</a></li>
            <li><a href="/resources">Runbooks &amp; resources</a></li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .composer-home {
    font-size: 1rem;
  }
  .composer-home h1,
  .composer-home h2,
  .composer-home h3 {
    letter-spacing: -0.03em;
  }

  /* First viewport: the task, one action, the prompt shortcut, real screens. */
  .home-hero {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem 3rem;
    align-items: flex-start;
    padding: 0 0 3rem;
  }
  .home-hero-copy {
    flex: 1 1 26rem;
    min-width: 0;
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .home-hero h1 {
    font-size: clamp(2.6rem, 4.4vw, 3.9rem);
    line-height: 1.02;
    margin: 0 0 1.25rem;
    max-width: 13ch;
  }
  .home-lede {
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 38ch;
    margin: 0 0 1.75rem;
  }
  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .home-hero-actions .button {
    font-size: 1.05rem;
    padding: 16px 24px;
    min-height: 3.5rem;
  }
  .home-quick {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 1.75rem 0 0;
    padding: 1rem 1.25rem;
    max-width: 33rem;
    border-left: 4px solid var(--color-action);
    border-radius: 0 8px 8px 0;
    background: var(--color-surface);
  }
  .home-quick-label {
    display: block;
    font: 600 1.1rem/1.35 Space, system-ui, sans-serif;
    overflow-wrap: anywhere;
  }
  .home-quick-label svg {
    display: inline-block;
    margin-left: 0.45rem;
    vertical-align: -3px;
    color: var(--color-accent);
  }
  .home-quick-note {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  .home-quick:hover {
    background: var(--color-field);
  }
  .home-agent-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin-top: 0.35rem;
    color: var(--color-accent);
    font-size: 0.95rem;
  }
  .home-agent-link svg {
    flex: none;
  }
  .home-quick:hover .home-quick-label {
    color: var(--color-accent);
  }
  .home-look {
    margin: 1rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 46ch;
  }

  .home-proof {
    flex: 0 1 30rem;
    min-width: 0;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-surface);
  }
  .home-proof-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    background: var(--color-brand);
    color: #17181b;
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }
  .home-proof-bar img {
    display: block;
    width: 22px;
    height: 22px;
  }
  .home-proof-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
  }
  .home-proof-grid a {
    display: block;
    min-width: 0;
    background: var(--color-background);
  }
  .home-proof-main {
    grid-column: 1 / -1;
  }
  .home-proof-grid img {
    display: block;
    width: 100%;
    height: auto;
  }
  .home-proof-grid a span {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4rem;
    padding: 0.5rem 0.7rem;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--color-muted);
  }
  .home-proof-grid a span strong {
    color: var(--color-foreground);
    font-weight: 600;
  }
  .home-proof-grid a:hover span strong {
    color: var(--color-accent);
  }
  .home-proof figcaption {
    padding: 0.65rem 0.9rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  /* Three jobs, one destination each. */
  .home-paths,
  .home-made,
  .home-briefing,
  .home-depth {
    border-top: 1px solid var(--color-border);
  }
  .home-paths {
    padding: 2.5rem 0;
  }
  .home-paths h2 {
    font-size: clamp(1.75rem, 2.8vw, 2.4rem);
    margin: 0 0 1.75rem;
    max-width: 24ch;
  }
  .home-paths-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 0 2.5rem;
  }
  .home-paths-list article {
    min-width: 0;
    border-top: 1px solid var(--color-border);
    padding: 1rem 0 0.5rem;
  }
  .home-paths-list h3 {
    font-size: 1.25rem;
    margin: 0 0 0.6rem;
  }
  .home-paths-list p {
    margin: 0 0 0.9rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 34ch;
  }
  .home-path-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    margin: 0 !important;
  }
  .home-path-action a,
  .home-path-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 0.95rem;
    color: var(--color-foreground);
  }
  .home-path-action a svg {
    color: var(--color-accent);
  }
  .home-path-more {
    color: var(--color-muted);
    font-weight: 500;
  }

  /* Real output from the shipped apps. */
  .home-made {
    padding: 2.5rem 0;
  }
  .home-section-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 2.5rem;
  }
  .home-section-heading h2 {
    font-size: clamp(1.75rem, 2.8vw, 2.4rem);
    margin: 0 0 0.6rem;
    max-width: 22ch;
  }
  .home-section-heading p {
    margin: 0;
    max-width: 52ch;
    color: var(--color-muted);
    font-size: 0.98rem;
  }
  .home-section-heading > a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .home-made-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 2rem 2.25rem;
    margin-top: 2rem;
  }
  .home-made-list article {
    min-width: 0;
  }
  .home-made-art {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface);
  }
  .home-made-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .home-made-play {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    background: #17181b;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .home-made-list h3 {
    font-size: 1.2rem;
    line-height: 1.25;
    margin: 0.9rem 0 0.5rem;
  }
  .home-made-list h3 a {
    color: var(--color-foreground);
  }
  .home-made-list h3 a:hover {
    color: var(--color-accent);
  }
  .home-made-list p {
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 42ch;
  }
  .home-made-action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    font-size: 0.9rem;
  }
  .home-made-action svg {
    color: var(--color-accent);
  }

  .home-instance {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
  }
  .home-instance h2 {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0;
  }
  .home-instance p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-muted);
    max-width: 52ch;
  }
  .home-instance a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-size: 0.92rem;
  }

  /* The campaign keeps its own linked section, below the product work. */
  .home-briefing {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 2rem 3rem;
    align-items: center;
    padding: 2.5rem 0;
  }
  .home-briefing-copy {
    min-width: 0;
  }
  .home-briefing-kicker {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-muted);
  }
  .home-briefing-kicker span {
    color: var(--color-accent);
  }
  .home-briefing h2 {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    line-height: 1.05;
    max-width: 16ch;
    margin: 0 0 0.75rem;
  }
  .home-briefing-copy p {
    margin: 0 0 1rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 46ch;
  }
  .home-briefing-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 0.95rem;
  }
  .home-briefing-art {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
  }
  .home-briefing-art img {
    display: block;
    width: 100%;
    height: auto;
  }
  .home-briefing-art img.home-briefing-square {
    display: none;
  }

  .home-depth {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3.5rem;
    padding: 2.5rem 0 0;
  }
  .home-depth-intro {
    flex: 1 1 21rem;
    min-width: 0;
  }
  .home-depth-intro h2 {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    margin: 0 0 0.75rem;
    max-width: 18ch;
  }
  .home-depth-intro p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    max-width: 42ch;
  }
  .home-depth-links {
    flex: 2 1 30rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1.5rem 2rem;
  }
  .home-depth-links h3 {
    font: 650 0.78rem/1.4 system-ui, sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 0.4rem;
  }
  .home-depth-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .home-depth-links li {
    margin: 0;
  }
  .home-depth-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.95rem;
