---
import Base from "../layouts/Base.astro";
import { portfolioProjects } from "../lib/portfolio-projects";
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import { apps } from "../lib/apps";
import instance from "../../config/instance.json";
import "../styles/product-home.css";

const miniApps = apps.filter(app => app.id !== "media-studio" && app.id !== "showcase");
const projects = portfolioProjects.filter(project => project.site && project.id !== "app-composer" && project.id !== "media-studio");
const resources = [
  {title: "Learn and create", links: [["First app", "/learn"], ["Project sandbox", "/demo"], ["Illustrated workshop", "/demo/workshop"], ["Share films", "/share?view=films"], ["Screening room", "/demo/screening-room"], ["Prompt library", "/prompts"], ["Diagrams", "/diagrams"]]},
  {title: "Run your apps", links: [["Manage apps", "/manage"], ["Platform console", "/platform"], ["Console demo", "/platform/demo"], ["Analytics and reports", "/activity"], ["Creator stacks", "/studio"], ["Cloudflare costs", "/cloudflare"], ["Release evidence", "/release"]]},
  {title: "Explore Composer", links: [["Why I built this", "/story"], ["Build story", "/building"], ["Find a tool by task", "/discover"], ["Project setup", "/setup"], ["Connect an agent", "/agent"], ["Service guide", "/guide"], ["Operator resources", "/resources"], ["PHP2Shell briefing", "/php2shell"]]},
];
const questions = [
  {
    area: "Engineering", question: "Can I build this?",
    answer: "Start with one useful feature. Use Init to give your AI agent a brief and a working reference.",
    href: "/init", link: "Write an app brief",
  },
  {
    area: "Product", question: "Does anyone actually want this?",
    answer: "Show someone a working version and ask what they’d use. After launch, check what people actually open.",
    href: "/activity", link: "See recorded usage",
  },
  {
    area: "Strategy", question: "Should I build, buy, integrate or reuse it?",
    answer: "Try a working tool first. Reuse what fits, pay for a specialist service if it earns its place, and build the missing piece.",
    href: "/discover", link: "Find a tool by task",
  },
  {
    area: "Distribution", question: "How do I get it into people’s hands?",
    answer: "Publish to your own Cloudflare account and send a working link. See how a profile and guestbook went live and changed later.",
    href: "/creator-hub", link: "Follow the Creator Hub build",
  },
  {
    area: "Economics", question: "What does it cost to build and operate?",
    answer: "Reuse an agent you have and start on Workers Free if it fits. Budget for hosting, maintenance and optional AI features powered by Workers AI.",
    href: "/ready/start-for-free", link: "Read the free-first cheat sheet",
  },
  {
    area: "Leverage", question: "How does this help my next project?",
    answer: "Carry your source, assets and workflows forward. See how Prints Desktop turns artwork into a reusable shortlist and release assets.",
    href: "/articles/picking-release-art", link: "See the Prints workflow",
  },
];
const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "App Composer",
  url: "https://composer.loftwah.com/",
};
---

<Base
  homePage
  shareImage="/brand/campaign/composer-make-an-app-20261128.png"
  shareAlt="App Composer. Make an app you own. Large black type on signature orange."
  title="App Composer — create, ship and run projects with AI"
  description="Build and run software you own with your AI agent. App Composer brings together reusable apps, Media Studio and your own Cloudflare account."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  <div class="composer-home">
    <section class="home-opening campaign-opening" aria-labelledby="home-heading">
      <div class="campaign-frame home-container">
        <div class="campaign-copy">
          <h1 id="home-heading">Make an app<br />
            you own<span>.</span></h1>
          <p>Start with a working example, then build and run your app with your AI agent in accounts you control.</p>
          <nav class="home-opening-actions" aria-label="Start exploring">
            <a class="home-button" href="/ready">Build your first app <ArrowRight size={17} aria-hidden="true" /></a>
            <a class="home-text-link" href="/discover">Find a starting point <ArrowRight size={17} aria-hidden="true" /></a>
          </nav>
        </div>
        <figure class="campaign-print">
          <img src="/brand/campaign/build-it-keep-it-running-864-20261128.webp"
            srcset="/brand/campaign/build-it-keep-it-running-864-20261128.webp 864w, /brand/campaign/build-it-keep-it-running-1728-20261128.webp 1728w"
            sizes="(max-width: 760px) 94vw, (max-width: 1440px) 56vw, 770px" width="1728" height="910"
            fetchpriority="high" alt="App Composer. Build it. Keep it running. An illuminated workshop press feeds out an app sketch." />
        </figure>
      </div>
      <nav class="campaign-destinations home-container" aria-label="Open App Composer tools">
        <a href="/media-studio/studio">Media Studio <ArrowUpRight size={16} aria-hidden="true" /></a>
        <a href="/apps">App library <ArrowRight size={16} aria-hidden="true" /></a>
        <a href="/showcase/">Linkarooie <ArrowRight size={16} aria-hidden="true" /></a>
        <a href="/share">Share <ArrowRight size={16} aria-hidden="true" /></a>
      </nav>
      <nav class="campaign-apps home-container" aria-label="Try a working app">
        <a href="/creator-hub"><span><strong>Creator Hub</strong>Open a profile and guestbook</span><ArrowUpRight size={20} aria-hidden="true" /></a>
        <a href="https://paperwork.loftwah.com/"><span><strong>Paperwork</strong>Fill and sign a PDF</span><ArrowUpRight size={20} aria-hidden="true" /></a>
        <a href="https://spin.loftwah.com/"><span><strong>Spin</strong>Put a decision on the wheel</span><ArrowUpRight size={20} aria-hidden="true" /></a>
      </nav>
    </section>

    <section class="home-miniapps home-container" aria-labelledby="work-heading">
      <div class="home-section-head"><h2 id="work-heading">Apps &amp; creative tools</h2><a class="home-text-link" href="/apps">Browse the library <ArrowRight size={18} aria-hidden="true" /></a></div>
      <div class="home-features">
        <article><a href="/media-studio/films#studio-teaser"><img src="/media-studio/low-tide-teaser-art-20261128.webp" width="442" height="252" alt="Low Tide by LoftwahFM, in white lettering over a violet and pink coastline." loading="lazy" /><h3>Watch the Media Studio teaser</h3></a><p>See Low Tide and other finished work in the Studio reel.</p><a href="/media-studio">Explore Media Studio →</a></article>
        <article><a href="/showcase/"><img src="/brand/apps/linkarooie-share-20261018-v2.jpg" width="1200" height="630" alt="Linkarooie’s workshop curator" loading="lazy" /><h3>Linkarooie</h3></a><p>Open Loftwah’s published profile for music, games, writing and the projects behind them.</p><a href="/showcase/">Explore the profile →</a></article>
        <article><a href="/share/artwork/atlas-04-composer-family/palette"><img src="/brand/campaign/composer-family-atlas.webp" width="640" height="429" alt="The Composer family artwork shows a workshop opening onto an orange mountain landscape." loading="lazy" /><h3>Take a colour from the artwork</h3></a><p>Sample the Composer family illustration and export the colours you pick.</p><a href="/share">Browse Share →</a></article>
      </div>
      <ul class="home-tools">{miniApps.map(app => <li><a href={app.href}><img src={app.thumbnail} alt="" width="32" height="32" loading="lazy" />{app.name}<ArrowUpRight size={15} aria-hidden="true" /></a></li>)}</ul>
      <div class="home-widget-trail">
        <p>Embed LoftwahFM’s Night Signal player on your site.</p>
        <a class="home-text-link" href="/widgets">Open the Widget library <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
    </section>

    <section class="home-workflow" id="make-something" aria-labelledby="start-heading">
      <div class="home-container">
        <div class="home-section-head">
          <div>
            <h2 id="start-heading">From idea to live app</h2>
            <p>App Composer is open source. Explore the public examples here, then build with your own agent, GitHub repository and Cloudflare account.</p>
          </div>
          <a class="home-text-link" href="/ready/start-for-free">See what you can start for free <ArrowRight size={17} aria-hidden="true" /></a>
        </div>
        <div class="home-decisions">
          <ul class="home-questions" role="list">
            {questions.map(({ area, question, answer, href, link }) => (
              <li>
                <span class="home-question-area">{area}</span>
                <div>
                  <h3>{question}</h3>
                  <p>{answer}</p>
                  <a class="home-text-link" href={href}>{link} <ArrowRight size={16} aria-hidden="true" /></a>
                </div>
              </li>
            ))}
          </ul>
          <aside class="home-examples" id="example" aria-label="Examples you can try">
            <figure>
              <a href="/creator-hub#follow-up">
                <img src="/creator-hub/profile-20261112.webp" width="1440" height="1535" alt="The published Mara Quinn profile with two featured links" loading="lazy" />
                <span>See the change after launch <ArrowUpRight size={16} aria-hidden="true" /></span>
              </a>
              <figcaption>Creator Hub · fictional profile, live on Cloudflare</figcaption>
            </figure>
            <figure>
              <a href="/articles/picking-release-art">
                <img src="/articles/prints-creator-workflow-050.jpg" width="1280" height="800" alt="Prints Desktop compares an album cover and release poster side by side" loading="lazy" />
                <span>Follow the Prints Desktop workflow <ArrowUpRight size={16} aria-hidden="true" /></span>
              </a>
              <figcaption>Prints Desktop · a working artwork tool</figcaption>
            </figure>
          </aside>
        </div>
        <div class="home-case" id="origin">
          <div>
            <h3>Why this workshop exists</h3>
            <p>It began with systems work, music storefronts and a simple habit: reuse what works, pay for the specialist parts and build what's missing.</p>
          </div>
          <a class="home-text-link" href="/story">Read the founder story <ArrowUpRight size={17} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <nav class="home-resource-index home-container" aria-label="Composer guides and tools">
      {resources.map(group => <section><h2>{group.title}</h2>{group.links.map(([label, href]) => <a href={href}>{label}</a>)}</section>)}
    </nav>
    <section class="home-other home-container" aria-label="Portfolio projects"><h2><a href="/projects">Other projects →</a></h2>
      <nav aria-label="Open a portfolio project">{projects.map(project => <a href={project.site}>{project.name}</a>)}<a href="/projects">Full project directory</a></nav>
    </section>
    {instance.enabled && (
      <div class="home-instance home-container">
        <p><strong>{instance.name}</strong></p>
        <a class="home-text-link" href={instance.profile}>
          Open {instance.owner}’s Linkarooie profile <ArrowUpRight size={17} aria-hidden="true" />
        </a>
      </div>
    )}
  </div>
</Base>


<script>
  // Bookmarks to editions created by the former homepage editor still open that edition.
  if (location.hash.startsWith('#postcards=1&')) location.replace('/demo/postcards/edit' + location.hash);
</script>
