---
import Base from "../layouts/Base.astro";
import { ArrowRight, ArrowDown, ArrowUpRight, Play } from "@lucide/astro";
import { apps } from "../lib/apps";
import instance from "../../config/instance.json";
import "../styles/product-home.css";

const ownerInstance = instance.enabled ? instance : null;
const appById = (id: string) => {
  const app = apps.find((entry) => entry.id === id);
  if (!app) throw new Error(`Unknown app in the homepage: ${id}`);
  return app;
};
const paperwork = appById("paperwork");
const studioRoute = "M515 268H551V389Q551 400 540 400H520";
const selectedApps = [
  {
    app: paperwork,
    purpose: "Finish the paperwork.",
    detail:
      "Fill a PDF, add your signature and save the completed document. Your files stay in your browser.",
  },
  {
    app: appById("ldraw"),
    purpose: "Give an idea some shape.",
    detail:
      "Draw an editable diagram, work from the included examples and export a PNG or SVG.",
  },
  {
    app: appById("launch-kit"),
    purpose: "Give your work an identity.",
    detail:
      "Turn your own artwork into app icons, profile cards and share images. Inspect the files before exporting.",
  },
];
const previewHeights: Record<string, number> = {
  paperwork: 1100,
  ldraw: 1000,
  "launch-kit": 900,
};
const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "App Composer",
  url: "https://composer.loftwah.com/",
};
---

<Base
  homePage
  title="App Composer — build apps with your agent on Cloudflare"
  description="Bring the app you need. Your agent builds it with you on Cloudflare, and the source, the data and the admin stay yours. Start with Get Ready, shape it in Init or copy a prompt straight to your agent."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(siteSchema)}
  />
  <div class="composer-home">
    <section class="home-hero" aria-labelledby="home-heading">
      <div class="hero-rule" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="hero-copy">
          <h1 id="home-heading">
            Make software.
            <br />
            <span>Keep it yours.</span>
          </h1>
          <p class="hero-lede">
            Bring the app you wish existed. Build it with your agent. Keep the
            source, the data and the freedom to change it.
          </p>
          <div class="hero-actions">
            <a class="home-button" href="/ready">
              Start with Get Ready <ArrowUpRight size={21} aria-hidden="true" />
            </a>
            <a class="hero-prompts" href="/prompts">
              Just give me the prompts{" "}
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
          <p class="hero-context">
            <a href="/creator-hub">
              See the live Creator Hub <ArrowRight size={16} aria-hidden="true" />
            </a>
          </p>
        </div>
        <div class="studio-scene" data-studio-scene aria-hidden="true">
          <div class="studio-assembly">
            <div class="studio-plate">
              <img
                src="/brand/composer-mark-reverse-20261022b.svg"
                width="84"
                height="84"
                alt=""
              />
              <div class="studio-slot"></div>
            </div>
            <svg
              class="studio-routing"
              viewBox="0 0 600 540"
              preserveAspectRatio="none"
              fill="none"
            >
              <path class="studio-guides" d="M38 126V42H122M480 498H562V416" />
              <path class="studio-route" d={studioRoute} pathLength="100" />
              <path class="studio-signal" d={studioRoute} pathLength="100" />
              <circle class="studio-terminal-ring" cx="520" cy="400" r="9" />
              <circle class="studio-terminal" cx="520" cy="400" r="4" />
            </svg>
            <div class="studio-sheet studio-output">
              <div class="studio-label">Launch Kit <span>Profile card</span></div>
              <img
                src="/launch-kit/cards/river-typography.png"
                width="1200"
                height="630"
                alt=""
                decoding="async"
              />
            </div>
            <div class="studio-sheet studio-app">
              <div class="studio-label">Paperwork <span>PDF editor</span></div>
              <img
                src={paperwork.preview}
                width="1440"
                height="1100"
                alt=""
                decoding="async"
              />
            </div>
          </div>
        </div>
        <div class="hero-bottom">
          <a href="#make-something">
            Explore what you can make <ArrowDown size={18} aria-hidden="true" />
          </a>
          <span>The Paperwork editor and a fictional Launch Kit export.</span>
        </div>
      </div>
    </section>

    <section
      class="home-start home-container"
      id="make-something"
      aria-labelledby="start-heading"
    >
      <div class="section-intro home-reveal">
        <p class="home-eyebrow">
          <span class="section-number">01</span> From an idea to something
          useful
        </p>
        <h2 id="start-heading">
          For the app you
          <br />
          wish already existed.
        </h2>
        <p class="section-lede">
          A tool for your team. A home for your work. A small problem worth
          solving. App Composer gives your agent a practical place to start.
        </p>
      </div>
      <ol class="build-steps">
        <li class="home-reveal">
          <span class="step-index" aria-hidden="true">
            01 /
          </span>
          <div>
            <h3>Get your tools ready.</h3>
            <p>
              Check the source, tools and Cloudflare account your agent will
              use. You can start before you have an app idea.
            </p>
            <a class="home-text-link" href="/ready">
              Open Get Ready <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
        </li>
        <li class="home-reveal">
          <span class="step-index" aria-hidden="true">
            02 /
          </span>
          <div>
            <h3>Shape what you need.</h3>
            <p>
              Choose a starting point in Init. Turn the useful details into a
              clear brief for your existing coding agent.
            </p>
            <a class="home-text-link" href="/init">
              Shape an app in Init <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
        </li>
        <li class="home-reveal">
          <span class="step-index" aria-hidden="true">
            03 /
          </span>
          <div>
            <h3>Make it your own.</h3>
            <p>
              Your agent implements the brief in your repository and account.
              Keep building on software you can inspect and change.
            </p>
            <a class="home-text-link" href="/learn">
              Follow the build journey{" "}
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
        </li>
      </ol>
    </section>

    <section class="home-work" aria-labelledby="work-heading">
      <div class="home-container">
        <div class="work-heading home-reveal">
          <div>
            <p class="home-eyebrow">
              <span class="section-number">02</span> Built here. Open now.
            </p>
            <h2 id="work-heading">
              Software you can
              <br />
              use right now.
            </h2>
          </div>
          <div class="work-aside">
            <p>
              Independent apps with their own source, data and release. Try the
              finished work, then explore how it is made.
            </p>
            <a class="home-text-link" href="/apps">
              Browse all {apps.length} apps{" "}
              <ArrowUpRight size={19} aria-hidden="true" />
            </a>
          </div>
        </div>
        <div class="work-gallery" data-home-gallery>
          <div
            class="work-tabs"
            aria-label="Choose an application"
            data-home-tabs
          >
            {selectedApps.map(({ app }, index) => (
              <a
                class="work-tab"
                href={`#work-${app.id}`}
                id={`work-tab-${app.id}`}
                data-home-tab
              >
                <span class="tab-number">0{index + 1}</span>
                <span>{app.name}</span>
                <ArrowUpRight size={18} aria-hidden="true" />
              </a>
            ))}
          </div>
          {selectedApps.map(({ app, purpose, detail }) => (
            <div class="work-panel" id={`work-${app.id}`} data-home-panel>
              <div class="work-panel-caption">
                <div>
                  <h3>{purpose}</h3>
                  <p>{detail}</p>
                </div>
                <a class="home-button home-button-quiet" href={app.href}>
                  Open {app.name} <ArrowUpRight size={19} aria-hidden="true" />
                </a>
              </div>
              <figure class={`work-screen work-screen-${app.id}`}>
                <a href={app.href} aria-label={`Open ${app.name}`}>
                  <img
                    src={app.previewWide}
                    width="1440"
                    height={previewHeights[app.id] ?? 960}
                    alt={app.previewAlt}
                    loading="lazy"
                    decoding="async"
                    data-captured={app.previewCaptured}
                  />
                </a>
                <figcaption>
                  <span>
                    Deployed app capture ·{" "}
                    <time datetime={app.previewCaptured}>
                      {app.previewCaptured.replaceAll("-", "/")}
                    </time>
                  </span>
                  <a href={app.source}>
                    Explore the source{" "}
                    <ArrowUpRight size={14} aria-hidden="true" />
                  </a>
                </figcaption>
              </figure>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="home-composition" aria-labelledby="composition-heading">
      <div class="home-container composition-layout">
        <div class="composition-copy home-reveal">
          <p class="home-eyebrow">
            <span class="section-number">03</span> Better together
          </p>
          <h2 id="composition-heading">
            Make the pieces
            <br />
            work together.
          </h2>
          <p>
            Here / there keeps the photos. Linkarooie makes the collection.
            Connect them, change a source postcard and see what follows.
          </p>
          <a class="home-button home-button-ink" href="/demo">
            Try the composition studio{" "}
            <ArrowUpRight size={21} aria-hidden="true" />
          </a>
          <span class="composition-note">
            An interactive experiment with fictional postcards, saved on this
            device.
          </span>
          <a class="composition-live" href="/creator-hub">
            See a live Creator Hub built this way{" "}
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </div>
        <figure class="composition-art home-reveal">
          <svg
            class="composition-wiring"
            viewBox="0 0 620 570"
            fill="none"
            aria-hidden="true"
          >
            <path d="M60 130H460V420H180" />
            <path d="m194 406-14 14 14 14" />
            <circle cx="60" cy="130" r="6" />
          </svg>
          <div class="postcard postcard-source">
            <div class="postcard-label">
              <span>Here / there</span>
              <span>The source</span>
            </div>
            <img
              src="/brand/demo/ringmarket-v5.webp"
              width="1200"
              height="900"
              alt="Fictional postcard from the demo: an orange market above a ringed planet."
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="postcard postcard-collection">
            <div class="postcard-label">
              <span>Linkarooie</span>
              <span>The collection</span>
            </div>
            <img
              src="/brand/demo/lighthouse-v5.webp"
              width="1200"
              height="900"
              alt="Fictional postcard from the demo: a lighthouse on a small moon."
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>Each app keeps its own source and records.</figcaption>
        </figure>
      </div>
      <div class="composition-foot home-container">
        <span>One connected experience.</span>
        <a href="/architecture">
          See how the parts fit <ArrowRight size={19} aria-hidden="true" />
        </a>
      </div>
    </section>

    <section class="home-film home-container" aria-labelledby="film-heading">
      <div class="film-heading home-reveal">
        <p class="home-eyebrow">
          <span class="section-number">04</span> The work behind the interface
        </p>
        <h2 id="film-heading">
          See the whole
          <br />
          journey take shape.
        </h2>
        <div>
          <p>
            A team requests an app. Someone reviews the contribution. The
            software changes. Follow a recorded walkthrough using fictional
            teams and working application screens.
          </p>
          <a class="home-text-link" href="/manage">
            Explore the owner side <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>
      </div>
      <a
        class="film-cover home-reveal"
        href="/platform/demo"
        aria-label="Watch the recorded team application walkthrough"
      >
        <img
          src="/demos/platform-native-25dc7589-b3cd5894/overview-poster.jpg"
          width="1600"
          height="1200"
          alt="Recorded native application screens from the fictional two-team walkthrough."
          loading="lazy"
          decoding="async"
        />
        <span class="film-play">
          <span class="play-circle">
            <Play size={27} fill="currentColor" aria-hidden="true" />
          </span>
          <span>
            Watch the team walkthrough{" "}
            <ArrowUpRight size={18} aria-hidden="true" />
          </span>
        </span>
      </a>
      <div class="film-foot">
        <span>Recorded demonstration · fictional team data</span>
        <a href="/platform">
          Explore the internal platform{" "}
          <ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>
    </section>

    <section
      class="home-community home-container"
      aria-labelledby="community-heading"
    >
      <div class="community-heading home-reveal">
        <p class="home-eyebrow">From the community</p>
        <h2 id="community-heading">
          The next idea
          <br />
          doesn’t have to be ours.
        </h2>
      </div>
      <article class="community-project home-reveal">
        <span class="community-mark" aria-hidden="true">
          ↗
        </span>
        <div>
          <p class="community-byline">Robert DeVore</p>
          <h3>Agent Black Box</h3>
          <p>
            Robert used Composer’s manifest and composition validators to build
            three independent Worker apps for importing agent-run evidence,
            replaying it and publishing an approved report.
          </p>
          <p class="community-scope">
            Open-source local demo with a project-specific adapter.
          </p>
          <div class="community-links">
            <a
              class="home-text-link"
              href="https://github.com/robertdevore/agent-black-box"
            >
              Explore the project <ArrowUpRight size={18} aria-hidden="true" />
            </a>
            <a href="https://x.com/deviorobert/status/2117347151525134372">
              Read Robert’s announcement{" "}
              <ArrowUpRight size={16} aria-hidden="true" />
            </a>
          </div>
        </div>
      </article>
    </section>

    <section class="home-next" aria-labelledby="next-heading">
      <div class="home-container">
        <p class="home-eyebrow">A useful place to start</p>
        <div class="next-heading">
          <h2 id="next-heading">
            What would
            <br />
            you make?
          </h2>
          <img
            src="/brand/composer-icon-20261022b.svg"
            width="180"
            height="180"
            alt=""
            loading="lazy"
          />
        </div>
        <div class="next-actions">
          <a class="home-button" href="/ready">
            Let’s build something <ArrowUpRight size={21} aria-hidden="true" />
          </a>
          <a class="home-text-link" href="/agent">
            Point your existing agent here{" "}
            <ArrowRight size={19} aria-hidden="true" />
          </a>
        </div>
        <p class="next-note">
          Looking around needs no account. Building uses your own source, agent
          and Cloudflare account.
        </p>
      </div>
    </section>

    <section
      class="home-depth home-container"
      aria-label="Explore App Composer"
    >
      <div class="depth-intro">
        <img
          src="/brand/composer-icon-tile-20261022b.svg"
          width="40"
          height="40"
          alt=""
          loading="lazy"
        />
        <h2>
          Go as deep
          <br />
          as you need.
        </h2>
        <p>The tools, the build story and the details behind the work.</p>
      </div>
      <div>
        <h3>Make something</h3>
        <ul>
          <li>
            <a href="/prompts">Prompt library</a>
          </li>
          <li>
            <a href="/init">Init</a>
          </li>
          <li>
            <a href="/setup">Set up your project</a>
          </li>
          <li>
            <a href="/learn">Learn the workflow</a>
          </li>
          <li>
            <a href="/launch-kit">Launch Kit</a>
          </li>
        </ul>
      </div>
      <div>
        <h3>Explore the work</h3>
        <ul>
          <li>
            <a href="/apps">App library</a>
          </li>
          <li>
            <a href="/discover">Find a path for your work</a>
          </li>
          <li>
            <a href="/studio">Creator stacks</a>
          </li>
          <li>
            <a href="/activity">Analytics &amp; reports</a>
          </li>
          <li>
            <a href="/php2shell">The PHP2Shell Australia briefing</a>
          </li>
        </ul>
      </div>
      <div>
        <h3>Understand it</h3>
        <ul>
          <li>
            <a href="/architecture">How it works</a>
          </li>
          <li>
            <a href="/cloudflare">Cloudflare costs &amp; operations</a>
          </li>
          <li>
            <a href="/guide">Platform &amp; service guide</a>
          </li>
          <li>
            <a href="/building">Build story</a>
          </li>
          <li>
            <a href="/diagrams">Diagram atlas</a>
          </li>
          <li>
            <a href="/resources">Runbooks &amp; resources</a>
          </li>
          <li>
            <a href="/release">Release evidence</a>
          </li>
        </ul>
      </div>
    </section>
    {ownerInstance && (
      <div class="home-instance home-container">
        <p>
          <strong>{ownerInstance.name}</strong> — {ownerInstance.description}
        </p>
        <a href={ownerInstance.profile}>
          Open {ownerInstance.owner}’s Linkarooie profile{" "}
          <ArrowUpRight size={17} aria-hidden="true" />
        </a>
      </div>
    )}
  </div>
</Base>

<script>
  const scene = document.querySelector<HTMLElement>("[data-studio-scene]");
  const motion = matchMedia(
    "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
  );

  const terminal = scene?.querySelector(".studio-terminal");
  if (
    scene &&
    terminal &&
    "IntersectionObserver" in window &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        scene.classList.add("is-connected");
        observer.disconnect();
      },
      { rootMargin: "0px 0px -24px" },
    );
    observer.observe(terminal);
  }

  scene?.addEventListener("pointermove", (event) => {
    if (!motion.matches || event.pointerType !== "mouse") return;

    const { left, top, width, height } = scene.getBoundingClientRect();
    const x = (event.clientX - left) / width - 0.5;
    const y = (event.clientY - top) / height - 0.5;
    scene.style.setProperty("--studio-pitch", `${-y * 9}deg`);
    scene.style.setProperty("--studio-yaw", `${x * 12}deg`);
  });
  scene?.addEventListener("pointerleave", () => {
    scene.style.removeProperty("--studio-pitch");
    scene.style.removeProperty("--studio-yaw");
  });

  // Without JavaScript these remain ordinary links and all screens are readable.
  for (const gallery of document.querySelectorAll<HTMLElement>(
    "[data-home-gallery]",
  )) {
    const tabList = gallery.querySelector<HTMLElement>("[data-home-tabs]");
    const tabs = Array.from(
      gallery.querySelectorAll<HTMLAnchorElement>("[data-home-tab]"),
    );
    const panels = Array.from(
      gallery.querySelectorAll<HTMLElement>("[data-home-panel]"),
    );
    if (!tabList || tabs.length !== panels.length) continue;
    tabList.setAttribute("role", "tablist");
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, position) => {
        tab.setAttribute("aria-selected", String(position === index));
        tab.tabIndex = position === index ? 0 : -1;
        panels[position].hidden = position !== index;
      });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, index) => {
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", panels[index].id);
      panels[index].setAttribute("role", "tabpanel");
      panels[index].setAttribute("aria-labelledby", tab.id);
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        select(index);
      });
      tab.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft")
          next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
    const anchored = panels.findIndex(
      (panel) => `#${panel.id}` === window.location.hash,
    );
    select(anchored < 0 ? 0 : anchored);
    gallery.classList.add("is-enhanced");
  }

  const motionPreference = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );
  if (!motionPreference.matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.08 },
    );
    document
      .querySelectorAll<HTMLElement>(".home-reveal")
      .forEach((element) => {
        element.classList.add("will-reveal");
        observer.observe(element);
      });
    motionPreference.addEventListener("change", (event) => {
      if (!event.matches) return;
      observer.disconnect();
      document
        .querySelectorAll(".home-reveal")
        .forEach((element) => element.classList.add("is-visible"));
    });
  }
</script>
