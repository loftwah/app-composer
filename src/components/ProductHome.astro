---
import Base from "../layouts/Base.astro";
import { ArrowRight, ArrowUpRight, Play } from "@lucide/astro";
import { apps } from "../lib/apps";
import instance from "../../config/instance.json";
import "../styles/product-home.css";

const miniApps = apps.filter(app => app.id === "guestbook" || app.id === "showcase");

const steps = [
  { title: "Shape the idea", detail: "Bring a goal and references. Use Init to turn them into a brief your agent can build from.", href: "/init", link: "Write a brief in Init" },
  { title: "Build and publish", detail: "Prepare a Cloudflare environment and build the app with your coding agent in your own repository.", href: "/ready", link: "Set up with Get Ready" },
  { title: "Run it and come back", detail: "Manage content in EmDash, then ask your agent for the next change on the same live project.", href: "/creator-hub#follow-up", link: "See a change after launch" },
];
const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "App Composer",
  url: "https://composer.loftwah.com/",
};
---

<Base
  homePage
  title="App Composer — create, ship and run projects with AI"
  description="Build and run software you own with your AI agent. App Composer brings together reusable apps, Media Studio and your own Cloudflare account."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  <div class="composer-home">
    <section class="home-opening" aria-labelledby="home-heading">
      <div class="home-container home-opening-inner">
        <div class="home-opening-main">
          <h1 id="home-heading">Build your app<br /><span>from mini apps.</span></h1>
          <p>Start with a photo guestbook and a profile. Connect them with App Composer, then use your AI agent to make the app your own. You keep the code, the content and the accounts.</p>
          <div class="home-opening-actions">
            <a class="home-button" href="/demo/connected-apps">Try two apps together <ArrowRight size={20} aria-hidden="true" /></a>
            <a class="home-text-link" href="/learn">Build your first app <ArrowUpRight size={17} aria-hidden="true" /></a>
          </div>
        </div>
        <figure class="home-lead">
          <a class="home-lead-link" href="/demo#commercial" aria-label="Watch Take it with you, the App Composer short film">
            <img src="/brand/campaign/take-it-with-you-20261118.webp" width="1280" height="720" alt="Orange and ivory App Composer blocks on a blue workbench." fetchpriority="high" decoding="async" />
            <span class="home-lead-play" aria-hidden="true"><Play size={19} fill="currentColor" /></span>
          </a>
          <figcaption>
            <strong>Take it with you</strong>
            <span>App Composer short film · 11 seconds</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="home-miniapps home-container" aria-labelledby="work-heading">
      <div class="home-section-head">
        <div>
          <h2 id="work-heading">A guestbook meets a profile</h2>
          <p>Here / there collects the postcards. Linkarooie gives the ones you select a home. Open either app to see its part.</p>
        </div>
        <a class="home-text-link" href="/apps">Explore the app library <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <ul class="home-projects">
        {miniApps.map((project) => (
          <li>
            <a class="home-project" href={project.href}>
              <img src={project.image} width="480" height="480" alt="" loading="lazy" decoding="async" />
              <div class="home-project-caption">
                <div>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                </div>
                <ArrowUpRight size={24} aria-hidden="true" />
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-creative home-container" aria-labelledby="creative-heading">
      <div class="home-section-head"><h2 id="creative-heading">Media Studio &amp; Share</h2></div>
      <div class="home-creative-links">
        <a href="/media-studio"><img src="/media-studio/brand/studio-launch-thumb.webp" width="112" height="112" alt="" loading="lazy" /><div><h3>Media Studio</h3><p>Follow a still image through a masked edit, sound and motion. Open the tools to make your own.</p></div><ArrowUpRight size={21} aria-hidden="true" /></a>
        <a href="/share"><img src="/brand/campaign/composer-family-atlas.webp" width="112" height="112" alt="" loading="lazy" /><div><h3>App Composer Share</h3><p>Explore the project artwork. Open a piece to see its credit, download the original or sample its colours.</p></div><ArrowUpRight size={21} aria-hidden="true" /></a>
      </div>
    </section>

    <section class="home-workflow" id="make-something" aria-labelledby="start-heading">
      <div class="home-container">
        <div class="home-section-head">
          <div>
            <h2 id="start-heading">Build, ship, keep going.</h2>
            <p>App Composer is open source. The supported app and website path uses your agent, GitHub, Cloudflare and EmDash.</p>
          </div>
          <a class="home-text-link" href="/architecture#project-workspace">See how it fits together <ArrowUpRight size={17} aria-hidden="true" /></a>
        </div>
        <ol class="home-steps">
          {steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
              <a class="home-text-link" href={step.href}>{step.link} <ArrowRight size={17} aria-hidden="true" /></a>
            </li>
          ))}
        </ol>
        <div class="home-case" id="example">
          <div>
            <h3>See an app go from brief to live</h3>
            <p>Creator Hub shows how an agent connected two apps, released them to Cloudflare and changed the live site later.</p>
          </div>
          <a class="home-text-link" href="/creator-hub">Follow the Creator Hub build <ArrowUpRight size={17} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <nav class="home-resources home-container" aria-label="More places to explore">
      <a class="home-text-link" href="/demo">Try the sandbox <ArrowUpRight size={17} aria-hidden="true" /></a>
      <a class="home-text-link" href="/agent">Connect your agent <ArrowUpRight size={17} aria-hidden="true" /></a>
      <a class="home-text-link" href="/release">Release evidence <ArrowUpRight size={17} aria-hidden="true" /></a>
      <a class="home-text-link" href="/projects">Other projects <ArrowUpRight size={17} aria-hidden="true" /></a>
    </nav>
    {instance.enabled && (
      <div class="home-instance home-container">
        <p><strong>{instance.name}</strong> · {instance.description}</p>
        <a class="home-text-link" href={instance.profile}>
          Open {instance.owner}’s Linkarooie profile <ArrowUpRight size={17} aria-hidden="true" />
        </a>
      </div>
    )}
  </div>
</Base>
