---
import { readyTasks } from '../lib/ready-handoff';
import { Copy } from '@lucide/astro';
const { preferences=false }=Astro.props;
const selected=Astro.url.searchParams.get('task');
const taskId=selected&&Object.hasOwn(readyTasks,selected)?selected as keyof typeof readyTasks:'setup';
const initial=readyTasks[taskId];
---
<div data-ready-handoff data-use-setup-preferences={preferences ? "true" : undefined}>
 <label>What should the agent do?
  <select data-ready-task disabled>{Object.entries(readyTasks).map(([id,task])=><option value={id} selected={id===taskId}>{task.label}</option>)}</select>
 </label>
 <p data-ready-help class="small" role="status">{initial.help}</p>
 <button class="button" data-copy-ready disabled><Copy size={18} aria-hidden="true"/>Copy to Codex</button>
 <p data-ready-message role="status" aria-live="polite" class="message"></p>
 <details><summary>Read or copy the agent handoff</summary><pre data-ready-prompt tabindex="0">{initial.prompt}</pre></details>
 <noscript><p class="small">Open the handoff above, select its text and copy it into Codex. Without JavaScript, it contains the selected request.</p></noscript>
</div>
<script>
import {readyTasks} from '../lib/ready-handoff';
import {setupPreferenceHandoff,assistanceHandoff} from '../../lib/get-ready/preferences.mjs';
import {currentAssistance} from '../lib/assistance';
for(const container of document.querySelectorAll<HTMLElement>('[data-ready-handoff]')){
 const selector=container.querySelector<HTMLSelectElement>('[data-ready-task]')!;
 const button=container.querySelector<HTMLButtonElement>('[data-copy-ready]')!;
 const prompt=container.querySelector<HTMLElement>('[data-ready-prompt]')!;
 const message=container.querySelector<HTMLElement>('[data-ready-message]')!;
 const update=()=>{
  const task=readyTasks[selector.value as keyof typeof readyTasks]??readyTasks.setup;
  let text=task.prompt+assistanceHandoff(currentAssistance());button.disabled=false;
  if(container.dataset.useSetupPreferences){
   const form=document.querySelector<HTMLFormElement>('[data-setup-preferences]');
   try{if(form)text+=setupPreferenceHandoff({version:1,destination:(form.elements.namedItem('destination') as RadioNodeList).value,hostname:(form.elements.namedItem('setup-hostname') as HTMLInputElement).value});}
   catch(error){button.disabled=true;message.textContent=error instanceof Error?error.message:'Choose a supported address.';prompt.textContent='Complete your address choice before copying the setup request.';return;}
  }
  prompt.textContent=text;
  container.querySelector('[data-ready-help]')!.textContent=task.help;
  message.textContent='';
 };
 // Reconcile browser-restored form state before enabling copy.
 selector.disabled=false;update();
 selector.addEventListener('change',update);
 // Native form restoration may finish after the module first executes.
 window.addEventListener('pageshow',update);
 window.addEventListener('composer:setup-choice',update);
 window.addEventListener('composer:assistance-choice',update);
 button.addEventListener('click',async()=>{
  update();if(button.disabled)return;
  const task=selector.value;const text=prompt.textContent!;
  try{
   await navigator.clipboard.writeText(text);
   if(selector.value===task)message.textContent='Copied. Paste this into Codex in your chosen project.';
  }catch{
   if(selector.value===task){message.textContent='Clipboard access failed. Open the handoff below, select its text and copy it.';container.querySelector('details')!.open=true;}
  }
 });
}
</script>
