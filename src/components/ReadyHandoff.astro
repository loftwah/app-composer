---
import { browserCheckHref, handoffAgentFromParams, agentContextLine, handoffAgents, readyTasks, conceptInputLimit } from '../lib/ready-handoff';
import { Copy, Download } from '@lucide/astro';
const { preferences=false }=Astro.props;
const selected=Astro.url.searchParams.get('task');
const taskId=selected&&Object.hasOwn(readyTasks,selected)?selected as keyof typeof readyTasks:'setup';
const initial=readyTasks[taskId];
const browserTask=taskId==='browser';
const selectedAgent=preferences?handoffAgentFromParams(Astro.url.searchParams):'any';
const initialPrompt=taskId==='setup'&&selectedAgent!=='any'?agentContextLine(selectedAgent)+'\n\n'+initial.prompt:initial.prompt;
---
<div data-ready-handoff data-use-setup-preferences={preferences ? "true" : undefined}>
 <label>What should the agent do?
  <select data-ready-task disabled>{Object.entries(readyTasks).map(([id,task])=><option value={id} selected={id===taskId}>{task.label}</option>)}</select>
 </label>
 <p data-ready-help class="small" role="status">{initial.help}</p>
 <p class="small" data-browser-check-link hidden={!browserTask}><a href={browserCheckHref(selectedAgent)}>Open the practice page</a></p>
 {preferences && <label data-ready-agent-choice hidden>Which coding agent do you use?
  <select data-ready-agent>{Object.entries(handoffAgents).map(([id,agent])=><option value={id} selected={id===selectedAgent}>{agent.label}</option>)}</select>
 </label>}
 {preferences && <details data-ready-concept hidden>
  <summary>Use an idea I already have</summary>
  <label>Describe a first small feature
   <textarea data-ready-concept-input rows="4" maxlength={conceptInputLimit} wrap="soft" placeholder="Write an idea or paste a project brief."></textarea>
  </label>
  <label>Replace idea from a .txt or .md file
   <input data-ready-concept-file type="file" accept=".txt,.md,text/plain,text/markdown">
  </label>
  <p class="small">Files are read on this device. Copy or download the handoff to include the idea.</p>
  <p data-ready-concept-file-status class="small" role="status" aria-live="polite"></p>
 </details>}
 <div class="ready-actions">
  <button class="button" data-copy-ready disabled><Copy size={18} aria-hidden="true"/><span data-ready-copy-label>{browserTask ? 'Copy browser check' : 'Copy agent handoff'}</span></button>
  <button class="button secondary" data-download-ready disabled><Download size={18} aria-hidden="true"/><span>Download handoff (.md)</span></button>
 </div>
 <p data-ready-message role="status" aria-live="polite" class="message"></p>
 <details><summary>Read or copy the agent handoff</summary><pre data-ready-prompt tabindex="0">{initialPrompt}</pre></details>
 <noscript><p class="small">Open the handoff above, select its text and paste it into your coding agent. Without JavaScript, it contains the selected request.</p></noscript>
</div>
<style>
  .ready-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  pre[data-ready-prompt] {
    max-height: none;
    overflow: visible;
  }
  p[data-ready-message][data-state=manual] {
    color: var(--color-foreground);
    font-weight: 600;
  }
  details[data-ready-concept] {
    margin: 14px 0 4px;
  }
  details[data-ready-concept] summary {
    cursor: pointer;
    min-height: 44px;
    align-content: center;
    font-weight: 600;
  }
  details[data-ready-concept] label {
    display: grid;
    gap: 8px;
    margin-top: 6px;
    font-weight: 600;
  }
  details[data-ready-concept] textarea {
    inline-size: 100%;
    max-inline-size: 100%;
    min-block-size: 96px;
    padding: 10px 12px;
    font: inherit;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-foreground);
    background: var(--color-field);
    border: 1px solid var(--color-control-border);
    border-radius: 8px;
    resize: vertical;
  }
  details[data-ready-concept] input[type=file] {
    max-inline-size: 100%;
    font: inherit;
  }
  details[data-ready-concept] textarea:focus-visible,
  details[data-ready-concept] input[type=file]:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  details[data-ready-concept] [data-ready-concept-file-status]:empty {
    margin: 0;
  }
  details[data-ready-concept] p.small {
    margin: 8px 0 0;
    color: var(--color-muted);
    max-width: 70ch;
  }
</style>
<script>
import {readyTasks,handoffAgent,agentContextLine,conceptContextBlock,browserCheckHref,readyTaskHref,conceptInputLimit} from '../lib/ready-handoff';
import {setupPreferenceHandoff,assistanceHandoff} from '../../lib/get-ready/preferences.mjs';
import {currentAssistance} from '../lib/assistance';
for(const container of document.querySelectorAll<HTMLElement>('[data-ready-handoff]')){
 const selector=container.querySelector<HTMLSelectElement>('[data-ready-task]')!;
 const agentSelector=container.querySelector<HTMLSelectElement>('[data-ready-agent]');
 const agentChoice=container.querySelector<HTMLElement>('[data-ready-agent-choice]');
 const conceptDetail=container.querySelector<HTMLDetailsElement>('[data-ready-concept]');
 const conceptInput=container.querySelector<HTMLTextAreaElement>('[data-ready-concept-input]');
 const conceptFile=container.querySelector<HTMLInputElement>('[data-ready-concept-file]');
 const briefStatus=container.querySelector<HTMLElement>('[data-ready-concept-file-status]');
 const button=container.querySelector<HTMLButtonElement>('[data-copy-ready]')!;
 const downloadButton=container.querySelector<HTMLButtonElement>('[data-download-ready]')!;
 const prompt=container.querySelector<HTMLElement>('[data-ready-prompt]')!;
 const message=container.querySelector<HTMLElement>('[data-ready-message]')!;
 const help=container.querySelector<HTMLElement>('[data-ready-help]')!;
 const copyLabel=container.querySelector<HTMLElement>('[data-ready-copy-label]')!;
 const browserCheckLink=container.querySelector<HTMLElement>('[data-browser-check-link]')!;
 const browserCheckAnchor=browserCheckLink.querySelector<HTMLAnchorElement>('a')!;
 const browserTaskAnchor=container.closest('#agent-start')?.querySelector<HTMLAnchorElement>('[data-ready-browser-task-link]');
 // A clipboard result only describes the request it started from. revision moves
 // whenever the generated text changes and attempt names the latest copy action,
 // so an older settlement cannot speak for a different or newer request.
 let revision=0,attempt=0,importRevision=0,renderedText='',renderedTask='';
 const briefImportByteLimit=conceptInputLimit * 4;
 const started=(attemptId:number,startedAt:number,task:string,text:string)=>attemptId===attempt&&startedAt===revision&&selector.value===task&&prompt.textContent===text;
 // Copy and download share the same validity gate, including an invalid setup address.
 const setDisabled=(value:boolean)=>{button.disabled=value;downloadButton.disabled=value;};
 const revealHandoff=()=>{
  prompt.closest('details')!.open=true;
  prompt.focus();
  const range=document.createRange();
  range.selectNodeContents(prompt);
  const selection=window.getSelection();
  selection?.removeAllRanges();
  selection?.addRange(range);
 };
 const update=()=>{
  const task=readyTasks[selector.value as keyof typeof readyTasks]??readyTasks.setup;
  const browserTask=task===readyTasks.browser;
  const agentId=handoffAgent(agentSelector?.value);
  let text=task.prompt,failure='';
  setDisabled(false);
  help.textContent=task.help;
  copyLabel.textContent=browserTask?'Copy browser check':'Copy agent handoff';
  browserCheckLink.hidden=!browserTask;
  browserCheckAnchor.href=browserCheckHref(agentId);
  if(browserTaskAnchor)browserTaskAnchor.href=readyTaskHref('browser',agentId);
  if(agentChoice)agentChoice.hidden=task!==readyTasks.setup;
  if(conceptDetail)conceptDetail.hidden=task!==readyTasks.setup;
  if(task===readyTasks.setup){
   const hostContext=agentContextLine(agentId);
   if(hostContext)text=hostContext+'\n\n'+text;
  }
  if(!browserTask)text+=assistanceHandoff(currentAssistance());
  if(!browserTask&&container.dataset.useSetupPreferences){
   const form=document.querySelector<HTMLFormElement>('[data-setup-preferences]');
   try{if(form)text+=setupPreferenceHandoff({version:1,destination:(form.elements.namedItem('destination') as RadioNodeList).value,hostname:(form.elements.namedItem('setup-hostname') as HTMLInputElement).value});}
   catch(error){setDisabled(true);failure=error instanceof Error?error.message:'Choose a supported address.';text='Complete your address choice to use the setup request.';}
  }
  if(task===readyTasks.setup&&!failure)text+=conceptContextBlock(conceptInput?.value??'');
  // Restored form state, help-level and pageshow events rerun this often. Only a
  // real change to the request retires the status that belongs to the old one.
  if(text!==renderedText||selector.value!==renderedTask){
   renderedText=text;renderedTask=selector.value;revision++;
   prompt.textContent=text;
   message.textContent='';delete message.dataset.state;
  }
  if(failure){message.textContent=failure;delete message.dataset.state;}
 };
 // Reconcile browser-restored form state before enabling copy.
 selector.disabled=false;update();
 conceptFile?.addEventListener('change',async()=>{
  const importId=++importRevision;
  const file=conceptFile.files?.[0];
  // Let the native picker select the same file again after success or failure.
  conceptFile.value='';
  if(!file || !conceptInput || !briefStatus || selector.value!=='setup') return;
  const draft=conceptInput.value;
  const current=()=>importId===importRevision && selector.value==='setup' && conceptInput.value===draft;
  const fail=(text:string)=>{if(current()) briefStatus.textContent=text;};
  briefStatus.textContent='';
  if(!/\.(txt|md)$/i.test(file.name)){
   fail('Choose a UTF-8 .txt or .md file.');
   return;
  }
  if(file.size>briefImportByteLimit){
   fail('The file exceeds 16,000 bytes.');
   return;
  }
  let text:string;
  try{
   const buffer=await file.arrayBuffer();
   if(!current())return;
   if(buffer.byteLength>briefImportByteLimit){
    fail('The file exceeds 16,000 bytes.');
    return;
   }
   text=new TextDecoder('utf-8',{fatal:true}).decode(buffer).replace(/\r\n?/g,'\n');
  }catch{
   fail('Choose a file saved as UTF-8 text.');
   return;
  }
  if(!current())return;
  if(!text.trim() || text.includes('\0')){
   fail('Choose a text file with an idea in it.');
   return;
  }
  if(text.length>conceptInputLimit){
   fail('The text exceeds 4,000 characters.');
   return;
  }
  conceptInput.value=text;
  update();
  briefStatus.textContent='Brief imported into your idea.';
 });
 const updateAfterIdeaChange=()=>{
  importRevision++;
  if(briefStatus) briefStatus.textContent='';
  update();
 };
 selector.addEventListener('change',updateAfterIdeaChange);
 agentSelector?.addEventListener('change',update);
 conceptInput?.addEventListener('input',updateAfterIdeaChange);
 // Native form restoration may finish after the module first executes.
 window.addEventListener('pageshow',update);
 window.addEventListener('composer:setup-choice',update);
 window.addEventListener('composer:assistance-choice',update);
 button.addEventListener('click',async()=>{
  update();if(button.disabled)return;
  // Snapshot the exact request this write is for, plus the attempt that owns it.
  const attemptId=++attempt,startedAt=revision,task=selector.value,text=prompt.textContent??'';
  try{
   await navigator.clipboard.writeText(text);
   if(!started(attemptId,startedAt,task,text))return;
   message.dataset.state='copied';
   message.textContent=task==='browser'?'Copied. Paste this into the agent you want to check.':'Copied. Paste this into your coding agent in your chosen project.';
  }catch{
   if(!started(attemptId,startedAt,task,text))return;
   message.dataset.state='manual';
   message.textContent='Clipboard access failed. The handoff below is selected; use your keyboard shortcut or device copy menu.';
   revealHandoff();
  }
 });
 downloadButton.addEventListener('click',()=>{
  update();if(downloadButton.disabled)return;
  // A write still in flight belongs to an older request. Retire it so its
  // settlement cannot replace this download's feedback; the rendered text
  // and its revision are left alone.
  attempt++;
  const text=prompt.textContent??'';
  let url='';
  const anchor=document.createElement('a');
  try{
   url=URL.createObjectURL(new Blob([text],{type:'text/markdown;charset=utf-8'}));
   anchor.href=url;
   // Fixed generic name: no idea, address or other private input in the filename.
   anchor.download='ready-handoff.md';
   document.body.appendChild(anchor);
   anchor.click();
   message.dataset.state='downloaded';
   message.textContent='Markdown download started.';
  }catch{
   message.dataset.state='manual';
   message.textContent='Download failed. The handoff below is selected for copying.';
   revealHandoff();
  }finally{
   anchor.remove();
   if(url)window.setTimeout(()=>URL.revokeObjectURL(url),1000);
  }
 });
}
</script>
