---
import "../../styles/share-experiences.css";
import {
  developerBingo, doorChoices, doorRooms, exhibitionPrompts,
  experiencePath, experiences, thisOrThatQuestions, twentyOneQuestions,
  twentyOneResultTitle, type ExperienceId,
} from "../../lib/share-experiences.ts";
import {
  customThisOrThatAltLimit, customThisOrThatOptionLimit, customThisOrThatPromptLimit,
} from "../../lib/this-or-that.ts";
import {
  personaFor,
} from "../../lib/persona-packs.ts";
import {
  personaDraftOptionLimit, personaDraftOutcomeLimit, personaDraftPromptLimit, personaDraftTitleLimit,
} from "../../lib/persona-quiz.ts";
import { twentyOneAnswerLimit, twentyOnePromptLimit } from "../../lib/twenty-one-questions.ts";
import { nineItemLimit, nineSubtitleLimit } from "../../lib/share-experience-draft.ts";
import { nineListLimit } from "../../lib/top-nine-list.ts";
import { profileUrlLimit } from "../../lib/top-nine-profile.ts";
import { pageUrlLimit } from "../../lib/top-nine-pages.ts";
import {
  tierListDefaultTitle, tierListEntryLimit, tierListEntryTotal,
  tierListRowEntryLimit, tierListTiers, tierListTitleLimit,
} from "../../lib/tier-list.ts";
import {
  oneMustGoChoiceCount, oneMustGoChoiceLimit, oneMustGoStarterChoices,
} from "../../lib/one-must-go.ts";
import {
  wrongAnswerCount, wrongAnswerLimit, wrongAnswerPrompts,
} from "../../lib/wrong-answers.ts";
import {
  redFlagCourtCases, redFlagCourtCount, redFlagCourtSubtitle,
} from "../../lib/red-flag-court.ts";
import {
  techTournamentEntries, techTournamentMatchLabel, techTournamentMatches,
  techTournamentPickCount, techTournamentPlaceholder,
} from "../../lib/tech-tournament.ts";
import {
  cursedChoices, cursedChoicesSubtitle, cursedChoiceCount,
} from "../../lib/cursed-choices.ts";

interface Props {
  game: ExperienceId;
  experience: (typeof experiences)[ExperienceId];
  art: string;
}
const { game, experience, art } = Astro.props;
const isDoor = game === "pick-a-door";
const isNine = game === "top-nine";
const isBingo = game === "tech-bingo";
const isThis = game === "this-or-that";
const isTwentyOne = game === "twenty-one-questions";
const isCloudflare = game === "developer-type";
const isLanguage = game === "language-type";
const isTier = game === "tier-list";
const isMustGo = game === "one-must-go";
const isWrong = game === "wrong-answers";
const isCourt = game === "red-flag-court";
const isTournament = game === "tech-tournament";
const isCurse = game === "cursed-choices";
const persona = personaFor(game);
const cells = [...developerBingo.slice(0, 12), "Free space", ...developerBingo.slice(12)];
// A text-only, unranked example board built from the current Top Nine result
// fragment contract, so it restores through the same path as a shared result.
const exampleBoard = {
  game: "top-nine",
  byline: "",
  skin: 0,
  title: "Example: Nine programming languages",
  items: ["Python", "JavaScript", "TypeScript", "Rust", "Go", "Java", "C++", "Ruby", "Swift"],
};
const exampleBoardHref = `${experiencePath("top-nine")}#${new URLSearchParams({ result: JSON.stringify(exampleBoard) }).toString()}`;
---

<article class:list={["share-experience", `experience-${experience.theme}`]} data-experience={game}
  data-background={art} data-skin="0">
  <nav class="experience-crumb" aria-label="Internet Workshop">
    <a href="/share?tag=internet-workshop">← App Composer Share</a>
  </nav>
  <header class="experience-heading">
    <div>
      <h1>{isCloudflare ? "Which Cloudflare® service are you?" : isLanguage ? "Which programming language are you?" : experience.title}</h1>
      <p data-tot-description>{experience.description}</p>
    </div>
    <picture>
      <img src={art.replace(".jpg", "-480.webp")} width="480" height="480" alt={experience.imageDescription} fetchpriority="high" />
    </picture>
  </header>

  <noscript><p>Enable JavaScript to play, customise and download your result.</p></noscript>

  {isDoor && <section data-play-panel class="door-stage" aria-label="Choose a door">
    <div class="door-run" data-root-view>
      {doorRooms.map(([title], index) => <button type="button" class="door" data-door={index} aria-label={`Open door ${index + 1}`} disabled>
        <span class="door-number">{index + 1}</span><span class="door-handle" aria-hidden="true"></span>
        <span class="door-label" aria-hidden="true">{title.split(" ").slice(-1)[0]}</span>
      </button>)}
    </div>
    {doorRooms.map(([title, text], index) => <section hidden class="door-room" data-room={index}>
      <h2 tabindex="-1">{title}</h2>
      <p>{text}</p>
      <div class="room-options">{doorChoices[index].map((choice, number) =>
        <button type="button" data-ending={number + (index === 0 ? 0 : index === 1 ? 3 : 7)} disabled>{choice}</button>
      )}</div>
    </section>)}
    <section hidden class="door-result" data-result>
      <h2 tabindex="-1" data-reveal-title></h2>
      <p data-reveal-copy></p>
    </section>
    <button hidden type="button" class="secondary experience-reset" data-restart>Back to the doors</button>
  </section>}

  {isNine && <section data-play-panel class="exhibition" aria-label="Edit your exhibition">
    <div class="exhibition-heading">
      <div>
        <label for="exhibition-title">Exhibition title</label>
        <input id="exhibition-title" type="text" maxlength="72" value={exhibitionPrompts[0]} data-exhibition-title />
      </div>
      <div>
        <label for="exhibition-subtitle">Optional subtitle</label>
        <input id="exhibition-subtitle" type="text" maxlength={nineSubtitleLimit} placeholder="A short line under the title" data-exhibition-subtitle />
      </div>
    </div>
    <details class="exhibit-list" data-list-panel>
      <summary>Paste a list</summary>
      <p class="experience-note" id="exhibit-list-help">Enter one title per line. From a spreadsheet, add a tab and a public HTTPS page to link that title. Only empty slots without attachments are filled.</p>
      <form data-list-form>
        <label for="exhibit-list">Exhibit titles and optional pages</label>
        <textarea id="exhibit-list" rows="4" maxlength={nineListLimit} autocomplete="off"
          aria-describedby="exhibit-list-help exhibit-list-status" data-list-text></textarea>
        <div class="exhibit-list-actions">
          <button type="submit" data-list-fill disabled>Fill empty exhibits</button>
          <button type="button" class="secondary" data-list-undo disabled>Undo fill</button>
        </div>
      </form>
      <p class="experience-note" role="status" aria-live="polite" id="exhibit-list-status" data-list-status></p>
    </details>
    <label class="exhibition-ranked">
      <input type="checkbox" data-nine-ranked />
      Rank exhibits #1 to #9
    </label>
    <details class="exhibit-music" data-music-panel>
      <summary>Find albums, songs, books, apps, games, films and TV series</summary>
      <form class="music-search" data-music-form>
        <label for="music-target">Fill exhibit
          <select id="music-target" data-music-target-choice>
            {Array.from({length: 9}, (_, index) => <option value={index}>{index + 1}</option>)}
          </select>
        </label>
        <div class="music-kind" role="group" aria-label="Search for">
          <button type="button" data-music-kind="album" aria-pressed="true">Albums</button>
          <button type="button" data-music-kind="song" aria-pressed="false">Songs</button>
          <button type="button" data-music-kind="book" aria-pressed="false">Books</button>
          <button type="button" data-music-kind="app" aria-pressed="false">Apps</button>
          <button type="button" data-music-kind="film" aria-pressed="false">Films</button>
          <button type="button" data-music-kind="series" aria-pressed="false">TV series</button>
          <button type="button" data-music-kind="game" aria-pressed="false">Games</button>
        </div>
        <label for="music-game-platform" data-music-platform hidden>Game platform
          <select id="music-game-platform" data-music-game-platform>
            <option value="all">All games</option>
            <option value="pc">PC</option>
            <option value="console">Console</option>
          </select>
        </label>
        <label for="music-country" data-music-storefront>Storefront
          <select id="music-country" data-music-country>
            <option value="AU">Australia (AU)</option>
            <option value="NZ">New Zealand (NZ)</option>
            <option value="US">United States (US)</option>
            <option value="GB">United Kingdom (GB)</option>
            <option value="CA">Canada (CA)</option>
            <option value="IE">Ireland (IE)</option>
            <option value="DE">Germany (DE)</option>
            <option value="FR">France (FR)</option>
            <option value="SE">Sweden (SE)</option>
            <option value="JP">Japan (JP)</option>
            <option value="BR">Brazil (BR)</option>
            <option value="MX">Mexico (MX)</option>
            <option value="IN">India (IN)</option>
            <option value="ZA">South Africa (ZA)</option>
            <option value="TW">Taiwan (TW)</option>
            <option value="HK">Hong Kong (HK)</option>
            <option value="ES">Spain (ES)</option>
            <option value="IT">Italy (IT)</option>
            <option value="NL">Netherlands (NL)</option>
          </select>
        </label>
        <label for="music-query" class="music-query">Album, song, book, app, game, film or TV series
          <input id="music-query" type="search" maxlength="80" autocomplete="off" enterkeyhint="search" data-music-query />
        </label>
        <button type="submit" data-music-submit>Search</button>
      </form>
      <p class="experience-note" data-music-game-coverage hidden>PC and Console use platforms recorded on Wikidata. Games with no recorded platform, or only other platforms, stay under All games.</p>
      <p class="experience-note" role="status" data-music-status></p>
      <ul class="music-results" aria-label="Search results" hidden data-music-results></ul>
      <div class="music-replace" role="group" aria-label="Replace an exhibit" data-music-replace hidden>
        <p class="experience-note" id="music-replace-note" data-music-replace-note></p>
        <div class="music-replace-actions">
          <button type="button" class="secondary" data-music-replace-keep aria-describedby="music-replace-note">Keep current exhibit</button>
          <button type="button" data-music-replace-confirm aria-describedby="music-replace-note">Replace exhibit</button>
        </div>
      </div>
      <button type="button" class="secondary" hidden data-music-more>Show more results</button>
      <div class="music-recovery" data-music-recovery hidden>
        <p class="experience-note" data-music-recovery-note>Wrong match? Search Apple Music or Spotify, select the exact album or song, copy its link and paste it below.</p>
        <div class="music-recovery-links">
          <a data-music-recovery-apple target="_blank" rel="noopener noreferrer nofollow">Search this on Apple Music</a>
          <a data-music-recovery-spotify target="_blank" rel="noopener noreferrer nofollow">Search this on Spotify</a>
          <a data-music-recovery-wikidata target="_blank" rel="noopener noreferrer nofollow" hidden>Search this on Wikidata</a>
          <button type="button" class="secondary" data-music-recovery-wikidata-albums hidden>Search Wikidata albums</button>
        </div>
      </div>
      <form class="music-paste" data-music-paste-form>
        <label for="music-paste">Or paste an Apple Music, Spotify, Apple Books, App Store or Wikidata link</label>
        <div class="music-paste-row">
          <input id="music-paste" type="url" inputmode="url" autocomplete="off" placeholder="https://music.apple.com/…" data-music-paste />
          <button type="submit" class="secondary">Use link</button>
        </div>
      </form>
      <ul class="music-linked" aria-label="Exhibits with source links" hidden data-music-linked></ul>
      <section class="music-preview" aria-label="Music preview" hidden data-music-preview>
        <div class="music-preview-head">
          <h3 tabindex="-1" data-music-preview-title></h3>
          <button type="button" class="secondary" data-music-preview-close>Close preview</button>
        </div>
        <div class="music-preview-frame" data-music-preview-frame></div>
        <p class="experience-note"><a data-music-preview-source target="_blank" rel="noopener noreferrer nofollow">Open in the music app</a></p>
      </section>
      <p class="experience-note" data-music-coverage hidden>Films, TV series and games come from Wikidata (CC0 data). Coverage is partial, and each result links to its item page.</p>
    </details>
    <details class="exhibit-covers" data-cover-panel>
      <summary>Hang your own cover art</summary>
      <div class="cover-pick">
        <label for="cover-target">Cover exhibit
          <select id="cover-target" data-cover-target-choice>
            {Array.from({length: 9}, (_, index) => <option value={index}>{index + 1}</option>)}
          </select>
        </label>
        <label for="cover-file" class="cover-file">Image from this device
          <input id="cover-file" type="file" accept="image/png,image/jpeg,image/webp" data-cover-file />
        </label>
      </div>
      <p class="experience-note" role="status" data-cover-status></p>
      <ul class="cover-linked" aria-label="Exhibits with covers" hidden data-cover-linked></ul>
      <p class="experience-note">PNG, JPEG or WebP up to 20 MB. Covers stay in this browser — they go into your downloaded image, not into result links or drafts. Each cover fills its cell; Fit beside it shows the whole artwork instead, letterboxed on the cell’s colour.</p>
    </details>
    <div class="exhibition-objects" data-exhibition-objects>
      {Array.from({length: 9}, (_, index) => <label>
        <span class="exhibit-heading" draggable="true" data-drag-slot={index} title="Drag onto another slot to swap exhibits">
          <span class="exhibit-grip" aria-hidden="true"></span><span><em class="exhibit-rank" id={`exhibit-rank-${index}`} data-exhibit-rank={index} hidden>#{index + 1}</em> Exhibit {index + 1} <em class="exhibit-filling" data-exhibit-filling={index} aria-hidden="true" hidden>· filling</em></span>
        </span>
        <input type="text" maxlength={nineItemLimit} data-object={index} aria-label={`Exhibit ${index + 1}`} />
        <span class="exhibit-link-state" data-music-slot-state={index} hidden></span>
        <span class="exhibit-page-state" data-page-slot-state={index} hidden></span>
        <span class="exhibit-cover-state" data-cover-slot-state={index} hidden></span>
      </label>)}
    </div>
    <details class="exhibit-pages" data-page-panel>
      <summary>Link a public web page to an exhibit</summary>
      <form class="music-paste" data-page-form>
        <label for="page-target">Page exhibit
          <select id="page-target" data-page-target-choice>
            {Array.from({length: 9}, (_, index) => <option value={index}>{index + 1}</option>)}
          </select>
        </label>
        <label for="page-url">Exact public HTTPS page</label>
        <div class="music-paste-row">
          <input id="page-url" type="url" inputmode="url" maxlength={pageUrlLimit} autocomplete="off"
            placeholder="https://example.com/thing" data-page-url />
          <button type="submit" class="secondary">Attach page</button>
        </div>
      </form>
      <p class="experience-note" role="status" data-page-status></p>
      <ul class="music-linked" aria-label="Exhibits with web pages" hidden data-page-linked></ul>
      <p class="experience-note">For a title you type yourself. The exact public page opens in a new tab from the board and stays out of the PNG, its image description and every provider search.</p>
    </details>
    <div class="exhibition-order">
      <label for="exhibit-order">Move exhibit</label>
      <select id="exhibit-order" data-order-index>{Array.from({length: 9}, (_, index) =>
        <option value={index}>{index + 1}</option>
      )}</select>
      <button class="secondary" type="button" data-move="-1">Move earlier</button>
      <button class="secondary" type="button" data-move="1">Move later</button>
      <label for="exhibit-swap-target">Swap selected exhibit with slot</label>
      <select id="exhibit-swap-target" data-swap-target>{Array.from({length: 9}, (_, index) =>
        <option value={index}>{index + 1}</option>
      )}</select>
      <button class="secondary" type="button" data-swap-slots disabled>Swap slots</button>
      <button class="secondary" type="button" data-undo-move disabled>Undo last move</button>
    </div>
    <p class="experience-note">Drag an exhibit heading onto another slot to swap them. Move and Swap controls remain available for keyboard and touch.</p>
    <label for="exhibition-theme">Try a title</label>
    <select id="exhibition-theme" data-nine-preset>
      <option value="">Choose a prompt</option>
      {exhibitionPrompts.map((label) => <option>{label}</option>)}
    </select>
    <p class="experience-note"><a href={exampleBoardHref} target="_blank" rel="noopener noreferrer">Open an example board</a></p>
    <div class="experience-actions exhibition-draft">
      <button type="button" data-draft-save>Save draft</button>
      <button type="button" class="secondary" data-draft-open hidden>Open saved draft</button>
      <button type="button" class="secondary" data-draft-clear>Clear saved draft</button>
      <button type="button" class="secondary" data-draft-file-save disabled>Download draft file</button>
      <label class="exhibition-file-open">Open draft file
        <input type="file" accept="application/json,.json" data-draft-file disabled
          aria-describedby="nine-draft-file-note" />
      </label>
    </div>
    <p class="experience-note">Drafts keep your title, subtitle, exhibits, source links, profile link and ranked setting in this browser. Cover images aren’t saved — download your result image to keep them.</p>
    <p class="experience-note" role="status" data-draft-status></p>
    <p class="experience-note" id="nine-draft-file-note">A draft file is private JSON with board text, links and settings. Open it to replace the current board. Download a PNG to keep the cover images.</p>
    <p class="experience-note" role="status" data-draft-file-status></p>
  </section>}

  {isBingo && <section class="bingo-stage" data-play-panel aria-label="Bingo board">
    <div class="bingo-packs">
      <label for="bingo-pack">Play a pack</label>
      <select id="bingo-pack" data-bingo-pack>
        <option value="dev">Developer</option>
        <option value="agents">Agent chaos</option>
        <option value="internet">Old internet</option>
      </select>
      <button type="button" class="secondary" data-clear>Clear marks</button>
    </div>
    <p class="bingo-score" role="status" data-score>0 lines</p>
    <div class="bingo-grid" role="group" aria-describedby="bingo-hint" data-bingo-grid>
      {cells.map((value, index) => <button type="button" aria-pressed={index === 12 ? "true" : "false"}
        disabled={index === 12} data-tile={index}>{value}</button>)}
    </div>
    <p class="experience-note" id="bingo-hint">Arrow keys move between squares. Enter or Space marks the square.</p>
  </section>}

  {isTier && <section data-play-panel class="tier-stage" aria-label="Build your tier list">
    <div class="tier-tools">
      <label class="tier-title">List title
        <input id="tier-title" type="text" maxlength={tierListTitleLimit} value={tierListDefaultTitle} data-tier-title disabled />
      </label>
      <button type="button" class="secondary" data-tier-starter disabled>Try an example list</button>
    </div>
    <p class="experience-note tier-local-note" id="tier-local-note">Your board stays in this tab. Download a PNG to keep a copy.</p>
    <form class="tier-add" data-tier-add autocomplete="off">
      <label>New entry
        <input type="text" maxlength={tierListEntryLimit} placeholder="A book, tool, habit…" aria-describedby="tier-local-note" data-tier-add-text disabled />
      </label>
      <label>Row
        <select data-tier-add-row disabled>
          {tierListTiers.map((tier, row) => <option value={row}>{tier.label}</option>)}
        </select>
      </label>
      <button type="submit" disabled>Add entry</button>
    </form>
    <p class="experience-note" data-tier-status role="status" aria-live="polite"></p>
    <div class="tier-rows">
      {tierListTiers.map((tier, row) => <section class="tier-row" aria-labelledby={`tier-row-${row}`}>
        <div class="tier-row-head">
          <h2 id={`tier-row-${row}`}>{tier.label}</h2>
          <span data-tier-count={row}>0 of {tierListRowEntryLimit}</span>
        </div>
        <p class="tier-empty" data-tier-empty={row}>No entries yet.</p>
        <ol class="tier-entries" data-tier-list={row} aria-labelledby={`tier-row-${row}`} hidden></ol>
      </section>)}
    </div>
    <p class="experience-note">Up to {tierListEntryTotal} entries, {tierListRowEntryLimit} in a row. Use the row menu beside an entry to move it.</p>
  </section>}

  {isMustGo && <section data-play-panel class="omg-stage" aria-label="One must go">
    <div class="omg-head">
      <h2 id="omg-prompt">Which one would you drop?</h2>
      <p class="omg-round-note" data-omg-round-note>Poster round</p>
    </div>
    <div class="omg-choices" role="group" aria-labelledby="omg-prompt">
      {oneMustGoStarterChoices.map((choice, index) => <button type="button" class="omg-choice" data-omg-choice={index} disabled>
        <span class="omg-choice-label" data-omg-choice-label>{choice}</span>
        <span class="omg-choice-state" data-omg-choice-state hidden>Gone</span>
      </button>)}
    </div>
    <p class="experience-note" role="status" aria-live="polite" data-omg-status></p>
    <section hidden class="omg-result" data-omg-result aria-label="Your elimination">
      <h3 tabindex="-1" data-omg-result-title></h3>
      <p data-omg-result-copy></p>
      <ul class="omg-survivors" aria-label="Still on the stage" data-omg-survivors></ul>
      <div class="tot-controls">
        <button type="button" data-omg-again disabled>Choose again</button>
      </div>
    </section>
    <details class="omg-custom">
      <summary>Write your own round</summary>
      <p class="experience-note" id="omg-custom-help">Enter four choices of your own. Your round stays in this tab.</p>
      <form data-omg-form autocomplete="off" aria-describedby="omg-custom-help">
        {Array.from({ length: oneMustGoChoiceCount }, (_, index) => <label>Choice {index + 1}
          <input type="text" maxlength={oneMustGoChoiceLimit} data-omg-input disabled />
        </label>)}
        <button type="submit" disabled>Play my round</button>
        <p class="experience-note" role="status" data-omg-form-status></p>
      </form>
      <div class="tot-controls">
        <button type="button" class="secondary" data-omg-starter disabled hidden>Back to the poster round</button>
      </div>
    </details>
  </section>}

  {isWrong && <section data-play-panel class="wa-stage" aria-label="Write a wrong answer">
    <div class="wa-index" role="group" aria-label="Choose a question">
      {wrongAnswerPrompts.map((prompt, index) => <button type="button" class="wa-index-tab" data-wa-prompt={index}
        aria-label={`Question ${index + 1}: ${prompt.question}`} aria-controls="wa-question"
        aria-pressed={index === 0 ? "true" : "false"} disabled>
        <span class="wa-index-name">{prompt.tab}</span>
      </button>)}
    </div>
    <div class="wa-sheet">
      <p class="wa-folio" data-wa-folio>Question 1 of {wrongAnswerCount}</p>
      <h2 id="wa-question" class="wa-question" tabindex="-1" data-wa-question>{wrongAnswerPrompts[0].question}</h2>
      <label class="wa-answer-label" for="wa-answer">Your wrong answer</label>
      <textarea id="wa-answer" rows="3" maxlength={wrongAnswerLimit} autocomplete="off" spellcheck="true"
        enterkeyhint="next" aria-describedby="wa-local wa-count" data-wa-answer disabled></textarea>
      <div class="wa-meta">
        <p class="wa-local" id="wa-local">Your drafts stay in this tab. Download a PNG to keep your answer.</p>
        <p class="wa-count" id="wa-count" data-wa-count>0 / {wrongAnswerLimit}</p>
      </div>
      <div class="wa-controls">
        <button type="button" class="secondary" data-wa-back disabled>Previous question</button>
        <button type="button" data-wa-next disabled>Next question</button>
        <button type="button" class="secondary" data-wa-clear disabled>Clear this answer</button>
      </div>
    </div>
    <p class="experience-note wa-status" role="status" aria-live="polite" data-wa-status></p>
  </section>}

  {isCourt && <section data-play-panel class="rfc-stage" aria-label="Red Flag Court docket">
    <div class="rfc-masthead">
      <p class="rfc-kicker">{redFlagCourtSubtitle} · Internet Workshop</p>
      <p class="rfc-folio" data-rfc-folio>Case 01 of {redFlagCourtCount} · 0 called</p>
    </div>
    <div class="rfc-index" role="group" aria-label="Choose a case">
      {redFlagCourtCases.map((entry, index) => <button type="button" data-rfc-case={index}
        aria-label={`Case ${index + 1}: ${entry.tab}`} aria-pressed={index === 0 ? "true" : "false"}
        aria-controls="rfc-case" disabled>
