          : isCloudflare ? ["Midnight etching", "Aged amber", "Night archive"]
          : isLanguage ? ["Canyon dawn", "Warm paper", "Night archive"]
          : isTier ? ["Wine press", "Marble and cobalt", "Cobalt night"]
          : isMustGo ? ["Noir orange", "Stamp orange", "Paper and ink"]
          : isWrong ? ["Saffron page", "Faded copy", "Night school"]
          : isCourt ? ["Court paper", "Late edition", "Newsprint"]
          : isTournament ? ["Fanzine orange", "Newsprint", "Floodlight"]
          : isCurse ? ["Game show gold", "Library green", "Modem magenta"]
          : ["Gig flyer", "Bingo hall", "Photocopy"]).map((label, index) =>
            <option value={index}>{label}</option>
          )}
      </select></label>
      {isCourt || isTournament || isCurse ? <label>Format<select data-format>
        <option value="portrait">Portrait · 1080 × 1350</option>
        <option value="wide">Landscape · 1200 × 630</option>
      </select></label> : (isTwentyOne || isCloudflare || isLanguage) ? <label>Format<select data-format>
        <option value="portrait">Portrait · 1080 × 1350 (4:5)</option>
        <option value="story">Story · 1080 × 1920 (9:16)</option>
        <option value="square">Square · 1080 × 1080 (1:1)</option>
      </select></label> : <label>Format<select data-format>
        <option value="portrait">Portrait · 1080 × 1350</option>
        <option value="story">Story · 1080 × 1920</option>
        <option value="square">Square · 1080 × 1080</option>
        <option value="wide">Landscape · 1200 × 630</option>
      </select></label>}
    </div>
    {isNine && <p class="experience-note" id="nine-profile-note">A full HTTPS profile link appears beside your preview and travels only in your result link and saved draft — never in the image or its description.</p>}
    {isNine && <p class="experience-note" role="status" data-profile-status></p>}
    {persona && <div class="persona-avatar" data-persona-avatar>
      <input hidden type="file" accept="image/png,image/jpeg,image/webp" data-persona-avatar-file
        aria-label="Optional photo for your result card" aria-describedby="persona-avatar-note" />
      <button type="button" class="secondary" data-persona-avatar-pick>Add a photo</button>
      <img hidden class="persona-avatar-preview" alt="" data-persona-avatar-preview />
      <button type="button" class="secondary" data-persona-avatar-remove hidden>Remove photo</button>
      <p class="experience-note" id="persona-avatar-note">Optional: a small round photo of you in the corner of your card. It stays in this tab and only appears in the card you save — never in a link, caption, description, draft or result.</p>
      <p class="experience-note" role="status" data-persona-avatar-status></p>
    </div>}
    <div class="experience-actions">
      <button type="button" data-download disabled={isDoor || isNine || isThis || isTwentyOne || isCloudflare || isLanguage || isTier || isMustGo || isWrong || isCourt || isTournament || isCurse}>
        {isCloudflare ? "Prepare card" : isLanguage ? "Prepare card" : isTwentyOne ? "Prepare cards" : isCourt ? "Download verdict card" : isTournament ? "Download winner card" : isCurse ? "Download curse card" : "Download result"}
      </button>
      {(isNine || isThis) && <button type="button" class="secondary" data-copy-png disabled>Copy PNG</button>}
      {(isNine || isThis || isTier || isMustGo || isWrong || isCourt || isTournament || isCurse) && <button type="button" class="secondary" data-copy-alt disabled aria-describedby={isNine ? "nine-alt-note" : isThis ? "tot-alt-note" : "local-alt-note"}>Copy image description</button>}
      <button type="button" class="secondary" data-copy hidden={isTwentyOne || isCloudflare || isLanguage || isTier || isMustGo || isWrong || isCourt || isTournament || isCurse} disabled={isDoor || isNine || isThis || isTwentyOne || isCloudflare || isLanguage || isTier || isMustGo || isWrong || isCourt || isTournament || isCurse}>Copy result link</button>
      <button type="button" class="secondary" data-share hidden disabled={isDoor || isNine || isThis || isTwentyOne || isCloudflare || isLanguage || isTier || isMustGo || isWrong || isCourt || isTournament}>Share result</button>
    </div>
    {isNine && <div class="persona-caption" data-nine-caption>
      <button type="button" class="secondary" data-nine-caption-copy disabled aria-describedby="nine-caption-note">Copy caption</button>
      <textarea hidden readonly rows="4" aria-label="Top Nine caption text" data-nine-caption-manual></textarea>
      <p class="experience-note" id="nine-caption-note">Copies your title, optional subtitle and byline with a link to make their own.</p>
      <p class="experience-note" role="status" data-nine-caption-status></p>
    </div>}
    {isTwentyOne && <div class="experience-actions" data-tq-downloads hidden></div>}
    {persona && <div class="experience-actions" data-persona-preview hidden></div>}
    {isNine && <p class="experience-note" id="nine-alt-note">A plain-text image description made from your title, optional subtitle and byline, and your nine exhibit titles in top, middle and bottom rows. A ranked board announces each exhibit with its #1 to #9 position.</p>}
    {isThis && <p class="experience-note" id="tot-alt-note">A plain-text image description made from your title, optional byline and your chosen options, in question order.</p>}
    {(isTier || isMustGo || isWrong || isCourt || isTournament || isCurse) && <p class="experience-note" id="local-alt-note">{isTier
      ? "A plain-text image description made from your list title, optional byline and the four named rows in order, with their entries."
      : isMustGo
      ? "A plain-text image description made from the title, the choice crossed out and the three that stay in stage order, plus any byline."
      : isCourt
      ? "A plain-text image description made from the current case number, its exact wording, your verdict and any byline."
      : isTournament
      ? "A plain-text image description made from the exact champion, the runner-up, their paired names and any byline."
      : isCurse
      ? "A plain-text image description made from the current curse number, its exact wording, your chosen constraint and its consequence, plus any byline."
      : "A plain-text image description made from the selected question, your answer and any byline."}</p>}
    <p class="experience-note" data-share-note>{isTier
      ? "Download the PNG to keep this board. There is no result link, public board or vote, and your entries are never serialised into a URL."
      : isMustGo
      ? "Download the PNG to keep this elimination. There is no result link, public vote or percentage, and a private round never travels in a URL."
      : isWrong
      ? "The PNG includes the selected question, your answer and any byline."
      : isCourt
      ? "The card prints the current case, its exact wording, your red or green flag and any byline. There is no result link, public verdict or stored docket."
      : isTournament
      ? "The card prints your exact champion, the runner-up and their paired names, plus any byline. There is no result link, public vote, score, ranking or stored bracket."
      : isCurse
      ? "The card prints the current curse, its exact prompt, the constraint you picked and its consequence, plus any byline. There is no result link, public vote, comparison or stored history."
      : isTwentyOne
      ? "Your answers stay in this tab. Save your cards to keep a copy."
      : isNine
      ? "A result link carries your title, subtitle, exhibits, source links, web page links, byline, optional profile link and ranked setting. Cover images never go into the link — download the result image to keep them."
      : isCloudflare
      ? "Your card prints the result name, service, explanation and any byline. It never prints your answers or the quiz address; Copy result link above holds the answer-free link."
      : isLanguage
      ? "Your card prints the result name, language, explanation and any byline. It never prints your answers or the quiz address; Copy result link above holds the answer-free link."
      : "A result link includes the result and any byline you enter. Downloads stay on your device."}</p>
    <p class="experience-note" role="status" data-status></p>
    <input hidden readonly aria-label="Result link" data-manual-copy />
    {(isNine || isThis || isTier || isMustGo || isWrong || isCourt || isTournament || isCurse) && <textarea hidden readonly rows="4" aria-label="Image description text" data-manual-alt></textarea>}
  </section>

  {!isNine && !isThis && !isTwentyOne && !isTier && !isMustGo && !isWrong && !isCourt && !isTournament && !isCurse && !persona && <details class="experience-custom">
    <summary>{isDoor ? "Write your own endings" : "Write your own bingo squares"}</summary>
    <form data-custom-form>
      <label for="experience-custom">
        {isDoor ? "Ten endings. Write one per line as Title | Story." : "Enter 24 phrases, one per line. The centre stays free."}
      </label>
      <textarea id="experience-custom" required rows="9" maxlength={5500} data-custom></textarea>
      <button type="submit" disabled={isDoor}>Use this version</button>
      <p role="status" data-custom-status></p>
    </form>
  </details>}

  <footer class="experience-footer">
    <a href="/"><img src="/brand/composer-icon-20261022b-48.png" alt="" width="26" height="26" /> Made with App Composer</a>
    <nav aria-label="More experiences">
      {Object.entries(experiences).filter(([id]) => id !== game).map(([id, item]) =>
        <a href={experiencePath(id as ExperienceId)}>{item.title} →</a>
      )}
    </nav>
  </footer>
</article>

<script>
  import { mountShareExperience } from "../../browser/share-experiences.ts";
  const root = document.querySelector<HTMLElement>("[data-experience]");
  if (root) mountShareExperience(root);
</script>
