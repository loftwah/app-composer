---
import Base from '../layouts/Base.astro';
import {ArrowUpRight,ArrowRight,Settings2} from '@lucide/astro';
import {apps} from '../lib/apps';
interface Props {instance:{name:string;owner:string;person:string;description:string;bio:string;portrait:string;banner:string;profile:string;connections:{title:string;description:string;href:string;kind:string}[]}}
const {instance}=Astro.props;
const daily=apps.filter(app=>['showcase','guestbook','linkcheck'].includes(app.id)).sort((a,b)=>['showcase','guestbook','linkcheck'].indexOf(a.id)-['showcase','guestbook','linkcheck'].indexOf(b.id));
---
<Base title={instance.name} description={instance.description} shareImage="https://composer.loftwah.com/brand/instance-share-v1.jpg" shareAlt="Loftwah’s App Composer — my apps, connected. Linkarooie, guestbook and tools, with Loftwah’s portrait.">
 <section class="instance-intro" aria-labelledby="instance-title"><div class="instance-cover"><img src={instance.banner} width="1500" height="500" alt="Loftwah’s kangaroo in green and gold at a concert" fetchpriority="high"/></div><div class="instance-identity"><img class="instance-portrait" src={instance.portrait} width="400" height="400" alt={instance.person}/><div><h1 id="instance-title">{instance.owner}’s workspace</h1><p class="lede">{instance.bio}</p><div class="actions"><a class="button" href={instance.profile}>Open Linkarooie <ArrowRight size={18} aria-hidden="true"/></a><a href="/guestbook/">Leave a postcard <ArrowUpRight size={17} aria-hidden="true"/></a></div></div></div></section>
 <section class="instance-section" aria-labelledby="daily-title"><div class="instance-section-heading"><div><h2 id="daily-title">My apps</h2></div><a href="/apps">All {apps.length} apps <ArrowRight size={17} aria-hidden="true"/></a></div><div class="instance-apps">{daily.map(app=><article><img src={app.thumbnail} width="64" height="64" alt="" loading="lazy"/><div><h3><a href={app.href}>{app.name} <ArrowUpRight size={17} aria-hidden="true"/></a></h3><p>{app.description}</p></div></article>)}</div></section>
 <section class="instance-section" aria-labelledby="connections-title"><div class="instance-section-heading"><div><h2 id="connections-title">More from {instance.owner}</h2><p>Music to listen to, games to play and the work around this workspace.</p></div><a href={instance.profile}>The full profile <ArrowRight size={17} aria-hidden="true"/></a></div><div class="instance-connections">{instance.connections.map(item=><a href={item.href}><span class="instance-kind">{item.kind}</span><strong>{item.title}</strong><span>{item.description}</span><ArrowUpRight size={18} aria-hidden="true"/></a>)}</div></section>
 <section class="instance-tools" aria-labelledby="tools-title"><div><Settings2 size={24} aria-hidden="true"/><h2 id="tools-title">Keep building.</h2><p>Manage my app content, put together the next app, or inspect how this instance works.</p><a class="button secondary" href="/_emdash/admin/plugins/composer-miniapps/apps">Manage my apps <ArrowRight size={17} aria-hidden="true"/></a></div><nav aria-label="Workspace tools"><a href="/init"><strong>Init</strong><span>Shape an app and keep its specification.</span><ArrowUpRight size={18} aria-hidden="true"/></a><a href="/ready"><strong>Get Ready</strong><span>Check the environment with an authorised agent.</span><ArrowUpRight size={18} aria-hidden="true"/></a><a href="/architecture"><strong>How it works</strong><span>Source, data, connections and ownership.</span><ArrowUpRight size={18} aria-hidden="true"/></a><a href="/learn"><strong>Build your own</strong><span>Follow along with App Composer.</span><ArrowUpRight size={18} aria-hidden="true"/></a></nav></section>
</Base>
<style>
.instance-intro{padding-top:4px}.instance-cover img{display:block;width:100%;height:clamp(160px,17vw,220px);object-fit:cover;object-position:50% 0%;border-radius:10px}.instance-identity{display:grid;grid-template-columns:96px minmax(0,1fr);gap:24px;padding:0 20px 12px;margin-top:-38px;position:relative}.instance-portrait{border:6px solid var(--color-bg);border-radius:50%;width:96px;height:96px;object-fit:cover;background:var(--color-surface)}.instance-identity>div{padding-top:56px}.instance-identity h1{font-size:clamp(2rem,3.4vw,3rem);letter-spacing:-.035em;margin:0 0 12px;line-height:1.12;max-width:none}.instance-identity .lede{margin:0 0 12px;font-size:21px}.instance-identity .actions{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:12px 16px;margin:16px 0 0}.instance-identity .actions>a{display:inline-flex;align-items:center;gap:8px;min-height:44px;font-size:14px}.instance-section{border-top:1px solid var(--color-border);padding-top:32px;margin-top:28px}.instance-section-heading{display:flex;justify-content:space-between;align-items:start;gap:24px;margin-bottom:28px}.instance-section-heading h2{font-size:26px;margin:0 0 10px;letter-spacing:-.03em}.instance-section-heading p{font-size:15px;color:var(--color-muted);margin:0}.instance-section-heading>a{display:inline-flex;align-items:center;gap:8px;min-height:44px;white-space:nowrap;font-size:13px}.instance-apps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.instance-apps article{display:flex;gap:16px;min-width:0}.instance-apps img{flex:none;width:56px;height:56px;object-fit:contain;border-radius:8px}.instance-apps h3{font-size:20px;line-height:1.3;margin:0 0 4px}.instance-apps h3 a{display:inline-flex;align-items:center;gap:8px;min-height:44px}.instance-apps p{font-size:14px;line-height:1.6;color:var(--color-muted);margin:0}.instance-connections{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 32px}.instance-connections>a{position:relative;display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--color-border);padding:22px 28px 24px 0;min-height:154px}.instance-connections .instance-kind{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--color-muted)}.instance-connections strong{font-size:20px}.instance-connections span:not(.instance-kind){font-size:14px;font-weight:400;color:var(--color-muted)}.instance-connections svg{position:absolute;right:0;top:50px}.instance-tools{display:grid;grid-template-columns:1fr 1fr;gap:64px;border-top:1px solid var(--color-border);padding-top:32px;margin-top:32px}.instance-tools h2{margin:16px 0;font-size:28px}.instance-tools p{color:var(--color-muted);font-size:15px}.instance-tools nav{display:block}.instance-tools nav a{display:grid;grid-template-columns:1fr 20px;gap:6px 16px;padding:18px 0;border-bottom:1px solid var(--color-border);min-height:86px}.instance-tools nav strong{font-size:16px}.instance-tools nav span{grid-column:1;font-size:13px;color:var(--color-muted);font-weight:400}.instance-tools nav svg{grid-column:2;grid-row:1/3;align-self:center}
@media(max-width:900px){.instance-apps{grid-template-columns:1fr;gap:24px}.instance-apps article{max-width:600px}.instance-connections{grid-template-columns:repeat(2,minmax(0,1fr))}.instance-tools{gap:32px}}@media(max-width:600px){.instance-cover img{height:150px;object-position:50% 40%}.instance-identity{display:block;padding:0 0 12px;margin-top:-30px}.instance-portrait{width:72px;height:72px;border-width:4px}.instance-identity>div{padding-top:14px}.instance-identity h1{font-size:29px;max-width:none}.instance-identity .lede{font-size:16px}.instance-identity .actions{gap:12px 16px;margin-top:18px}.instance-section-heading{flex-direction:row;flex-wrap:wrap;align-items:baseline;gap:10px 16px;margin-bottom:20px}.instance-section-heading h2{font-size:24px}.instance-connections{grid-template-columns:1fr}.instance-connections>a{min-height:130px}.instance-tools{grid-template-columns:1fr;gap:24px}.instance-tools nav a{padding-block:16px}}
</style>
