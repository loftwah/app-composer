---
import { ArrowRight } from '@lucide/astro';
import { type browseShareArtwork, SHARE_CATALOGUE_QUERY_MAX } from '../lib/share-catalogue-asset.ts';

interface Props {
  catalogue: Awaited<ReturnType<typeof browseShareArtwork>>;
  query: string;
  project: string;
  after: string;
}
const { catalogue, query, project, after } = Astro.props;
const artworkPath = (values: Record<string, string>) => {
  const search = new URLSearchParams(Object.entries(values).filter(([, value]) => value));
  return search.size ? `/share?${search}` : '/share';
};
---

<section aria-label="Artwork" data-share-artwork>
  <form class="artwork-search" method="get" action="/share" role="search" aria-label="Search artwork">
    <input type="search" name="art" aria-label="Search artwork" placeholder="Search artwork" value={query} maxlength={SHARE_CATALOGUE_QUERY_MAX} />
    {project && <input type="hidden" name="project" value={project} />}
    <button type="submit">Search</button>
    {(query || project) && <a href="/share">Clear filters</a>}
  </form>
  {project && <p class="small">Project: {project}</p>}

  {!catalogue ? (
    <div class="artwork-empty">
      <h2>Artwork is temporarily unavailable</h2>
      <p><a href={artworkPath({ art: query, project, after })}>Try again</a>.</p>
    </div>
  ) : (
    <>
      {catalogue.items.length ? (
        <div class="artwork-grid" data-artwork-grid>
          {catalogue.items.map((item) => (
            <article class="artwork-card" data-artwork-id={item.assetId}>
              <a class="artwork-card-link" href={`/share/artwork/${item.assetId}`} aria-labelledby={`artwork-${item.assetId}`}>
                <div class="artwork-image">
                  <img src={item.thumbnailUrl} alt={item.alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                </div>
                <h2 id={`artwork-${item.assetId}`}>{item.title}</h2>
              </a>
              <p class="artwork-project small">
                {project === item.project ? item.project : <a href={artworkPath({ project: item.project })}>{item.project}</a>}
              </p>
            </article>
          ))}
        </div>
      ) : (
        <div class="artwork-empty">
          <h2>No artwork found</h2>
          <p><a href="/share">Browse all artwork</a></p>
        </div>
      )}
      {(after || catalogue.nextAfter) && (
        <nav class="artwork-pages" aria-label="Artwork pages">
          {after && <a href={artworkPath({ art: query, project })}>First page</a>}
          {catalogue.nextAfter && <a href={artworkPath({ art: query, project, after: catalogue.nextAfter })} data-artwork-next>More artwork <ArrowRight size={16} aria-hidden="true" /></a>}
          <span data-artwork-status role="status"></span>
        </nav>
      )}
    </>
  )}
</section>

<script>
  const wall = document.querySelector<HTMLElement>('[data-share-artwork]');
  const grid = wall?.querySelector<HTMLElement>('[data-artwork-grid]');
  const link = wall?.querySelector<HTMLAnchorElement>('[data-artwork-next]');
  const status = wall?.querySelector<HTMLElement>('[data-artwork-status]');

  if (grid && link && status) {
    const seen = new Set(Array.from(grid.children, (card) => (card as HTMLElement).dataset.artworkId));
    const loaded = new Set([location.href.split('#')[0]]);
    let loading = false;
    let moveFocus = false;
    const observer = typeof IntersectionObserver === 'function'
      ? new IntersectionObserver(([entry]) => {
          if (entry?.isIntersecting) void load();
        }, { rootMargin: '0px 0px 300px' })
      : null;

    async function load(explicit = false) {
      if (!grid || !link || !status || link.hidden) return;
      moveFocus ||= explicit;
      if (loading) return;
      loading = true;
      observer?.unobserve(link);
      status.textContent = 'Loading artwork…';
      try {
        const url = link.href;
        const response = await fetch(url, { redirect: 'error', signal: AbortSignal.timeout(8_000) });
        if (!response.ok) throw new Error('Artwork page unavailable');
        const page = new DOMParser().parseFromString(await response.text(), 'text/html');
        const batch = page.querySelector('[data-artwork-grid]');
        if (!batch) throw new Error('Artwork page missing');
        const cards = Array.from(batch.querySelectorAll<HTMLElement>('[data-artwork-id]')).filter((card) => {
          const id = card.dataset.artworkId;
          if (!id || seen.has(id)) return false;
          seen.add(id);
          return true;
        });
        if (!cards.length) throw new Error('No new artwork in batch');
        grid.append(...cards);
        if (moveFocus && document.activeElement === link) {
          cards[0].querySelector<HTMLAnchorElement>('a')?.focus();
        }
        loaded.add(url);
        const href = page.querySelector('[data-artwork-next]')?.getAttribute('href');
        const next = href ? new URL(href, url) : null;
        if (next?.origin === location.origin && next.pathname === location.pathname && !loaded.has(next.href)) {
          link.href = next.href;
          observer?.observe(link);
        } else {
          link.hidden = true;
        }
        status.textContent = link.hidden ? 'You’ve reached the end of the artwork.' : `${cards.length} more artworks loaded.`;
      } catch {
        status.textContent = 'Couldn’t load more here. Open the next page to try again.';
        link.dataset.navigate = '';
      } finally {
        loading = false;
        moveFocus = false;
      }
    }

    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.hasAttribute('data-navigate')) return;
      event.preventDefault();
      void load(true);
    });
    observer?.observe(link);
  }
</script>

<style>
  .artwork-search {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
  }
  .artwork-search input {
    flex: 0 1 24rem;
    min-width: 0;
    width: auto;
    min-height: 44px;
    margin: 0;
  }
  .artwork-search button, .artwork-search a, .artwork-pages a { min-height: 44px; margin: 0; }
  .artwork-search a, .artwork-pages a { display: inline-flex; align-items: center; gap: 0.35rem; }
  .artwork-pages { display: flex; align-items: center; flex-wrap: wrap; gap: 0 1rem; margin-block-start: 1.5rem; }
  .artwork-pages a[hidden] { display: none; }
  .artwork-pages [role="status"] { color: var(--color-muted); font-size: 0.9rem; }
  @media (max-width: 38rem) {
    .artwork-search input { flex: 1 1 12rem; }
  }
  .artwork-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.15rem, 2vw, 2rem) clamp(0.75rem, 1.1vw, 1.25rem);
  }
  @media (min-width: 38rem) {
    .artwork-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 55rem) {
    .artwork-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 72rem) {
    .artwork-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .artwork-card { min-width: 0; }
  .artwork-image { background: var(--color-surface); border-radius: 0.65rem; overflow: clip; }
  .artwork-image img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; }
  .artwork-card-link { display: block; }
  .artwork-card h2 {
    margin: 0;
    padding-block: 0.5rem 0.2rem;
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    line-height: 1.24;
    overflow-wrap: anywhere;
  }
  .artwork-project { margin: 0; color: var(--color-muted); }
  .artwork-project a { display: inline-flex; align-items: start; min-height: 24px; overflow-wrap: anywhere; }
  @media (pointer: coarse) {
    .artwork-project a { min-height: 44px; padding-block: 0.35rem; }
  }
  .artwork-card-link:hover h2, .artwork-project a:hover { color: var(--color-accent); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .artwork-image img { transition: transform 220ms ease-out; }
    .artwork-card-link:hover img { transform: scale(1.018); }
  }

</style>
