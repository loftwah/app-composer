---
import { ArrowLeft, ArrowRight, ArrowUpRight, ChevronDown, MessageSquare, Maximize2, Search, Shuffle, SlidersHorizontal, X } from '@lucide/astro';
import { SHARE_CATALOGUE_QUERY_MAX } from '../lib/share-catalogue-asset.ts';
import { artworkCategories, artworkLabel, artworkOrientations, artworkSorts, galleryHref, type ArtworkFilters, type galleryPage } from '../lib/share-gallery.ts';
import { shareCalendarEntry } from '../lib/share-calendar-entry';
import ShareSections from './ShareSections.astro';
import '../styles/share-gallery.css';

interface Props {
  catalogue: ReturnType<typeof galleryPage> | null;
  filters: ArtworkFilters;
  signedIn: boolean;
}
const { catalogue, filters, signedIn } = Astro.props;
const shareCalendarHref = shareCalendarEntry(signedIn);
const { query, project, sort, category, orientation, tag, after, legacy, liked } = filters;
const href = (updates: Partial<ArtworkFilters> = {}) => galleryHref(filters, { after: '', ...updates });
const browse = new URL(href({ after }), 'https://composer.loftwah.com').search;
const signIn = '/_emdash/admin/login?' + new URLSearchParams({ redirect: href({ after }) });
const shuffle = href({ sort: 'random', seed: crypto.randomUUID().slice(0, 8) });
const facets = [
  { key: 'query', label: query },
  { key: 'project', label: project && artworkLabel(project) },
  { key: 'category', label: artworkCategories[category] },
  { key: 'orientation', label: orientation !== 'any' && artworkOrientations[orientation] },
  { key: 'tag', label: tag && artworkLabel(tag) },
].filter(facet => facet.label);
const facetCount = [category, orientation !== 'any', tag].filter(Boolean).length;
const showStarts = !liked && !after && !legacy && !facets.length && sort === 'featured';
const starts = [
  { title: 'Make a poster', description: 'Copy a brief and see the finished print.', href: '/prints-desktop/make#brief' },
  { title: 'Build a palette', description: 'Sample the artwork and export the colours as CSS.', href: '/share/artwork/atlas-04-composer-family/palette' },
  { title: 'Make a social kit', description: 'Export four sizes from one image in Media Studio.', href: 'https://media.loftwah.com/tools/images' },
];
const options = {
  projects: [...new Set([...(catalogue?.projects ?? []), ...(project ? [project] : [])])],
  tags: [...new Set([...(catalogue?.tags ?? []), ...(tag ? [tag] : [])])],
};
---

<section class="share-gallery" aria-labelledby="artwork-heading" data-share-artwork>
  <header class="gallery-heading">
    <h1 id="artwork-heading">{liked ? 'Liked artwork' : <>Share<span>.</span></>}</h1>
    <div class="gallery-intro">
      <p>{liked ? 'Artwork you’ve given a thumbs-up in private feedback.' : 'Artwork, sketches and posters across our projects.'}</p>
      <ShareSections current={liked ? 'liked' : 'artwork'} showLiked={signedIn || liked} />
    </div>
    {catalogue?.items.length ? <a class="button gallery-shuffle" href={shuffle}><Shuffle size={18} aria-hidden="true" /> Shuffle artwork</a> : null}
  </header>

  {catalogue && <form class="gallery-controls" method="get" action="/share" role="search" aria-label="Browse artwork">
    <label class="gallery-search">
      <span class="gallery-visually-hidden">Search artwork</span><Search size={18} aria-hidden="true" />
      <input type="search" name="art" placeholder="Search artwork" value={query} maxlength={SHARE_CATALOGUE_QUERY_MAX} />
    </label>
    <div class="gallery-sort gallery-project">
      <label for="gallery-project">Project</label>
      <select id="gallery-project" name="project">
        <option value="">All projects</option>
        {options.projects.map(value => <option value={value} selected={value === project}>{artworkLabel(value)}</option>)}
      </select>
    </div>
    <div class="gallery-sort">
      <label for="gallery-sort">Sort</label>
      <select id="gallery-sort" name="sort">
        {Object.entries(artworkSorts).map(([value, label]) => <option value={value} selected={value === sort}>{label}</option>)}
      </select>
    </div>
    <details class="gallery-filter-menu">
      <summary><SlidersHorizontal size={16} aria-hidden="true" /> Filters{facetCount > 0 && ` (${facetCount})`} <ChevronDown size={14} aria-hidden="true" /></summary>
      <div class="gallery-filters">
        <div>
          <label for="gallery-category">Category</label>
          <select id="gallery-category" name="category">
            <option value="">All categories</option>
            {Object.entries(artworkCategories).map(([value, label]) => <option value={value} selected={value === category}>{label}</option>)}
          </select>
        </div>
        <div>
          <label for="gallery-orientation">Orientation</label>
          <select id="gallery-orientation" name="orientation">
            {Object.entries(artworkOrientations).map(([value, label]) => <option value={value} selected={value === orientation}>{label}</option>)}
          </select>
        </div>
        <div>
          <label for="gallery-tag">Tag</label>
          <select id="gallery-tag" name="tag">
            <option value="">All tags</option>
            {options.tags.map(value => <option value={value} selected={value === tag}>{artworkLabel(value)}</option>)}
          </select>
        </div>
        <button type="submit">Apply filters</button>
      </div>
    </details>
    <button class="secondary gallery-apply" type="submit">Apply <span class="gallery-visually-hidden">search, project and sort</span></button>
    {liked && <input type="hidden" name="view" value="liked" />}
    {filters.seed && <input type="hidden" name="seed" value={filters.seed} />}
  </form>}

  {showStarts && (
    <nav class="gallery-starts" aria-label="Make something with Share">
      {starts.map(({ title, description, href }) => (
        <a href={href}>
          <span><strong>{title}</strong><span>{description}</span></span>
          <ArrowUpRight size={23} aria-hidden="true" />
        </a>
      ))}
    </nav>
  )}

  <div class="gallery-readout">
    <div class="gallery-results">
      {catalogue && <p>{catalogue.total.toLocaleString('en-AU')} {catalogue.total === 1 ? 'piece' : 'pieces'}{facets.length > 0 && ' found'}</p>}
      {facets.map(({ key, label }) => (
        <a class="gallery-active-filter" href={href({ [key]: '' })} aria-label={`Remove filter: ${label}`}>
          {label} <X size={13} aria-hidden="true" />
        </a>
      ))}
      {facets.length > 1 && <a href={href({ query: '', project: '', category: '', orientation: 'any', tag: '' })}>Clear filters</a>}
    </div>
    <details class="gallery-more">
      <summary>More from Share</summary>
      <nav class="gallery-related" aria-label="More to explore">
        {tag === "computer-club" && <a href="/share/experiences/computer-club">Play Computer Club <ArrowUpRight size={13} aria-hidden="true" /></a>}
        <a href={shareCalendarHref}>{signedIn ? 'Share calendar' : 'Share calendar (invited access)'} <ArrowUpRight size={13} aria-hidden="true" /></a>
        <a href="/widgets">Widget library <ArrowUpRight size={13} aria-hidden="true" /></a>
        <a href="/share/spin">Spin <ArrowUpRight size={13} aria-hidden="true" /></a>
        <a href="https://media.loftwah.com/gallery">Media Studio <ArrowUpRight size={13} aria-hidden="true" /></a>
        <a href="/diagrams">Diagrams <ArrowUpRight size={13} aria-hidden="true" /></a>
        {!signedIn && <a href={signIn}>Collaborator sign-in <ArrowUpRight size={13} aria-hidden="true" /></a>}
      </nav>
    </details>
  </div>

  {liked && !signedIn ? (
    <div class="gallery-empty"><h2>Sign in to see your liked artwork</h2><a href={signIn}>Continue to sign-in</a></div>
  ) : !catalogue ? (
    <div class="gallery-empty"><h2>{liked ? 'Liked artwork is temporarily unavailable' : 'Artwork is temporarily unavailable'}</h2><a href={href()}>Try again</a></div>
  ) : catalogue.items.length ? (
    <div class="gallery-grid" data-artwork-grid>
      {catalogue.items.map((item, index) => (
        <article class="gallery-tile" id={`artwork-${item.assetId}`} data-artwork-id={item.assetId}>
          <a href={`/share/artwork/${item.assetId}${browse}`} data-artwork-open aria-label={`View ${item.title}`}>
            <div class="gallery-thumbnail" data-width={item.thumbnailSize?.width} data-height={item.thumbnailSize?.height}>
              <img src={item.thumbnailUrl} width={item.thumbnailSize?.width ?? undefined} height={item.thumbnailSize?.height ?? undefined}
                alt={item.alt} loading={index < 5 && !after ? 'eager' : 'lazy'} decoding="async" fetchpriority={!after && index === 0 ? "high" : undefined} referrerpolicy="no-referrer" />
              {item.featured && <span class="gallery-featured">Featured</span>}
            </div>
            <div class="gallery-caption">
              <div>
                <h2>{item.title}</h2>
                <p>{artworkLabel(item.project)} <span aria-hidden="true">·</span> {artworkCategories[item.category]}</p>
              </div>
              <Maximize2 size={15} aria-hidden="true" />
            </div>
          </a>
          {signedIn && <a class="gallery-tile-feedback" data-artwork-feedback href={`/share/artwork/${item.assetId}${browse}#artwork-feedback`} aria-label={`Give feedback on ${item.title}`}><MessageSquare size={16} aria-hidden="true" /> Feedback</a>}
        </article>
      ))}
    </div>
  ) : (
    <div class="gallery-empty">
      <h2>{facets.length ? 'No artwork matches these filters' : liked ? 'No liked artwork yet' : 'No artwork available'}</h2>
      {liked && !facets.length && <p>Give a piece a thumbs-up using Feedback, then find it here.</p>}
      <a href={liked && facets.length ? "/share?view=liked" : "/share"}>{liked && facets.length ? 'Clear filters' : 'Browse all artwork'}</a>
    </div>
  )}

  {catalogue && (after || catalogue.nextAfter) && (
    <nav class="gallery-pages" aria-label="Artwork pages">
      {after && <a href={href()}>First page</a>}
      {catalogue.nextAfter && (
        <a href={legacy ? `${href()}${href().includes('?') ? '&' : '?'}after=${catalogue.nextAfter}` : href({after: catalogue.nextAfter})} data-artwork-next>
          More artwork <ArrowRight size={16} aria-hidden="true" />
        </a>
      )}
      <span data-artwork-status role="status"></span>
    </nav>
  )}

  <dialog class="gallery-lightbox" data-gallery-dialog aria-label="Artwork preview">
    <header class="gallery-lightbox-bar">
      <button type="button" data-gallery-close autofocus><X size={20} aria-hidden="true" /> Close</button>
      <div class="gallery-lightbox-arrows">
        <button type="button" data-gallery-prev aria-label="Previous artwork"><ArrowLeft size={20} aria-hidden="true" /></button>
        <button type="button" data-gallery-next aria-label="Next artwork"><ArrowRight size={20} aria-hidden="true" /></button>
      </div>
    </header>
    <div data-gallery-content></div>
  </dialog>
</section>

<script>
  import { mountShareGallery } from '../browser/share-gallery.ts';
  const wall = document.querySelector<HTMLElement>('[data-share-artwork]');
  if (wall) {
    const filters = wall.querySelector<HTMLDetailsElement>('.gallery-filter-menu');
    if (filters) {
      document.addEventListener('pointerdown', (event) => {
        if (!filters.contains(event.target as Node)) filters.open = false;
      });
      filters.addEventListener('focusout', (event) => {
        if (event.relatedTarget && !filters.contains(event.relatedTarget as Node)) filters.open = false;
      });
      filters.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !filters.open || event.defaultPrevented) return;
        filters.open = false;
        filters.querySelector('summary')?.focus();
      });
    }
    mountShareGallery(wall);
  }
</script>
