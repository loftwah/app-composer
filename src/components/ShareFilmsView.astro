---
import { ArrowUpRight } from '@lucide/astro';
import ShareSections from './ShareSections.astro';
import { shareFilms, studioFilmPath } from '../lib/share-films.ts';

const [socialKit, studioTeaser, workshop] = shareFilms;
const workshopWatch = '/brand/campaign/take-it-with-you-20261118';
const teaserWatch = '/media-studio/watch/media-studio-teaser-recut';
const films = [
  {
    id: workshop.id,
    title: workshop.title,
    detail: workshop.detail,
    src: workshop.href,
    poster: workshopWatch + '.webp',
    captions: workshopWatch + '.vtt',
    transcript: workshopWatch + '.txt',
    width: 1280,
    height: 720,
    portrait: false,
  },
  {
    id: studioTeaser.id,
    title: studioTeaser.title,
    detail: '30 seconds · From a brief to a published motion study.',
    credit: 'Features Low Tide by LoftwahFM.',
    src: teaserWatch + '.mp4',
    poster: '/media-studio/teaser-poster-20261117.jpg',
    captions: teaserWatch + '.vtt',
    transcript: teaserWatch + '.txt',
    width: 540,
    height: 960,
    portrait: true,
  },
  {
    id: socialKit.id,
    title: socialKit.title,
    detail: '17 seconds · Image Tools turns one PNG into four sizes and downloads a ZIP.',
    credit: 'Music by LoftwahFM · Pixel Box Theory',
    src: socialKit.href,
    poster: studioFilmPath + '.jpg',
    captions: studioFilmPath + '.vtt',
    width: 1080,
    height: 1920,
    portrait: true,
  },
];
---

<section class="share-films" aria-labelledby="films-heading" data-share-films>
  <header class="films-heading">
    <h1 id="films-heading">Films<span aria-hidden="true">.</span></h1>
    <div class="films-intro">
      <p>Watch short films from our projects.</p>
      <ShareSections current="films" />
    </div>
  </header>

  <ul class="film-list" role="list">
    {films.map((film) => (
      <li class:list={['film', film.id === workshop.id && 'film-feature']} id={film.id}>
        <video controls playsinline preload="none" poster={film.poster} width={film.width} height={film.height}
          class:list={['film-player', film.portrait && 'film-player-portrait']} aria-labelledby={`${film.id}-title`}>
          <source src={film.src} type="video/mp4" />
          <track kind="captions" src={film.captions} srclang="en" label="English captions" default />
          <a href={film.src}>Open {film.title}</a>
        </video>
        <div class="film-copy">
          <h2 id={`${film.id}-title`}>{film.title}</h2>
          <p>{film.detail}</p>
          {film.credit && <p class="film-credit">{film.credit}</p>}
          <nav class="film-actions" aria-label={`${film.title} files`}>
            <a href={film.src} download>Download film</a>
            {film.transcript && <a href={film.transcript}>Transcript</a>}
          </nav>
        </div>
      </li>
    ))}
  </ul>

  <nav class="films-detail" aria-label="More about the films">
    <a href="/share?tag=operation-world-domination">Operation World Domination <ArrowUpRight size={14} aria-hidden="true" /></a>
    <a href="/media-studio#watch">Watch the full Studio build <ArrowUpRight size={14} aria-hidden="true" /></a>
    <a href="/media-studio/films#my-feedback">Private feedback <ArrowUpRight size={14} aria-hidden="true" /></a>
  </nav>
</section>

<style>
  .share-films { max-width: 104rem; margin-inline: auto; }
  .films-heading { display: grid; grid-template-columns: minmax(0, 1fr); gap: .55rem; margin-block-end: clamp(1.2rem, 2.8vw, 2.75rem); }
  .films-heading h1 { margin: 0; font-size: clamp(3rem, 6vw, 5rem); line-height: .94; letter-spacing: -.04em; }
  .films-heading h1 span { color: var(--color-accent); }
  .films-intro p { margin: 0; max-width: 62ch; color: var(--color-muted); font-size: clamp(.875rem, 1.4vw, 1.1rem); line-height: 1.4; }
  .film-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.3rem, 3vw, 2.75rem);
    max-width: none;
    padding: 0;
    margin: 0;
  }
  .film {
    display: grid;
    grid-template-columns: minmax(0, .7fr) minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    min-width: 0;
    border-top: 1px solid var(--color-border);
    padding-block-start: 1rem;
  }
  .film-feature {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 4vw, 4rem);
    padding: clamp(.75rem, 2vw, 1.75rem);
    border: 0;
    background: var(--color-surface);
  }
  .film-player { display: block; width: 100%; height: auto; border-radius: 8px; background: #101214; }
  .film-player-portrait { width: min(100%, 14rem); }
  .film h2 { margin: .15rem 0 .4rem; font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.2; }
  .film-feature h2 { max-width: 13ch; font-size: clamp(1.75rem, 4vw, 3.3rem); line-height: 1.02; }
  .film p { margin: 0 0 .35rem; color: var(--color-muted); font-size: .9rem; }
  .film .film-credit { font-size: .8rem; }
  .film-actions { display: flex; flex-wrap: wrap; gap: 0 1rem; margin-block-start: .35rem; font-size: .875rem; font-weight: 650; }
  .film-actions a { display: inline-flex; align-items: center; min-height: 44px; }
  .films-detail { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin: clamp(1.5rem, 3vw, 2.5rem) 0 0; padding-block-start: 1rem; border-top: 1px solid var(--color-border); font-size: .9rem; }
  .films-detail a { display: inline-flex; align-items: center; gap: .25rem; min-height: 44px; color: var(--color-muted); }
  .film-actions a:hover, .films-detail a:hover { color: var(--color-accent); }
  @media (max-width: 700px) {
    .film-list { grid-template-columns: 1fr; }
    .film { grid-template-columns: 1fr; }
    .film-player-portrait { width: min(100%, 13rem); }
    .film-feature h2 { max-width: none; }
  }
</style>
