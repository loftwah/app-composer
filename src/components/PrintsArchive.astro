---
import { ArrowDownToLine, ArrowRight } from '@lucide/astro';
import { isPrintsHost, printsIcon } from '../lib/prints-site.mjs';

const { guide, watch, compare } = Astro.props;
const printsProduct = isPrintsHost(Astro.url);
---
<header class="archive" id="archive" tabindex="-1" aria-labelledby="archive-title">
  <div class="archive-intro">
    {!printsProduct && <p class="signature"><img src={printsIcon} width="32" height="32" alt="" /> Prints Desktop</p>}
    <h1 id="archive-title"><span>Compare artwork.</span> <span>Keep the original.</span></h1>
    <p class="lede">Put an album cover beside its release poster, see what changed, and export the exact original. Explore the Loftwah Creative Archive or bring your own images.</p>
    <div class="archive-actions">
      <a class="download" href="#downloads"><ArrowDownToLine size={18} aria-hidden="true" /> Download preview</a>
      <a href="#paths">Try a workflow <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
    <div class="archive-links">
      <a href={guide}>Poster workshop</a>
      <a href={watch}>Watch the 15-second demo</a>
      <a href="#afterlight">Play Afterlight</a>
    </div>
  </div>
  <figure class="compare-proof">
    <a href={compare} aria-label="View the full-size Prints Desktop comparison screenshot">
      <img src={compare} width="1280" height="790" alt="Prints Desktop shows LoftwahFM’s square Higher Than Before cover and tall release poster side by side." fetchpriority="high" decoding="async" />
    </a>
    <figcaption>
      <span><strong>Higher Than Before</strong> · Cover and release poster</span>
      <span>Captured in Prints Desktop on macOS</span>
    </figcaption>
  </figure>
</header>

<style>
  .archive { display: grid; grid-template-columns: minmax(0,.88fr) minmax(0,1.12fr); gap: 26px clamp(26px,5vw,76px); align-items: center; scroll-margin-top: 5rem; }
  .signature { display: flex; align-items: center; gap: 9px; margin: 0 0 12px; font-weight: 700; }
  .archive h1 { margin: 0 0 18px; max-width: 16ch; font-size: clamp(2.5rem,4.2vw,4.4rem); line-height: .99; font-weight: 700; letter-spacing: -.035em; text-wrap: balance; }
  .archive h1 span { display: block; }
  .lede { font-size: clamp(1rem,1.7vw,1.23rem); line-height: 1.53; max-width: 37ch; margin: 0 0 20px; }
  .archive-actions,.archive-links { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; }
  .archive-actions a,.archive-links a { display: inline-flex; min-height: 44px; align-items: center; gap: 7px; font-size: .9rem; }
  .archive-actions a { font-weight: 700; }
  .download { border-radius: 6px; padding: 0 12px; background: var(--color-action); color: var(--color-on-action); }
  .download:hover { background: var(--color-action-hover); color: var(--color-on-action); }
  .archive-links a { color: var(--color-muted); }
  .archive-links a:hover { color: var(--color-foreground); }
  .compare-proof { min-width: 0; margin: 0; }
  .compare-proof a { display: block; border-radius: 10px; border: 1px solid var(--color-border); background: #191919; overflow: hidden; }
  .compare-proof img { display: block; width: 100%; height: auto; }
  .compare-proof figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 3px 12px; margin-top: 8px; color: var(--color-muted); font-size: .85rem; }
  .compare-proof figcaption strong { color: var(--color-foreground); }
  .archive a:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  @media(max-width: 780px) {
    .archive { grid-template-columns: minmax(0,1fr); gap: 16px; }
    .archive h1 { max-width: 15ch; }
  }
  @media(max-width: 620px) {
    .archive h1 { max-width: none; margin-bottom: 12px; font-size: clamp(1.9rem,8.4vw,2.875rem); line-height: 1.04; text-wrap: initial; }
    .archive .lede { margin-bottom: 13px; }
    .archive-actions,.archive-links { column-gap: 10px; }
    .archive-actions .download { padding-inline: 9px; }
  }
  @media(max-width: 360px) {
    .archive-actions a:not(.download) svg { display: none; }
  }
</style>
