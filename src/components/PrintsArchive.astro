---
import { ArrowDown, ArrowDownToLine, ArrowUpRight } from '@lucide/astro';
const{ guide } = Astro.props;
const folder = '/prints-desktop/archive-v1/';
const entries = [
  {
    title: 'Higher Than Before',
    source: 'https://fm.loftwah.com/album/higher-than-before/',
    img: 'higher-than-before.webp',
    alt: 'Higher Than Before in large cream lettering above an orange disc on dark blue.',
    from: 'LoftwahFM',
    detail: 'The finished cover for the eleven-track record.',
  },
  {
    title: 'Before the Bell',
    source: 'https://fighter.loftwah.com/',
    img: 'before-the-bell.webp',
    alt: 'A horned fighter, a masked fighter and the Grim Reaper share a ring under a warm spotlight.',
    from: 'Fighter',
    detail: 'A cinematic still from the arcade game’s campaign.',
  },
  {
    title: 'One Shot',
    source: 'https://bubbles.loftwah.com/',
    img: 'bubbles-one-shot.webp',
    alt: 'A Bubbles Classic campaign card built around an actual one-shot clear.',
    from: 'Bubbles',
    detail: 'A real Classic clear, framed as a game poster.',
  },
  {
    title: 'The Last Lift',
    source: 'https://fm.loftwah.com/album/higher-than-before/#album-booklet',
    img: 'the-last-lift.webp',
    alt: 'An empty tiled pool in the artwork for The Last Lift booklet.',
    from: 'LoftwahFM',
    detail: 'The booklet that follows the record after dark.',
  },
];
---

<header class="archive" id="archive" aria-labelledby="archive-title">
  <div class="archive-intro">
    <p class="signature"><span>Prints Desktop</span> by Loftwah</p>
    <h1 id="archive-title">The work behind the work.</h1>
    <p class="lede">Album covers, arcade posters and the files in between. Explore the Loftwah Creative Archive, then bring your own images into Prints Desktop.</p>
    <div class="archive-actions">
      <a class="download" href="#downloads"><ArrowDownToLine size={18} aria-hidden="true" /> Get the desktop preview</a>
      <a href="#afterlight">Pick an Afterlight print <ArrowDown size={17} aria-hidden="true" /></a>
    </div>
    <a class="guide" href={guide}>Installation and connection guide <ArrowUpRight size={16} aria-hidden="true" /></a>
  </div>
  <div class="proof-sheet" aria-label="Selected work from the Loftwah Creative Archive">
    {entries.map((entry, index) => (
      <figure>
        <img src={folder + entry.img} alt={entry.alt} width="1000" height="1000" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={index === 0 ? 'high' : 'auto'} />
        <figcaption>
          <a href={entry.source}>{entry.title}<ArrowUpRight size={15} aria-hidden="true" /></a>
          <span><strong>{entry.from}</strong> · {entry.detail}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</header>

<style>
  .archive { display: grid; grid-template-columns: minmax(0,.91fr) minmax(0,1.09fr); gap: 30px clamp(24px,5vw,68px); align-items: center; scroll-margin-top: 5rem; }
  .archive-intro .signature { margin: 0 0 7px; color: var(--color-muted); font-size: .92rem; }
  .signature span { font-weight: 700; color: var(--color-foreground); }
  .archive h1 { margin: 0 0 18px; max-width: 11ch; font-size: clamp(3rem,7.5vw,6rem); line-height: .98; font-weight: 700; letter-spacing: -.035em; text-wrap: balance; }
  .archive .lede { font-size: clamp(1rem,1.7vw,1.23rem); line-height: 1.5; max-width: 34ch; margin: 0 0 18px; }
  .archive-actions { display: flex; flex-wrap: wrap; gap: 7px 13px; }
  .archive-actions a, .guide { display: inline-flex; min-height: 44px; align-items: center; gap: 6px; font-size: .9rem; }
  .archive-actions .download { border-radius: 6px; padding: 0 10px; background: #ffdab8; color: #24171d; }
  .archive-actions .download:hover { background: #ffbc97; }
  .guide { color: var(--color-muted); }
  .guide:hover { color: var(--color-foreground); }
  .proof-sheet { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(7px,1.5vw,15px); padding: clamp(10px,2vw,21px); border-radius: 12px; background: #251f28; color: #fff0da; }
  .proof-sheet figure { min-width: 0; margin: 0; background: #322834; }
  .proof-sheet img { width: 100%; height: auto; aspect-ratio: 1.25; object-fit: contain; display: block; background: #321f31; }
  .proof-sheet figcaption { padding: 5px 9px 9px; line-height: 1.3; }
  .proof-sheet figcaption a { min-height: 44px; display: inline-flex; gap: 4px; align-items: center; color: #fff0da; font: 700 clamp(.84rem,1.6vw,1.1rem)/1.14 Space,sans-serif; }
  .proof-sheet figcaption a:hover { color: #ffc3a3; }
  .proof-sheet figcaption span { display: block; font-size: .77rem; color: #e4cdbe; }
  .archive a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media(max-width: 790px) {
    .archive { grid-template-columns: minmax(0,1fr); gap: 15px; }
    .archive h1 { max-width: 14ch; }
  }
</style>
