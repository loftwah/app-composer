---
interface Props {
  id: string;
  title: string;
  directory: string;
  description?: string;
  featureFirst?: boolean;
  entries: {
    name: string;
    title: string;
    caption: string;
    width: number;
    height: number;
    alt?: string;
    steps?: { title: string; detail: string }[];
  }[];
}

const { id, title, directory, description, featureFirst = false, entries } = Astro.props;
---

<section class="diagram-collection" id={id} aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>{title}</h2>
  {description && <p class="collection-description">{description}</p>}
  <ul class:list={['sheet', { 'feature-first': featureFirst }]}>
    {entries.map((entry, index) => {
      const base = `/diagrams/${directory}/${entry.name}`;
      return (
        <li id={`diagram-${entry.name}`}>
          <figure>
            <a class="preview" href={`${base}.png`} aria-label={`View full-size diagram: ${entry.title}`}>
              <img
                src={`${base}.webp`}
                width={entry.width}
                height={entry.height}
                alt={entry.alt ?? ''}
                loading={featureFirst && index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
            <figcaption>
              <h3>{entry.title}</h3>
              <p>{entry.caption}</p>
              <div class="formats">
                <a href={`${base}.excalidraw`} download aria-label={`Download editable Excalidraw scene for ${entry.title}`}>Editable scene</a>
                <a href={`${base}.svg`} download aria-label={`Download SVG for ${entry.title}`}>SVG</a>
                <a href={`${base}.png`} download aria-label={`Download PNG for ${entry.title}`}>PNG</a>
              </div>
              {entry.steps && (
                <details>
                  <summary>Read this diagram as text</summary>
                  <ol>{entry.steps.map((step) => <li><strong>{step.title}</strong> {step.detail}</li>)}</ol>
                </details>
              )}
            </figcaption>
          </figure>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .diagram-collection { margin-block: 3rem; scroll-margin-top: 6rem; }
  h2 { margin-block: 0 .45rem; font-size: clamp(1.75rem, 4vw, 3rem); }
  .collection-description { color: var(--color-muted); max-width: 68ch; margin: 0 0 1.25rem; }
  .sheet {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem 1rem;
    padding: 0;
    max-width: none;
    margin-block: 1rem 0;
    list-style: none;
  }
  .sheet > li { min-width: 0; scroll-margin-top: 6rem; }
  .feature-first > li:first-child { grid-column: span 2; grid-row: span 2; }
  figure { margin: 0; }
  .preview {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: #eeece6;
    border: 1px solid var(--color-border);
    border-radius: .5rem;
  }
  .preview img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: contain; border-radius: .45rem; }
  figcaption { padding: .65rem .125rem 0; }
  h3 { font-size: 1.05rem; line-height: 1.25; margin: 0 0 .35rem; }
  figcaption p { color: var(--color-muted); font-size: .9rem; margin: 0; }
  .formats { display: flex; flex-wrap: wrap; gap: 0 .9rem; }
  .formats a { display: inline-flex; align-items: center; min-height: 44px; font-size: .875rem; font-weight: 600; }
  details { color: var(--color-muted); font-size: .875rem; }
  summary { min-height: 44px; padding-block-start: .55rem; }
  details ol { margin-block: 0 .8rem; padding-inline-start: 1.25rem; }
  details li + li { margin-block-start: .35rem; }
  @media (max-width: 820px) {
    .sheet { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .feature-first > li:first-child { grid-row: auto; }
  }
  @media (max-width: 500px) {
    .sheet { grid-template-columns: minmax(0, 1fr); }
    .feature-first > li:first-child { grid-column: auto; }
  }
</style>
