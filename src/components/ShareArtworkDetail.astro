---
import { ArrowUpRight, Copy, Download, Maximize2, Package, Share2 } from '@lucide/astro';
import { currentShareURL } from '../../public/brand/page-share-url.mjs';
import { publicPageCanonical } from '../lib/public-pages.mjs';
import { artworkFiles, artworkRevision, type CatalogueArtwork } from '../lib/share-catalogue-asset.ts';
import { artworkPostBrief, artworkPostText } from '../lib/share-artwork-post.ts';
import { artworkCategories, artworkLabel } from '../lib/share-gallery.ts';
import { shareCalendarEntry } from '../lib/share-calendar-entry';
import '../styles/share-gallery.css';

interface Props { artwork: CatalogueArtwork; signedIn: boolean; tags: string[]; }
const { artwork, signedIn, tags } = Astro.props;
const path = `/share/artwork/${artwork.assetId}`;
const canonical = publicPageCanonical(path).href;
const [revision, shareUrl] = await Promise.all([
  artworkRevision(artwork),
  currentShareURL(canonical, artwork.title.includes('App Composer') ? artwork.title : `${artwork.title} · App Composer`, artwork.alt, artwork.previewUrl),
]);
const postText = artworkPostText(artwork, canonical);
const files = artworkFiles(artwork);
const primary = files[0].url;
const primaryDownloadLabel = artwork.original ? 'Download original' : 'Download preview';
const download = (index: number) => `/api/share-artwork-download?${new URLSearchParams({id: artwork.assetId, file: String(index), revision})}`;
const postTextFile = `${postText}\n\nImage alt text\n\n${artwork.alt}`;
const postTextDownload = `data:text/plain;charset=utf-8,${encodeURIComponent(postTextFile.toWellFormed())}`;
const postTextFileName = `${artwork.assetId}-post-text.txt`;
const postBrief = artworkPostBrief(artwork, canonical, new URL(download(0), canonical).href, revision);
const postBriefDownload = `data:application/json;charset=utf-8,${encodeURIComponent(JSON.stringify(postBrief, null, 2))}`;
const postBriefFileName = `${artwork.assetId}-post-brief.json`;
const primaryExtension = new URL(primary, canonical).pathname.split('.').at(-1)?.toLowerCase() || 'png';
// A reference fragment only: Studio reads the asset ID and revision to offer
// its own Image Tools handoff. Composer never fetches or uploads anything.
const studioToolsUrl = `https://media.loftwah.com/tools/images#${new URLSearchParams({'composer-artwork': artwork.assetId, revision})}`;
const shareCalendarHref = shareCalendarEntry(signedIn, { assetId: artwork.assetId, revision });
const packageData = JSON.stringify({
  assetId: artwork.assetId,
  revision,
  title: artwork.title,
  credit: artwork.credit,
  sourceUrl: artwork.sourceUrl,
  canonical,
  extension: primaryExtension,
  download: download(0),
  postTextFile,
  alt: artwork.alt,
});
---

<article class="gallery-piece" data-gallery-piece>
  <a class="gallery-stage" href={primary} target="_blank" rel="noreferrer" aria-label="Open full-size image in a new tab">
    <img src={artwork.previewUrl} alt={artwork.alt} decoding="async" referrerpolicy="no-referrer" />
    <span class="gallery-full-size"><Maximize2 size={15} aria-hidden="true" /> Full size</span>
  </a>
  <div class="gallery-details">
    <p class="gallery-piece-category"><a href={`/share?project=${artwork.project}`}>{artworkLabel(artwork.project)}</a> · <a href={`/share?category=${artwork.category}`}>{artworkCategories[artwork.category]}</a></p>
    <h1>{artwork.title}</h1>
    <p class="gallery-credit">{artwork.credit}</p>
    {artwork.description && <p class="gallery-description">{artwork.description}</p>}
    <div class="gallery-piece-actions">
      <a class="button gallery-file-action" href={download(0)} download><Download size={17} aria-hidden="true" /> {primaryDownloadLabel}</a>
      <button class="secondary" type="button" data-gallery-package={packageData} hidden><Package size={16} aria-hidden="true" /> Download post package (ZIP)</button>
      <a class="button secondary" href={path + '/palette'}>Pick colours</a>
      <button class="secondary" type="button" data-gallery-native={shareUrl} hidden><Share2 size={16} aria-hidden="true" /> Share</button>
      <button class="secondary" type="button" data-gallery-copy={shareUrl} hidden><Copy size={16} aria-hidden="true" /> Copy link</button>
      <button class="secondary" type="button" data-gallery-copy-post hidden><Copy size={16} aria-hidden="true" /> Copy post text</button>
    </div>
    <p role="status" data-gallery-copy-status></p>
    <p role="status" data-gallery-package-status></p>
    <input data-gallery-copy-fallback aria-label="Artwork link" readonly hidden />
    <textarea data-gallery-post-field aria-label="Post text to copy manually" rows="6" readonly hidden>{postText}</textarea>
    {files.length > 1 && (
      <details class="gallery-piece-section">
        <summary>Available formats</summary>
        <ul>{files.map((file, index) => (
          <li><a href={download(index)} download>{file.label} {file.width && file.height && <span>· {file.width} × {file.height}</span>} <ArrowUpRight size={14} aria-hidden="true" /></a></li>
        ))}</ul>
      </details>
    )}
    {artwork.versions.length > 0 && (
      <details class="gallery-piece-section">
        <summary>Earlier versions</summary>
        <ul>{artwork.versions.map(version => (
          <li><a href={version.url} target="_blank" rel="noreferrer">{version.label} <ArrowUpRight size={14} aria-hidden="true" /></a>
            {version.note && <p>{version.note}</p>}
            {version.sourceUrl && <a href={version.sourceUrl}>Source notes for {version.label}</a>}
          </li>
        ))}</ul>
      </details>
    )}
    {tags.length > 0 && (
      <ul class="gallery-tags" aria-label="Tags">
        {tags.map(tag => <li><a href={`/share?${new URLSearchParams({tag})}`}>{artworkLabel(tag)}</a></li>)}
      </ul>
    )}
    <details class="gallery-piece-section">
      <summary>Source and project kits</summary>
      <div class="gallery-piece-links">
        {artwork.projectUrl && <a href={artwork.projectUrl}>Visit project <ArrowUpRight size={14} /></a>}
        <a href={artwork.shareUrl}>Project share kit <ArrowUpRight size={14} /></a>
        {artwork.kitUrl && <a href={artwork.kitUrl}>Open social kit <ArrowUpRight size={14} /></a>}
        {artwork.sourceUrl && <a href={artwork.sourceUrl}>Source record <ArrowUpRight size={14} /></a>}
        {artwork.projectUrl && artwork.sourceUrl && (
          <a href={shareCalendarHref}>{signedIn ? 'Prepare in Share calendar' : 'Sign in to prepare in Share calendar'} <ArrowUpRight size={14} aria-hidden="true" /></a>
        )}
        <button class="secondary" type="button" data-gallery-copy-alt hidden><Copy size={16} aria-hidden="true" /> Copy image alt text</button>
        <a class="button secondary" href={postTextDownload} download={postTextFileName}><Download size={16} aria-hidden="true" /> Download post text (TXT)</a>
        <a class="button secondary" href={postBriefDownload} download={postBriefFileName}><Download size={16} aria-hidden="true" /> Download post brief (JSON)</a>
      </div>
      {(artwork.projectUrl && artwork.sourceUrl) && <p>Workspace owners can review the artwork before confirming reuse in Calendar.</p>}
      <p role="status" data-gallery-alt-status></p>
      <input data-gallery-alt-field aria-label="Image alt text to copy manually" value={artwork.alt} readonly hidden />
    </details>
    <details class="gallery-piece-section">
      <summary>Use in Media Studio</summary>
      <p><a href={postBriefDownload} download={postBriefFileName}>Download the draft post brief (JSON)</a> to include the caption and alt text in your social kit.</p>
      <p><a class="button gallery-file-action" href={studioToolsUrl}>Open in Studio Image Tools <ArrowUpRight size={16} aria-hidden="true" /></a></p>
      <p>Choose <strong>Load Composer artwork</strong>. Under <strong>Add post text</strong>, choose <strong>Fill from Composer post brief (JSON)</strong>. Review the text and reuse rights for your crop, then choose <strong>Make 4 social sizes</strong>.</p>
      <p>You can also work from a downloaded file.</p>
      <ol>
        <li><a href={download(0)} download>{primaryDownloadLabel}</a> to your device.</li>
        <li>In <a href="https://media.loftwah.com/tools/images">Image Tools</a>, add the file and choose <strong>Make 4 social sizes</strong>, then download the ZIP.</li>
        <li>Keep the <a href={postTextDownload} download={postTextFileName}>credited post text (TXT)</a> with your crops. It includes the artwork link and image alt text.</li>
      </ol>
      <p>Image Tools also resizes, crops and converts files in your browser. Check the source record before reusing the artwork.</p>
      <p>In your Studio project, choose <strong>Library → Import from Woodhouse Share</strong>, enter this asset ID and confirm you have permission to reuse the original.</p>
      <label>Share asset ID<input type="text" value={artwork.assetId} readonly data-studio-asset-id /></label>
      <button type="button" class="secondary" data-copy-studio-id hidden><Copy size={16} aria-hidden="true" /> Copy asset ID</button>
      <span role="status" data-studio-id-status></span>
      <a href="/media-studio/studio">Open Media Studio <ArrowUpRight size={14} /></a>
    </details>
    {signedIn ? (
      <details class="gallery-piece-section" data-artwork-review>
        <summary>Private feedback</summary>
        <form data-review-form data-asset-id={artwork.assetId} data-revision={revision}>
          <p>Only you can see your vote and note.</p>
          <fieldset disabled>
            <legend>Your vote</legend>
            <label><input type="radio" name="vote" value="up" required /> <span>Thumbs up</span></label>
            <label><input type="radio" name="vote" value="down" /> <span>Thumbs down</span></label>
          </fieldset>
          <label for={`note-${artwork.assetId}`}>Note <span>(optional)</span></label>
          <textarea id={`note-${artwork.assetId}`} name="note" maxlength="1000" rows="3" disabled></textarea>
          <div class="gallery-piece-actions">
            <button type="submit" disabled>Save feedback</button>
            <button type="button" class="secondary" data-review-remove hidden>Remove</button>
            <button type="button" class="secondary" data-review-retry hidden>Try again</button>
          </div>
          <p data-review-status role="status"></p>
        </form>
      </details>
    ) : (
      <p class="gallery-piece-section"><a href={`/_emdash/admin/login?${new URLSearchParams({redirect: path})}`}>Sign in to give private feedback</a></p>
    )}
  </div>
</article>
