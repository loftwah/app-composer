---
import { apps } from '../lib/apps';
import { Grid3x3, X, ArrowRight, Terminal, SlidersHorizontal, GitBranch, FileCheck, BookOpen, ChartNoAxesColumn } from '@lucide/astro';
// The Apps menu follows the shared launcher contract documented in
// src/browser/launcher.ts (styles in public/brand/launcher.css, linked once in
// the base layout). Only the Composer task list and the app catalogue are local.
---
<div class="app-launcher">
 <button type="button" class="secondary apps-trigger" data-open-apps aria-label="Open apps" title="Apps and shortcuts (Ctrl/Cmd+K)" aria-haspopup="dialog"><Grid3x3 size={20} aria-hidden="true"/><span>Apps</span><kbd>⌘K / Ctrl K</kbd></button>
 <dialog id="app-navigation" aria-labelledby="app-navigation-title">
  <div class="dialog-heading">
   <h2 id="app-navigation-title">Apps and shortcuts</h2>
   <button type="button" data-close-apps autofocus><X size={18} aria-hidden="true"/><span>Close</span></button>
  </div>
  <label>Find an app or task<input type="search" placeholder="App name, Get Ready, Init…" autocomplete="off"/></label>
  <p class="small" role="status" aria-live="polite"></p>
  <ul>
   <li data-destination><a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}><span class="task-icon"><Grid3x3 size={22} aria-hidden="true"/></span><span>App Composer<small>Application studio</small></span></a></li>
   {apps.map(app=><li data-destination><a href={app.href}><img class="app-thumbnail" src={app.thumbnail} width="40" height="40" alt="" loading="lazy"/><span>{app.name}<small>{app.category}</small></span></a></li>)}
   {[{name:"Follow-along tutorial",href:"/learn",icon:BookOpen},{name:"Get Ready",href:"/ready",icon:Terminal},{name:"Get Ready library and CLI",href:"/docs#standalone-get-ready",icon:Terminal},{name:"Init",href:"/init",icon:SlidersHorizontal},{name:"Content and form builder",href:"/init/content",icon:SlidersHorizontal},{name:"The whole platform",href:"/architecture",icon:BookOpen},{name:"CMS, cloud, commerce and email guide",href:"/guide",icon:BookOpen},{name:"Manage mini-apps (invited admin)",href:"/_emdash/admin/plugins/composer-miniapps/apps",icon:SlidersHorizontal},{name:"Decision Explorer",href:"/explore",icon:GitBranch},{name:"Review share report",href:"/review",icon:FileCheck},{name:"App activity",href:"/activity",icon:ChartNoAxesColumn},{name:"Documentation",href:"/docs",icon:BookOpen}].map(task=><li data-destination><a href={task.href}><span class="task-icon"><task.icon size={22} aria-hidden="true"/></span><span>{task.name}<small>Composer task</small></span></a></li>)}
  </ul>
  <a class="launcher-all" href="/apps">Browse all apps <ArrowRight size={18} aria-hidden="true"/></a>
 </dialog>
</div>
<script is:inline src="/brand/launcher.js" defer></script>
