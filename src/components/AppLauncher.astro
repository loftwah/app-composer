---
import { apps } from '../lib/apps';
import { Grid3x3, X, Search, ArrowRight, Terminal, SlidersHorizontal, GitBranch, FileCheck, BookOpen, ChartNoAxesColumn } from '@lucide/astro';
---
<div class="app-launcher">
 <button class="theme-toggle apps-trigger" popovertarget="apps-popover" aria-label="Open apps" title="Apps and shortcuts (Ctrl/Cmd+K)" aria-haspopup="dialog"><Grid3x3 size={20} aria-hidden="true"/><span>Apps</span></button>
 <div id="apps-popover" popover role="dialog" aria-label="App launcher">
  <div class="launcher-heading"><strong>Apps and shortcuts</strong><button class="theme-toggle" popovertarget="apps-popover" popovertargetaction="hide" aria-label="Close app launcher"><X size={18} aria-hidden="true"/><span>Close</span></button></div>
  <label class="launcher-search"><span class="icon-label"><Search size={16} aria-hidden="true"/>Find an app or task</span><input id="launcher-search" type="search" placeholder="App name, Get Ready, Init…" autocomplete="off"/></label>
  <p class="small" id="launcher-results" role="status" aria-live="polite"></p>
  <ul>{apps.map(app=><li data-launcher-entry data-search={`${app.name} ${app.category}`.toLowerCase()}><a href={app.href}><img class="app-thumbnail" src={app.thumbnail} width="48" height="48" alt="" loading="lazy"/><span>{app.name}<small>{app.category}</small></span></a></li>)}{[{name:"Get Ready",href:"/ready",icon:Terminal},{name:"Init",href:"/init",icon:SlidersHorizontal},{name:"Decision Explorer",href:"/explore",icon:GitBranch},{name:"Review share report",href:"/review",icon:FileCheck},{name:"App activity",href:"/activity",icon:ChartNoAxesColumn},{name:"Documentation",href:"/docs",icon:BookOpen}].map(task=><li data-launcher-entry data-search={task.name.toLowerCase()}><a href={task.href}><span class="task-icon"><task.icon size={22} aria-hidden="true"/></span><span>{task.name}<small>Composer task</small></span></a></li>)}</ul>
  <a class="launcher-all" href="/apps">Browse all apps <ArrowRight size={18} aria-hidden="true"/></a>
 </div>
</div>

<script>
const panel=document.querySelector<HTMLElement>('#apps-popover')!;const search=document.querySelector<HTMLInputElement>('#launcher-search')!;const entries=[...panel.querySelectorAll<HTMLElement>('[data-launcher-entry]')];
function fit(){const viewport=window.visualViewport,height=viewport?.height??window.innerHeight,top=window.innerWidth<=600||height<650?8:Math.min((document.querySelector('header')?.getBoundingClientRect().bottom??88)+8,160);panel.style.setProperty('--launcher-height',`${height}px`);panel.style.setProperty('--launcher-top',`${top}px`);panel.style.top=`${(viewport?.offsetTop??0)+top}px`;}window.visualViewport?.addEventListener('resize',fit);window.addEventListener('resize',fit);
function filter(){let count=0;for(const entry of entries){entry.hidden=!entry.dataset.search!.includes(search.value.trim().toLowerCase());if(!entry.hidden)count++;}document.querySelector('#launcher-results')!.textContent=count?`${count} destinations`:'No matches. Try an app name or task.';}
search.addEventListener('input',filter);panel.addEventListener('beforetoggle',event=>{if((event as ToggleEvent).newState==='open'){fit();search.value='';filter();}});panel.addEventListener('toggle',event=>{if((event as ToggleEvent).newState==='open')search.focus();});document.addEventListener('keydown',event=>{if((event.ctrlKey||event.metaKey)&&!event.altKey&&event.key.toLowerCase()==='k'){event.preventDefault();panel.togglePopover();}});search.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();event.stopPropagation();panel.hidePopover();document.querySelector<HTMLButtonElement>('.apps-trigger')?.focus();return;}if(event.key==='Enter'){const first=entries.find(entry=>!entry.hidden)?.querySelector<HTMLAnchorElement>('a');if(first){event.preventDefault();first.click();}}});
</script>
