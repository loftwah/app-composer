---
import Base from "./Base.astro";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    cover: string;
    coverAlt: string;
    published: string;
  };
}

const { title, description, cover, coverAlt, published } = Astro.props.frontmatter;
const publishedLabel = new Intl.DateTimeFormat("en-AU", { dateStyle: "long", timeZone: "UTC" }).format(new Date(published));
---

<Base title={title} description={description} shareImage={cover} shareAlt={coverAlt} shareWidth={1200} shareHeight={630} ogType="article">
  <meta slot="head" property="article:published_time" content={published} />
  <article class="field-note">
    <header>
      <a class="back" href="/articles">← Articles</a>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <time datetime={published}>{publishedLabel}</time>
    </header>
    <figure class="cover">
      <img src={cover} alt={coverAlt} width="1200" height="630" fetchpriority="high" />
      <figcaption>AI-generated editorial illustration for App Composer.</figcaption>
    </figure>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .field-note { max-width: 1040px; margin-inline: auto; }
  header, .prose { max-width: 68ch; margin-inline: auto; }
  header { padding-block: clamp(10px,4vw,42px) clamp(22px,4vw,42px); }
  .back { display: inline-flex; align-items: center; min-height: 44px; font-weight: 650; }
  h1 { font-size: clamp(2.25rem,5.8vw,4.25rem); line-height: 1.02; letter-spacing: -.045em; margin: .35em 0 .3em; text-wrap: balance; }
  .lead { font-size: clamp(1.03rem,2.2vw,1.3rem); line-height: 1.5; margin-top: 0; }
  time, figcaption { color: var(--color-muted); font-size: .875rem; }
  figure { margin: 0; }
  .cover img, .prose :global(figure img) { display: block; width: 100%; height: auto; border-radius: 8px; }
  .cover figcaption, .prose :global(figcaption) { margin-top: .6rem; line-height: 1.45; }
  .prose { margin-block: clamp(24px,5vw,52px); font-size: 1.05rem; line-height: 1.72; }
  .prose :global(h2) { margin: 1.6em 0 .48em; font-size: clamp(1.4rem,3vw,1.85rem); }
  .prose :global(figure) { margin: 1.65em 0; }
  .prose :global(figcaption) { color: var(--color-muted); font-size: .875rem; }
  .prose :global(:not(pre) > code) { overflow-wrap: anywhere; }
  .prose :global(pre) { max-width: 100%; overflow-x: auto; }
</style>
