---
import "../styles/global.css";
import "../styles/header.css";
import "../styles/prints-theme.css";
import instance from "../../config/instance.json";
import AppLauncher from "../components/AppLauncher.astro";
import BuilderContext from "../components/BuilderContext.astro";
import {agentSearchMetadata} from "../lib/public-agent-search.mjs";
import {noindexFor} from "../lib/indexing.mjs";
import {publicPageCanonical} from "../lib/public-pages.mjs";
import {spinBrandFiles, spinDiscovery, spinOrigin} from "../lib/spin-site.mjs";
import {printsIcon} from "../lib/prints-site.mjs";
import {siteShareArtwork, siteShareImageType} from "../lib/site-share-artwork.mjs";
interface Props {
  title: string;
  description: string;
  /** Full-width product presentation; operational pages keep the shared shell. */
  homePage?: boolean;
  noindex?: boolean;
  shareImage?: string;
  shareAlt?: string;
  shareType?: string;
  shareWidth?: number | null;
  ogType?: "website" | "article";
  shareHeight?: number | null;
  /** Clean canonical for a page whose address is not just its path. */
  canonical?: string;
  /** The launcher study mounts its own instance; the controller binds by ID. */
  launcher?: boolean;
  focusedExperience?: boolean;
  /** Dedicated Prints product hostname. */
  printsProduct?: boolean;
  spinProduct?: boolean;
}
const {
  title,
  description,
  noindex = noindexFor(Astro.url.hostname, (Astro.response.status ?? 200) < 400),
} = Astro.props;
const printsProduct = Astro.props.printsProduct === true;
const spinProduct = Astro.props.spinProduct === true;
const themeKey = spinProduct ? "spin-theme" : printsProduct ? "prints-theme" : "composer-theme";
const themeColors = printsProduct ? { light: "#faf6ef", dark: "#191613" }
  : { light: "#faf9f7", dark: "#17181b" };
const initialTheme = printsProduct || spinProduct ? "light" : "dark";
const printsNavigation = [
  { href: "/#paths", label: "Try it" },
  { href: "/watch", label: "Watch" },
  { href: "/#share-prints", label: "Share kit" },
  { href: "/#downloads", label: "Download", primary: true },
];
const composerNavigation = [
  { path: "/", label: "Home" },
  { path: "/learn", label: "Learn" },
  { path: "/demo", label: "Demos" },
  { path: "/share", label: "Share" },
  { path: "/media-studio", label: "Media Studio" },
  { path: "/projects", label: "Projects" },
];
const printsPagePath = Astro.url.pathname.replace(/^\/prints-desktop(?=\/|$)/, "");
const siteName = spinProduct ? spinDiscovery.name : printsProduct ? "Prints Desktop" : "App Composer";
const pageTitle = title.includes(siteName)
  ? title
  : title + " · " + siteName;
const canonical = Astro.props.canonical
  ? new URL(Astro.props.canonical)
  : publicPageCanonical(Astro.url.pathname);
const searchMetadata = !noindex && agentSearchMetadata(Astro.url.origin);
const focusedExperience = Astro.props.focusedExperience === true;
const artwork = siteShareArtwork(canonical.pathname);
const shareImage = new URL(Astro.props.shareImage ?? artwork.path, canonical);
const shareAlt = Astro.props.shareAlt ?? artwork.alt;
const shareType = (Astro.props.shareImage ? Astro.props.shareType : undefined) ?? siteShareImageType(shareImage.pathname);
const { shareWidth = 1200, shareHeight = 630 } = Astro.props;
Astro.response.headers.set("Cache-Control", "no-store");
// Cloudflare reads the SSR CSP header to nonce its own detection scripts.
// Keep Astro's generated hashes; never add nonces to untrusted page content.
Astro.csp?.insertScriptResource(
  `'nonce-${btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(16))))}'`,
);
---

<!doctype html>
<html lang="en" data-theme={initialTheme} data-theme-key={themeKey} data-product={spinProduct ? "spin" : printsProduct ? "prints" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <link rel="stylesheet" href="/brand/launcher.css" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!spinProduct || Astro.url.origin === spinOrigin) &&
      <link rel="manifest" href={spinProduct ? spinBrandFiles.manifest : printsProduct ? "/prints-desktop/site-20261125.webmanifest" : "/site.webmanifest"} />}
    <meta name="theme-color" content={themeColors[initialTheme]} data-light={themeColors.light} data-dark={themeColors.dark} />
    {spinProduct ? <>
      <link rel="icon" href={spinBrandFiles.faviconSmall} type="image/png" sizes="16x16" />
      <link rel="icon" href={spinBrandFiles.favicon} type="image/png" sizes="32x32" />
      <link rel="apple-touch-icon" href={spinBrandFiles.touch} sizes="180x180" />
    </> : printsProduct ? <>
      <link rel="icon" href="/prints-desktop/icons/aperture-16-20261125.png" type="image/png" sizes="16x16" />
      <link rel="icon" href={printsIcon} type="image/png" sizes="32x32" />
      <link rel="icon" href="/prints-desktop/icons/favicon-20261125.ico" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" />
      <link rel="apple-touch-icon" href="/prints-desktop/icons/aperture-180-20261125.png" />
    </> : <>
      <link rel="icon" href="/brand/composer-icon-tile-20261022b.svg" type="image/svg+xml" sizes="any" />
      <link rel="icon" href="/brand/favicon-20261022b.ico" sizes="any" />
      <link rel="icon" href="/brand/composer-icon-20261022b-16.png" type="image/png" sizes="16x16" />
      <link rel="icon" href="/brand/composer-icon-20261022b-32.png" type="image/png" sizes="32x32" />
      <link rel="icon" href="/brand/composer-icon-20261022b-48.png" type="image/png" sizes="48x48" />
      <link rel="icon" href="/brand/composer-icon-20261022b-96.png" type="image/png" sizes="96x96" />
      <link rel="apple-touch-icon" href="/brand/composer-icon-20261022b-180.png" sizes="180x180" />
    </>}
    <!-- Deliberate: /brand/space-latin-20261018.woff2 is the declared source of the one bundled
         face in global.css and the family every heading asks for, so the single
         early request is consumed. tests/font-preload.test.mjs locks the pairing. -->
    <link
      rel="preload"
      href="/brand/space-latin-20261018.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content={Astro.props.ogType ?? "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:type" content={shareType} />
    {shareWidth !== null && <meta property="og:image:width" content={String(shareWidth)} />}
    {shareHeight !== null && <meta property="og:image:height" content={String(shareHeight)} />}
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage.href} />
    <meta name="twitter:image:alt" content={shareAlt} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "max-image-preview:large"} />
    {searchMetadata && Object.entries(searchMetadata).map(([key, value]) => <meta name={`agent:${key}`} content={value} />)}
    <slot name="head" />
    <script is:inline src="/brand/theme-bootstrap.js?v=2"></script>
    <link rel="stylesheet" href="/brand/page-share.css" />
    <link rel="stylesheet" href="/brand/theme-control.css" />
  </head>
  <body class:list={{ "home-shell": Astro.props.homePage, "focused-experience": focusedExperience, "prints-product": printsProduct, "spin-experience": spinProduct }}>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      {spinProduct ? (
        <a class="brand spin-brand select-none" href={spinDiscovery.href}>
          <img src={spinBrandFiles.mark} width="38" height="38" alt="" />
          <span class="spin-brand-name">Spin.<span>by App Composer</span></span>
        </a>
      ) : printsProduct ? (
        <a class="brand select-none" href="/">
          <img src={printsIcon} width="32" height="32" alt="" />
          <span>Prints Desktop</span>
        </a>
      ) : focusedExperience ? (
        <a class="brand select-none" href="/">
          <img src="/brand/composer-icon-tile-20261022b.svg" width="24" height="24" alt="" />
          <span>App Composer</span>
        </a>
      ) : <a class="brand select-none" href="/">
        <img src="/brand/composer-icon-tile-20261022b.svg" width="38" height="38" alt="" />
        <span class="brand-copy">
          <span>App Composer</span>
          {instance.enabled && (
            <span class="instance-brand-context">{instance.owner}’s instance</span>
          )}
        </span>
      </a>}
      {printsProduct && <>
        <nav class="prints-nav" aria-label="Prints navigation">
          {printsNavigation.map(({ href, label, primary }) => (
            <a href={href} class:list={{"prints-download": primary}} aria-current={printsPagePath === href ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <details class="prints-menu">
          <summary>
            <span class="prints-menu-compact">Menu</span>
            <span class="prints-menu-wide">App Composer</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </summary>
          <div class="prints-menu-panel">
            <nav class="prints-menu-local" aria-label="Prints navigation">
              {printsNavigation.map(({ href, label, primary }) => (
                <a href={href} class:list={{"prints-download": primary}} aria-current={printsPagePath === href ? "page" : undefined}>{label}</a>
              ))}
            </nav>
            <nav class="prints-menu-composer" aria-label="App Composer">
              <p aria-hidden="true">App Composer</p>
              {composerNavigation.map(({ path, label }) => <a href={`https://composer.loftwah.com${path}`}>{label}</a>)}
            </nav>
          </div>
        </details>
      </>}
      {!printsProduct && !focusedExperience && <nav class="site-navigation" aria-label="Main navigation">
        <a class="nav-direct" href="/learn">Learn</a>
        <a class="nav-direct" href="/demo">Demos</a>
        <a class="nav-direct" href="/media-studio">Media Studio</a>
        <details class="site-menu">
          <summary aria-label="More navigation">
            <span class="menu-word">More</span>
            <svg class="menu-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            <svg class="menu-bars" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
          </summary>
          <div class="site-menu-panel">
            <div class="site-menu-quick compact-only">
              <a href="/learn">Learn</a>
              <a href="/demo">Demos</a>
              <a href="/media-studio">Media Studio</a>
            </div>
            <div class="site-menu-group">
              <p class="site-menu-heading">Build &amp; manage</p>
              <a href="/ready">Get Ready</a>
              <a href="/init">Create an app</a>
              <a href="/media-studio/studio">Media Studio</a>
              <a href="/me">Invited profile &amp; apps</a>
            </div>
            <div class="site-menu-group">
              <p class="site-menu-heading">Explore</p>
              <a href="/discover">Browse by task</a>
              <a href="/share">Share</a>
              <a href="/activity/portfolio">Analytics</a>
              <a href="/benchmarks">Benchmarks Studio</a>
              <a href="/projects">Other projects</a>
            </div>
            <div class="site-menu-resources">
              <a href="/resources">Runbooks &amp; resources</a>
              <a href="/docs">Documentation</a>
            </div>
          </div>
        </details>
      </nav>}
      <div class="header-utilities">
        {!printsProduct && !focusedExperience && Astro.props.launcher !== false && <AppLauncher />}
        <button
          type="button"
          class="theme-control secondary theme-toggle shrink-0"
          id="theme-toggle"
          aria-label="Dark theme"
          aria-pressed={initialTheme === "dark" ? "true" : "false"}
          title={initialTheme === "dark" ? "Switch to light theme" : "Switch to dark theme"}
        >
          <svg
            data-theme-glyph="dark"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
          </svg>
          <svg
            data-theme-glyph="light"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main">
      {!printsProduct && !focusedExperience && <BuilderContext />}
      <slot />
      <slot name="page-share" />
    </main>
    {printsProduct ? <footer class="prints-footer">
      <p>Prints Desktop by <a href="https://loftwah.com">Loftwah</a>.</p>
      <nav aria-label="Prints project links">
        <a href="/guide">Guide</a>
        <a href="/workshop-kit">Workshop kit</a>
        <a href="https://composer.loftwah.com/prints-desktop">App Composer showcase</a>
        <a href="https://github.com/loftwah/prints-desktop">Source and releases</a>
        <a href="https://composer.loftwah.com/privacy">Privacy</a>
      </nav>
    </footer> : focusedExperience ? <footer>
      {spinProduct && <a href="https://composer.loftwah.com/apps">App Composer library</a>}
      <a href={spinProduct ? "https://composer.loftwah.com/privacy" : "/privacy"}>Privacy</a>
    </footer> : <footer>
      {!noindex && !Astro.slots.has("page-share") && (
        <div class="public-page-share" data-page-share hidden>
          <button type="button" class="secondary" data-page-native hidden>
            Share page
          </button>
          <button type="button" class="secondary" data-page-copy hidden>
            Copy page link
          </button>
          <p role="status" aria-live="polite" data-share-status></p>
          <label data-share-fallback hidden>
            Published page URL
            <input readonly aria-label="Published page URL" />
          </label>
        </div>
      )}
      <p>
        {instance.enabled ? (
          <>
            This is <a href={instance.profile}>{instance.owner}’s</a> instance of
            App Composer. Product and source are shared; the apps, media and
            owner settings are {instance.owner}’s.
          </>
        ) : (
          <>
            Made by <a href="https://loftwah.com">Loftwah</a>. Operated by
            agents, directed by you.
          </>
        )}
      </p>
      <p>
        <a href="https://github.com/loftwah/app-composer">Source</a> ·{" "}
        <a href="/guide">Platform &amp; service guide</a> ·{" "}
        <a href="/pitch">Technical pitch</a> ·{" "}
        <a href="/activity/portfolio">Analytics</a> · <a href="/privacy">Privacy</a> ·{" "}
        <a href="/release">Release evidence</a>
      </p>
    </footer>}
    <script>
      const toggle =
        document.querySelector<HTMLButtonElement>("#theme-toggle")!;
      const root = document.documentElement;
      const themeMeta = document.querySelector<HTMLMetaElement>("meta[name=theme-color]");
      function label() {
        const dark = root.dataset.theme !== "light";
        toggle.setAttribute("aria-pressed", String(dark));
        toggle.title = dark ? "Switch to light theme" : "Switch to dark theme";
      }
      label();
      toggle.addEventListener("click", () => {
        const theme = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = theme;
        if (themeMeta?.dataset[theme]) themeMeta.content = themeMeta.dataset[theme];
        try {
          if (root.dataset.themeKey) localStorage.setItem(root.dataset.themeKey, theme);
        } catch {}
        label();
      });
      const siteMenu = document.querySelector<HTMLDetailsElement>(".site-menu, .prints-menu");
      if (siteMenu) {
        const menuSummary = siteMenu.querySelector("summary")!;
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && siteMenu.open) {
            siteMenu.open = false;
            menuSummary.focus();
          }
        });
        document.addEventListener("click", (event) => {
          if (event.target instanceof Node && !siteMenu.contains(event.target)) {
            siteMenu.open = false;
          }
        });
        siteMenu.addEventListener("focusout", (event) => {
          if (event.relatedTarget instanceof Node && !siteMenu.contains(event.relatedTarget)) {
            siteMenu.open = false;
          }
        });
        if (siteMenu.classList.contains("prints-menu")) {
          siteMenu.addEventListener("click", (event) => {
            if (event.target instanceof Element && event.target.closest("a")) siteMenu.open = false;
          });
        }
        document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Main navigation"] a').forEach((a) => {
          if (a.pathname === location.pathname)
            a.setAttribute("aria-current", "page");
        });
      }
    </script>
    <script is:inline type="module" src="/brand/page-performance.mjs"></script>
    <script is:inline type="module" src="/brand/page-share.mjs"></script>
  </body>
</html>

<style>
  .site-header .spin-brand { display: inline-flex; gap: 9px; flex-wrap: nowrap; }
  .site-header .spin-brand > img { width: 38px; height: 38px; border-radius: 0; }
  .spin-brand-name { display: flex; align-items: baseline; flex-wrap: wrap; gap: 3px 10px; font: 700 1.55rem/.95 Space, sans-serif; letter-spacing: -.035em; }
  .spin-brand-name span { color: var(--color-muted); font: 650 .76rem/1.2 system-ui, sans-serif; letter-spacing: 0; }
  .focused-experience .site-header {
    grid-template-columns: minmax(0, 1fr) auto;
    min-height: 56px;
    padding: 6px max(18px, calc((100% - 1024px) / 2));
  }
  .spin-experience .site-header { padding-inline: max(18px, calc((100% - 1100px) / 2)); }
  .spin-brand > img { border-radius: 9px; }
  .focused-experience .site-header .brand { min-height: 44px; font-size: .88rem; font-weight: 650; }
  .focused-experience .site-header .brand:not(.spin-brand) > img { width: 24px; height: 24px; }
  .focused-experience #main { padding-block-start: .65rem; }
  .prints-product .site-header {
    position: relative;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    gap: 0 clamp(6px, 1.4vw, 20px);
    min-height: 64px;
    padding-block: 9px;
  }
  .prints-product .site-header .brand {
    gap: 8px;
    min-height: 44px;
    width: fit-content;
    font-size: 1.22rem;
    white-space: nowrap;
  }
  .prints-product .site-header .brand > img { width: 32px; height: 32px; }
  .prints-nav { align-items: center; flex-wrap: nowrap; gap: 5px; }
  .prints-nav a,
  .prints-menu-panel a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 6px;
    color: var(--color-foreground);
    white-space: nowrap;
  }
  .prints-nav :is(a:hover, a[aria-current="page"]),
  .prints-menu-panel :is(a:hover, a[aria-current="page"]),
  .prints-menu summary:hover,
  .prints-menu[open] summary { background: var(--color-surface); }
  .prints-nav .prints-download,
  .prints-menu-panel .prints-download {
    background: var(--color-action);
    color: var(--color-on-action);
    font-weight: 700;
  }
  .prints-nav .prints-download:hover,
  .prints-menu-panel .prints-download:hover {
    background: var(--color-action-hover);
    color: var(--color-on-action);
  }
  .prints-footer { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 4px 20px; }
  .prints-footer p { margin: 0; }
  .prints-footer nav a { display: inline-flex; align-items: center; min-height: 44px; }
  .prints-menu { position: relative; margin: 0; }
  .prints-menu summary {
    display: flex;
    align-items: center;
    gap: 5px;
    min-height: 44px;
    padding: 0 9px;
    border-radius: 6px;
    color: var(--color-foreground);
    font-size: .875rem;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .prints-menu summary::-webkit-details-marker { display: none; }
  .prints-menu[open] summary svg { transform: rotate(180deg); }
  .prints-menu-panel {
    position: absolute;
    inset: calc(100% + 8px) 0 auto auto;
    z-index: 8;
    width: 268px;
    max-height: calc(100dvh - 86px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: var(--color-background);
    box-shadow: 0 12px 26px #26140426;
  }
  .prints-menu-composer {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 4px;
  }
  .prints-menu-composer p {
    grid-column: 1 / -1;
    margin: 3px 12px 2px;
    color: var(--color-muted);
    font-size: .8125rem;
    font-weight: 650;
  }
  .prints-product .site-header :is(summary, a):focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }
  .prints-menu-compact, .prints-menu-local { display: none; }

  @media (max-width: 760px) {
    .prints-product .site-header {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 0 4px;
      min-height: 58px;
      padding-block: 6px;
      padding-inline: clamp(12px, 4vw, 24px);
    }
    .prints-product .site-header .brand { font-size: clamp(1rem, 4.7vw, 1.13rem); }
    .prints-product .site-header .brand > img { width: 28px; height: 28px; }
    .prints-product #main { padding-block-start: 23px; }
    .prints-nav, .prints-menu-wide { display: none; }
    .prints-menu { position: static; }
    .prints-menu summary { border: 1px solid var(--color-border); }
    .prints-menu-compact { display: block; }
    .prints-menu-panel {
      inset-block-start: calc(100% + 5px);
      inset-inline-end: clamp(12px, 4vw, 24px);
      width: min(354px, calc(100% - 2 * clamp(12px, 4vw, 24px)));
      padding: 10px;
    }
    .prints-menu-local {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      margin-bottom: 9px;
    }
    .prints-menu-local a { background: var(--color-surface); font-weight: 700; }
    .prints-menu-local :is(a:hover, a[aria-current="page"]) { background: var(--color-selected); }
    .prints-menu-local .prints-download { justify-content: center; }
    .prints-menu-composer { border-top: 1px solid var(--color-border); padding-top: 6px; }
  }

</style>
