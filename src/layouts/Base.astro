---
import '../styles/global.css';
import instance from '../../config/instance.json';
import AppLauncher from '../components/AppLauncher.astro';
import { Sun, Moon } from '@lucide/astro';
interface Props {title:string;description:string;noindex?:boolean;shareImage?:string;shareAlt?:string}
const {title,description,noindex=Astro.url.hostname.includes('workers.dev')}=Astro.props;
const pageTitle=title.includes('App Composer')?title:title+' · App Composer';
const canonical=new URL(Astro.url.pathname,'https://composer.loftwah.com');
const shareImage=Astro.props.shareImage??'https://composer.loftwah.com/brand/share-composer-20261014-v2.jpg';
const shareAlt=Astro.props.shareAlt??'App Composer: From setup to software. Built for Cloudflare and EmDash. Illustrated form, photo and collection connected by an orange route.';
Astro.response.headers.set('Cache-Control','no-store');
// Cloudflare reads the SSR CSP header to nonce its own detection scripts.
// Keep Astro's generated hashes; never add nonces to untrusted page content.
Astro.csp?.insertScriptResource(`'nonce-${btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(16))))}'`);
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#17181b"/><link rel="icon" href="/brand/mark.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/brand/icon.png"/><link rel="preload" href="/brand/space.woff2" as="font" type="font/woff2" crossorigin/><meta property="og:type" content="website"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={shareImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={shareAlt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={shareImage}/><meta name="twitter:image:alt" content={shareAlt}/><meta property="og:image:type" content="image/jpeg"/>{noindex&&<meta name="robots" content="noindex,nofollow"/>}<script is:inline src="/brand/theme-bootstrap.js"></script><link rel="stylesheet" href="/brand/page-share.css"/></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand select-none" href="/"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M5 7h22v22H5z" fill="none" stroke="#252923" stroke-width="4"/><path d="M15 17h20v19H15z" fill="#f4f0e8" stroke="#d95022" stroke-width="4"/><path d="M15 17v12h12" stroke="#252923" stroke-width="4" fill="none"/></svg>App Composer{instance.enabled&&<span class="instance-brand-context">{instance.owner}’s workspace</span>}</a><nav aria-label="Main navigation">{instance.enabled?<><a href="/apps">My apps</a><a href={instance.profile}>My profile</a><a href="/guestbook/">Guestbook</a><a href="/init">Build</a></>:<><a href="/learn">Learn</a><a href="/ready">Get Ready</a><a href="/init">Init</a><a href="/demo">Connected apps</a><a href="/explore">Explore</a><a href="/architecture">How it works</a></>}<AppLauncher/><button class="theme-toggle shrink-0" id="theme-toggle" aria-label="Switch colour theme"><Sun class="theme-sun" size={18} aria-hidden="true"/><Moon class="theme-moon" size={18} aria-hidden="true"/><span data-theme-label>Light mode</span></button></nav></header><main id="main"><slot/></main><footer>{!noindex&&<div class="public-page-share" data-page-share hidden><button type="button" class="secondary" data-page-native hidden>Share page</button><button type="button" class="secondary" data-page-copy hidden>Copy page link</button><p role="status" aria-live="polite" data-share-status></p><label data-share-fallback hidden>Published page URL<input readonly aria-label="Published page URL"></label></div>}<p>{instance.enabled?<>This is <a href={instance.profile}>{instance.owner}’s</a> App Composer. Built and run here.</>:<>Made by <a href="https://loftwah.com">Loftwah</a>. Operated by agents, directed by you.</>}</p><p><a href="https://github.com/loftwah/app-composer">Source</a> · <a href="/guide">Platform &amp; service guide</a> · <a href="/activity">App activity</a> · <a href="/privacy">Privacy</a> · <a href="/release">Release evidence</a><br/>Reviewed 14 October 2026</p></footer><script>const toggle=document.querySelector<HTMLButtonElement>("#theme-toggle")!;function label(){toggle.querySelector("[data-theme-label]")!.textContent=document.documentElement.dataset.theme==="light"?"Dark mode":"Light mode";}label();toggle.addEventListener("click",()=>{const theme=document.documentElement.dataset.theme==="light"?"dark":"light";document.documentElement.dataset.theme=theme;document.querySelector("meta[name=theme-color]")?.setAttribute("content",theme==="dark"?"#17181b":"#faf9f7");try{localStorage.setItem("composer-theme",theme);}catch{}label();});document.querySelectorAll<HTMLAnchorElement>("nav a").forEach(a=>{if(a.pathname===location.pathname)a.setAttribute("aria-current","page");});</script><script is:inline type="module" src="/brand/page-performance.mjs"></script><script is:inline type="module" src="/brand/page-share.mjs"></script></body></html>
