---
import '../styles/global.css';
interface Props {title:string;description:string;noindex?:boolean}
const {title,description,noindex=Astro.url.hostname.includes('workers.dev')}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://composer.loftwah.com');
Astro.response.headers.set('Cache-Control','no-store');
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · App Composer</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#17181b"/><link rel="icon" href="/brand/mark.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/brand/icon.png"/><link rel="preload" href="/brand/space.woff2" as="font" type="font/woff2" crossorigin/><meta property="og:type" content="website"/><meta property="og:title" content={title+' · App Composer'}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://composer.loftwah.com/brand/share.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="App Composer. Build with apps you own. Original composition artwork."/><meta name="twitter:card" content="summary_large_image"/>{noindex&&<meta name="robots" content="noindex,nofollow"/>}<script is:inline>try{const theme=localStorage.getItem("composer-theme");if(theme==="light"){document.documentElement.dataset.theme="light";document.querySelector("meta[name=theme-color]")?.setAttribute("content","#faf9f7");}}catch{}</script></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand select-none" href="/"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M5 7h22v22H5z" fill="none" stroke="#252923" stroke-width="4"/><path d="M15 17h20v19H15z" fill="#f4f0e8" stroke="#d95022" stroke-width="4"/><path d="M15 17v12h12" stroke="#252923" stroke-width="4" fill="none"/></svg>App Composer</a><nav aria-label="Main navigation"><a href="/ready">Get Ready</a><a href="/init">Init</a><a href="/demo">Live apps</a><a href="/explore">Explore</a><a href="/docs">How it works</a><button class="theme-toggle shrink-0" id="theme-toggle" aria-label="Switch colour theme">Light mode</button></nav></header><main id="main"><slot/></main><footer><p>Made by <a href="https://loftwah.com">Loftwah</a>. Operated by agents, directed by you.</p><p><a href="https://github.com/loftwah/app-composer">Source</a> · <a href="/privacy">Privacy</a> · <a href="/release">Release evidence</a><br/>Reviewed 13 October 2026</p></footer><script>const toggle=document.querySelector<HTMLButtonElement>("#theme-toggle")!;function label(){toggle.textContent=document.documentElement.dataset.theme==="light"?"Dark mode":"Light mode";}label();toggle.addEventListener("click",()=>{const theme=document.documentElement.dataset.theme==="light"?"dark":"light";document.documentElement.dataset.theme=theme;document.querySelector("meta[name=theme-color]")?.setAttribute("content",theme==="dark"?"#17181b":"#faf9f7");try{localStorage.setItem("composer-theme",theme);}catch{}label();});document.querySelectorAll<HTMLAnchorElement>("nav a").forEach(a=>{if(a.pathname===location.pathname)a.setAttribute("aria-current","page");});</script></body></html>
