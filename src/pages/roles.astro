---
import Base from '../layouts/Base.astro';
import { rolePacks, rolePackReviewed, rolePackSuite } from '../lib/role-packs';
import { rolePackExample } from '../lib/role-packs-example';
import evaluation from '../../labs/fresh-agent/results-20261025.json';

const edition = rolePackSuite.replace('composer.role-packs/', 'edition ');
const negativeTests = rolePacks.reduce((sum, pack) => sum + pack.negativeTests.length, 0);
const { workspace, application, service, environment } = rolePackExample;
const trialCount = evaluation.cases.length;
const evaluationHref = 'https://github.com/loftwah/app-composer/blob/codex/lane-g-evaluation-20261025/docs/evaluations/fresh-agent-20261025.md';
---
<Base
  title="Agent role packs"
  description="Six versioned job contracts for a local agent: service owner, programmer, architect, DevOps/SRE, security and QA. Inputs, evidence, output, stop rules, negative tests and a shared fictional bundle."
  canonical="https://composer.loftwah.com/roles"
>
  <div class="role-hub">
    <section class="hub-opening">
      <p class="hub-kicker">Agent role packs · {edition} · reviewed {rolePackReviewed}</p>
      <h1>Six jobs.<br />One evidence bundle.</h1>
      <p class="lede">
        A role pack is a versioned job contract for an owner’s local agent. Each one names the inputs it needs,
        the evidence it must cite, the result it returns and the point where it stops.
      </p>
      <div class="hub-actions">
        <a class="button" href="/roles/v1/role-packs.zip" download>Download all six <span>ZIP · Markdown, prompts, examples</span></a>
        <a href="#run">Run a brief on your machine</a>
        <a href="/prompts">Start from a prompt</a>
      </div>
      <dl class="hub-proof">
        <div><dt>Fresh-agent runs</dt><dd>{trialCount}</dd></div>
        <div><dt>Assertions passed</dt><dd>{evaluation.totals.passed} of {evaluation.totals.total}</dd></div>
        <div><dt>Human interventions</dt><dd>{evaluation.humanInterventions}</dd></div>
      </dl>
      <p class="hub-proof-note">Two packs run end to end and one unsafe bundle refused, on {evaluation.observedDate}. Same-model local runs; not cross-client or provider-onboarding proof.</p>
      <p class="hub-proof-links"><a href={evaluationHref}>Read the evaluation</a><a href="/setup">Start from a project guide</a></p>
    </section>

    <nav class="role-rows" aria-label="Choose a role pack">
      {rolePacks.map((pack) => (
        <a class="role-row" href={`/roles/${pack.id}`}>
          <span class="row-number" aria-hidden="true">{pack.number}</span>
          <span class="row-name"><strong>{pack.label}</strong><small>v{pack.version}</small></span>
          <span class="row-job">{pack.title}<small>{pack.purpose}</small></span>
          <span class="row-output"><span>Returns</span>{pack.output.slice(0, 2).map((field) => field.name).join(' · ')}</span>
          <span class="row-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>

    <section class="hub-bundle" id="bundle" aria-labelledby="bundle-title">
      <div class="bundle-copy">
        <p class="hub-kicker">The shared bundle</p>
        <h2 id="bundle-title">The same facts. Six different jobs.</h2>
        <p>
          Every shipped pack runs against one fictional stack, so the service review, defect patch, decision record,
          drift report, security finding and QA verdict can be compared without changing the evidence underneath them.
        </p>
        <p class="bundle-links">
          <a href="/roles/v1/examples/fictional-trail-notes.json" download>Download the bundle</a>
          <a href="/roles/v1/examples/README.md" download>Read the refusal fixtures</a>
        </p>
      </div>
      <dl class="bundle-facts">
        <div><dt>Workspace</dt><dd>{workspace.name}<small>{workspace.owner.name}, accountable owner{workspace.owner.fallback ? ` · ${workspace.owner.fallback} fallback` : ''}</small></dd></div>
        <div><dt>Application</dt><dd>{application.name}<small>{application.source} · {application.release}</small></dd></div>
        <div><dt>Service</dt><dd>{service.name}<small>{service.owner.name}, service owner · {service.kind} · {service.account}</small></dd></div>
        <div><dt>Environment</dt><dd>{environment.kind} / {environment.target}<small>{rolePackExample.evidence.length} evidence items · {rolePackExample.gates?.length ?? 0} gates · {rolePackExample.dependencies.length} dependency edges</small></dd></div>
      </dl>
    </section>

    <section class="hub-run" id="run" aria-labelledby="run-title">
      <div>
        <p class="hub-kicker">Executable, not decorative</p>
        <h2 id="run-title">A brief, or a refusal.</h2>
        <p>
          The runner validates the pack, checks ownership, environment, freshness, secret-like values and self-approval,
          then assembles a role-specific brief. Unsafe input is refused before a brief exists.
        </p>
        <p class="small">{negativeTests} negative tests ship with the six packs. The project’s own test suite runs every pack against this bundle.</p>
      </div>
      <div class="run-panel">
        <pre tabindex="0"><code>node scripts/roles.mjs check

node scripts/roles.mjs brief \
  --role qa \
  --input examples/role-packs/fictional-trail-notes.json</code></pre>
        <table>
          <caption>Exit status</caption>
          <tbody>
            <tr><th scope="row">0</th><td>Brief emitted, no blocking stop.</td></tr>
            <tr><th scope="row">2</th><td>Input refused with a named human action.</td></tr>
            <tr><th scope="row">3</th><td>Brief emitted with a blocking stop.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="hub-contract" aria-labelledby="contract-title">
      <h2 id="contract-title">What every pack refuses</h2>
      <ol>
        <li><strong>Self-approval.</strong> The agent cannot approve its own release, patch, exception or verdict. A separate accountable human accepts.</li>
        <li><strong>Privilege escalation.</strong> No pack grants access, changes an owner, deploys, merges, spends, sends or rotates a credential.</li>
        <li><strong>Invented facts.</strong> Missing owner, service, edge, health or cost stays missing or unknown; it is not filled from a name or a guess.</li>
        <li><strong>Unsafe evidence.</strong> Secret-like values, production targets for patch/test work and stale telemetry are refused with the human step that resolves them.</li>
      </ol>
    </section>

    <p class="hub-provenance">
      Pack proposals only. The accountable owner decides; native EmDash acceptance, connected-agent authentication and
      production execution remain separate gates. Source links: <a href="https://github.com/loftwah/app-composer/issues/315">role packs #315</a>,
      <a href="https://github.com/loftwah/app-composer/issues/311">local agent handoff #311</a>,
      <a href="https://github.com/loftwah/app-composer/issues/314">service ownership #314</a>.
      <a href="/resources">Operating runbooks</a> remain a separate, broader kit.
    </p>
  </div>
</Base>

<style>
  .role-hub { min-width: 0; }
  .hub-opening { display: block; padding: 0 0 36px; border-bottom: 1px solid var(--color-border); }
  .hub-kicker { margin: 0 0 16px; font-size: .8rem; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; color: var(--color-accent); }
  .hub-opening h1 { font-size: clamp(3rem, 5vw, 4.7rem); margin: 0 0 20px; max-width: 20ch; }
  .hub-opening .lede { font-size: 1.2rem; max-width: 56ch; margin: 0; }
  .hub-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 26px; margin-top: 28px; }
  .hub-actions .button { gap: 2px; flex-direction: column; align-items: flex-start; padding-block: 10px; }
  .hub-actions .button span { font-size: .74rem; font-weight: 500; opacity: .9; }
  .hub-actions > a:not(.button) { min-height: 44px; display: inline-flex; align-items: center; font-size: .9rem; }
  .hub-proof { display: flex; flex-wrap: wrap; gap: 10px 44px; margin: 26px 0 0; padding-top: 20px; border-top: 1px solid var(--color-border); }
  .hub-proof dt { color: var(--color-muted); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .hub-proof dd { margin: 4px 0 0; font-family: Space, sans-serif; font-size: 1.02rem; font-variant-numeric: tabular-nums; }
  .hub-proof-note { margin: 14px 0 0; font-size: .8rem; line-height: 1.6; color: var(--color-muted); max-width: 62ch; }
  .hub-proof-links { display: flex; flex-wrap: wrap; gap: 4px 24px; margin: 4px 0 0; font-size: .84rem; }
  .hub-proof-links a { display: inline-flex; align-items: center; min-height: 44px; }
  .role-rows { display: block; border-bottom: 1px solid var(--color-border); }
  .role-row { display: grid; grid-template-columns: 46px minmax(130px, .7fr) minmax(0, 1.6fr) minmax(150px, .8fr) 24px; gap: 22px; align-items: start; padding: 22px 8px; border-top: 1px solid var(--color-border); color: var(--color-foreground); }
  .role-row:first-child { border-top: 0; }
  .role-row:hover, .role-row:focus-visible { background: var(--color-surface); color: var(--color-foreground); }
  .row-number { color: var(--color-accent); font-family: Space, sans-serif; font-size: 1.05rem; font-variant-numeric: tabular-nums; padding-top: 2px; }
  .row-name strong { display: block; font-family: Space, sans-serif; font-size: 1.18rem; font-weight: 550; letter-spacing: -.02em; }
  .row-name small { display: block; margin-top: 4px; color: var(--color-muted); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .row-job { font-size: .95rem; line-height: 1.45; }
  .row-job small { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 7px; color: var(--color-muted); font-size: .85rem; line-height: 1.55; }
  .row-output { color: var(--color-muted); font-size: .8rem; line-height: 1.5; }
  .row-output span { display: block; color: var(--color-foreground); font-size: .7rem; font-weight: 650; letter-spacing: .05em; text-transform: uppercase; margin-bottom: 4px; }
  .row-arrow { color: var(--color-accent); font-size: 1.15rem; padding-top: 2px; }
  .hub-bundle { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 48px; padding: 52px 0; border-bottom: 1px solid var(--color-border); }
  .hub-bundle h2, .hub-run h2, .hub-contract h2 { font-size: clamp(1.7rem, 2.8vw, 2.35rem); max-width: 20ch; }
  .bundle-copy p { max-width: 52ch; }
  .bundle-links { display: flex; flex-wrap: wrap; gap: 6px 24px; margin-top: 22px; }
  .bundle-links a { min-height: 44px; display: inline-flex; align-items: center; font-size: .88rem; }
  .bundle-facts { margin: 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--color-border); }
  .bundle-facts > div { padding: 18px 18px 18px 0; border-bottom: 1px solid var(--color-border); }
  .bundle-facts > div:nth-child(odd) { border-right: 1px solid var(--color-border); }
  .bundle-facts > div:nth-child(even) { padding-left: 18px; }
  .bundle-facts dt { color: var(--color-muted); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .bundle-facts dd { margin: 6px 0 0; font-family: Space, sans-serif; font-size: 1rem; line-height: 1.35; }
  .bundle-facts dd small { display: block; font-family: system-ui, sans-serif; font-size: .76rem; color: var(--color-muted); margin-top: 6px; overflow-wrap: anywhere; }
  .hub-run { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 48px; padding: 52px 0; border-bottom: 1px solid var(--color-border); }
  .run-panel pre { margin: 0; font-size: .82rem; }
  .run-panel table { margin-top: 20px; }
  .run-panel caption { text-align: left; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: var(--color-muted); padding-bottom: 8px; }
  .run-panel th { width: 46px; color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .hub-contract { padding: 48px 0 20px; }
  .hub-contract ol { max-width: none; display: grid; grid-template-columns: 1fr 1fr; gap: 22px 40px; padding-left: 22px; margin-top: 24px; }
  .hub-contract li { padding-left: 4px; }
  .hub-contract li::marker { color: var(--color-accent); font-weight: 650; }
  .hub-contract strong { display: block; font-family: Space, sans-serif; font-size: 1.08rem; font-weight: 550; margin-bottom: 5px; }
  .hub-contract li { color: var(--color-muted); font-size: .92rem; line-height: 1.6; }
  .hub-provenance { margin: 36px 0 0; padding-top: 20px; border-top: 1px solid var(--color-border); font-size: .86rem; color: var(--color-muted); }
  @media (max-width: 1000px) {
    .role-row { grid-template-columns: 38px minmax(120px, .8fr) minmax(0, 1.6fr) 20px; gap: 16px; }
    .row-output { display: none; }
    .hub-bundle, .hub-run { gap: 28px; }
  }
  @media (max-width: 760px) {
    .role-row { grid-template-columns: 32px minmax(0, 1fr) 20px; gap: 4px 12px; padding: 18px 4px; }
    .row-number { grid-row: 1 / 3; }
    .row-name { grid-column: 2; }
    .row-name strong { font-size: 1.05rem; }
    .row-job { grid-column: 2 / 4; font-size: .9rem; }
    .row-job small { display: block; overflow: visible; }
    .row-arrow { grid-column: 3; grid-row: 1; justify-self: end; }
    .row-output { display: none; }
    .hub-bundle, .hub-run { grid-template-columns: 1fr; gap: 24px; padding: 40px 0; }
    .bundle-facts { margin-top: 4px; grid-template-columns: 1fr; }
    .bundle-facts > div:nth-child(odd) { border-right: 0; }
    .bundle-facts > div:nth-child(even) { padding-left: 0; }
    .bundle-facts > div { padding: 14px 0; }
    .run-panel pre { font-size: .72rem; }
    .hub-contract ol { grid-template-columns: 1fr; gap: 18px; }
    .hub-opening h1 { font-size: 3rem; }
    .hub-actions { flex-direction: column; align-items: stretch; gap: 8px; }
    .hub-actions .button { width: 100%; justify-content: space-between; }
  }
</style>
