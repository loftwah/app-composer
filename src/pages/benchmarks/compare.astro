---
import Base from '../../layouts/Base.astro';
import {
  blindView,
  DEFAULT_REVIEWER_LABEL,
  getRunRecord,
  isMediaRecord,
  renderBlindPairGrid,
} from '../../lib/benchmark-runs.ts';

const requested = Astro.url.searchParams.get('run');
const found = getRunRecord(requested ?? undefined);
if (found && isMediaRecord(found.record))
  return Astro.redirect(`/benchmarks/media?run=${encodeURIComponent(found.id)}`);
if (requested && !found) Astro.response.status = 404;
if (!found) Astro.response.status = 404;
const view = found ? blindView(found.record) : null;
const grid = view ? renderBlindPairGrid(view) : '';
const task = found?.record.task ?? {};
const source = typeof found?.record.sourceVersion === 'string' ? found.record.sourceVersion : null;
const short = source ? source.slice(0, 7) : 'unrecorded';
const recordedAt = view?.recordedAt
  ? `${view.recordedAt.slice(0, 16).replace('T', ' ')} UTC`
  : 'unknown';
---

<Base
  title="Benchmarks Studio · blind comparison"
  description="One frozen brief, nine recorded takes, nine pairs. The configuration and model labels stay hidden until you record a choice on the server; revealing without choosing is recorded as unblinded."
>
  {!found || !view
    ? (
      <section class="cmp-missing" role="status">
        <p class="eyebrow">Benchmarks Studio · comparison</p>
        <h1>That run is not recorded here.</h1>
        <p>The comparison is opened from a committed run record. The address may be incomplete, or the run was never committed.</p>
        <p><a class="button" href="/benchmarks/compare">Open the current blind comparison</a></p>
        <p><a href="/benchmarks">See the sandbox checks</a> · <a href="/benchmarks/comparisons">Read the Studio job receipts</a></p>
      </section>
    )
    : (
      <>
        <div class="cmp-heading" data-blind-review data-run={view.runId} data-task={String(task.id ?? '')}>
          <p class="eyebrow">Benchmarks Studio · blind comparison</p>
          <h1>Judge the work before you know who made it.</h1>
          <p class="lede">
            One frozen brief, passed unchanged to every recorded configuration, three times each. The labels, model ids
            and judge results stay hidden until you record a choice. The choice is written to the server record, not to
            this browser, so it survives a reload and survives this device.
          </p>
          <dl class="cmp-meta">
            <div><dt>Task</dt><dd>{String(task.title ?? 'unknown')} <span class="small">v{String(task.version ?? '?')}</span></dd></div>
            <div><dt>Brief hash</dt><dd><code>{String(task.briefSha256 ?? 'unknown').slice(0, 22)}…</code></dd></div>
            <div><dt>Recorded</dt><dd>{recordedAt}</dd></div>
            <div><dt>Source</dt><dd>
              {source
                ? <code>{short}</code>
                : <span>unrecorded</span>}
              <span class="small"> · link on the run record</span>
            </dd></div>
            <div><dt>Sample</dt><dd>{view.sample.configurations} configurations · {view.sample.trials} takes · {view.sample.pairs} pairs</dd></div>
          </dl>
          <p class="cmp-claim">
            A preference recorded here is one unauthenticated label's judgement of these recorded takes. It is not a
            model leaderboard, a provider invoice, a deployment claim or proof of the owner's judgement.
          </p>
        </div>

        <section class="cmp-section" aria-labelledby="how-title">
          <h2 id="how-title">How the blind reveal works</h2>
          <ol class="cmp-steps">
            <li>Open both takes in a pair. The previews are the committed pages, mounted from an opaque route.</li>
            <li>Choose <strong>A is better</strong>, <strong>B is better</strong>, <strong>Tie</strong> or <strong>Can't tell</strong>. The server resolves the pair and stores the vote.</li>
            <li>The response reveals the two configuration labels and the judge's deterministic results. Reloading the page restores the revealed state from the server.</li>
            <li>If you need to see the labels before choosing, use <strong>Reveal without choosing</strong>. That is recorded as unblinded and is never counted as a blind preference.</li>
          </ol>
          <div class="cmp-reviewer">
            <label for="reviewer-label">Reviewer label</label>
            <input id="reviewer-label" data-reviewer type="text" value={DEFAULT_REVIEWER_LABEL} maxlength="32" autocomplete="off" />
            <p class="small">A self-declared label, not a sign-in. It is the only identity stored; no email, account id or commenter data is written.</p>
          </div>
          <p class="cmp-unauthenticated" role="note">
            <strong>Votes are unauthenticated.</strong> Choices are stored server-side, but this page does not sign anyone
            in. Anyone can submit under any reviewer label. A vote count is not proof of who voted, and a label called
            “owner” is not the owner's verified judgement.
          </p>
          <p class="small cmp-vote-availability" data-vote-availability role="status" aria-live="polite">
            The authoritative record is server-side but unauthenticated. Checking the record…
          </p>
          <p class="small cmp-vote-summary" data-vote-summary>0 of {view.sample.pairs} pairs recorded on the server. Votes are unauthenticated.</p>
          <p class="small" data-run-link hidden></p>
        </section>

        <section class="cmp-section" aria-labelledby="pairs-title">
          <h2 id="pairs-title">Nine pairs, labels hidden</h2>
          <p class="small">
            Pair order and the A/B side are derived from the run, not from configuration order, so the layout does not
            encode the answer. Preview addresses name only the run, the pair and the side; the server maps them back to
            the committed trial files.
          </p>
          <noscript>
            <p class="cmp-warning">Voting needs JavaScript. The previews still open through their opaque addresses, but the labels stay hidden without a recorded choice.</p>
          </noscript>
          <Fragment set:html={grid} />
        </section>

        <section class="cmp-section" aria-labelledby="limits-title">
          <h2 id="limits-title">What this comparison does not prove</h2>
          <ul class="cmp-limits">
            <li>
              A reviewer's pick is a preference between two takes, not a quality ranking. The judge records whether a take
              met the brief; it cannot tell you which page you would actually use. The vote itself is unauthenticated and
              is not evidence of who cast it.
            </li>
            <li>
              Some configurations share one harness. More than one model id ran, but the harness dimension is untested —
              a different agent runtime is recorded as its own configuration instead. This page does not name either
              before a choice is recorded.
            </li>
            <li>
              No rate card is loaded, so the estimate and the provider charge both read as unknown. The CLI reports tokens,
              not an invoice. A number would have been a guess.
            </li>
            <li>One job. A model that writes a good landing page has not been shown to fix a build, migrate data or deploy.</li>
            <li>Three trials per configuration bounds variance; it does not eliminate it. Nine takes is not a benchmark suite.</li>
            <li>
              The recorded pages are static files. Opening one proves the agent produced working markup; it does not prove
              anything was deployed.
            </li>
            <li>
              The reviewer label is self-declared and this endpoint does not authenticate a person. The record is honest
              about what it stores; it cannot prove who cast the vote.
            </li>
          </ul>
          <div class="cmp-actions">
            <a class="button" href="/benchmarks">See the sandbox checks</a>
            <a class="button secondary" href="/benchmarks/comparisons">Read the Studio job receipts</a>
            <a class="button secondary" href="/benchmarks/suites">Open the provider-free suite packs</a>
            <a class="button secondary" href="https://github.com/loftwah/app-composer/issues/601">Follow Benchmarks Studio</a>
          </div>
        </section>
      </>
    )}
</Base>

<script>
  import '../../browser/benchmark-compare.ts';
</script>

<style is:global>
  .cmp-missing{max-width:62ch;margin:40px 0}
  .cmp-missing h1{font-size:clamp(2rem,4vw,3rem);max-width:22ch;margin:10px 0 18px}
  .cmp-heading{max-width:860px}
  .cmp-heading h1{font-size:clamp(2.6rem,5vw,4.4rem);max-width:15ch;margin:10px 0 20px;text-wrap:balance}
  .cmp-heading .lede{max-width:62ch}
  .cmp-meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px;margin:28px 0 0;padding:20px;background:var(--color-surface);border-radius:10px}
  .cmp-meta dt{font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--color-muted)}
  .cmp-meta dd{margin:4px 0 0;font-size:14px;overflow-wrap:anywhere}
  .cmp-claim{margin:20px 0 0;padding:12px 0 0;border-top:1px solid var(--color-border);font-size:14px;color:var(--color-muted);max-width:72ch}
  .cmp-section{border-top:1px solid var(--color-border);padding-top:28px;margin-top:44px}
  .cmp-section h2{font-size:clamp(1.6rem,3vw,2.2rem);max-width:26ch}
  .cmp-steps{max-width:74ch;padding-left:22px;line-height:1.7}
  .cmp-steps li{margin:10px 0;color:var(--color-muted)}
  .cmp-steps strong{color:var(--color-foreground)}
  .cmp-reviewer{display:grid;grid-template-columns:auto minmax(0,220px);gap:8px 12px;align-items:center;margin:20px 0 8px;max-width:520px}
  .cmp-reviewer label{font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--color-muted)}
  .cmp-reviewer input{font:inherit;font-size:14px;padding:9px 11px;min-height:42px;border-radius:8px;border:1px solid var(--color-border);background:var(--color-surface);color:inherit;min-width:0}
  .cmp-reviewer .small{grid-column:1/-1;margin:0;color:var(--color-muted)}
  .cmp-unauthenticated{margin:14px 0 0;padding:12px 14px;border-left:3px solid var(--color-accent);background:var(--color-surface);font-size:13.5px;line-height:1.6;max-width:74ch;color:var(--color-muted)}
  .cmp-unauthenticated strong{color:var(--color-foreground)}
  .cmp-vote-availability,.cmp-vote-summary{margin:6px 0 0;color:var(--color-muted)}
  .cmp-vote-availability[data-state='unavailable']{color:#ff8a6a}
  .cmp-warning{padding:12px 14px;border-left:3px solid var(--color-accent);background:var(--color-surface);max-width:70ch}
  .cmp-pair-grid{display:grid;gap:22px;margin-top:18px}
  .cmp-pair{border:1px solid var(--color-border);border-radius:12px;padding:18px;min-width:0}
  .cmp-pair-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}
  .cmp-pair-head h3{margin:0;font-size:1.1rem;max-width:none}
  .cmp-pair-head p{margin:4px 0 0;color:var(--color-muted)}
  .cmp-pair-count{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--color-muted);white-space:nowrap;padding-top:4px}
  .cmp-pair-sides{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;margin-top:14px}
  .cmp-pair-side{margin:0;min-width:0}
  .cmp-browser{border:1px solid var(--color-border);border-radius:10px;overflow:hidden;background:var(--color-surface)}
  .cmp-browser-bar{display:flex;align-items:center;gap:6px;padding:8px 12px;border-bottom:1px solid var(--color-border)}
  .cmp-browser-bar span{width:8px;height:8px;border-radius:50%;background:var(--color-border);flex:0 0 auto}
  .cmp-browser-bar code{margin-left:8px;font-size:11px;color:var(--color-muted)}
  .cmp-preview{position:relative;height:360px;overflow:auto;background:#fff;contain:paint}
  .cmp-preview-status{margin:0;padding:10px 12px}
  .cmp-preview[data-ready='true'] + .cmp-preview-status{display:none}
  .cmp-pair-side figcaption{display:flex;flex-direction:column;gap:4px;margin-top:10px;font-size:13px;min-width:0}
  .cmp-pair-side figcaption .small{color:var(--color-muted)}
  .cmp-choice{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
  .cmp-choice button{font:inherit;font-size:13px;padding:10px 14px;min-height:44px;border-radius:8px;border:1px solid var(--color-border);background:transparent;color:inherit;cursor:pointer;white-space:normal;text-align:left}
  .cmp-choice button.secondary{color:var(--color-muted)}
  .cmp-choice button[aria-pressed='true']{border-color:var(--color-accent);background:color-mix(in srgb,var(--color-accent) 14%,transparent);color:var(--color-foreground)}
  .cmp-choice button:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}
  .cmp-choice button:disabled{opacity:.55;cursor:wait}
  .cmp-pair-reason{display:flex;flex-direction:column;gap:4px;margin-top:12px;max-width:520px}
  .cmp-pair-reason span{color:var(--color-muted)}
  .cmp-pair-reason input{font:inherit;font-size:13px;padding:8px 10px;min-height:42px;border-radius:8px;border:1px solid var(--color-border);background:transparent;color:inherit;min-width:0}
  .cmp-pair-status{margin:8px 0 0;min-height:1.5em;color:var(--color-muted)}
  .cmp-pair-reveal{margin-top:14px;padding-top:14px;border-top:1px solid var(--color-border)}
  .cmp-pair-reveal[hidden]{display:none}
  .cmp-reveal-head{max-width:74ch}
  .cmp-reveal-head p{margin:0 0 4px}
  .cmp-reveal-verdict{font-size:1.05rem;font-weight:500}
  .cmp-reveal-meta,.cmp-reveal-reason{color:var(--color-muted)}
  .cmp-reveal-sides{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;margin-top:14px}
  .cmp-reveal-side{border:1px solid var(--color-border);border-radius:10px;padding:14px;min-width:0}
  .cmp-reveal-side h4{margin:0;font-size:1rem;overflow-wrap:anywhere}
  .cmp-reveal-facts{display:grid;gap:6px;margin:12px 0;font-size:13px}
  .cmp-reveal-facts div{display:grid;grid-template-columns:110px minmax(0,1fr);gap:10px}
  .cmp-reveal-facts dt{color:var(--color-muted);font-size:11px;letter-spacing:.05em;text-transform:uppercase;padding-top:2px}
  .cmp-reveal-facts dd{margin:0;overflow-wrap:anywhere}
  .cmp-reveal-failed{margin:0 0 8px;color:#ff8a6a;font-size:13px;overflow-wrap:anywhere}
  .cmp-reveal-checks summary{cursor:pointer;color:var(--color-muted)}
  .cmp-reveal-check-list{list-style:none;padding:0;margin:8px 0 0;font-size:12px}
  .cmp-reveal-check-list li{display:grid;grid-template-columns:14px minmax(0,1fr);gap:8px;padding:6px 0;border-top:1px solid var(--color-border)}
  .cmp-reveal-check-list li span{font-weight:600}
  .cmp-reveal-check-list .is-pass span{color:var(--color-success)}
  .cmp-reveal-check-list .is-fail span{color:#ff8a6a}
  .cmp-reveal-check-list p{margin:2px 0 0;color:var(--color-muted);font-size:11px}
  .cmp-limits{max-width:70ch;line-height:1.8}
  .cmp-limits li{margin:10px 0}
  .cmp-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}
  @media(max-width:880px){
    .cmp-pair-sides,.cmp-reveal-sides{grid-template-columns:1fr}
    .cmp-preview{height:320px}
  }
  @media(max-width:600px){
    .cmp-pair{padding:14px}
    .cmp-pair-head{display:block}
    .cmp-pair-count{display:none}
    .cmp-meta{grid-template-columns:1fr 1fr;padding:16px;gap:14px}
    .cmp-reviewer{grid-template-columns:1fr;max-width:none}
    .cmp-choice button{flex:1 1 100%}
    .cmp-preview{height:300px}
    .cmp-reveal-facts div{grid-template-columns:1fr;gap:2px}
  }
</style>
