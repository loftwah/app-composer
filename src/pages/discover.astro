---
import Base from '../layouts/Base.astro';
import DiscoverWork from '../components/DiscoverWork.astro';
import RoleDiscovery from '../components/RoleDiscovery.astro';
import { discoveryRoles } from '../lib/role-discovery';
---
<Base title="App Composer for your next job" description="Choose a role or a job, see a working example and start with the right tool. Creator, small business, developer and designer paths.">
  <header class="discovery-heading"><h1>What would you like to make?</h1><p>Choose your role or the job in front of you. Open a working example, then make it your own.</p></header>
  <RoleDiscovery role={discoveryRoles[0]} hub />
  <details class="more-tools"><summary>More working tools and walkthroughs</summary><DiscoverWork /></details>
  <p class="discovery-return"><a href="/incident-replay">Try the labelled incident review replay</a><a href="/plugin-trust">Review plugin evidence</a></p>
  <p class="discovery-return"><a href="/apps">All apps</a><a href="/setup">Set up your project</a><a href="/prompts">TLDR just give me the prompts</a></p>
</Base>
<style>
  .discovery-heading { display:flex; justify-content:space-between; gap:40px; align-items:flex-end; margin-bottom:28px; }
  .discovery-heading h1 { font-size:clamp(2rem,4vw,3.4rem); line-height:1.08; max-width:18ch; margin:0; text-wrap:balance; }
  .discovery-heading p { max-width:42ch; margin:0; font-size:1rem; color:var(--color-muted); }
  .more-tools { margin-top:32px; border-top:1px solid var(--color-border); padding-top:16px; }
  .more-tools>summary { min-height:44px; cursor:pointer; font-weight:500; }
  .discovery-return { display:flex; flex-wrap:wrap; gap:8px 28px; margin-top:22px; }
  .discovery-return a { min-height:44px; display:inline-flex; align-items:center; font-size:.9rem; }
  @media(max-width:720px) { .discovery-heading { display:block; margin-bottom:22px; }.discovery-heading h1 { max-width:22ch; font-size:2rem; }.discovery-heading p { max-width:60ch; margin-top:14px; } }
</style>
