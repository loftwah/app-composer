---
import Base from '../layouts/Base.astro';
import DiscoverWork from '../components/DiscoverWork.astro';
---

<Base title="Explore App Composer" description="Fill and sign a PDF, make profile cards and app icons, watch the team application films, open your profile and explore recorded analytics. Find the working App Composer tools.">
  <h1>Open something useful.</h1>
  <p class="lede">The tools, applications and walkthroughs you can use today.</p>
  <DiscoverWork />
  <section class="discovery-start" aria-labelledby="start-heading">
    <h2 id="start-heading">Build your own.</h2>
    <p><a href="/ready">Prepare your environment</a>, <a href="/init">describe an application</a>, or <a href="/learn">follow the tutorial</a>.</p>
    <p>Want to try the connection first? <a href="/demo">Open the composition workbench</a>. Still choosing a direction? <a href="/explore">Use the decision planner</a>.</p>
  </section>
</Base>

<style>
  h1 { overflow-wrap: anywhere; }
  .lede { max-width: 60ch; margin-bottom: 32px; }
  .discovery-start { border-top: 1px solid var(--color-border); padding-top: 32px; }
  .discovery-start p { max-width: 70ch; }
</style>
