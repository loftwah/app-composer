---
import Base from '../layouts/Base.astro';
---
<Base title="Review a Link Check report" description="Bring a versioned page inspection from the independent Link Check mini-app into Composer and prepare an agent review.">
<h1>Review a share report.</h1><p class="lede">Inspect a public page in Link Check, export the report, then bring its findings here.</p>
<div class="actions"><a class="button" href="https://share.loftwah.com">Open Link Check</a><a href="/apps">All apps</a></div>
<label>Import a Link Check report<input id="report-file" type="file" accept="application/json,.json"/></label><p class="small">The file stays in this browser. Imported findings are reported evidence, not independently rechecked results or deployment approval.</p><p id="import-status" role="status" aria-live="polite"></p>
<section id="report-result" hidden class="section"><h2 id="report-name"></h2><p id="report-date" class="small"></p><ul id="report-findings"></ul><button id="copy-review">Copy review to your agent</button><details id="review-details"><summary>Agent review prompt</summary><textarea id="review-prompt" readonly aria-label="Agent review prompt"></textarea></details></section>
<script>
import {validateInspectionReport,reviewPrompt} from '../lib/inspection-report.mjs';
const input=document.querySelector<HTMLInputElement>('#report-file')!;const status=document.querySelector('#import-status')!;let prompt='';let generation=0;
input.addEventListener('change',async()=>{const current=++generation;document.querySelector<HTMLElement>('#report-result')!.hidden=true;prompt='';const file=input.files?.[0];if(!file)return;try{if(file.size>64*1024)throw new Error('Choose a report under 64 KiB.');const value=JSON.parse(await file.text());if(current!==generation)return;const report=validateInspectionReport(value);document.querySelector('#report-name')!.textContent=report.title||'Page inspection';document.querySelector('#report-date')!.textContent=`Reported inspection: ${report.checkedAt}. Source: ${report.sourceSha}. Imported; not independently rechecked.`;const list=document.querySelector('#report-findings')!;list.replaceChildren();for(const finding of report.findings){const li=document.createElement('li');li.textContent=`${finding.status==='pass'?'Reported check':finding.status==='fix'?'Reported fix':'Review'} — ${finding.label}: ${finding.detail}`;list.append(li);}prompt=reviewPrompt(report);document.querySelector<HTMLTextAreaElement>('#review-prompt')!.value=prompt;document.querySelector<HTMLElement>('#report-result')!.hidden=false;status.textContent='Report imported locally. Its findings are ready for an agent review.';}catch(error){if(current===generation)status.textContent=error instanceof Error?error.message:'The report could not be read.';}});
document.querySelector('#copy-review')!.addEventListener('click',async()=>{if(!prompt)return;try{await navigator.clipboard.writeText(prompt);status.textContent='Review copied. Paste it into your authorised agent workspace.';}catch{const details=document.querySelector<HTMLDetailsElement>('#review-details')!,field=document.querySelector<HTMLTextAreaElement>('#review-prompt')!;details.open=true;field.focus();field.select();status.textContent='Clipboard unavailable. The review prompt is open and selected below; copy it with Ctrl/Cmd+C.';}});
</script>
</Base>
