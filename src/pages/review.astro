---
import Base from '../layouts/Base.astro';
---
<Base title="Review a Link Check report" description="Bring a versioned page inspection from the independent Link Check mini-app into Composer and prepare an agent review.">
<h1>Review a Link Check report</h1><p class="lede">Inspect a public page in Link Check, export the report, then bring its findings here.</p>
<div class="actions"><a class="button" href="https://share.loftwah.com">Open Link Check</a><a href="/apps">All apps</a></div>
<label>Import a Link Check report<input id="report-file" type="file" accept="application/json,.json"/></label><p class="small">The file stays in this browser. Imported findings are reported evidence, not independently rechecked results or deployment approval.</p><p id="import-status" role="status" aria-live="polite"></p>
<section id="report-result" hidden class="section"><h2 id="report-name"></h2><p id="report-date" class="small"></p><ul id="report-findings"></ul><button id="copy-review">Copy review to your agent</button><details id="review-details"><summary>Agent review prompt</summary><textarea id="review-prompt" readonly aria-label="Agent review prompt"></textarea></details></section>
<script>
import { validateInspectionReport, reviewPrompt } from '../lib/inspection-report.mjs';

const input = document.querySelector<HTMLInputElement>('#report-file')!;
const status = document.querySelector<HTMLElement>('#import-status')!;
const result = document.querySelector<HTMLElement>('#report-result')!;
const field = document.querySelector<HTMLTextAreaElement>('#review-prompt')!;
let prompt = '';
let generation = 0;
let copyAttempt = 0;

input.addEventListener('change', async () => {
  const file = input.files?.[0];
  if (!file) return;
  input.value = '';
  const current = ++generation;

  try {
    if (file.size > 64 * 1024) throw new Error('Choose a report under 64 KiB.');
    const content = await file.text();
    if (current !== generation) return;
    const report = validateInspectionReport(JSON.parse(content));
    const nextPrompt = reviewPrompt(report);
    const findings = report.findings.map(finding => {
      const li = document.createElement('li');
      const label = finding.status === 'pass' ? 'Reported check' : finding.status === 'fix' ? 'Reported fix' : 'Review';
      li.textContent = `${label} — ${finding.label}: ${finding.detail}`;
      return li;
    });

    document.querySelector('#report-name')!.textContent = report.title || 'Page inspection';
    document.querySelector('#report-date')!.textContent = `Reported inspection: ${report.checkedAt}. Source: ${report.sourceSha}. Imported; not independently rechecked.`;
    document.querySelector('#report-findings')!.replaceChildren(...findings);
    prompt = nextPrompt;
    field.value = prompt;
    result.hidden = false;
    status.textContent = 'Report imported locally. Its findings are ready for an agent review.';
  } catch (error) {
    if (current !== generation) return;
    const reason = error instanceof SyntaxError
      ? 'Choose a Link Check report in JSON format.'
      : error instanceof Error ? error.message : 'The report could not be read.';
    status.textContent = result.hidden ? reason : `${reason} You can still review the earlier report below.`;
  }
});

document.querySelector('#copy-review')!.addEventListener('click', async () => {
  const text = prompt;
  if (!text) return;
  const attempted = ++copyAttempt;
  const current = generation;
  const ownsStatus = () => attempted === copyAttempt && current === generation && text === prompt;
  try {
    await navigator.clipboard.writeText(text);
    if (ownsStatus()) status.textContent = 'Review copied. Paste it into your authorised agent workspace.';
  } catch {
    if (!ownsStatus()) return;
    document.querySelector<HTMLDetailsElement>('#review-details')!.open = true;
    field.focus();
    field.select();
    status.textContent = 'Clipboard unavailable. The review prompt is open and selected below; copy it with Ctrl/Cmd+C.';
  }
});
</script>
</Base>
