---
import Base from '../../layouts/Base.astro';
import {getEmDashEntry} from 'emdash';
const {entry,error}=await getEmDashEntry('catalogue',Astro.params.slug!);
if(error)return new Response('This mini-app is temporarily unavailable.',{status:503});
if(!entry)return new Response('Mini-app not found.',{status:404});
---
<Base title={entry.data.title} description={entry.data.description}><a href="/catalogue">All mini-apps</a><h1>{entry.data.title}</h1><p class="lede">{entry.data.description}</p><p class="small">Reviewed {entry.data.reviewed}</p><div class="actions"><a class="button" href={entry.data.href}>Open app</a><a class="button secondary" href={entry.data.source}>View GitHub source</a></div><section class="section"><h2>Build with this app</h2><p>Configure the supported pair in Init, then give the saved specification to your authorised coding agent.</p><a href="/init">Configure your app</a></section></Base>
