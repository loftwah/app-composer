---
import DeviceSupport from '../../components/DeviceSupport.astro';
import {appDeviceSupport} from '../../lib/app-device-support';
import Base from '../../layouts/Base.astro';
import {getEmDashEntry} from 'emdash';
import {noindexFor} from '../../lib/indexing.mjs';
import {reviewLabel} from '../../lib/date-label.mjs';
import {apps,appDetails} from '../../lib/apps';
const {entry,error}=await getEmDashEntry('catalogue',Astro.params.slug!);
if(error)Astro.response.status=503;
else if(!entry)Astro.response.status=404;
const title=error?'Mini-app temporarily unavailable':entry?entry.data.title:'Mini-app not found';
const description=error?'The published catalogue entry could not be loaded. The shipped app library remains available and unaffected.':entry?.data.description??'This catalogue address has no published mini-app contract.';
// The published contract decides the title and route; the shipped library supplies
// this app's own artwork, share card and a real screenshot when it already runs here.
const shipped=apps.find(app=>app.id===entry?.data.slug||app.id===Astro.params.slug);
const shareImage=shipped?`https://composer.loftwah.com${shipped.share}`:undefined;
const reviewed=entry?reviewLabel(entry.data.reviewed):null;
---
<Base title={title} description={description} noindex={noindexFor(Astro.url.hostname,Boolean(entry)&&!error)} shareImage={shareImage} shareType={shipped?.shareType} shareAlt={shipped?.shareAlt}>
{error ? (
 <>
  <a href="/catalogue">All mini-apps</a>
  <h1>This mini-app is temporarily unavailable.</h1>
  <p class="lede">EmDash could not load this published contract. The address is unchanged; nothing has been substituted in its place.</p>
  <div class="actions"><a class="button" href={'/catalogue/'+Astro.params.slug}>Try this page again</a><a class="button secondary" href="/apps">Browse the shipped app library</a></div>
  <p class="small">The apps themselves are separate deployments and are unaffected by this catalogue outage.</p>
 </>
) : !entry ? (
 <>
  <a href="/catalogue">All mini-apps</a>
  <h1>No mini-app exists at this address.</h1>
  <p class="lede">The published catalogue has no contract for <code>{Astro.params.slug}</code>. It may have been renamed, or the link may be incomplete.</p>
  <div class="actions"><a class="button" href="/catalogue">See every published mini-app</a><a class="button secondary" href="/apps">Browse the shipped app library</a></div>
  <p class="small">The shipped library lists apps from this deployment’s own source, whether or not a catalogue contract has been published.</p>
 </>
) : (
 <>
  <a href="/catalogue">All mini-apps</a><h1>{entry.data.title}</h1><p class="lede">{entry.data.description}</p><p class="small">{reviewed?'Contract reviewed '+reviewed+'.':'Contract review date not recorded.'} The same name appears in the app’s own repository and interface.</p><DeviceSupport support={appDeviceSupport(shipped?.id ?? entry.data.slug ?? Astro.params.slug!)}/><div class="actions"><a class="button" href={entry.data.href}>Open app</a><a class="button secondary" href={entry.data.source}>View GitHub source</a></div>
  {shipped&&<figure class="app-screen"><a href={entry.data.href}><picture><source type="image/webp" srcset={`${shipped.preview} 960w, ${shipped.previewWide} 1440w`} sizes="(max-width: 800px) calc(100vw - 64px), 720px"/><img src={shipped.preview} width="960" height="600" alt={shipped.previewAlt} loading="lazy" decoding="async"/></picture></a><figcaption>Real screenshot of <a href={('previewOrigin' in shipped?shipped.previewOrigin:shipped.standalone)}>{entry.data.title} at {new URL(('previewOrigin' in shipped?shipped.previewOrigin:shipped.standalone)).host}</a>, captured {new Date(shipped.previewCaptured+'T00:00:00Z').toLocaleDateString('en-AU',{day:'numeric',month:'long',year:'numeric'})}.</figcaption></figure>}
  {shipped&&<section class="section"><h2>What this app does.</h2><p>{appDetails[shipped.id].example}</p><ul>{appDetails[shipped.id].features.map(feature=><li>{feature}</li>)}</ul><p><strong>Make it yours.</strong> {appDetails[shipped.id].configuration}</p><p><strong>Works with.</strong> {appDetails[shipped.id].connection}</p></section>}
  <section class="section"><h2>Build with this app</h2>
   {shipped?.id==='ldraw' ? (
    <>
     <p>Use LDraw’s native <code>.excalidraw</code> files and independent editor source. Give your agent the released source and an editable scene; browser access stays under your authorisation.</p>
     <a href={shipped.source}>Build from the native LDraw source</a> · <a href={shipped.href}>Open LDraw</a>
    </>
   ) : (
    <>
     <p>{shipped?.id==='paperwork' ? 'Configure Paperwork in Init, then reproduce its exact reviewed source in a new directory.' : 'Configure the supported pair in Init, then give the saved specification to your authorised coding agent.'}</p>
     <a href={shipped?.id==='paperwork'?'/init/paperwork':'/init'}>Configure your app</a>
    </>
   )}
   {shipped&&<> · <a href="/apps">Compare it with the shipped app library</a></>}
  </section>
 </>
)}
</Base>
