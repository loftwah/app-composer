---
import Base from "../../layouts/Base.astro";
import { ArrowUpRight } from "@lucide/astro";
import { studioStations } from "../../scripts/studio/studio-data.js";
import "../../styles/product-home.css";
import "../../styles/illustrated-workshop.css";

const defaultStation = studioStations[0];
---

<Base homePage title="Illustrated workshop" description="An interactive illustration of the Paperwork, LDraw and Analytics tools.">
  <div class="composer-home">
    <section class="studio-hero" aria-labelledby="workshop-heading">
      <div class="studio-stage" data-studio-stage data-state="poster">
        <div class="studio-backdrop" aria-hidden="true"></div>
        <picture class="studio-poster studio-poster-dark" data-studio-poster>
          <source
            media="(max-width: 600px)"
            srcset="/brand/studio/studio-poster-mobile-dark-20261113.webp"
          />
          <img
            src="/brand/studio/studio-poster-desktop-dark-20261113.webp"
            width="1600"
            height="1000"
            alt="A midnight-blue illustrated workshop: an orange Paperwork press stamps a cream form, a pencil drawing rises into a paper staircase, and a separate brass evidence lens hangs above the floor."
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <picture class="studio-poster studio-poster-light" data-studio-poster>
          <source
            media="(max-width: 600px)"
            srcset="/brand/studio/studio-poster-mobile-light-20261113.webp"
          />
          <img
            src="/brand/studio/studio-poster-desktop-light-20261113.webp"
            width="1600"
            height="1000"
            alt="A warm, daylight-lit illustrated workshop: an orange Paperwork press stamps a cream form, a pencil drawing rises into a paper staircase, and a separate brass evidence lens hangs above the floor."
            loading="lazy"
            decoding="async"
          />
        </picture>
        <canvas
          class="studio-canvas"
          data-studio-canvas
          aria-hidden="true"
        ></canvas>
        <div class="studio-vignette" aria-hidden="true"></div>
        <div class="studio-scene-meta">
          <p class="studio-status-line">
            <span class="studio-live-dot" aria-hidden="true"></span>
            <span data-studio-status>Illustrated workshop</span>
          </p>
          <p class="studio-scene-label" data-studio-scene-label>
            {defaultStation.sceneLabel}
          </p>
          <p class="studio-hint">Drag to look · keys 1–3 · P pause</p>
        </div>
        <p class="studio-scene-caption" data-studio-caption>
          {defaultStation.caption}
        </p>
      </div>

      <div class="studio-copy">
        <p class="studio-eyebrow"><span class="studio-kicker-mark" aria-hidden="true">✳</span> An illustrated demo</p>
        <h1 id="workshop-heading">Explore a<br /><span>fictional workshop.</span></h1>
        <p class="studio-lede">Try a playful view of Paperwork, LDraw and Composer reporting. The workshop is an illustration; the real apps are linked below.</p>
        <div class="studio-actions"><a class="home-button" href="/apps">Explore the real apps <ArrowUpRight size={21} aria-hidden="true" /></a></div>
        <a class="studio-proof-print" href="/media-studio#made">
          <img
            src="/brand/studio/media-studio-print-20261114.webp"
            width="504"
            height="277"
            alt="A paper studio bench with an orange waveform and a cream camera"
            decoding="async"
          />
          <span class="studio-proof-label">
            <strong>Made in Media Studio</strong>
            <span>See the still, mask and motion</span>
          </span>
          <ArrowUpRight size={16} aria-hidden="true" />
        </a>
      </div>

      <div class="studio-deck">
        <div class="studio-console" data-studio-console hidden>
          <div class="studio-console-head">
            <div
              class="studio-stations"
              role="group"
              aria-label="Choose a workshop station"
            >
              {studioStations.map((station, index) => (
                <button
                  class="studio-station"
                  type="button"
                  data-station={station.id}
                  aria-pressed={index === 0 ? "true" : "false"}
                  tabindex={index === 0 ? 0 : -1}
                >
                  <span class="studio-station-number">{station.number}</span>
                  <span>{station.name}</span>
                </button>
              ))}
            </div>
            <button
              class="studio-pause"
              type="button"
              id="studio-pause"
              data-studio-pause
              aria-pressed="false"
            >
              <span data-studio-pause-label>Pause motion</span>
              <span aria-hidden="true" class="studio-pause-glyph">Ⅱ</span>
            </button>
          </div>
          <p class="studio-instruction" data-studio-instruction>
            {defaultStation.instruction}
          </p>
          <div class="studio-console-controls" aria-describedby="studio-control-help">
            <button class="studio-feed" type="button" data-studio-feed aria-pressed="false">
              <span data-studio-feed-label>Feed the sheet</span>
            </button>
            <button class="studio-action" type="button" id="studio-action" data-studio-action>
              <span data-studio-action-label>{defaultStation.actionIdle}</span>
            </button>
          </div>
          <div class="studio-console-foot">
            <div>
              <p class="studio-readout" data-studio-readout>
                {defaultStation.readout}
              </p>
              <p class="studio-context" data-studio-context>
                {defaultStation.context}
              </p>
            </div>
            <nav class="studio-app-links" aria-label="Open the real applications">
              <a href="/paperwork">Paperwork</a>
              <a href="/ldraw">LDraw</a>
              <a href="/activity">Analytics</a>
              <a class="studio-product-link" data-studio-link href={defaultStation.href}>
                {defaultStation.linkLabel} <ArrowUpRight size={14} aria-hidden="true" />
              </a>
            </nav>
          </div>
          <p id="studio-control-help" class="sr-only">
            Choose a station, then use its buttons. Arrow keys move between
            station buttons. Press 1, 2 or 3 to move between stations and P to
            pause ambient motion.
          </p>
        </div>

        <div class="studio-static" data-studio-static>
          <div class="studio-static-head">
            <p>Three jobs, one workshop</p>
            <span>The illustrated view</span>
          </div>
          <ul>
            {studioStations.map((station) => (
              <li>
                <span class="studio-static-number">{station.number}</span>
                <div>
                  <h2>{station.name}</h2>
                  <p>{station.context}</p>
                </div>
                <a href={station.href}>
                  {station.linkLabel} <ArrowUpRight size={15} aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
          <p class="studio-static-note" data-studio-static-note>
            The interactive workshop adds camera movement and three controls.
            The links and actions above also work in this view.
          </p>
        </div>
      </div>

      <p class="sr-only">
        An interactive illustrated workshop. The Paperwork press stamps a
        fictional form. LDraw lifts a pencil drawing into paper architecture.
        A separate evidence lens explores supported, recorded Composer
        analytics. The three stations are independent: documents and drawings do
        not feed analytics.
      </p>
      <p
        class="sr-only"
        aria-live="polite"
        data-studio-announcement
      ></p>
    </section>
  </div>
</Base>

<script>
  // The workshop is a separately loaded visual enhancement. The poster, product
  // copy and every app link are already in the HTML, so no JavaScript is needed
  // to understand or use the page.
  const studioStage = document.querySelector<HTMLElement>("[data-studio-stage]");
  const studioCanvas = studioStage?.querySelector("canvas");
  const studioConsole = document.querySelector<HTMLElement>("[data-studio-console]");
  const studioStatic = document.querySelector<HTMLElement>("[data-studio-static]");
  const studioStatus = document.querySelector<HTMLElement>("[data-studio-status]");

  const showStaticWorkshop = (message: string) => {
    if (!studioStage) return;
    studioStage.dataset.state = "static";
    studioStage.classList.remove("is-ready");
    studioStage
      .querySelectorAll<HTMLElement>("[data-studio-poster]")
      .forEach((poster) => {
        poster.hidden = false;
      });
    if (studioConsole) studioConsole.hidden = true;
    if (studioStatic) studioStatic.hidden = false;
    if (studioStatus) {
      studioStatus.textContent = "Illustrated workshop · static";
      studioStatus.dataset.tone = "warn";
    }
    const note = document.querySelector<HTMLElement>(
      "[data-studio-static-note]",
    );
    if (note) note.textContent = message;
  };

  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } })
    .connection?.saveData;
  if (studioStage && studioCanvas) {
    if (saveData) {
      showStaticWorkshop("Illustrated workshop · Save-Data");
    } else {
      const startStudio = () =>
        import("../../scripts/studio/studio-hero.js").catch((error) => {
          console.warn("Studio module unavailable:", error?.message ?? error);
          showStaticWorkshop("Illustrated workshop · live view unavailable");
        });
      const scheduleStudio = () => {
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(startStudio, { timeout: 350 });
        } else {
          globalThis.setTimeout(startStudio, 0);
        }
      };
      // The workshop now sits below the product introduction. Preload it as
      // the visitor approaches, instead of creating a WebGL scene offscreen
      // during the landing page's first render. The poster stays visible.
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          scheduleStudio();
        }, { rootMargin: "700px 0px" });
        observer.observe(studioStage);
      } else {
        scheduleStudio();
      }
    }
  }
</script>
