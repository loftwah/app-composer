---
import Base from '../layouts/Base.astro';
import { docsGuideLinks, docsReferenceSections, docsTaskPaths, docsUnavailable } from '../lib/docs-hub';
import { promptModule, renderPrompt } from '../lib/prompt-library';

const tasks = docsTaskPaths.map(task => {
  const prompt = promptModule(task.promptId);
  if (!prompt) throw new Error(`Documentation task ${task.id} points at an unknown prompt: ${task.promptId}`);
  return {
    ...task,
    detailId: `detail-${task.id}`,
    prompt,
    template: renderPrompt(task.promptId, {}, { template: true }).text,
  };
});
const totalLinks = docsReferenceSections.length + docsGuideLinks.length;
---
<Base title="Documentation: what do you want to make or do?" description="Choose a task, copy a maintained prompt for your own agent, and read the technical reference. Public, free to prepare, no model call.">
  <div class="docs-hub" data-docs-hub>
    <section class="docs-hero" aria-labelledby="docs-title">
      <div class="docs-hero-main">
        <p class="eyebrow">Documentation</p>
        <h1 id="docs-title">What do you want to make or do?</h1>
        <p class="lede">Use the agent you choose. Composer helps it work in your authorised environment, and the app, source and data stay yours.</p>
        <div class="docs-hero-actions">
          <a class="button" href="/prompts">Get a prompt for my agent</a>
          <a class="docs-hero-link" href="/docs/how-it-works">How it works</a>
          <a class="docs-hero-link" href="/demo/connected-apps">See a real example</a>
        </div>
      </div>

      <div class="docs-hero-picker">
        <div class="docs-search" role="search" aria-label="Find a task or reference" data-docs-search data-docs-enhanced hidden>
          <label for="docs-search">Find your task</label>
          <div class="docs-search-row">
            <input id="docs-search" type="search" data-docs-query autocomplete="off" spellcheck="false" placeholder="Try “make a site”" />
            <button type="button" class="secondary" data-docs-clear hidden>Clear</button>
          </div>
          <p class="docs-search-count" role="status" aria-live="polite" data-docs-count></p>
          <div class="docs-chips">
            <span>Try</span>
            {['make a site', 'publish', 'fix a broken app', 'new to agents', 'add a form'].map(example => <button type="button" data-docs-example={example}>{example}</button>)}
          </div>
          <p class="docs-search-note">No account. No model call. Copying a prompt runs nothing.</p>
        </div>
        <p class="docs-empty" data-docs-empty hidden>No match. <a href="/prompts">The prompt library</a> lists every job, and <a href="/ready">Get Ready</a> starts with the environment.</p>
      </div>
    </section>

    <noscript>
      <p class="note">Search needs JavaScript. Everything below is plain HTML: six task cards, the full prompt templates, the commands and recovery notes, and the technical reference. Open “Prerequisites, current limit and the full prompt” on any card to read or select a prompt.</p>
      <p class="note">Following an older link to one of this page’s former sections? Every section is preserved in <a href="/docs/how-it-works">How App Composer works</a>:{' '}
        {docsReferenceSections.map((section, index) => <span>{index ? ' · ' : ''}<a href={`/docs/how-it-works#${section.id}`}>{section.title}</a></span>)}
      </p>
    </noscript>

    <section class="docs-tasks" id="tasks" data-docs-group aria-labelledby="docs-tasks-heading">
      <div class="docs-section-head">
        <h2 id="docs-tasks-heading">Six ways to start</h2>
        <p>Choose the outcome closest to today’s job. Each card opens the maintained page for that job, and the copy button puts the same canonical prompt the prompt library renders on your clipboard.</p>
      </div>

      <ol class="docs-cards">
        {tasks.map((task, index) => (
          <li class="docs-card" id={task.anchor} data-docs-task={task.id} data-docs-index={task.id}>
            <article aria-labelledby={`${task.anchor}-title`}>
              <div class="docs-card-meta">
                <span class="docs-card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="docs-badge">{task.prompt.support}</span>
              </div>
              <h3 id={`${task.anchor}-title`}>{task.question}</h3>
              <p class="docs-card-outcome">{task.outcome}</p>
              <p class="docs-card-needs"><strong>You need</strong> {task.needs}</p>
              <div class="docs-card-actions">
                <button type="button" data-docs-copy={task.id} data-docs-enhanced aria-label={`Copy prompt template: ${task.question}`} aria-describedby={`${task.anchor}-status`} hidden>Copy prompt</button>
                <a class="docs-card-route" href={task.guide.href}>{task.cardAction}<span aria-hidden="true"> →</span></a>
              </div>
              <p class="docs-card-status" role="status" aria-live="polite" aria-atomic="true" id={`${task.anchor}-status`} data-docs-status={task.id}></p>
              {task.also?.slice(0, 1).map(link => <p class="docs-card-also"><a href={link.href}>{link.label}<span aria-hidden="true"> →</span></a></p>)}
              <p class="docs-card-more"><a href={`#${task.detailId}`}>Prerequisites, current limit and the full prompt<span aria-hidden="true"> ↓</span></a></p>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section class="docs-handoff" aria-labelledby="docs-flow-title">
      <div class="docs-handoff-head">
        <h2 id="docs-flow-title">What happens after you choose</h2>
        <p>The same five steps for every task. A copied prompt is a request, not authority: your agent still follows the project’s own instructions, permissions and release path.</p>
      </div>
      <ol class="docs-flow">
        <li><span class="docs-flow-index" aria-hidden="true">1</span><div><strong>Choose a job</strong><p>Start with your own words.</p></div></li>
        <li><span class="docs-flow-index" aria-hidden="true">2</span><div><strong>Copy a prompt</strong><p>Use the maintained text.</p></div></li>
        <li><span class="docs-flow-index" aria-hidden="true">3</span><div><strong>Your agent works</strong><p>In your authorised project only.</p></div></li>
        <li><span class="docs-flow-index" aria-hidden="true">4</span><div><strong>Verify the result</strong><p>Test the real journey.</p></div></li>
        <li><span class="docs-flow-index" aria-hidden="true">5</span><div><strong>Return to improve</strong><p>Operate the same app later.</p></div></li>
      </ol>
    </section>

    <section class="docs-task-details" aria-labelledby="docs-details-heading">
      <div class="docs-section-head">
        <h2 id="docs-details-heading">Every task in full</h2>
        <p>Open one task for its prerequisites, the canonical prompt and the limit that is real today. The full prompt is selectable here without JavaScript. Copying from a card above is the quickest route.</p>
      </div>

      {tasks.map((task, index) => (
        <details class="docs-task-detail" id={task.detailId} data-docs-details={task.id}>
          <summary>
            <span class="docs-summary-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="docs-summary-title">{task.question}</span>
            <span class="docs-summary-hint">Prerequisites, prompt and current limit</span>
          </summary>
          <div class="docs-task-body">
            <p class="docs-task-outcome"><strong>You get.</strong> {task.outcome}</p>

            <h3>Before you start</h3>
            <ul>
              {task.prerequisites.map(item => <li>{item}</li>)}
            </ul>

            <h3>What this asks your agent to do</h3>
            <p>{task.promptNote}</p>
            <p class="docs-task-promoteline"><span class="docs-badge">{task.prompt.support}</span><span>Canonical prompt: {task.prompt.title}</span></p>

            {task.also?.map(link => <p class="docs-task-also">Also for this task: <a href={link.href}>{link.label}<span aria-hidden="true"> →</span></a></p>)}
            <p class="docs-task-route">Supporting page: <a href={task.guide.href}>{task.guide.label}<span aria-hidden="true"> →</span></a> <span>{task.guide.note}</span></p>
            <p class="docs-task-route">Next step: <a href={task.next.href}>{task.next.label}<span aria-hidden="true"> →</span></a></p>
            <p class="docs-task-limit"><strong>Current limit.</strong> {task.limit}</p>

            <h3>Full prompt</h3>
            <p class="note">This is the canonical template. The prompt library’s <strong>Copy template</strong> action produces the same text; its completed prompt includes any details you add there. Bracketed fields are for your agent to inspect, or you can fill them in first. <a href={`/prompts#${task.promptId}`}>Open the prompt and add your details<span aria-hidden="true"> →</span></a></p>
            <pre class="docs-prompt-text" tabindex="0" role="region" aria-label={`Prompt template for: ${task.question}`} data-docs-prompt={task.id}>{task.template}</pre>
            <p class="note">Prefer to copy by hand? Select the text above and use your device’s Copy command. This always works, with or without JavaScript.</p>
          </div>
        </details>
      ))}
    </section>

    <section class="docs-operate" id="operate" aria-labelledby="docs-operate-heading">
      <div class="docs-section-head">
        <h2 id="docs-operate-heading">Browsing here, and changing your own project</h2>
        <p>This page reads and copies. It cannot install, deploy, spend or change an account. Those actions belong to your agent in your authorised environment.</p>
      </div>
      <div class="docs-operate-pair">
        <div>
          <h3>Works here, with no account</h3>
          <ul>
            <li>Read all six tasks and the {totalLinks} indexed reference and guide links.</li>
            <li>Search, filter and open any prompt template.</li>
            <li>Copy a template or select it by hand. Nothing runs and nothing is sent anywhere.</li>
            <li>Read the complete technical reference at <a href="/docs/how-it-works">How App Composer works</a>.</li>
          </ul>
        </div>
        <div>
          <h3>Needs your agent and your accounts</h3>
          <ul>
            <li>Inspecting or editing a real project on your machine.</li>
            <li>Creating Cloudflare resources, setting secrets or deploying.</li>
            <li>Installing tools, migrating data or spending with a provider.</li>
            <li>Publishing a page or revoking access. Each is a separate, explicit action.</li>
          </ul>
        </div>
      </div>

      <details class="docs-operate-detail">
        <summary>Exact commands, file paths and failure recovery</summary>
        <div class="docs-operate-body">
          <h3>Run this documentation checkout</h3>
          <p>These commands build and check App Composer itself. They do not build your project, and <code>pnpm deploy</code> releases this site, never yours. Node 26.13.1 and pnpm 12.19.0 are the reviewed pair in <code>README.md</code>; the supported floors are Node 22.23.5+, 24.22.3+ or 26.13.1+.</p>
          <pre tabindex="0" role="region" aria-label="Exact App Composer commands"><code>{`# install the pinned dependencies once
pnpm install --frozen-lockfile

# run the source checks, then local Astro on 127.0.0.1
pnpm dev

# the maintained release gate: types, lint, format and the retained suite
pnpm check

# iterate on one test file without pretending it is the release gate
pnpm check:fast -- tests/docs-hub.test.mjs

# build the public artifact, or run the guarded production release
pnpm build
pnpm deploy`}</code></pre>
          <h3>Where the words live</h3>
          <dl class="docs-files">
            <div><dt><code>src/pages/docs.astro</code></dt><dd>This hub: the six task cards, the full prompts, the commands and the reference index.</dd></div>
            <div><dt><code>src/lib/docs-hub.ts</code></dt><dd>Task records, task terms and the local, deterministic search. No model call.</dd></div>
            <div><dt><code>src/lib/docs-hub-client.ts</code></dt><dd>Search filtering, the copy action and its manual fallback.</dd></div>
            <div><dt><code>src/lib/prompt-library.ts</code></dt><dd>The canonical prompt text. This page renders these modules and never forks their prose.</dd></div>
            <div><dt><code>tests/docs-hub.test.mjs</code></dt><dd>Regressions for the tasks, anchors, canonical prompts, search fixtures and this copy behaviour.</dd></div>
            <div><dt><code>docs/STATUS.md</code></dt><dd>What is actually delivered, with dates and remaining gates.</dd></div>
            <div><dt><code>wrangler.jsonc</code></dt><dd>The Worker entry, bindings and environment configuration for this deployment.</dd></div>
          </dl>
          <h3>When something fails</h3>
          <dl class="docs-faults">
            <div><dt>The copy button does nothing</dt><dd>The browser refused clipboard access. The full prompt opens and is selected below that task’s card; copy it with Cmd/Ctrl+C or your device’s copy menu. The status line says which happened.</dd></div>
            <div><dt>Search is missing</dt><dd>JavaScript is off or blocked. The six task cards, prompts, commands and reference are still readable HTML; open any task on this page to select its full prompt.</dd></div>
            <div><dt>An old anchor link from the former documentation page</dt><dd>It forwards to the matching section of <a href="/docs/how-it-works">/docs/how-it-works</a>. Every former anchor is preserved.</dd></div>
            <div><dt>The Node version is unsupported</dt><dd>Install a supported floor (22.23.5+, 24.22.3+ or 26.13.1+) and rerun. <code>.node-version</code> selects the reviewed default.</dd></div>
            <div><dt>The release is refused</dt><dd>The guard needs a clean, pushed <code>main</code>. Commit and push first; do not bypass it to reach production.</dd></div>
            <div><dt>A task or guide link 404s</dt><dd>Report it rather than inventing a route. The reference and guide index above is the maintained list.</dd></div>
          </dl>
        </div>
      </details>
    </section>

    <section class="docs-reference" id="reference" data-docs-group aria-labelledby="docs-reference-heading">
      <div class="docs-section-head">
        <h2 id="docs-reference-heading">Technical reference</h2>
        <p>The exact behaviour behind each task. The complete former <code>/docs</code> article is preserved at <a href="/docs/how-it-works">How App Composer works</a>, including MCP, app contracts, updates and content projects.</p>
      </div>
      <div class="docs-reference-columns">
        <details class="docs-reference-group" data-docs-auto-open>
          <summary>Reference sections <span>{docsReferenceSections.length}</span></summary>
          <ul>
            {docsReferenceSections.map(section => (
              <li data-docs-section={section.id}><a href={`/docs/how-it-works#${section.id}`}>{section.title}</a><p>{section.summary}</p></li>
            ))}
          </ul>
        </details>
        <details class="docs-reference-group" data-docs-auto-open>
          <summary>Guides and tools <span>{docsGuideLinks.length}</span></summary>
          <ul>
            {docsGuideLinks.map(link => (
              <li data-docs-guide={link.id}><a href={link.href}>{link.label}</a><p>{link.summary}</p></li>
            ))}
          </ul>
        </details>
      </div>
    </section>

    <section class="docs-unavailable" data-docs-group aria-labelledby="docs-unavailable-heading">
      <div class="docs-section-head">
        <h2 id="docs-unavailable-heading">Not available yet</h2>
        <p>These requests come up often. They are named here so an empty search never turns into a made-up feature.</p>
      </div>
      <details class="docs-unavailable-group" data-docs-auto-open>
        <summary>Six requests and the closest working route</summary>
        <ul>
          {docsUnavailable.map(item => (
            <li data-docs-unavailable={item.id}>
              <h3>{item.request}</h3>
              <p>{item.explanation}</p>
              <p>Closest working route: <a href={item.closest.href}>{item.closest.label}<span aria-hidden="true"> →</span></a></p>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <p class="docs-reviewed">Reviewed 16 November 2026. Task prompts are rendered from the maintained prompt library, so this page cannot drift from <a href="/prompts">the prompt library</a>. {totalLinks} reference and guide links are indexed by the local search on this page.</p>
  </div>
</Base>

<script>
  import '../lib/docs-hub-client';
</script>

<style>
  .docs-hub { min-width: 0; }
  .docs-hub p { max-width: 68ch; }
  .docs-hub code { font-size: 1em; }
  .docs-hub .eyebrow { font-size: .875rem; }

  .docs-hero { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 48px; align-items: start; padding-bottom: 8px; }
  .docs-hero-main, .docs-hero-picker { min-width: 0; }
  .docs-hero h1 { max-width: 20ch; margin: 12px 0 18px; font-size: clamp(2.4rem, 4.6vw, 3.6rem); line-height: 1.04; }
  .docs-hero .lede { max-width: 54ch; margin: 0 0 20px; }
  .docs-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; margin: 0; }
  .docs-hero-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-accent); text-underline-offset: .18em; }
  .docs-hero-link:hover { text-decoration: underline; }

  .docs-search { margin: 0; padding: 20px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface); }
  .docs-search label { margin: 0; font-size: 1rem; font-weight: 650; }
  .docs-search-row { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
  .docs-search-row input { margin-top: 0; }
  .docs-search-row button { flex: none; }
  .docs-search-count { min-height: 1.5em; margin: 10px 0 0; font-size: .875rem; color: var(--color-muted); }
  .docs-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 8px; font-size: .875rem; color: var(--color-muted); }
  .docs-chips button { min-height: 44px; padding: 4px 10px; border: 1px solid var(--color-control-border); background: transparent; color: var(--color-foreground); font: 500 .875rem/1.3 system-ui, sans-serif; }
  .docs-chips button:hover { background: var(--color-selected); }
  .docs-search-note { margin: 10px 0 0; font-size: .875rem; line-height: 1.5; color: var(--color-muted); }

  .docs-handoff { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 28px 48px; margin-top: 48px; padding: 28px 0; border-block: 1px solid var(--color-border); }
  .docs-handoff-head h2 { max-width: 20ch; margin: 0 0 8px; font-size: 1.35rem; }
  .docs-handoff-head p { margin: 0; font-size: .9375rem; line-height: 1.55; color: var(--color-muted); }
  .docs-flow { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; max-width: none; margin: 0; padding: 0; list-style: none; }
  .docs-flow li { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px; margin: 0; }
  .docs-flow-index { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border: 1px solid var(--color-control-border); border-radius: 50%; font: 600 .875rem/1 system-ui, sans-serif; color: var(--color-accent); }
  .docs-flow strong { display: block; font: 600 .9375rem/1.3 Space, system-ui, sans-serif; }
  .docs-flow p { margin: 2px 0 0; font-size: .875rem; line-height: 1.45; color: var(--color-muted); }

  .docs-tasks { margin-top: 48px; }
  .docs-section-head { max-width: 78ch; margin-bottom: 8px; }
  .docs-section-head h2 { max-width: 24ch; margin-bottom: 12px; font-size: clamp(1.75rem, 2.6vw, 2.5rem); }
  .docs-section-head p { margin: 0; color: var(--color-muted); }

  .docs-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 22px; max-width: none; margin: 28px 0 0; padding: 0; list-style: none; align-items: stretch; }
  .docs-cards > li { display: flex; min-width: 0; margin: 0; }
  .docs-card { display: flex; width: 100%; }
  .docs-card > article { display: flex; flex-direction: column; width: 100%; padding: 24px; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); }
  .docs-card > article:focus-within { border-color: var(--color-accent); }
  .docs-card-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .docs-card-number { font: 600 .875rem/1 system-ui, sans-serif; letter-spacing: .12em; color: var(--color-accent); }
  .docs-badge { display: inline-block; padding: 5px 8px; border: 1px solid var(--color-control-border); border-radius: 999px; font: 600 .875rem/1.2 system-ui, sans-serif; letter-spacing: .04em; text-transform: uppercase; color: var(--color-foreground); white-space: nowrap; }
  .docs-card h3 { max-width: 24ch; margin: 14px 0 10px; font-size: 1.4rem; }
  .docs-card-outcome { margin: 0; font-size: .9375rem; line-height: 1.55; }
  .docs-card-needs { margin: 12px 0 0; font-size: .875rem; line-height: 1.5; color: var(--color-muted); }
  .docs-card-needs strong { color: var(--color-foreground); }
  .docs-card-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: auto; padding-top: 18px; }
  .docs-card-actions .button, .docs-card-actions button { min-height: 44px; padding: 10px 16px; font-size: 1rem; }
  .docs-card-route { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 10px 16px; border: 1px solid var(--color-control-border); border-radius: 6px; background: transparent; color: var(--color-foreground); font: 600 1rem/1.5 system-ui, sans-serif; }
  .docs-card-route:hover { background: var(--color-selected); }
  .docs-hub:not([data-enhanced]) .docs-card-route { border-color: var(--color-action); background: var(--color-action); color: var(--color-on-action); }
  .docs-card-status { margin: 10px 0 0; font-size: .875rem; line-height: 1.5; color: var(--color-accent); }
  .docs-card-status[data-copy-state="copied"] { color: var(--color-success); }
  .docs-card-status[data-copy-state="failed"] { padding-left: 10px; border-left: 3px solid var(--color-accent); color: var(--color-foreground); }
  .docs-card-status:empty { display: none; }
  .docs-card-actions button[data-copy-state="failed"] { border: 1px solid var(--color-accent); }
  .docs-card-actions button[data-copy-state="copied"] { border: 1px solid var(--color-success); }
  .docs-card-also { margin: 10px 0 0; font-size: .875rem; line-height: 1.45; }
  .docs-card-also a { display: inline-flex; align-items: center; min-height: 32px; color: var(--color-accent); }
  .docs-card-more { margin: 14px 0 0; font-size: .875rem; }
  .docs-card-more a { display: inline-flex; align-items: center; min-height: 32px; color: var(--color-accent); }

  .docs-task-details { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--color-border); }
  .docs-task-detail { margin: 0; border-bottom: 1px solid var(--color-border); }
  .docs-task-detail summary { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 16px; align-items: baseline; padding: 18px 0; }
  .docs-task-detail summary::marker { color: var(--color-accent); }
  .docs-summary-number { color: var(--color-accent); font: 600 .875rem/1.2 system-ui, sans-serif; letter-spacing: .1em; }
  .docs-summary-title { font: 600 1.1rem/1.35 Space, system-ui, sans-serif; }
  .docs-summary-hint { grid-column: 2; font-size: .875rem; font-weight: 400; color: var(--color-muted); }
  .docs-task-body { padding: 0 0 30px; }
  .docs-task-body h3 { margin: 24px 0 8px; font: 650 .875rem/1.4 system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--color-muted); }
  .docs-task-outcome { margin: 0; font-size: 1.05rem; }
  .docs-task-body ul { max-width: 72ch; margin: 8px 0 0; padding-left: 20px; font-size: .9375rem; }
  .docs-task-body li { margin: 6px 0; }
  .docs-task-body p { font-size: .9375rem; }
  .docs-task-promoteline { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 14px 0 0; color: var(--color-muted); }
  .docs-task-also, .docs-task-route { margin: 14px 0 0; }
  .docs-task-also a, .docs-task-route a { color: var(--color-accent); }
  .docs-task-route span { color: var(--color-muted); }
