---
import Base from '../layouts/Base.astro';
import { docsGuideLinks, docsReferenceSections, docsTaskPaths, docsUnavailable } from '../lib/docs-hub';
import { promptModule, renderPrompt } from '../lib/prompt-library';

const tasks = docsTaskPaths.map(task => {
  const prompt = promptModule(task.promptId);
  if (!prompt) throw new Error(`Documentation task ${task.id} points at an unknown prompt: ${task.promptId}`);
  return { ...task, prompt, template: renderPrompt(task.promptId, {}, { template: true }).text };
});
const totalLinks = docsReferenceSections.length + docsGuideLinks.length;
---
<Base title="Documentation: what do you want to make or do?" description="Choose a task, copy a maintained prompt for your own agent, and read the technical reference. Public, free to prepare, no model call.">
  <div class="docs-hub" data-docs-hub>
    <section class="docs-hero" aria-labelledby="docs-title">
      <p class="eyebrow">Documentation</p>
      <h1 id="docs-title">What do you want to make or do?</h1>
      <p class="lede">Use the agent you choose. Composer helps it work in your authorised environment, and the app, source and data stay yours.</p>
      <div class="docs-hero-actions">
        <a class="button" href="/prompts">Get a prompt for my agent</a>
      </div>

      <div class="docs-search" role="search" aria-label="Find a task or reference" data-docs-search data-docs-enhanced hidden>
        <label for="docs-search">Find your task</label>
        <div class="docs-search-row">
          <input id="docs-search" type="search" data-docs-query autocomplete="off" spellcheck="false" placeholder="Try “make a site”, “publish” or “fix a broken app”" />
          <button type="button" class="secondary" data-docs-clear hidden>Clear</button>
        </div>
        <p class="docs-search-count" role="status" aria-live="polite" data-docs-count></p>
        <div class="docs-chips">
          <span>Try</span>
          {['make a site', 'publish', 'fix a broken app', 'new to agents', 'add a form', 'MCP'].map(example => <button type="button" data-docs-example={example}>{example}</button>)}
        </div>
      </div>
      <p class="docs-empty" data-docs-empty hidden>No match. <a href="/prompts">The prompt library</a> lists every job, and <a href="/ready">Get Ready</a> starts with the environment.</p>
      <noscript>
        <p class="note">Search needs JavaScript. Everything below is plain HTML: six task paths, the full prompt templates, the commands and recovery notes, and the technical reference. Open “Preview the full prompt” to read or select a prompt.</p>
        <p class="note">Following an older link to one of this page’s former sections? Every section is preserved in <a href="/docs/how-it-works">How App Composer works</a>:{' '}
          {docsReferenceSections.map((section, index) => <span>{index ? ' · ' : ''}<a href={`/docs/how-it-works#${section.id}`}>{section.title}</a></span>)}
        </p>
      </noscript>

      <nav class="docs-index" aria-label="Six task paths" data-docs-group>
        <p class="docs-index-heading">Six starting points</p>
        <ol>
          {tasks.map((task, index) => (
            <li data-docs-index={task.id}>
              <a href={`#${task.anchor}`}><span class="docs-index-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{task.question}</span></a>
            </li>
          ))}
        </ol>
      </nav>

      <ol class="docs-flow" aria-label="How the work happens">
        <li><strong>Choose a job</strong>Start from your own words, not a product name.</li>
        <li><strong>Copy a prompt</strong>Use the maintained text, or add your details in the prompt library first.</li>
        <li><strong>Your agent works</strong>It inspects and changes only your authorised project and accounts.</li>
        <li><strong>Verify the result</strong>Check the real journey, not just a green build.</li>
        <li><strong>Come back</strong>Improve or operate the same app when it needs work.</li>
      </ol>
    </section>

    <section class="docs-tasks" id="tasks" data-docs-group aria-labelledby="docs-tasks-heading">
      <div class="docs-section-head">
        <h2 id="docs-tasks-heading">Six ways to start</h2>
        <p>Each path shows what you get, what you need, the canonical prompt and the next maintained page. Copying a prompt runs nothing.</p>
      </div>

      {tasks.map((task, index) => (
        <article class="docs-path" id={task.anchor} data-docs-task={task.id} aria-labelledby={`${task.anchor}-title`}>
          <header class="docs-path-head">
            <p class="docs-path-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
            <h3 id={`${task.anchor}-title`}>{task.question}</h3>
            <p class="docs-path-short">{task.short}</p>
          </header>
          <div class="docs-path-body">
            <p class="docs-path-outcome"><strong>You get.</strong> {task.outcome}</p>

            <h4>Before you start</h4>
            <ul class="docs-path-prereqs">
              {task.prerequisites.map(item => <li>{item}</li>)}
            </ul>

            <p class="docs-path-promptnote"><strong>Your agent will:</strong> {task.promptNote}</p>
            <p class="docs-path-promoteline"><span class="docs-badge">{task.prompt.support}</span><span>Canonical prompt: {task.prompt.title}</span></p>

            <div class="docs-path-actions">
              <button type="button" data-docs-copy={task.id} data-docs-enhanced aria-label={`Copy prompt template: ${task.question}`} aria-describedby={`${task.anchor}-copy-note ${task.anchor}-status`} hidden>Copy prompt template</button>
              <a class="docs-path-open" href={`/prompts#${task.promptId}`}>Open the prompt and add your details<span aria-hidden="true"> →</span></a>
            </div>
            <p class="docs-path-copy-note" id={`${task.anchor}-copy-note`}>Copies the canonical prompt template. The prompt library’s <strong>Copy template</strong> action produces this same text; its completed prompt includes any details you add there. Bracketed details are for your agent to inspect, or you can fill them in first. Copying runs nothing.</p>
            <p class="docs-path-status" role="status" aria-live="polite" aria-atomic="true" data-docs-status={task.id}></p>

            <details class="docs-prompt-preview" data-docs-details={task.id}>
              <summary>Preview the full prompt</summary>
              <pre class="docs-prompt-text" tabindex="0" role="region" aria-label={`Prompt template for: ${task.question}`} data-docs-prompt={task.id}>{task.template}</pre>
              <p class="note">Select the text and use your device’s Copy command if the copy button is unavailable. This always works, with or without JavaScript. This is a template, not a completed project-specific prompt.</p>
            </details>

            {task.also?.map(link => <p class="docs-path-also">Also for this task: <a href={link.href}>{link.label}<span aria-hidden="true"> →</span></a></p>)}
            <p class="docs-path-guide">Supporting guide: <a href={task.guide.href}>{task.guide.label}<span aria-hidden="true"> →</span></a> <span>{task.guide.note}</span></p>
            <p class="docs-path-next">Next step: <a href={task.next.href}>{task.next.label}<span aria-hidden="true"> →</span></a></p>
            <p class="docs-path-limit"><strong>Current limit.</strong> {task.limit}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="docs-operate" id="operate" aria-labelledby="docs-operate-heading">
      <div class="docs-section-head">
        <h2 id="docs-operate-heading">Browsing here, and changing your own project</h2>
        <p>This page reads and copies. It cannot install, deploy, spend or change an account. Those actions belong to your agent in your authorised environment.</p>
      </div>
      <div class="docs-operate-pair">
        <div>
          <h3>Works here, with no account</h3>
          <ul>
            <li>Read all six tasks and the {totalLinks} indexed reference and guide links.</li>
            <li>Search, filter and open any prompt template.</li>
            <li>Copy a template or select it by hand. Nothing runs and nothing is sent anywhere.</li>
            <li>Read the complete technical reference at <a href="/docs/how-it-works">How App Composer works</a>.</li>
          </ul>
        </div>
        <div>
          <h3>Needs your agent and your accounts</h3>
          <ul>
            <li>Inspecting or editing a real project on your machine.</li>
            <li>Creating Cloudflare resources, setting secrets or deploying.</li>
            <li>Installing tools, migrating data or spending with a provider.</li>
            <li>Publishing a page or revoking access. Each is a separate, explicit action.</li>
          </ul>
        </div>
      </div>
      <p class="docs-operate-rule">A copied prompt is a request, not authority. Your agent still follows the project’s own instructions, permissions and release path, and asks you for anything only a person can decide.</p>

      <details class="docs-operate-detail">
        <summary>Exact commands, file paths and failure recovery</summary>
        <div class="docs-operate-body">
          <h3>Run this documentation checkout</h3>
          <p>These commands build and check App Composer itself. They do not build your project, and <code>pnpm deploy</code> releases this site, never yours. Node 26.13.1 and pnpm 12.19.0 are the reviewed pair in <code>README.md</code>; the supported floors are Node 22.23.5+, 24.22.3+ or 26.13.1+.</p>
          <pre tabindex="0" role="region" aria-label="Exact App Composer commands"><code>{`# install the pinned dependencies once
pnpm install --frozen-lockfile

# run the source checks, then local Astro on 127.0.0.1
pnpm dev

# the maintained release gate: types, lint, format and the retained suite
pnpm check

# iterate on one test file without pretending it is the release gate
pnpm check:fast -- tests/docs-hub.test.mjs

# build the public artifact, or run the guarded production release
pnpm build
pnpm deploy`}</code></pre>
          <h3>Where the words live</h3>
          <dl class="docs-files">
            <div><dt><code>src/pages/docs.astro</code></dt><dd>This hub: the six tasks, the commands and the reference index.</dd></div>
            <div><dt><code>src/lib/docs-hub.ts</code></dt><dd>Task records, task terms and the local, deterministic search. No model call.</dd></div>
            <div><dt><code>src/lib/docs-hub-client.ts</code></dt><dd>Search filtering, the copy action and its manual fallback.</dd></div>
            <div><dt><code>src/lib/prompt-library.ts</code></dt><dd>The canonical prompt text. This page renders these modules and never forks their prose.</dd></div>
            <div><dt><code>tests/docs-hub.test.mjs</code></dt><dd>Regressions for the tasks, anchors, canonical prompts, search fixtures and this copy behaviour.</dd></div>
            <div><dt><code>docs/STATUS.md</code></dt><dd>What is actually delivered, with dates and remaining gates.</dd></div>
            <div><dt><code>wrangler.jsonc</code></dt><dd>The Worker entry, bindings and environment configuration for this deployment.</dd></div>
          </dl>
          <h3>When something fails</h3>
          <dl class="docs-faults">
            <div><dt>The copy button does nothing</dt><dd>The browser refused clipboard access. The full prompt opens and is selected below the task; copy it with Cmd/Ctrl+C or your device’s copy menu. The status line says which happened.</dd></div>
            <div><dt>Search is missing</dt><dd>JavaScript is off or blocked. The six tasks, prompts, commands and reference are still readable HTML; open any “Preview the full prompt” disclosure.</dd></div>
            <div><dt>An old anchor link from the former documentation page</dt><dd>It forwards to the matching section of <a href="/docs/how-it-works">/docs/how-it-works</a>. Every former anchor is preserved.</dd></div>
            <div><dt>The Node version is unsupported</dt><dd>Install a supported floor (22.23.5+, 24.22.3+ or 26.13.1+) and rerun. <code>.node-version</code> selects the reviewed default.</dd></div>
            <div><dt>The release is refused</dt><dd>The guard needs a clean, pushed <code>main</code>. Commit and push first; do not bypass it to reach production.</dd></div>
            <div><dt>A task or guide link 404s</dt><dd>Report it rather than inventing a route. The reference and guide index above is the maintained list.</dd></div>
          </dl>
        </div>
      </details>
    </section>

    <section class="docs-reference" id="reference" data-docs-group aria-labelledby="docs-reference-heading">
      <div class="docs-section-head">
        <h2 id="docs-reference-heading">Technical reference</h2>
        <p>The exact behaviour behind each task. The complete former <code>/docs</code> article is preserved at <a href="/docs/how-it-works">How App Composer works</a>, including MCP, app contracts, updates and content projects.</p>
      </div>
      <div class="docs-reference-columns">
        <div data-docs-group>
          <h3>How it works</h3>
          <ul>
            {docsReferenceSections.map(section => (
              <li data-docs-section={section.id}><a href={`/docs/how-it-works#${section.id}`}>{section.title}</a><p>{section.summary}</p></li>
            ))}
          </ul>
        </div>
        <div data-docs-group>
          <h3>Guides and tools</h3>
          <ul>
            {docsGuideLinks.map(link => (
              <li data-docs-guide={link.id}><a href={link.href}>{link.label}</a><p>{link.summary}</p></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="docs-unavailable" data-docs-group aria-labelledby="docs-unavailable-heading">
      <div class="docs-section-head">
        <h2 id="docs-unavailable-heading">Not available yet</h2>
        <p>These requests come up often. They are named here so an empty search never turns into a made-up feature.</p>
      </div>
      <ul>
        {docsUnavailable.map(item => (
          <li data-docs-unavailable={item.id}>
            <h3>{item.request}</h3>
            <p>{item.explanation}</p>
            <p>Closest working route: <a href={item.closest.href}>{item.closest.label}<span aria-hidden="true"> →</span></a></p>
          </li>
        ))}
      </ul>
    </section>

    <p class="docs-reviewed">Reviewed 16 November 2026. Task prompts are rendered from the maintained prompt library, so this page cannot drift from <a href="/prompts">the prompt library</a>. {totalLinks} reference and guide links are indexed by the local search above; nothing is sent anywhere.</p>
  </div>
</Base>

<script>
  import '../lib/docs-hub-client';
</script>

<style>
  .docs-hub { min-width: 0; }
  .eyebrow { font-size: 13px; letter-spacing: .09em; text-transform: uppercase; color: var(--color-muted); margin: 0; }
  .docs-hero { padding-bottom: 8px; }
  .docs-hero h1 { font-size: clamp(2.4rem, 5vw, 3.9rem); max-width: 26ch; margin: 10px 0 20px; line-height: 1.04; }
  .docs-hero .lede { max-width: 58ch; }
  .docs-hero-actions { display: flex; align-items: center; gap: 12px 24px; flex-wrap: wrap; margin: 22px 0 24px; }
    .docs-search { max-width: 760px; margin: 0 0 28px; padding: 20px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface); }
  .docs-search label { margin: 0; font-size: .95rem; font-weight: 650; }
  .docs-search-row { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
  .docs-search-row input { margin-top: 0; }
  .docs-search-row button { flex: none; }
  .docs-search-count { min-height: 1.4em; margin: 10px 0 0; font-size: .85rem; color: var(--color-muted); }
  .docs-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 12px; font-size: .82rem; color: var(--color-muted); }
  .docs-chips button { min-height: 44px; padding: 6px 12px; border: 1px solid var(--color-control-border); background: transparent; color: var(--color-foreground); font: inherit; }
  .docs-chips button:hover { background: var(--color-selected); }
  .docs-index { display: block; margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--color-border); }
  .docs-index-heading { max-width: none; margin: 0 0 12px; font: 650 .85rem/1.4 system-ui, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--color-muted); }
  .docs-index ol { display: grid; grid-template-columns: 1fr 1fr; gap: 0 40px; max-width: none; margin: 0; padding: 0; list-style: none; }
  .docs-index a { display: flex; align-items: baseline; gap: 14px; min-height: 44px; padding: 8px 0; border-bottom: 1px solid var(--color-border); font-weight: 600; color: var(--color-foreground); }
  .docs-index a:hover { color: var(--color-accent); }
  .docs-index-number { flex: none; font: 500 .8rem/1 system-ui, sans-serif; letter-spacing: .08em; color: var(--color-accent); }
  .docs-flow { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; max-width: none; margin: 32px 0 0; padding: 24px 0 0; border-top: 1px solid var(--color-border); list-style: none; }
  .docs-flow li { margin: 0; font-size: .88rem; line-height: 1.5; color: var(--color-muted); }
  .docs-flow strong { display: block; margin-bottom: 4px; color: var(--color-foreground); font: 600 .98rem/1.3 system-ui, sans-serif; }
  .docs-tasks { margin-top: 56px; }
  .docs-section-head { max-width: 78ch; }
  .docs-section-head h2 { max-width: 22ch; }
  .docs-section-head p { margin: 0 0 8px; color: var(--color-muted); }
  .docs-path { display: grid; grid-template-columns: minmax(0, 240px) minmax(0, 1fr); gap: 36px; padding: 36px 0; border-top: 1px solid var(--color-border); scroll-margin-top: 24px; }
  .docs-path-number { margin: 0; font: 500 .8rem/1 system-ui, sans-serif; letter-spacing: .1em; color: var(--color-accent); }
  .docs-path h3 { max-width: 18ch; margin: 8px 0 10px; font-size: clamp(1.65rem, 2.6vw, 2.25rem); }
  .docs-path-short { margin: 0; font-size: .92rem; color: var(--color-muted); }
  .docs-path-body { min-width: 0; }
  .docs-path-outcome { margin: 0; font-size: 1.05rem; }
  .docs-path h4 { margin: 24px 0 8px; font: 650 .8rem/1.4 system-ui, sans-serif; letter-spacing: .07em; text-transform: uppercase; color: var(--color-muted); }
  .docs-path-prereqs { max-width: none; margin: 0; padding-left: 20px; font-size: .95rem; }
  .docs-path-prereqs li { margin: 6px 0; }
  .docs-path-promptnote { margin: 24px 0 0; padding: 16px 18px; border-left: 3px solid var(--color-accent); background: var(--color-surface); font-size: .95rem; }
  .docs-path-promoteline { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 16px 0 0; font-size: .85rem; color: var(--color-muted); }
  .docs-badge { display: inline-block; padding: 6px 8px; border: 1px solid var(--color-control-border); border-radius: 4px; font: 600 .72rem/1 system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--color-foreground); }
  .docs-path-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 18px; }
  .docs-path-open { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-accent); }
  .docs-path-copy-note { max-width: 62ch; margin: 10px 0 0; font-size: .82rem; color: var(--color-muted); }
  .docs-path-status { margin: 10px 0 0; font-size: .9rem; color: var(--color-accent); }
  .docs-path-status[data-copy-state="copied"] { color: var(--color-success); }
  .docs-path-status[data-copy-state="failed"] { padding-left: 10px; border-left: 3px solid var(--color-accent); color: var(--color-foreground); }
  .docs-path-status:empty { display: none; }
  .docs-path-actions button[data-copy-state="failed"] { border-color: var(--color-accent); }
  .docs-path-actions button[data-copy-state="copied"] { border-color: var(--color-success); }
  .docs-prompt-preview { margin: 18px 0 0; padding: 8px 0; border-block: 1px solid var(--color-border); }
  .docs-prompt-preview summary { font-size: .9rem; }
  .docs-prompt-text { max-height: 320px; margin: 8px 0 0; font: .82rem/1.6 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .docs-path-also { margin: 20px 0 0; font-size: .92rem; color: var(--color-muted); }
  .docs-path-also a { color: var(--color-accent); }
  .docs-path-guide { margin: 12px 0 0; font-size: .92rem; }
  .docs-path-guide a, .docs-path-next a { color: var(--color-accent); }
  .docs-path-guide span { color: var(--color-muted); }
  .docs-path-next { margin: 10px 0 0; font-size: .92rem; }
  .docs-path-limit { margin: 20px 0 0; padding-top: 14px; border-top: 1px solid var(--color-border); font-size: .85rem; color: var(--color-muted); }
  .docs-path-limit strong { color: var(--color-foreground); }
  .docs-operate { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--color-border); }
  .docs-operate-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 32px 48px; margin-top: 24px; }
  .docs-operate-pair h3 { margin: 0 0 8px; font-size: 1.15rem; }
  .docs-operate-pair ul { max-width: 52ch; margin: 0; padding-left: 20px; font-size: .92rem; }
  .docs-operate-pair li { margin: 8px 0; }
  .docs-operate-pair li:first-child { margin-top: 0; }
  .docs-operate-rule { margin: 24px 0 0; padding: 16px 18px; border-left: 3px solid var(--color-accent); background: var(--color-surface); font-size: .92rem; }
  .docs-operate-detail { margin-top: 26px; border-block: 1px solid var(--color-border); padding: 8px 0; }
  .docs-operate-detail summary { font-size: .95rem; }
  .docs-operate-body { padding: 0 0 12px; }
  .docs-operate-body h3 { margin: 26px 0 10px; font: 650 .8rem/1.4 system-ui, sans-serif; letter-spacing: .07em; text-transform: uppercase; color: var(--color-muted); }
  .docs-operate-body h3:first-child { margin-top: 12px; }
  .docs-operate-body p { font-size: .92rem; }
  .docs-operate-body pre { max-height: 360px; margin: 12px 0 0; }
  .docs-files, .docs-faults { display: grid; gap: 0; max-width: 72ch; margin: 0; }
  .docs-files div, .docs-faults div { padding: 12px 0; border-top: 1px solid var(--color-border); }
  .docs-files dt, .docs-faults dt { margin: 0 0 4px; font: 600 .86rem/1.5 system-ui, sans-serif; }
  .docs-files dd, .docs-faults dd { margin: 0; font-size: .88rem; color: var(--color-muted); }
  .docs-files dd code { color: var(--color-foreground); }
  .docs-reference { margin-top: 64px; }
  .docs-reference-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 28px; }
  .docs-reference h3 { margin: 0 0 10px; font-size: 1.25rem; }
  .docs-reference ul { max-width: none; margin: 0; padding: 0; list-style: none; }
  .docs-reference li { margin: 0; padding: 10px 0; border-bottom: 1px solid var(--color-border); }
  .docs-reference li a { display: inline-flex; align-items: center; min-height: 32px; color: var(--color-accent); }
  .docs-reference li p { max-width: 48ch; margin: 2px 0 0; font-size: .82rem; color: var(--color-muted); }
  .docs-empty { margin: 0 0 8px; padding: 16px 18px; border: 1px solid var(--color-border); border-left: 3px solid var(--color-accent); border-radius: 6px; }
  .docs-unavailable { margin-top: 56px; }
  .docs-unavailable ul { max-width: none; margin: 24px 0 0; padding: 0; list-style: none; }
  .docs-unavailable li { padding: 20px 0; border-top: 1px solid var(--color-border); }
  .docs-unavailable h3 { margin: 0 0 6px; font: 600 1.05rem/1.4 system-ui, sans-serif; letter-spacing: 0; }
  .docs-unavailable li p { margin: 6px 0 0; font-size: .9rem; }
  .docs-unavailable li p:last-child { color: var(--color-muted); }
  .docs-unavailable a { color: var(--color-accent); }
  .docs-reviewed { margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--color-border); font-size: .85rem; color: var(--color-muted); }
  @media (max-width: 900px) {
    .docs-path { grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 28px 0; }
    .docs-index ol { grid-template-columns: 1fr; }
    .docs-flow { grid-template-columns: 1fr 1fr; gap: 14px 24px; }
    .docs-reference-columns { grid-template-columns: 1fr; gap: 28px; }
    .docs-operate-pair { grid-template-columns: 1fr; gap: 24px; }
  }
