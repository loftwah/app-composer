---
import Base from '../../layouts/Base.astro';
import VisualBoard from '../../components/VisualBoard.astro';
import { creatorHubCollection, creatorHubMedia } from '../../lib/visual-collections';
import { ArrowLeft, Copy, Download } from '@lucide/astro';

const story = 'https://composer.loftwah.com/creator-hub';
const { card, clip, poster } = creatorHubMedia;
const sourceLink = (source: string) => story + '?' + new URLSearchParams({
  utm_source: source,
  utm_medium: 'social',
  utm_campaign: 'creator_hub',
});

const channels = [
  {
    id: 'x',
    name: 'X / Twitter',
    format: 'Link post',
    label: 'Post',
    copy: 'What if a product demo opened as something you could actually edit? Creator Hub shows a working profile and moderated guestbook. Try the same setup in App Composer. Your saved draft stays yours.',
  },
  {
    id: 'linkedin',
    name: 'LinkedIn',
    format: 'Link post',
    label: 'Post',
    copy: 'A demo should show what you can keep and change.\n\nCreator Hub gives a fictional ceramicist a profile and a moderated guestbook. Each app keeps its own source, data and release. In App Composer you can open the same setup, adapt it, and give your agent the build plan.\n\nThe walkthrough shows what the owner does and where the agent takes over.',
  },
  {
    id: 'facebook',
    name: 'Facebook',
    format: 'Link post',
    label: 'Post',
    copy: 'Imagine a small studio website with a guestbook. People can leave a note, and you choose what goes public. We built one for Mara Quinn, a fictional ceramicist. Have a look around, then try a copy of the setup for your own project.',
  },
  {
    id: 'tiktok',
    name: 'TikTok',
    format: 'Vertical video',
    label: 'Caption',
    copy: 'Ever clicked a demo and thought, can I start with that? Here’s what happens when you try the Creator Hub setup. The two apps load together and your saved draft stays put until you save.',
  },
  {
    id: 'instagram',
    name: 'Instagram',
    format: 'Reel',
    label: 'Caption',
    copy: 'A home for your work. A place for people to leave a note. Mara Quinn’s studio is fictional, and the two apps are live. Watch how the example becomes a draft you can make your own. Find Creator Hub at composer.loftwah.com.',
  },
  {
    id: 'youtube',
    name: 'YouTube',
    format: 'Short',
    label: 'Description',
    title: 'Turn a live demo into your own app draft',
    copy: 'See a live creator profile, open its two-app setup in App Composer, then turn the sample into a plan your agent can follow. Creator Hub is a fictional reference build. Find it at composer.loftwah.com.',
  },
].map((channel) => ({
  ...channel,
  linkPost: channel.format === 'Link post',
  link: sourceLink(channel.id),
}));
---

<Base
  title="Creator Hub board"
  description="Browse and save pins from the Creator Hub reference build. Open the live apps, watch the walkthrough or copy a social draft."
  shareImage={'https://composer.loftwah.com' + card}
  shareType="image/jpeg"
  shareAlt="Creator Hub's working profile for fictional ceramicist Mara Quinn."
>
  <article class="share-kit">
    <div class="board-breadcrumb">
      <a class="back-link" href="/collections"><ArrowLeft size={16} aria-hidden="true" /> All collections</a>
      <a href="/creator-hub">Creator Hub case study</a>
    </div>
    <div class="board-header">
      <div>
        <h1>Creator Hub board</h1>
        <p class="lede">Explore the live apps, the draft behind them and the pieces you can share.</p>
      </div>
      <a class="button secondary" href="#post-drafts">Social drafts</a>
    </div>
    <VisualBoard collection={creatorHubCollection} />
    <div class="share-layout">
      <section class="clip-panel" id="walkthrough-film" tabindex="-1" aria-labelledby="clip-heading">
        <h2 id="clip-heading">From live example to your draft</h2>
        <video controls playsinline preload="none" width="1080" height="1920" poster={poster} aria-labelledby="clip-heading">
          <source src={clip} type="video/mp4" />
          <a href={clip}>Open the video</a>
        </video>
        <p class="small">22 seconds · Silent with on-screen captions · Live screen captures</p>
        <a class="button secondary" href={clip} download><Download size={16} aria-hidden="true" /> Download video</a>
        <details>
          <summary>Read the walkthrough</summary>
          <ol>
            <li>Open Mara Quinn’s live reference profile.</li>
            <li>On the Creator Hub case study, choose <strong>Try this setup</strong>.</li>
            <li>Keep your current draft or load the sample. Your saved draft stays intact until you save.</li>
            <li>Make it yours, then copy the two-app plan to your agent.</li>
          </ol>
        </details>
        <details class="link-image">
          <summary>Preview the link image</summary>
          <img src={card} width="1200" height="630" loading="lazy" alt="Creator Hub card showing Mara Quinn’s live profile and the two apps behind it." />
        </details>
      </section>
      <section class="channel-panel" id="post-drafts" tabindex="-1" aria-labelledby="channels-heading" data-channels>
        <h2 id="channels-heading">Choose a channel</h2>
        <div class="channel-controls" data-channel-controls hidden>
          {channels.map(({ id, name }) => (
            <button type="button" data-channel={id} aria-controls={'share-' + id} aria-pressed="false">{name}</button>
          ))}
        </div>
        {channels.map((channel) => (
          <section class="channel-draft" id={'share-' + channel.id} data-draft={channel.id} aria-labelledby={'title-' + channel.id}>
            <div class="channel-heading">
              <h3 id={'title-' + channel.id}>{channel.name}</h3>
              <span>{channel.format}</span>
            </div>
            {channel.title && <div class="post-title">
              <p class="small">Title</p>
              <p data-copy-text="title">{channel.title}</p>
              <button class="secondary" type="button" data-copy="title" hidden>Copy title</button>
            </div>}
            <p class="post-text" data-copy-text="post">{channel.copy}{channel.linkPost && '\n\n' + channel.link}</p>
            <div class="post-actions">
              <button type="button" data-copy="post" hidden><Copy size={16} aria-hidden="true" /> Copy {channel.label.toLowerCase()}</button>
              {channel.linkPost
                ? <a class="button secondary" href={card} download>Download link image</a>
                : <button class="secondary" type="button" data-copy="link" data-link={channel.link} hidden>Copy walkthrough link</button>}
            </div>
            {!channel.linkPost && <p class="small">Use the video above. Add the walkthrough link where your account supports links.</p>}
          </section>
        ))}
        <p class="copy-status small" role="status" data-copy-status></p>
      </section>
    </div>
  </article>
</Base>

<script>
  const channels = document.querySelector<HTMLElement>('[data-channels]');
  if (channels) {
    const controls = channels.querySelector<HTMLElement>('[data-channel-controls]')!;
    const choices = [...controls.querySelectorAll<HTMLButtonElement>('[data-channel]')];
    const drafts = [...channels.querySelectorAll<HTMLElement>('[data-draft]')];
    const status = channels.querySelector<HTMLElement>('[data-copy-status]')!;

    function selectChannel(id: string) {
      for (const choice of choices) choice.setAttribute('aria-pressed', String(choice.dataset.channel === id));
      for (const draft of drafts) draft.hidden = draft.dataset.draft !== id;
      status.textContent = '';
    }

    for (const choice of choices) choice.addEventListener('click', () => selectChannel(choice.dataset.channel!));
    for (const button of channels.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        const kind = button.dataset.copy;
        const text = button.closest('[data-draft]')?.querySelector<HTMLElement>(`[data-copy-text="${kind}"]`);
        const content = button.dataset.link ?? text?.textContent?.trim();
        if (!content) return;
        try {
          await navigator.clipboard.writeText(content);
          status.textContent = 'Copied to clipboard.';
        } catch {
          if (text) {
            const range = document.createRange();
            range.selectNodeContents(text);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
          }
          status.textContent = text ? 'Copy the selected text with your browser.' : 'Copy this link manually: ' + content;
        }
      });
    }
    controls.hidden = false;
    selectChannel('x');
  }
</script>

<style>
  .share-kit { max-width: 1220px; }
  .board-header { display: flex; align-items: end; justify-content: space-between; gap: 16px; padding: 0 0 20px; }
  .board-header > a { flex-shrink: 0; }
  .board-breadcrumb { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-bottom: 20px; }
  .back-link { display: inline-flex; gap: 7px; align-items: center; }
  h1 { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1; margin: 0 0 16px; }
  .lede { max-width: 55ch; margin: 0; }
  .share-layout { display: grid; grid-template-columns: minmax(250px, .7fr) minmax(0, 1fr); gap: clamp(26px, 5vw, 70px); border-top: 1px solid var(--color-border); padding-top: 24px; margin-top: 36px; }
  h2 { font-size: 1.4rem; margin: 0 0 16px; }
  video { display: block; width: min(100%, 310px); height: auto; aspect-ratio: 9 / 16; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); }
  .clip-panel > .small { max-width: 33ch; }
  details { margin-top: 16px; }
  summary { cursor: pointer; }
  .link-image img { display: block; width: 100%; height: auto; margin-top: 12px; border-radius: 8px; }
  .channel-controls { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .channel-controls button { min-height: 44px; padding: 8px 13px; color: var(--color-foreground); background: var(--color-surface); border: 1px solid var(--color-control-border); }
  .channel-controls button[aria-pressed="true"] { background: var(--color-action); color: var(--color-on-action); border-color: var(--color-action); }
  .channel-draft { border-top: 1px solid var(--color-border); padding: 16px 0 0; }
  .channel-heading { display: flex; flex-wrap: wrap; gap: 3px 16px; align-items: baseline; }
  .channel-heading h3 { margin: 0; font-size: 1.3rem; }
  .channel-heading span { color: var(--color-muted); font-size: .9rem; }
  .post-text { white-space: pre-wrap; overflow-wrap: anywhere; margin: 16px 0 20px; max-width: 62ch; }
  .post-title { margin-top: 16px; }
  .post-title p { margin: 0 0 4px; }
  .post-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .copy-status { min-height: 1.6em; overflow-wrap: anywhere; }
  [hidden] { display: none !important; }
  @media (max-width: 680px) {
    .board-header { align-items: flex-start; flex-direction: column; }
    .share-layout { grid-template-columns: minmax(0, 1fr); }
    .channel-panel { border-top: 1px solid var(--color-border); padding-top: 20px; }
  }
</style>
