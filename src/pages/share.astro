---
import Base from '../layouts/Base.astro';
import ShareArtwork from '../components/ShareArtwork.astro';
import { env } from 'cloudflare:workers';
import type { D1Database } from '@cloudflare/workers-types';
import { listShareArtwork, SHARE_CATALOGUE_ORIGIN } from '../lib/share-catalogue-asset.ts';
import { artworkFilters, galleryPage, readArtworkCuration } from '../lib/share-gallery.ts';
import { noindexFor } from '../lib/indexing.mjs';
import { hasShareWallFilters, shareWallQuery } from '../lib/share-wall.ts';

const params = Astro.url.searchParams;
if (params.get('view') === 'films') return Astro.redirect('/media-studio/films', 308);
if (params.get('view') === 'stacks' || hasShareWallFilters(shareWallQuery(params))) {
  const filters = new URLSearchParams();
  for (const name of ['q', 'app', 'theme']) {
    const value = params.get(name);
    if (value) filters.set(name, value);
  }
  return Astro.redirect(filters.size ? `/studio/published?${filters}` : '/studio/published', 308);
}
const filters = artworkFilters(params);
const [artwork, curation] = await Promise.all([
  listShareArtwork(),
  readArtworkCuration((env as unknown as {DB?: D1Database}).DB).catch(() => []),
]);
const catalogue = artwork ? galleryPage(artwork, curation, filters) : null;
if (!catalogue) Astro.response.status = 503;
Astro.csp?.insertDirective(`img-src ${SHARE_CATALOGUE_ORIGIN}/campaign/`);
---

<Base title="Share artwork" description="Browse public artwork from our projects and share a piece with its credit intact."
  noindex={noindexFor(Astro.url.hostname, Boolean(catalogue) && params.size === 0)}>
  <div class="share-artwork-library">
    <ShareArtwork catalogue={catalogue} filters={filters} />
  </div>
</Base>

<script>
  // The original bookmark fragments are only available to the browser.
  const moved: Record<string, string> = {
    '#films': '/media-studio/films',
    '#my-feedback': '/media-studio/films#my-feedback',
    '#published-stacks': '/studio/published',
  };
  if (Object.hasOwn(moved, location.hash)) location.replace(moved[location.hash]);
</script>

<style>
  :global(main:has(> .share-artwork-library)) {
    max-width: none;
    padding: clamp(1.35rem, 3.7vw, 3.5rem) clamp(1rem, 4vw, 4.5rem) 4rem;
  }
  :global(main:has([data-artwork-auto])) {
    padding-bottom: 1rem;
  }
  :global(main:has([data-artwork-auto]) + footer) {
    display: none;
  }
</style>
