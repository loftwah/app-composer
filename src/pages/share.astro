---
// The public Share wall. It lists exactly the stacks publicStack() can serve:
// the current published revision, newest publication first. Search and filters
// are a plain GET form, so a narrowed view is a link and every card works
// without JavaScript.
import Base from '../layouts/Base.astro';
import ShareFilmFeedback from '../components/ShareFilmFeedback.astro';
import ShareFilmVotes from '../components/ShareFilmVotes.astro';
import { shareFilms, studioFilmPath } from '../lib/share-films.ts';
import { ArrowUpRight, Search } from '@lucide/astro';
import type { D1Database } from '@cloudflare/workers-types';
import { env } from 'cloudflare:workers';
import { PUBLIC_STACK_LIMIT, publicStacks } from '../lib/stacks.mjs';
import { stackShareDetails } from '../lib/stack-sharing.ts';
import { noindexFor } from '../lib/indexing.mjs';
import {
  filterShareWall,
  hasShareWallFilters,
  shareWallCard,
  shareWallEmptyCopy,
  shareWallOptions,
  shareWallQuery,
  shareWallSummary,
  type ShareWallCard,
} from '../lib/share-wall.ts';

const query = shareWallQuery(Astro.url.searchParams);
const runtime = env as unknown as { DB?: D1Database };
let cards: ShareWallCard[] = [];
let unavailable = false;
if (!runtime.DB || typeof runtime.DB.prepare !== 'function') {
  unavailable = true;
} else {
  try {
    const stacks = await publicStacks(runtime.DB, PUBLIC_STACK_LIMIT);
    // The share image identity is bound to the exact publication, so a later
    // draft cannot change the pixels behind a card that is already on the wall.
    cards = await Promise.all(
      stacks.map(async (stack) => {
        const share = await stackShareDetails(stack);
        return shareWallCard(stack, share.imagePath);
      }),
    );
  } catch {
    unavailable = true;
  }
}
if (unavailable) Astro.response.status = 503;

const shown = filterShareWall(cards, query);
const options = shareWallOptions(cards, query);
const filtered = hasShareWallFilters(query);
const empty = shareWallEmptyCopy(cards.length, query);
const truncated = cards.length === PUBLIC_STACK_LIMIT;
const title = unavailable ? 'Share wall temporarily unavailable' : 'Share wall';
const description = unavailable
  ? 'The published creator stack wall is temporarily unavailable because the workspace database did not answer.'
  : 'Watch and share short films about App Composer and Media Studio, or browse published creator stacks.';
const [featuredFilm, ...films] = shareFilms;
const studioFilm = studioFilmPath;
const canReview = Boolean(Astro.locals.user);
Astro.response.headers.set("Vary", "Cookie");
// Base supplies the approved 1200x630 product share card; the wall has no
// separate artwork, so its preview stays the real product card.
---

<Base title={title} description={description} noindex={noindexFor(Astro.url.hostname, !unavailable)}>
  {unavailable ? (
    <section class="wall-state">
      <h1>The share wall is temporarily unavailable.</h1>
      <p class="lede">The workspace database did not answer, so nothing is shown in its place. Try again shortly.</p>
      <div class="actions"><a class="button" href="/share">Try this page again</a><a class="button secondary" href="/studio">About creator stacks</a></div>
    </section>
  ) : (
    <>
      <header class="wall-heading">
        <div>
          <h1>Share</h1>
        </div>
        <div class="wall-intro">
          <p>Browse artwork, films and published stacks from our projects.</p>
          <nav aria-label="Share sections"><a href={filtered ? "/share#films" : "#films"}>Watch films</a><a href="/share/artwork">Browse artwork <ArrowUpRight size={15} aria-hidden="true" /></a><a href="#published-stacks">Browse stacks</a>{canReview && <a href={filtered ? "/share#my-feedback" : "#my-feedback"}>Your feedback</a>}</nav>
        </div>
      </header>

      {!filtered && (
        <section class="wall-films" id="films" aria-labelledby="films-heading">
          <h2 id="films-heading">Short films and demos</h2>
          <div class="wall-film-layout">
            <article class="wall-featured-film" aria-labelledby="studio-film-heading">
              <video controls playsinline preload="none" poster={`${studioFilm}.jpg`} width="1080" height="1920" aria-labelledby="studio-film-heading">
                <source src={`${studioFilm}.mp4`} type="video/mp4" />
                <track kind="captions" src={`${studioFilm}.vtt`} srclang="en" label="English captions" />
                <a href={`${studioFilm}.mp4`}>Watch the social-kit film</a>
              </video>
              <div>
                <h3 id="studio-film-heading">One image. Four social sizes.</h3>
                <p>17 seconds. Watch Image Tools turn one PNG into four WebPs and a downloadable ZIP.</p>
                <p class="small">Music by LoftwahFM · Pixel Box Theory</p>
                <div class="wall-film-links">
                  <a href={`${studioFilm}.mp4`} download>Download video</a>
                  <a href="https://media.loftwah.com/tools/images">Try Image Tools</a>
                </div>
                {canReview && <ShareFilmVotes film={featuredFilm} />}
              </div>
            </article>
            <ul class="wall-film-list" role="list">
              {films.map((film) => (
                <li><a href={film.href}>{film.title} <ArrowUpRight size={16} aria-hidden="true" /></a><p>{film.detail}</p>{canReview && <ShareFilmVotes film={film} />}</li>
              ))}
            </ul>
          </div>
          <p><a href="https://media.loftwah.com/gallery">Browse the Media Studio gallery</a></p>
          {canReview ? <ShareFilmFeedback /> : <p><a href="/_emdash/admin/login?redirect=/share">Sign in to give private film feedback</a></p>}
        </section>
      )}
      <div id="published-stacks" class="wall-stacks-heading">
        <h2>Published creator stacks</h2>
        <a href="/studio">Build your own stack</a>
      </div>

      <form class="wall-controls" method="get" action="/share" role="search" aria-label="Filter published stacks" data-share-wall-form>
        <label class="wall-search">
          <span class="icon-label"><Search size={16} aria-hidden="true" />Search stacks</span>
          <input type="search" name="q" value={query.query} placeholder="Name or description" maxlength="80" autocomplete="off" />
        </label>
        <label>
          App
          <select name="app">
            <option value="">All apps</option>
            {options.apps.map((option) => <option value={option.value} selected={option.value === query.app}>{option.label}</option>)}
          </select>
        </label>
        <label>
          Page theme
          <select name="theme">
            <option value="">Both themes</option>
            {options.themes.map((option) => <option value={option.value} selected={option.value === query.theme}>{option.label}</option>)}
          </select>
        </label>
        <div class="wall-control-actions">
          <button type="submit">Show stacks</button>
          {filtered && <a class="wall-clear" href="/share">Clear filters</a>}
        </div>
      </form>

      {shown.length ? (
        <>
          <p class="wall-summary">{shareWallSummary(cards.length, shown.length, query)}</p>
          <div class="wall-grid">
            {shown.map((card) => (
              <article class="wall-card">
                <a class="wall-card-link" href={`/s/${card.slug}`}>
                  <img class="wall-card-image" src={card.imagePath} width="1200" height="630" alt="" loading="lazy" decoding="async" />
                  <div class="wall-card-body">
                    <h2>{card.name}</h2>
                    <p class="wall-card-description">{card.description}</p>
                    {card.appsLabel && <p class="wall-card-apps">{card.appsLabel}</p>}
                    <p class="wall-card-meta">{card.published ? `Published ${card.published} · revision ${card.revision}` : `Revision ${card.revision}`}</p>
                    <span class="wall-card-open">Open stack <ArrowUpRight size={16} aria-hidden="true" /></span>
                  </div>
                </a>
              </article>
            ))}
          </div>
          {truncated && <p class="small">The wall shows the {PUBLIC_STACK_LIMIT} most recently published stacks. A stack page stays public at its own address.</p>}
        </>
      ) : (
        <section class="wall-state" aria-labelledby="wall-empty-heading">
          <h2 id="wall-empty-heading">{empty.heading}</h2>
          <p>{empty.body}</p>
          <div class="actions">
            {filtered ? <a class="button" href="/share">Clear filters</a> : <a class="button" href="/studio">About creator stacks</a>}
            <a class="button secondary" href="/apps">Browse the app library</a>
          </div>
        </section>
      )}
    </>
  )}
</Base>

<script>
  // Choosing a filter submits the same GET form the visible button submits.
  // Empty fields are dropped so a narrowed address stays short and linkable.
  const form = document.querySelector<HTMLFormElement>('[data-share-wall-form]');
  form?.querySelectorAll('select').forEach((select) => select.addEventListener('change', () => form.requestSubmit()));
  form?.addEventListener('submit', () => {
    for (const field of form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[name], select[name]')) field.disabled = !field.value;
  });
</script>

<style>
  .wall-heading { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,1fr); gap:20px 48px; align-items:end; margin-bottom:26px; }
  .wall-heading h1 { margin:6px 0 0; max-width:18ch; font-size:clamp(2.4rem,5vw,4.2rem); line-height:1.04; }
  .wall-intro { max-width:46ch; }
  .wall-intro p { margin:0 0 8px; color:var(--color-muted); }
  .wall-intro nav { gap: 0 1rem; }
  .wall-intro nav a { display:inline-flex; align-items:center; gap:.3rem; min-height:44px; text-underline-offset:.2em; }
  .wall-intro nav a:hover { text-decoration:underline; }
  .wall-films { margin:0 0 42px; padding:24px 0 28px; border-block:1px solid var(--color-border); scroll-margin-top:22px; }
  .wall-films h2,.wall-stacks-heading h2 { margin:0 0 16px; }
  .wall-film-layout { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(0,1fr); gap:24px 44px; align-items:start; }
  .wall-featured-film { display:grid; grid-template-columns:minmax(0,190px) minmax(0,1fr); gap:16px 20px; align-items:start; }
  .wall-featured-film video { display:block; width:100%; height:auto; background:var(--color-field); border-radius:10px; }
  .wall-featured-film h3 { margin:0 0 8px; font-size:1.25rem; }
  .wall-featured-film p,.wall-film-list p { color:var(--color-muted); }
  .wall-film-links { display:flex; flex-wrap:wrap; gap:0 16px; font-weight:600; }
  .wall-film-links a { display:flex; align-items:center; min-height:44px; }
  .wall-film-list { list-style:none; margin:0; padding:0; }
  .wall-film-list li { padding:9px 0; border-bottom:1px solid var(--color-border); }
  .wall-film-list li:first-child { padding-top:0; }
  .wall-film-list a { display:inline-flex; gap:6px; align-items:center; font-weight:650; min-height:32px; }
  .wall-film-list p { margin:0; font-size:.875rem; }
  .wall-stacks-heading { display:flex; flex-wrap:wrap; gap:8px 20px; align-items:baseline; justify-content:space-between; scroll-margin-top:22px; }
  .wall-controls { display:grid; grid-template-columns:minmax(0,2.2fr) minmax(0,1fr) minmax(0,1fr) auto; gap:12px 16px; align-items:end; margin:0 0 16px; padding:18px; background:var(--color-surface); border:1px solid var(--color-border); border-radius:10px; }
  .wall-controls label { margin:0; min-width:0; font-size:.82rem; color:var(--color-muted); }
  .wall-controls input, .wall-controls select { margin-top:6px; background:var(--color-field); }
  .wall-control-actions { display:flex; align-items:center; gap:8px 16px; flex-wrap:wrap; }
  .wall-clear { display:inline-flex; align-items:center; min-height:44px; font-size:.9rem; }
  .wall-summary { margin:0 0 18px; font-size:.9rem; color:var(--color-muted); }
  .wall-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(17rem,1fr)); gap:20px; align-items:stretch; margin:0 0 8px; }
  .wall-card { min-width:0; margin:0; }
  .wall-card-link { display:flex; flex-direction:column; height:100%; overflow:hidden; border:1px solid var(--color-border); border-radius:10px; background:var(--color-surface); }
  .wall-card-link:hover { border-color:var(--color-accent); }
  .wall-card-link:hover h2 { color:var(--color-accent); }
  .wall-card-image { display:block; width:100%; height:auto; aspect-ratio:1200/630; object-fit:cover; background:var(--color-field); border-bottom:1px solid var(--color-border); }
  .wall-card-body { display:flex; flex:1; flex-direction:column; gap:8px; padding:16px 18px 18px; }
  .wall-card h2 { margin:0; font-size:1.16rem; line-height:1.3; overflow-wrap:anywhere; }
  .wall-card-description { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; margin:0; font-size:.92rem; line-height:1.55; color:var(--color-muted); overflow-wrap:anywhere; }
  .wall-card-apps { margin:0; font-size:.8rem; line-height:1.5; color:var(--color-muted); overflow-wrap:anywhere; }
  .wall-card-meta { margin:auto 0 0; padding-top:6px; font-size:.78rem; line-height:1.5; color:var(--color-muted); }
  .wall-card-open { display:inline-flex; align-items:center; gap:6px; font-size:.85rem; font-weight:600; color:var(--color-accent); }
  .wall-state { margin:0; padding:28px; border:1px solid var(--color-border); border-radius:10px; background:var(--color-surface); }
  .wall-state h1 { margin:0 0 12px; max-width:20ch; font-size:clamp(2.2rem,4.5vw,3.4rem); }
  .wall-state h2 { margin:0 0 8px; font-size:1.4rem; }
  .wall-state p { max-width:52ch; color:var(--color-muted); }
  @media (max-width:900px) {
    .wall-heading { grid-template-columns:minmax(0,1fr); align-items:start; }
    .wall-heading h1 { max-width:22ch; }
  }
  @media (max-width:760px) {
    .wall-film-layout { grid-template-columns:minmax(0,1fr); }
    .wall-controls { grid-template-columns:minmax(0,1fr) minmax(0,1fr); padding:14px; }
    .wall-search, .wall-control-actions { grid-column:1/-1; }
    .wall-grid { grid-template-columns:repeat(auto-fill,minmax(15rem,1fr)); }
  }
  @media (max-width:460px) {
    .wall-featured-film { grid-template-columns:minmax(0,138px) minmax(0,1fr); gap:12px; }
    .wall-controls { grid-template-columns:minmax(0,1fr); }
    .wall-grid { grid-template-columns:minmax(0,1fr); }
    .wall-state { padding:20px; }
  }
</style>
