---
import Base from '../layouts/Base.astro';
import ShareArtwork from '../components/ShareArtwork.astro';
import ShareFilmsView from '../components/ShareFilmsView.astro';
import { env } from 'cloudflare:workers';
import type { D1Database } from '@cloudflare/workers-types';
import { composerShareCollection, listShareArtwork, SHARE_CATALOGUE_ORIGIN } from '../lib/share-catalogue-asset.ts';
import { experiencePath, experiences, type ExperienceId } from "../lib/share-experiences.ts";
import { artworkFilters, galleryPage, readArtworkCuration } from '../lib/share-gallery.ts';
import { readLikedArtworkIds } from '../lib/share-feedback.ts';
import { spinDiscovery } from '../lib/spin-site.mjs';
import { noindexFor } from '../lib/indexing.mjs';
import { hasShareWallFilters, shareWallQuery } from '../lib/share-wall.ts';

const params = Astro.url.searchParams;
const filmsView = params.get('view') === 'films';
if (!filmsView && (params.get('view') === 'stacks' || hasShareWallFilters(shareWallQuery(params)))) {
  const filters = new URLSearchParams();
  for (const name of ['q', 'app', 'theme']) {
    const value = params.get(name);
    if (value) filters.set(name, value);
  }
  return Astro.redirect(filters.size ? `/studio/published?${filters}` : '/studio/published', 308);
}
const filters = artworkFilters(params);
const dominationFilm = !filmsView && filters.tag === "operation-world-domination";
const internetWorkshop = !filmsView && filters.tag === "internet-workshop";
if (!filmsView && filters.liked) Astro.response.headers.set('X-Robots-Tag', 'noindex');
const user = Astro.locals.user;
const db = (env as unknown as {DB?: D1Database}).DB;
if (!filmsView) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('Vary', 'Cookie');
}
const canBrowse = !filters.liked || Boolean(user);
const shareData = filmsView || !canBrowse ? null : await Promise.all([
  composerShareCollection(filters.tag) ?? listShareArtwork(),
  readArtworkCuration(db).catch(() => []),
  filters.liked && user ? readLikedArtworkIds(user.id, db).catch(() => null) : undefined,
]);
const artwork = shareData?.[0] ?? null;
const likedIds = shareData?.[2];
const catalogue = artwork && likedIds !== null ? galleryPage(artwork, shareData?.[1] ?? [], filters, likedIds) : null;
if (!filmsView && canBrowse && !catalogue) Astro.response.status = 503;
if (catalogue) Astro.csp?.insertDirective(`img-src ${SHARE_CATALOGUE_ORIGIN}/campaign/`);
---

<Base title={filmsView ? "Share films" : dominationFilm ? "Operation World Domination" : internetWorkshop ? "Internet Workshop" : "Share artwork"} description={filmsView ? "Watch short films from our projects, with captions and credit intact." : "Browse public artwork from our projects and share a piece with its credit intact."}
  noindex={noindexFor(Astro.url.hostname, (filmsView && params.size === 1) || (Boolean(catalogue) && params.size === 0))}>
  {filmsView ? <ShareFilmsView /> : (
    <div class="share-artwork-library">
      {dominationFilm && (
        <nav class="workshop-play" aria-label="Operation World Domination film and release materials">
          <strong>Operation World Domination</strong>
          <a href="https://media.loftwah.com/p/7LZN-PT2isCqeG2t">Watch the film</a>
          <a href="https://media.loftwah.com/p/6ef--UaaAPxAjpKU">Theatrical trailer</a>
          <a href="https://media.loftwah.com/gallery?project=d5fQQNhQ7sU">Full release in Media Studio</a>
          <a href="/campaign/operation-world-domination/captions.en.vtt" download>English captions</a>
          <a href="/campaign/operation-world-domination/campaign-art-and-captions.zip" download>Download the campaign art</a>
        </nav>
      )}
      {internetWorkshop && (
        <nav class="workshop-play" aria-label="Remix an Internet Workshop experience">
          <strong>Play and remix</strong>
          <a href={spinDiscovery.href}>{spinDiscovery.name} →</a>
          {Object.entries(experiences).map(([id, item]) => <a href={experiencePath(id as ExperienceId)}>{item.title} →</a>)}
        </nav>
      )}
      <ShareArtwork catalogue={catalogue} filters={filters} signedIn={Boolean(Astro.locals.user)} />
    </div>
  )}
</Base>

<script>
  // The original bookmark fragments are only available to the browser.
  const moved: Record<string, string> = {
    '#briefing-cards': '/share?tag=briefing-cards',
    '#diagram-artwork': '/share?tag=engineering-artwork',
    '#films': '/share?view=films',
    '#my-feedback': '/share?view=films#my-feedback',
    '#published-stacks': '/studio/published',
  };
  if (Object.hasOwn(moved, location.hash)) location.replace(moved[location.hash]);
</script>

<style>
  .workshop-play { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1rem; border-bottom: 1px solid var(--border, #77757b); margin-bottom: 1.4rem; }
  .workshop-play a { display: flex; align-items: center; min-height: 44px; }
  :global(main:has(> :is(.share-artwork-library, .share-films))) {
    max-width: none;
    padding: clamp(1.35rem, 3.7vw, 3.5rem) clamp(1rem, 4vw, 4.5rem) 4rem;
  }
  :global(main:has([data-artwork-auto])) {
    padding-bottom: 1rem;
  }
  :global(main:has([data-artwork-auto]) + footer) {
    display: none;
  }
</style>
