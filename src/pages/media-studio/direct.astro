---
import Base from "../../layouts/Base.astro";

// These public examples are hosted by the first-party Studio.
Astro.csp?.insertDirective("media-src 'self' https://media.loftwah.com");

interface DirectingLesson {
  title: string;
  outcome: string;
  steps: string;
  prompt: string;
  example: string;
  href: string;
  source: string;
  artworkCredit?: string;
  studioNote?: string;
  localTool?: { href: string; label: string; detail: string };
  storyStill?: { href: string; label: string; detail: string };
  filmClip?: { href: string; label: string; detail: string };
  // Alternate words a visitor may search for that the title/outcome do not already contain.
  terms?: string;
}

const groups: { id: string; title: string; lessons: DirectingLesson[] }[] = [
  {
    id: "plan",
    title: "Plan the shot",
    lessons: [
      {
        title: "Plan a five-second scene",
        outcome: "Give one moment room to read.",
        steps:
          "Choose one subject, one action and one change in the frame. Start from a still you have permission to use. In Create, select the still, choose an image-to-video model and a five-second duration; review the estimate before submitting.",
        prompt:
          "A quiet five-second scene: the subject notices a small change, turns towards it, and the camera holds long enough to see the reaction. Preserve the original character and setting.",
        example: "Fighter · Across the Ring in motion",
        href: "https://media.loftwah.com/p/QXaKw_fL9cZenKCg",
        source:
          "Share original Across the Ring; Studio H3 image-to-video result, 5.2 seconds.",
      },
      {
        title: "Choose the camera",
        outcome: "Make the audience look at the important thing.",
        steps:
          "Describe the starting frame and one camera movement. A locked frame gives small acting room; a slow move adds discovery. Treat camera language as direction in the prompt, not a guaranteed physical camera control.",
        prompt:
          "Begin on a medium shot of the subject. Move the viewpoint slowly closer while the subject stays legible; avoid a fast pan or a sudden cut.",
        example: "Paperwork · A PDF stays here",
        href: "https://media.loftwah.com/p/1qjHzSyIrIAQ4Zuk",
        source:
          "Share build-note-app-composer-paper-bench; Studio H3 result, 5.2 seconds.",
      },
      {
        title: "Direct light and colour",
        outcome: "Keep the subject distinct from its surroundings.",
        steps:
          "Name a light source and its effect before listing colours. Compare the result at phone size. If the character disappears into the background, revise the next take rather than assuming the model has a lighting slider.",
        prompt:
          "Warm window light moves across the subject; keep the background quieter and the main silhouette clear. Retain the original palette and materials.",
        example: "Hello World · Small beginning",
        href: "https://media.loftwah.com/p/VQDLALCKpgZoylDr",
        source: "Share original new-116; Studio H3 result, 5.2 seconds.",
      },
      {
        title: "Use a reference with permission",
        outcome: "Keep the source and its credit alongside the new work.",
        steps:
          "Open the original artwork and check its source and credit. Confirm that you have permission to reuse the artwork before importing it into your project library.",
        prompt:
          "Use the selected reference for the subject and setting. Keep the recognisable silhouette, materials and palette; animate only a small, readable action.",
        example: "Launch Kit · The edge takes a bite",
        href: "https://media.loftwah.com/p/5ycQgw8F4AhOj_oB",
        source: "Share original new-119; Studio H3 result, 5.2 seconds.",
        artworkCredit: "/share/artwork/new-119",
      },
    ],
  },
  {
    id: "make",
    title: "Make and refine",
    lessons: [
      {
        title: "Keep a character consistent",
        outcome: "Carry a recognisable subject between separate takes.",
        steps:
          "Keep the same owned reference and write down the few visual traits that matter: silhouette, clothing, colours and distinguishing marks. Review every take side by side; a prompt can request consistency but does not lock an identity.",
        prompt:
          "Keep the same subject, silhouette, clothing and colour palette as the reference. Change only the action: a small turn and a glance towards the light.",
        example: "Fighter · Across the Ring in motion",
        href: "https://media.loftwah.com/p/QXaKw_fL9cZenKCg",
        source:
          "One animated take, not proof of a locked character across scenes.",
      },
      {
        title: "Change one failed take",
        outcome: "Preserve the original while trying a specific improvement.",
        steps:
          "Name what failed—motion, framing or a detail—then make one deliberate change in a new request. Keep both takes. For a still, a masked fill changes a selected region; it does not edit the video itself.",
        prompt:
          "Keep the scene and subject unchanged. Make the movement slower and keep the face visible throughout the shot.",
        example: "Before the Bell · Fighter still variation",
        href: "https://media.loftwah.com/p/yFSN93LOFy1ja4j0",
        source:
          "Published FLUX.2 Klein variation from a credited Fighter original; this is a still, not a video edit.",
      },
      {
        title: "Choose a vertical frame",
        outcome: "Compose for a phone without calling 4:5 a 9:16 export.",
        steps:
          "Keep faces and essential action inside the intended crop. A 768 × 960 image is 4:5; a genuine 9:16 file has a width-to-height ratio of 9:16. Check the actual exported dimensions and watch the full result.",
        prompt:
          "Compose a vertical scene with the subject centred and breathing room above and below. Keep essential action away from the edges.",
        example: "Paperwork · portrait motion",
        href: "https://media.loftwah.com/p/1qjHzSyIrIAQ4Zuk",
        source:
          "This 768 × 960 Studio result is 4:5, not 9:16. Check dimensions before calling a version vertical 9:16.",
        storyStill: {
          href: "/share/artwork/atlas-04-composer-family",
          label: "Try a real 1080 × 1920 Story still",
          detail:
            "On the artwork, expand Use in Media Studio and choose Open in Studio Image Tools. Load the image, choose Make 4 social sizes, then download the 9:16 story.",
        },
        localTool: {
          href: "https://media.loftwah.com/tools/video-clip",
          label: "Clip and frame a video",
          detail:
            "Choose your own video, set Frame to 9:16, and save the MP4 on this device. No sign-in or generation.",
        },
        filmClip: {
          href: "https://media.loftwah.com/p/PbvQYtyGG-YlF0Dh",
          label: "Practise with Take it with you",
          detail:
            "On the Watch page, choose Clip this video, then Load published video. Set Start to 1 second, End to 4 seconds and Frame to 9:16. Choose Make MP4, then Save MP4.",
        },
      },
      {
        title: "Remix footage responsibly",
        outcome: "Know what you can use before making a cut.",
        steps:
          "Start with footage and audio you own or are allowed to adapt and publish. Keep originals, check music and participant permissions, and mark fictional or generated scenes as such. Studio’s image-to-video tool animates a still; it is not a general video restyler.",
        prompt:
          "Describe the intended edit and its source rights: which original, what to keep, what to change, and where the finished piece may be shared.",
        example: "Fighter: After Hours, a local remix",
        href: "/media-studio#fighter-after-hours",
        source:
          "The build story credits Woodhouse’s original Fighter gameplay and After Hours by LoftwahFM, made with Suno. The published film was cut and mixed locally. For practice, choose footage and audio you have permission to adapt.",
        localTool: {
          href: "https://media.loftwah.com/tools/add-music",
          label: "Mix a cleared clip locally",
          detail:
            "Choose the video and soundtrack, set levels and fades, then save an MP4 from your browser.",
        },
      },
    ],
  },
  {
    id: "finish",
    title: "Sound, edit and share",
    lessons: [
      {
        title: "Make a song clip",
        outcome:
          "Plan pictures around an owned song without losing the original.",
        steps:
          "Pick the song section and mark its start, end and beat changes. Use the free local audio trimmer for a WAV, or upload an authorised track to your project. Plan saved shots against the section, then use Assemble to order takes and mix audio. A new provider render is a separate estimated action.",
        prompt:
          "For this song excerpt, plan three shots: an opening image, one change on the strongest beat, and a quiet ending. Keep cuts aligned to the supplied timing; do not invent lyrics.",
        example: "Open the local audio trimmer",
        href: "https://media.loftwah.com/tools/audio-trim",
        source:
          "Trim mono or stereo audio up to 16 MB and five minutes on this device. Export WAV clips up to three minutes. High-rate audio may need a shorter selection.",
        studioNote: "Select your project, then open Assemble to order the saved takes and mix the song.",
        terms: "music clip music video make a music clip",
      },
      {
        title: "Plan a 15-second spoken spot",
        outcome: "Give a short voiceover a beginning, turn and invitation.",
        steps:
          "Write a short script and read it aloud with a timer. Make or upload narration, plan three five-second shots and save them. Mix narration and any licensed music with trim, gain and fades. Studio can save a storyboard; the previously tested assembly provider returned a permission error, so verify the current render status before promising an export.",
        prompt:
          "Write a warm, plain-language 15-second introduction to [project]. One sentence says what it does, one shows a specific benefit, and one invites the viewer to try it. No invented claims.",
        example: "Take it with you · App Composer commercial",
        href: "/demo#commercial",
        source:
          "A 10.5-second commercial made in ElevenCreative Producer with narration. English captions and a transcript are available. Use it as an example for pacing.",
        localTool: {
          href: "https://media.loftwah.com/tools/add-music",
          label: "Add narration to a clip locally",
          detail:
            "Choose your own video and narration, adjust each track, and download an MP4 on this device.",
        },
        studioNote: "Select your project, then open Create to plan the three five-second shots.",
        terms: "spoken promo 15s spoken promo make a 15s spoken promo 15s promo 15-second promo",
      },
      {
        title: "Caption a lyric or line",
        outcome: "Keep words readable and correctly timed.",
        steps:
          "In Assemble, time the words by hand, confirm you have permission, and save the captions in the song plan. Download them as SRT or WebVTT. To put them in the picture, open a storyboard made from the same saved plan revision. Choose Mix soundtrack, then Save changes. Under Render MP4 on this device, choose Burn in saved captions. Review the same captioned MP4 you’ll download.",
        prompt:
          "Break the supplied authorised words into short readable caption lines. Preserve every word and mark uncertain timings for a human to review.",
        example: "Watch captions on the Studio walkthrough",
        href: "/media-studio/tutorial#film",
        source:
          "The illustrated walkthrough has selectable English captions and a transcript.",
        localTool: {
          href: "https://media.loftwah.com/tools/video-clip",
          label: "Clip and caption your own video",
          detail:
            "Choose your video and add an SRT or WebVTT under Use your own captions. Make the clip and turn on Show imported captions on preview. Prepare a receipt when you want to save the timed VTT.",
        },
        filmClip: {
          href: "https://media.loftwah.com/p/PbvQYtyGG-YlF0Dh",
          label: "Check captions on a three-second cut",
          detail:
            "On Watch, choose Clip this video, then Load published video. Set Start to 1 second and End to 4 seconds, then choose Make MP4. Open Clip receipt, choose Prepare receipt and turn on Show English captions on preview.",
        },
      },
      {
        title: "Save and publish deliberately",
        outcome: "Share one chosen result while keeping the rest private.",
        steps:
          "Review the actual image, video or sound, title and description. Use Publish on that asset only. The public page exposes the selected media and entered details; withdrawing it stops new visits but cannot recall downloads. Check permissions before publishing.",
        prompt:
          "Write a short, accurate description of this selected work. Say whether it is an illustration or a recording, credit its source and avoid claims the result cannot support.",
        example: "Published Fighter motion",
        href: "https://media.loftwah.com/p/QXaKw_fL9cZenKCg",
        source:
          "A deliberately published image-to-video illustration, not recorded gameplay.",
      },
    ],
  },
];
---
<Base title="Direct a scene in Media Studio" description="Practical lessons for directing shots, choosing references, planning sound and sharing an owned creative project.">
<article class="director-guide">
  <header class="director-intro">
    <a href="/media-studio">← Media Studio build story</a>
    <h1>Make the next shot count.</h1>
    <p class="lede">A practical field guide to directing images, motion and sound. Start with a job, borrow a direction, and adapt it to work you own.</p>
    <div class="actions"><a class="button" href="#field-guide-topics">Choose a lesson</a><a class="button secondary" href="/media-studio/studio">Open your Studio</a><a class="button secondary" href="https://media.loftwah.com/tools/images">Try Image Tools</a></div>
    <p>Reading and copying are free. Image Tools run in your browser with no sign-in and no charge. Opening Studio does not generate anything. Sign-in and project access may be required; this guide does not prefill a draft.</p>
  </header>
  <section class="director-proof" aria-labelledby="proof-title">
    <div><h2 id="proof-title">See the workflow</h2><p>This narrated walkthrough uses Studio screen images to explain the brief, library, sound and a saved cut. It is an illustrated guide, not a recording of each live interaction. Captions and a transcript are available.</p><p><a href="/media-studio/watch/walkthrough.txt">Read the transcript</a> · <a href="/media-studio/tutorial">Build your own Studio</a></p></div>
    <video controls preload="none" poster="/media-studio/watch/walkthrough-poster.jpg" width="1440" height="900" aria-label="Play the illustrated Media Studio walkthrough"><source src="/media-studio/watch/walkthrough.mp4" type="video/mp4"/><track kind="captions" src="/media-studio/watch/walkthrough.vtt" srclang="en" label="English captions" default/><a href="/media-studio/watch/walkthrough.mp4">Download the walkthrough</a></video>
  </section>
  <section class="director-screening" aria-labelledby="screening-title">
    <h2 id="screening-title">Watch the creative choices</h2>
    <p>These are published Studio outputs. Play each example, then use the source link to inspect its provenance.</p>
    <div class="director-films">
      <figure>
        <video controls playsinline preload="none" poster="/media-studio/direct/ldraw.webp" aria-label="Play Move the mountain, an LDraw motion study"><source src="https://media.loftwah.com/p/hvhyL90Wm1EXbrAE/media" type="video/mp4"/><a href="https://media.loftwah.com/p/hvhyL90Wm1EXbrAE">Watch Move the mountain in Studio</a></video>
        <figcaption><h3>One action, one shot</h3><p>A six-second LDraw motion study animates a hand lifting a mountain from an owned reference. Watch how the central action stays readable.</p><a href="https://media.loftwah.com/p/hvhyL90Wm1EXbrAE">View the Studio source and provenance →</a></figcaption>
      </figure>
      <figure>
        <video controls playsinline preload="none" poster="/media-studio/direct/paper.webp" aria-label="Play Paper and Light studio cut, with sound"><source src="https://media.loftwah.com/p/Na9FNUB_VhzZ7zA9/media" type="video/mp4"/><a href="https://media.loftwah.com/p/Na9FNUB_VhzZ7zA9">Watch Paper &amp; Light in Studio</a></video>
        <figcaption><h3>Build a cut with sound</h3><p>This 17-second Paper &amp; Light cut combines three saved generated takes with a Studio Score music bed. Listen for how the sound carries the change of scene.</p><a href="https://media.loftwah.com/p/Na9FNUB_VhzZ7zA9">View the Studio source and provenance →</a></figcaption>
      </figure>
    </div>
  </section>
  <nav id="field-guide-topics" class="director-nav" aria-label="Field guide topics"><a href="#plan">Plan the shot</a><a href="#make">Make and refine</a><a href="#finish">Sound, edit and share</a><a href="#words">Creative vocabulary</a></nav>
  <div class="director-search" hidden data-search-wrap><label for="lesson-search">Find a lesson</label><input id="lesson-search" type="search" placeholder="Try camera, music or sharing"/><button class="button secondary" type="button" data-search-clear hidden>Clear search</button><span data-search-status role="status" aria-live="polite"></span></div>
  <p class="director-cost">The text below is creative direction, not a model parameter. Choose the actual model, reference and duration in Studio. One five-second H3 request in the cited examples was estimated at US$0.24 on 14 November 2026; prices and availability can change. One recorded 30-second Studio Score bed was US$0.015 and one Studio Voice request was US$0.06; those are historical estimates, not current quotes. Review the current estimate for each request. Estimates are not invoices.</p>
  {groups.map(group => (
    <section id={group.id} class="director-section">
      <h2>{group.title}</h2>
      <div class="director-lessons">
        {group.lessons.map((lesson, i) => (
          <article class="director-lesson" data-search-terms={lesson.terms ?? ''}>
            <h3>{lesson.title}</h3>
            <p class="director-outcome">{lesson.outcome}</p>
            <p>{lesson.steps}</p>
            <details>
              <summary>Direction to adapt</summary>
              <p class="director-prompt" id={`${group.id}-prompt-${i}`} tabindex="-1">{lesson.prompt}</p>
              <button class="secondary" type="button" data-copy-target={`${group.id}-prompt-${i}`}>Copy direction</button>
              <span class="copy-status" role="status" aria-live="polite"></span>
            </details>
            <p class="director-example">
              <a href={lesson.href}>{lesson.example} →</a><br/><span>{lesson.source}</span>
            </p>
            {lesson.artworkCredit && (
              <p class="director-example"><a href={lesson.artworkCredit}>See the original artwork and credit →</a></p>
            )}
            {lesson.storyStill && (
              <p class="director-example">
                <a href={lesson.storyStill.href}>{lesson.storyStill.label} →</a><br/><span>{lesson.storyStill.detail}</span>
              </p>
            )}
            {lesson.filmClip && (
              <p class="director-example">
                <a href={lesson.filmClip.href}>{lesson.filmClip.label} →</a><br/><span>{lesson.filmClip.detail}</span>
              </p>
            )}
            {lesson.localTool && (
              <p class="director-example">
                <a href={lesson.localTool.href}>{lesson.localTool.label} →</a><br/><span>{lesson.localTool.detail}</span>
              </p>
            )}
            {lesson.studioNote && (
              <p class="director-example">
                <a href="/media-studio/studio">Open your Studio →</a><br/><span>{lesson.studioNote}</span>
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}
  <section id="words" class="director-section"><h2>Words you will meet</h2><dl class="director-words"><div><dt>Scene / shot / take</dt><dd>A scene is a moment in a place; a shot is one continuous view; a take is one attempt at that shot.</dd></div><div><dt>Reference / prompt / parameter</dt><dd>A reference is source media; a prompt describes intent; a parameter is an actual model control such as duration. Prompted motion is a request, not a guaranteed setting.</dd></div><div><dt>Timeline / clip / stem</dt><dd>A timeline orders sound and picture in time. A clip is a piece of media. A stem is a separate part of a mix, such as narration or music.</dd></div><div><dt>Slate / render / master</dt><dd>A slate is an opening card. A render produces a new media file from a saved edit. A master is the selected finished version retained for reuse.</dd></div><div><dt>Variant / private / public</dt><dd>A variant is a separate result derived from a source. Private project work stays restricted; deliberate publication exposes the chosen media and its entered details. Do not assume an unlisted link is private.</dd></div></dl></section>
  <p><a href="/media-studio/tutorial">Continue with the full Studio tutorial →</a></p>
</article>
<script>
  import { copyPromptText } from '../../lib/docs-copy';

  const searchWrap = document.querySelector<HTMLElement>('[data-search-wrap]');
  const search = document.querySelector<HTMLInputElement>('#lesson-search');
  const searchStatus = document.querySelector<HTMLElement>('[data-search-status]');
  const searchClear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const lessons = [...document.querySelectorAll<HTMLElement>('.director-lesson')];
  if (searchWrap && search && searchStatus) {
    searchWrap.hidden = false;
    const applySearch = () => {
      const term = search.value.trim().toLocaleLowerCase();
      let count = 0;
      for (const lesson of lessons) {
        const haystack = ((lesson.textContent ?? '') + ' ' + (lesson.dataset.searchTerms ?? '')).toLocaleLowerCase();
        const match = !term || haystack.includes(term);
        lesson.hidden = !match;
        if (match) count++;
      }
      for (const group of document.querySelectorAll<HTMLElement>('.director-section')) {
        if (group.querySelector('.director-lessons')) group.hidden = !group.querySelector('.director-lesson:not([hidden])');
      }
      searchStatus.textContent = term ? `${count} ${count === 1 ? 'lesson' : 'lessons'} found.` : '';
      if (searchClear) searchClear.hidden = count !== 0;
    };
    search.addEventListener('input', applySearch);
    if (searchClear) searchClear.addEventListener('click', () => {
      search.value = '';
      applySearch();
      search.focus();
    });
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-target]')) {
    button.addEventListener('click', async () => {
      const prompt = document.getElementById(button.dataset.copyTarget ?? '');
      const status = button.nextElementSibling;
      if (!prompt || !status) return;
      const previousFocus = document.activeElement;
      status.textContent = '';
      const clipboard = navigator.clipboard;
      const outcome = await copyPromptText(prompt.textContent?.trim() ?? '', clipboard?.writeText?.bind(clipboard));
      if (outcome === 'copied') {
        status.textContent = 'Copied.';
        return;
      }
      if (outcome === 'empty') {
        status.textContent = 'The direction text did not load.';
        return;
      }
      const selection = window.getSelection();
      if (!selection || document.activeElement !== previousFocus || !prompt.getClientRects().length) {
        status.textContent = 'Copy unavailable. Select the direction text and copy it.';
        return;
      }
      prompt.focus({ preventScroll: true });
      const range = document.createRange();
      range.selectNodeContents(prompt);
      selection.removeAllRanges();
      selection.addRange(range);
      status.textContent = 'Direction selected. Copy it with your keyboard shortcut or your device’s copy menu.';
    });
  }
</script>
<style>
.director-search:not([hidden]) {
  display: grid;
  gap: 8px;
  max-width: 34rem;
  margin-top: 28px;
}
.director-search label {
  font-weight: 650;
}
.director-search input {
  font: inherit;
  padding: 12px;
  border: 1px solid var(--color-control-border);
  border-radius: 8px;
  background: var(--color-field);
  color: var(--color-foreground);
}
.director-search span {
  color: var(--color-muted);
}
.director-search [data-search-clear][hidden] {
  display: none;
}
.director-guide {
  max-width: 1120px;
  margin: auto;
}
.director-intro {
  max-width: 900px;
  padding: 24px 0 56px;
}
.director-intro h1 {
  max-width: 14ch;
  overflow-wrap: anywhere;
}
.director-intro > p:last-child {
  color: var(--color-muted);
  max-width: 68ch;
}
.director-proof {
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  gap: 36px;
  align-items: start;
  border-top: 1px solid var(--color-border);
  padding: 40px 0;
}
.director-proof h2 {
  font-size: 2rem;
}
.director-proof video {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 8px;
  background: var(--color-surface);
}
.director-screening {
  border-top: 1px solid var(--color-border);
  padding: 40px 0;
}
.director-screening > p { max-width: 65ch; }
.director-films {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 32px;
}
.director-films figure { margin: 0; min-width: 0; }
.director-films video {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: contain;
  border-radius: 8px;
  background: var(--color-surface);
}
.director-films h3 { margin: 16px 0 8px; }
.director-films p { margin: 0 0 12px; }
.director-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 24px;
  border-block: 1px solid var(--color-border);
  padding: 20px 0;
}
.director-nav a {
  text-decoration: underline;
  text-underline-offset: 4px;
}
.director-cost {
  color: var(--color-muted);
  margin: 28px 0 0;
  max-width: 78ch;
}
.director-section {
  padding: 64px 0 16px;
  scroll-margin-top: 24px;
}
.director-lessons {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 48px;
}
.director-lesson {
  border-top: 1px solid var(--color-border);
  padding: 24px 0 32px;
  min-width: 0;
}
.director-lesson h3 {
  margin: 0 0 8px;
}
.director-lesson p {
  margin: 0 0 16px;
}
.director-outcome {
  font-weight: 650;
}
.director-lesson details {
  margin: 20px 0;
}
.director-lesson summary {
  cursor: pointer;
  min-height: 44px;
  padding: 8px 0;
  font-weight: 650;
}
.director-prompt {
  padding: 12px 0;
  white-space: pre-wrap;
}
.copy-status {
  display: inline-block;
  margin-left: 12px;
  color: var(--color-muted);
}
.director-example {
  font-size: 0.95rem;
