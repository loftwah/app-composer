---
import Base from "../../layouts/Base.astro";
import type { D1Database } from "@cloudflare/workers-types";
import { env } from "cloudflare:workers";
import { studioAccess } from "../../lib/member-access";

export const prerender = false;

const runtime = env as unknown as {
  DB?: D1Database;
  MEDIA_STUDIO_BRIDGE_SECRET?: string;
  MEDIA_STUDIO_ORIGIN?: string;
};
const user = Astro.locals.user;
const project = Astro.url.searchParams.get("project");

function base64url(value: string) {
  return btoa(value).replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", "");
}

async function bridgeToken(secret: string, claim: Record<string, unknown>) {
  const payload = base64url(JSON.stringify(claim));
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"],
  );
  const signature = await crypto.subtle.sign(
    "HMAC",
    key,
    new TextEncoder().encode(payload),
  );
  const hex = Array.from(new Uint8Array(signature))
    .map((byte) => byte.toString(16).padStart(2, "0"))
    .join("");
  return payload + "." + hex;
}

let state: "signed-out" | "no-workspace" | "denied" | "unconfigured" | "open" =
  "signed-out";
let workspaceName = "";
let actions: string[] = [];

if (user && runtime.DB) {
  const workspace = await runtime.DB.prepare(
    `SELECT w.id,w.name,m.role FROM creator_members m
     JOIN creator_workspaces w ON w.id=m.workspace_id
     WHERE m.user_id=?
     ORDER BY CASE WHEN m.role='owner' THEN 0 ELSE 1 END, w.created_at, w.id
     LIMIT 1`,
  )
    .bind(user.id)
    .first<{ id: string; name: string; role: string }>();
  if (!workspace) state = "no-workspace";
  else {
    const access = await studioAccess(
      runtime.DB,
      { id: user.id, email: user.email ?? "", name: user.name ?? null, role: 20 },
      workspace.id,
    );
    workspaceName = workspace.name;
    actions = access.actions;
    if (!actions.includes("read")) state = "denied";
    else if (!runtime.MEDIA_STUDIO_BRIDGE_SECRET || !runtime.MEDIA_STUDIO_ORIGIN) {
      state = "unconfigured";
    } else {
      const token = await bridgeToken(runtime.MEDIA_STUDIO_BRIDGE_SECRET, {
        aud: "media-studio",
        iss: "https://composer.loftwah.com",
        sub: user.id,
        actorName: user.name ?? user.email ?? "Composer member",
        workspace: workspace.id,
        workspaceName: workspace.name,
        project: project && /^[a-z0-9_]{4,64}$/.test(project) ? project : null,
        actions,
        revision: access.revision,
        exp: Date.now() + 120_000,
        jti: crypto.randomUUID(),
      });
      const target = new URL("/bridge", runtime.MEDIA_STUDIO_ORIGIN);
      target.searchParams.set("token", token);
      return Astro.redirect(target.href, 302);
    }
  }
}
---

<Base
  title="Open your Media Studio"
  description="Open the Media Studio installation attached to your App Composer workspace, or read how it was built."
  noindex={true}
  canonical="https://composer.loftwah.com/media-studio/studio"
>
  <main class="studio-entry" id="main">
    <h1>Media Studio</h1>
    <p class="lede">Make images, video and sound. Keep your projects and takes together.</p>

    {state === "signed-out" && (
      <section class="entry-card" aria-labelledby="entry-signed-out">
        <h2 id="entry-signed-out">Open your studio</h2>
        <p>Sign in with App Composer to open the studio connected to your workspace.</p>
        <a class="button" href="/_emdash/admin/login?redirect=/media-studio/studio">Sign in to App Composer</a>
      </section>
    )}

    {state === "no-workspace" && (
      <section class="entry-card" aria-labelledby="entry-no-workspace">
        <h2 id="entry-no-workspace">No workspace yet</h2>
        <p>
          You are signed in, but this account is not in a Composer workspace. Join or create one
          first; a workspace owner can then grant Media Studio access.
        </p>
        <a class="button secondary" href="/me">Open My apps</a>
      </section>
    )}

    {state === "denied" && (
      <section class="entry-card" aria-labelledby="entry-denied">
        <h2 id="entry-denied">No Media Studio permission in {workspaceName}</h2>
        <p>Ask the owner of {workspaceName} to give you Media Studio access.</p>
        <a class="button secondary" href="/me">Open My apps</a>
      </section>
    )}

    {state === "unconfigured" && (
      <section class="entry-card" aria-labelledby="entry-unconfigured">
        <h2 id="entry-unconfigured">Your studio isn’t connected</h2>
        <p>Ask your workspace owner to connect its Media Studio installation, then reopen this page.</p>
        <a class="button secondary" href="/me">Open My apps</a>
      </section>
    )}

    <section class="entry-card" aria-labelledby="entry-start">
      <h2 id="entry-start">Start a new studio</h2>
      <p>Pick your project name and creative defaults in Init. You’ll get a setup brief for your own Cloudflare app.</p>
      <a class="button secondary" href="/init?start=media-studio">Set up a studio</a>
    </section>

    <nav class="entry-links" aria-label="Media Studio guides">
      <a href="/media-studio">Read the build story</a>
      <a href="/media-studio/tutorial">Follow the tutorial</a>
    </nav>
  </main>

  <style>
    .studio-entry { max-width: 900px; margin: 0 auto; padding: 48px 24px 96px; }
    .studio-entry h1 { font: 600 clamp(2.4rem, 5vw, 4rem)/1.02 "Space Grotesk", system-ui, sans-serif; letter-spacing: -.04em; max-width: 18ch; margin: 0 0 18px; }
    .lede { font-size: 1.15rem; line-height: 1.6; color: var(--color-muted); max-width: 65ch; }
    .entry-card { border-top: 1px solid var(--color-border); padding: 24px 0; max-width: 65ch; }
    .entry-card h2 { font: 600 1.4rem/1.2 "Space Grotesk", system-ui, sans-serif; margin: 0 0 8px; }
    .entry-card p { line-height: 1.6; margin: 0 0 16px; }
    .entry-links { display: flex; flex-wrap: wrap; gap: 8px 24px; border-top: 1px solid var(--color-border); padding-top: 16px; max-width: 65ch; }
    .entry-links a { font-weight: 600; }
    :focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  </style>
</Base>
