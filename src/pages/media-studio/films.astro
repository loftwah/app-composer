---
import Base from '../../layouts/Base.astro';
import ShareFilmFeedback from '../../components/ShareFilmFeedback.astro';
import ShareFilmVotes from '../../components/ShareFilmVotes.astro';
import { shareFilms, studioFilmPath } from '../../lib/share-films.ts';

const [socialKit, studioTeaser, ...films] = shareFilms;
const teaser = '/media-studio/watch/media-studio-teaser-recut';
const canReview = Boolean(Astro.locals.user);
Astro.response.headers.set('Vary', 'Cookie');
---

<Base title="Media Studio films" description="Watch a Studio build, see how a social kit comes together, and find the tools and tutorials behind the films.">
  <header class="films-intro" id="films">
    <a href="/media-studio">← Media Studio</a>
    <h1>Media Studio films</h1>
    <p class="lede">Watch the finished work and see how it was made.</p>
  </header>

  <div class="featured">
    <article id="studio-teaser" class="feature" aria-labelledby="teaser-title">
      <video controls playsinline preload="none" poster="/media-studio/teaser-poster-20261117.jpg" width="1080" height="1920" aria-labelledby="teaser-title">
        <source src={teaser + '.mp4'} type="video/mp4" />
        <track kind="captions" src={teaser + '.vtt'} srclang="en" label="English captions" />
        <a href={teaser + '.mp4'}>Open the 30-second film</a>
      </video>
      <div>
        <h2 id="teaser-title">{studioTeaser.title}</h2>
        <p>From a brief in App Composer to a working media library and a published motion study.</p>
        <p class="credit">Features Low Tide by LoftwahFM.</p>
        <nav class="film-links" aria-label="Media Studio in 30 seconds">
          <a href="/media-studio#watch">See the full build</a>
          <a href={teaser + '.txt'}>Transcript</a>
          <a href={teaser + '.mp4'} download>Download video</a>
        </nav>
        {canReview && <ShareFilmVotes film={studioTeaser} />}
      </div>
    </article>
    <article id="studio-social-kit" class="feature" aria-labelledby="social-kit-title">
      <video controls playsinline preload="none" poster={studioFilmPath + '.jpg'} width="1080" height="1920" aria-labelledby="social-kit-title">
        <source src={studioFilmPath + '.mp4'} type="video/mp4" />
        <track kind="captions" src={studioFilmPath + '.vtt'} srclang="en" label="English captions" />
        <a href={studioFilmPath + '.mp4'}>Open the social kit film</a>
      </video>
      <div>
        <h2 id="social-kit-title">{socialKit.title}</h2>
        <p>In 17 seconds, see Image Tools turn one PNG into four sizes and download them in a ZIP.</p>
        <p class="credit">Music by LoftwahFM · Pixel Box Theory</p>
        <nav class="film-links" aria-label="One image. Four social sizes">
          <a href="https://media.loftwah.com/tools/images">Try Image Tools</a>
          <a href={studioFilmPath + '.mp4'} download>Download video</a>
        </nav>
        {canReview && <ShareFilmVotes film={socialKit} />}
      </div>
    </article>
  </div>

  <section class="film-library" aria-labelledby="library-title">
    <h2 id="library-title">More films and demos</h2>
    <ul role="list">
      <li><a href="/creator-hub#film">See the Creator Hub build</a><p>34 seconds · Two independent apps built from one brief</p></li>
      {films.map((film) => (
        <li id={film.id}>
          <a href={film.href}>{film.title}</a>
          <p>{film.detail}</p>
          {canReview && <ShareFilmVotes film={film} />}
        </li>
      ))}
    </ul>
    <p><a href="https://media.loftwah.com/gallery">Browse the Media Studio gallery</a></p>
    {canReview ? <ShareFilmFeedback /> : <p><a href="/_emdash/admin/login?redirect=/media-studio/films">Sign in to give private film feedback</a></p>}
  </section>
</Base>

<style>
  .films-intro { max-width: 42rem; margin-bottom: 2rem; }
  .films-intro h1 { margin-block: .6rem; }
  .featured { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .feature { display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); gap: 1.35rem; align-items: start; padding-block: 1.25rem; border-top: 1px solid var(--color-border); scroll-margin-top: 1rem; }
  .feature video { display: block; width: 100%; height: auto; border-radius: 10px; background: #17181b; }
  .feature h2 { margin: 0 0 .65rem; font-size: clamp(1.35rem, 2.4vw, 1.75rem); }
  .feature p { margin: 0 0 .75rem; }
  .credit,.film-library li p { color: var(--color-muted); font-size: .875rem; }
  .film-links { display: flex; flex-wrap: wrap; gap: 0 1rem; font-weight: 600; }
  .film-links a { display: inline-flex; align-items: center; min-height: 44px; }
  .film-library { margin: 2rem 0; padding-block: 1.5rem; border-top: 1px solid var(--color-border); }
  .film-library ul { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
  .film-library li { padding-block: .85rem; border-bottom: 1px solid var(--color-border); }
  .film-library li p { margin: .35rem 0 0; }
  @media (max-width: 850px) {
    .featured { grid-template-columns: minmax(0, 1fr); gap: .5rem; }
  }
  @media (max-width: 480px) {
    .feature { grid-template-columns: minmax(0, 1fr); }
    .feature video { width: min(100%, 17rem); }
    .film-library ul { grid-template-columns: minmax(0, 1fr); }
  }
</style>
