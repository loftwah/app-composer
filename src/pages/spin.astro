---
import Base from '../layouts/Base.astro';
import SpinTasteCloud from '../components/SpinTasteCloud.astro';
import SpinShareDialog from '../components/SpinShareDialog.astro';
import { ArrowUpRight, CalendarDays, ChevronDown, Gamepad2, Pencil, Plus, RotateCw, Share2, Utensils, Volume2, VolumeX } from '@lucide/astro';
import { spinLinkArtwork, spinLinkArtworkAlt, spinDiscovery, spinOrigin } from '../lib/spin-site.mjs';
import { spinExamples } from '../lib/spin-examples.mjs';
import { spinDefaultPreset, spinPresetById, spinPresetGroups } from '../lib/spin-presets.mjs';
import { spinChoiceLimit, spinIdPattern, spinLifetimeDays } from '../lib/spin-protocol.mjs';
const candidate = Astro.url.searchParams.get('example');
const sharedId = Astro.url.searchParams.get('session');
const sessionLink = sharedId !== null;
const example = !sessionLink && candidate && Object.hasOwn(spinExamples, candidate) ? candidate : '';
const replay = Boolean(sessionLink || example);
const defaultWheel = spinPresetById[spinDefaultPreset];
const spinPath = Astro.url.origin === spinOrigin ? '/' : '/spin';
const title = replay ? 'Shared spin · Spin by App Composer' : 'Decision Wheel & Random Picker · Spin by App Composer';
const description = replay
  ? 'See where the wheel landed.'
  : 'Free, ad-free decision wheel. Add your own choices, spin once or play best-of rounds, then copy the result as an image.';
Astro.csp?.insertDirective('img-src blob:');
if (replay) Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const canonical = (example || (sharedId && spinIdPattern.test(sharedId))) ? new URL(spinPath + '?' + new URLSearchParams(
  sessionLink ? { session: sharedId ?? '' } : { example },
), Astro.url.origin).href : spinDiscovery.href;
const application = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: spinDiscovery.name,
  url: spinDiscovery.href,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  inLanguage: 'en-AU',
  image: new URL(spinLinkArtwork, spinOrigin).href,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'AUD' },
});
---
<Base {title} {description} {canonical} shareImage={spinLinkArtwork}
  shareAlt={spinLinkArtworkAlt} shareType="image/jpeg" shareWidth={1200} shareHeight={630} noindex={replay || undefined} focusedExperience spinProduct>
  <meta slot="head" property="og:locale" content="en_AU" />
  {!replay && <script slot="head" type="application/ld+json" set:html={application} />}
  <section class="spin" data-spin data-spin-path={spinPath} data-spin-example={example || undefined}>
    <div class="play">
      <div class="wheel-panel" data-wheel-panel>
        <div class="stage-controls">
          <header class="stage-heading">
            <h1 class="wheel-question" data-spin-heading>{replay ? 'Opening draw…' : defaultWheel.question}</h1>
            <ul class="choice-preview" data-choice-preview aria-label="Choices">
              {!replay && defaultWheel.entries.map(label => <li>{label}</li>)}
            </ul>
            <p class="note" data-spin-intro hidden></p>
          </header>
          <div class="stage-mode">
            <label class="mode-picker">
              <span>Play mode</span>
              <span class="mode-select"><select name="bestOf" form="spin-setup" aria-describedby="spin-mode-help" required disabled={replay}>
                <option value="1">Single spin · Rounds off</option>
                <option value="3">Best of 3</option>
                <option value="5">Best of 5</option>
                <option value="7">Best of 7</option>
                <option value="0">Open tally</option>
                <optgroup label="Longer series">
                  {[9, 11, 13, 15, 17, 19, 21].map(count => <option value={count}>Best of {count}</option>)}
                </optgroup>
              </select><ChevronDown size={16} aria-hidden="true" /></span>
            </label>
            <p id="spin-mode-help" data-rules></p>
          </div>
          <div class="wheel-actions">
            <div class="primary-slot" data-spin-primary>
              <button type="submit" class="button wheel-primary" form="spin-setup" data-spin-now
                aria-describedby="spin-link-privacy" hidden={replay} disabled>Spin</button>
              <button type="button" class="button wheel-primary" data-draw hidden>Spin</button>
              <button type="button" class="button wheel-primary" data-spin-again hidden><RotateCw size={17} aria-hidden="true" /> Spin again</button>
              <button type="button" class="button wheel-primary" data-stage-replay hidden><RotateCw size={17} aria-hidden="true" /> Replay spin</button>
              <button type="button" class="button wheel-primary" disabled data-waiting hidden>Waiting for host</button>
            </div>
            <button type="button" data-share disabled={replay}><Share2 size={17} aria-hidden="true" data-share-icon /> <span data-share-label>Share wheel</span></button>
          </div>
          <div class="wheel-readout" role="status">
            <p class="readout-label" data-result-label>{replay ? 'Shared draw' : 'Tap or flick the wheel'}</p>
            <p class="wheel-status" data-result>{replay ? 'Opening replay…' : 'Loading wheel…'}</p>
          </div>
          <section data-share-result aria-label="Share result" hidden></section>
          <div class="wheel-tools">
            {!replay && <button type="button" data-edit-choices aria-controls="spin-wheel-editor" aria-expanded="false"><Pencil size={15} aria-hidden="true" /> Edit wheel</button>}
            <button type="button" data-clear-wheel aria-label="Clear choices">Clear</button>
            <button type="button" data-reset-wheel aria-label="Reset wheel">Reset</button>
            <button type="button" data-undo-wheel hidden>Undo</button>
            <button type="button" data-sound aria-pressed="true" aria-label="Wheel sound">
              <Volume2 size={18} aria-hidden="true" data-sound-on /><VolumeX size={18} aria-hidden="true" data-sound-off hidden />
              <span data-sound-label>Sound on</span>
            </button>
            <button type="button" data-auto hidden>Run series</button>
            <button class="finish-session" type="button" data-finish aria-label="Finish session" hidden>Finish</button>
            <a data-nearby target="_blank" rel="noopener noreferrer" hidden>Nearby <ArrowUpRight size={15} aria-hidden="true" /></a>
          </div>
          <p role="alert" data-error></p>
          {replay && <p data-start-over hidden><a href={spinDiscovery.href}>Open Spin</a></p>}
        </div>
        <div class="wheel-display">
          <div class="wheel-frame" data-wheel-tap>
            <canvas width="560" height="560" aria-hidden="true" data-wheel></canvas>
            <button type="button" class="spin-hub" data-spin-hub aria-label="Spin the wheel" disabled></button>
            <div class="wheel-applause" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="result-display" data-result-display hidden>
            <a data-preview-link target="_blank" rel="noopener" aria-label="Open full-size result image in a new tab" hidden></a>
            <p data-image-status role="status">Preparing image…</p>
          </div>
        </div>
      </div>
      <div class="preset-quick" role="group" aria-label="Wheel presets" data-spin-presets>
        <button type="button" data-quick-chains aria-pressed="false"><Utensils size={16} aria-hidden="true" /> Fast food</button>
        <button type="button" data-quick-preset="game" aria-pressed="false"><Gamepad2 size={16} aria-hidden="true" /> Game night</button>
        <button type="button" data-quick-preset="weekend" aria-pressed="false"><CalendarDays size={16} aria-hidden="true" /> Weekend</button>
        <label class="preset-picker">
          <span class="screen-reader">Choose a preset</span>
          <select form="spin-setup" data-preset-picker>
            <option value="">All presets</option>
            {spinPresetGroups.map(group => <optgroup label={group.label}>
              {group.presets.map(preset => <option value={preset.id}>{preset.label}</option>)}
            </optgroup>)}
          </select>
          <ChevronDown size={15} aria-hidden="true" />
        </label>
      </div>
      <div class="controls">
        <p class="note verification-warning" data-verification-warning role="alert"></p>
        <section class="wheel-editor" id="spin-wheel-editor" data-wheel-editor hidden>
          <form id="spin-setup" novalidate data-setup hidden={replay}>
            <div class="choice-heading">
              <h2 id="spin-choices" tabindex="-1">Build your wheel</h2>
              <div class="button-row editor-shortcuts">
                <button type="button" data-resume-draft hidden>Resume draft</button>
                <button type="button" data-food-ideas aria-controls="spin-ideas"><Utensils size={16} aria-hidden="true" /> Food ideas</button>
              </div>
            </div>
            <label class="question-field">Question <input name="question" required maxlength="100" value={defaultWheel.question} /></label>
            <div class="choice-heading choice-caption">
              <h3>Choices</h3>
              <p class="note" data-choice-odds></p>
            </div>
            <ol class="choice-list" data-choices-list aria-label="Wheel choices"></ol>
            <div class="add-entry">
              <input type="text" name="entry" maxlength="56" aria-label="New choice" placeholder="Add a choice" autocomplete="off" />
              <button type="button" data-add-choice><Plus size={18} aria-hidden="true" /> Add</button>
            </div>
            <p class="note" data-editor-message role="status"></p>
            <details class="saved-wheels">
              <summary>Saved wheels</summary>
              <div class="button-row">
                <button type="button" data-favourite aria-pressed="false">Favourite preset</button>
                <button type="button" data-reset>Reset to preset</button>
              </div>
              <div class="button-row">
                <button type="button" data-save-wheel>Save this wheel</button>
                <button type="button" data-duplicate-wheel>Save a copy</button>
                <button type="button" data-remove-wheel>Remove saved copy</button>
              </div>
              <label>Saved wheels <select data-saved-wheels></select></label>
              <label>Favourites <select data-favourites></select></label>
              <label>Recent presets <select data-recent-wheels></select></label>
            </details>
            <SpinTasteCloud />
            <details class="choice-editor">
              <summary>Paste or manage choices</summary>
              <label class="order-toggle"><input type="checkbox" data-show-order /> Show reorder controls</label>
              <label>Find a choice <input type="search" data-choice-search autocomplete="off" /></label>
              <div class="button-row">
                <button type="button" data-enable="all">Enable all</button>
                <button type="button" data-enable="none">Disable all</button>
              </div>
              <label>Paste choices <textarea name="paste" rows="2" placeholder="One choice per line"></textarea></label>
              <button type="button" data-paste-choices>Add pasted choices</button>
              <p class="note">The wheel uses 2–{spinChoiceLimit} enabled choices. The numbers match the wheel on longer lists.</p>
            </details>
            <p class="screen-reader" id="spin-link-privacy">Anyone with the link to a spin can see the question and choices for {spinLifetimeDays} days.</p>
            <details>
              <summary>Find takeaway near you</summary>
              <label>Suburb, town or postcode <input name="suburb" maxlength="80" placeholder="e.g. Sunbury VIC 3429" autocomplete="off" /></label>
              <p class="note">Your area stays on this device. On a takeaway result, open Maps to look for the winning choice near you. Check store details there.</p>
            </details>
          </form>
        </section>
        <details class="draw-info" data-session hidden>
          <summary data-session-heading>Draw details</summary>
          <p data-full-question></p>
          <p class="note" data-series></p>
          <div class="result-actions button-row">
            <button type="button" data-refresh>Refresh result</button>
          </div>
          <div class="result-actions button-row" data-playback hidden>
            <button type="button" data-replay-last>Replay last spin</button>
            <button type="button" data-replay-series>Replay the series</button>
            <a class="button" data-create-own href={spinDiscovery.href}>Make your own wheel <ArrowUpRight size={16} aria-hidden="true" /></a>
          </div>
          <details data-score-details>
            <summary data-score-heading>Series score</summary>
            <ol class="scores" aria-label="Series score" data-scores></ol>
          </details>
          <details>
            <summary>Spin history</summary>
            <p data-verification></p>
            <p class="note" data-history-note hidden></p>
            <ol data-rounds></ol>
            <p class="note" data-expiry></p>
            <details>
              <summary>Draw code</summary>
              <p class="note">The code is set before the first spin. You can send the link early so friends can compare it with the code they see after you finish.</p>
              <code data-commitment></code>
              <p><a href="https://composer.loftwah.com/articles/why-we-built-spin">How Spin checks a result</a></p>
            </details>
          </details>
          <div class="button-row secondary-actions">
            <button type="button" data-abandon hidden>Abandon session</button>
            <a data-remix>Edit a copy of this wheel</a>
          </div>
        </details>
        <noscript><p>Enable JavaScript to use Spin.</p></noscript>
      </div>
    </div>
    <SpinShareDialog />
    {!replay && <nav class="spin-guide" aria-label="Spin examples and help">
      {Object.entries(spinExamples).map(([key, label]) => <a href={spinOrigin + '/?example=' + key}>{label}</a>)}
      <a href="https://composer.loftwah.com/articles/why-we-built-spin">How Spin checks a result</a>
      <a href="https://composer.loftwah.com/share/spin">Spin in App Composer Share</a>
    </nav>}
  </section>
</Base>

<script>
  import '../browser/spin.mjs';
</script>

<style>
  .spin {
    --spin-accent: #bc3b00;
    --spin-ink: #1d1c25;
    --spin-orange: #fc5b05;
    --spin-pink: #ffaec2;
    --spin-stage: #ffffff;
    --spin-stage-text: #1d1c25;
    --spin-win: #82310d;
    --spin-stage-hover: rgb(40 34 57 / .08);
    max-width: 1100px; margin-inline: auto; accent-color: var(--spin-accent);
  }
  :global(html[data-theme='dark']) .spin {
    --spin-stage: #17181b;
    --spin-stage-text: #ffffff;
    --spin-win: #ffb692;
    --spin-stage-hover: rgb(245 240 255 / .12);
    --spin-accent: #ff9f72;
  }
  .play { display: grid; gap: 17px; padding-top: clamp(8px, 2vw, 26px); }
  .wheel-panel {
    display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr);
    align-items: center; gap: clamp(20px, 4vw, 60px); min-width: 0;
    padding: clamp(0px, 1.6vw, 20px);
  }
  .stage-controls { min-width: 0; display: grid; gap: 10px; grid-area: 1 / 2; }
  .stage-heading { min-width: 0; }
  .stage-heading p { position: absolute; clip-path: inset(50%); }
  .wheel-question {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
    overflow: hidden; overflow-wrap: anywhere;
    margin: 0; max-width: none;
    font: 700 clamp(2.5rem, 5vw, 4.25rem)/.95 Space, sans-serif;
    letter-spacing: -.04em;
  }
  .choice-preview {
    display: flex; gap: 7px 15px; align-items: center; flex-wrap: wrap;
    list-style: none; min-height: 32px; margin: 8px 0 0; padding: 0;
    color: var(--color-muted); font: 650 .88rem/1.25 Space, sans-serif;
  }
  .choice-preview :global(li) { min-width: 0; display: flex; align-items: center; gap: 5px; margin: 0; overflow-wrap: anywhere; }
  .choice-preview :global(img) { width: 30px; height: 28px; object-fit: contain; }
  .stage-mode { width: min(100%, 375px); }
  .stage-mode p { margin: 4px 0 0; color: var(--color-muted); font-size: .8rem; line-height: 1.25; }
  .stage-mode p:empty { display: none; }
  .mode-picker { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 10px; font-size: .83rem; }
  .mode-select { position: relative; min-width: 0; }
  .mode-select svg { position: absolute; right: 10px; top: 14px; color: var(--color-foreground); pointer-events: none; }
  .mode-picker select { display: block; appearance: none; block-size: 44px; padding-inline-end: 29px; }
  .mode-picker select:disabled { opacity: 1; cursor: default; }
  .mode-picker select:disabled + svg { visibility: hidden; }
  .wheel-display {
    position: relative; min-width: 0; width: 100%; aspect-ratio: 1; grid-area: 1 / 1;
    display: grid; place-items: center; overflow: hidden;
    background: var(--spin-stage);
    border: 1px solid var(--color-border); border-radius: 0;
  }
  .wheel-frame { width: 96%; aspect-ratio: 1; position: relative; user-select: none; }
  [data-result-image] .wheel-frame { visibility: hidden; }
  .result-display { position: absolute; inset: clamp(9px, 3%, 17px); display: grid; place-items: center; color: var(--color-muted); }
  .result-display a:not([hidden]) { position: absolute; inset: 0; display: grid; place-items: center; }
  .result-display :global(img:not([hidden])), .result-display :global(canvas[data-preview-canvas]) {
    position: absolute; inset: 0; margin: auto; display: block; width: auto; height: auto;
    max-width: 100%; max-height: 100%; object-fit: contain; filter: drop-shadow(0 6px 12px rgb(20 17 33 / .18));
  }
  .result-display p { margin: 0; padding: 13px; text-align: center; }
  .controls { min-width: 0; }
  .wheel-editor, .draw-info { margin: 0; border-top: 1px solid var(--color-border); }
  .wheel-editor { padding-block: 15px 0; }
  .draw-info > summary {
    min-height: 44px; padding: 11px 0; width: fit-content; font-weight: 700;
  }
  .wheel-editor form, .draw-info > :not(summary) { max-width: 700px; }
  .verification-warning { color: var(--color-accent); font-weight: 650; }
  .wheel-panel:has([data-spin-now]:enabled:not([hidden]), [data-draw]:enabled:not([hidden])) .wheel-frame { cursor: pointer; }
  @media (prefers-reduced-motion: no-preference) {
    .wheel-panel:has([data-spin-now]:enabled:not([hidden]), [data-draw]:enabled:not([hidden])) .wheel-frame {
      cursor: grab; touch-action: pan-y pinch-zoom;
    }
    .wheel-panel:has([data-spin-now]:enabled:not([hidden]), [data-draw]:enabled:not([hidden])) .wheel-frame:active {
      cursor: grabbing;
    }
  }
  canvas { display: block; width: 100%; height: auto; }
  .spin-hub {
    position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -50%);
    width: max(44px, 19%); aspect-ratio: 1; padding: 0; min-height: 44px;
    border: 0; border-radius: 50%; color: inherit; background: transparent; cursor: pointer;
    touch-action: manipulation;
  }
  .spin-hub:is(:hover, :active, :focus-visible) { background: transparent; }
  .spin-hub:disabled { pointer-events: none; background: rgb(30 28 40 / .18); }
  .spin-hub:hover:enabled { box-shadow: inset 0 0 0 2px rgb(255 250 240 / .75); }
  .spin-hub:focus-visible { outline: 2px solid var(--spin-stage-text); outline-offset: 3px; }
  .wheel-readout { min-width: 0; display: grid; align-content: center; gap: 1px; min-block-size: 2.8rem; }
  .readout-label { margin: 0; color: var(--color-muted); font-size: .8rem; font-weight: 650; }
  .readout-label:empty { display: none; }
  .wheel-status {
    max-block-size: 3lh; overflow: auto; margin: 0; overflow-wrap: anywhere;
    font: 700 clamp(1rem, 2.4vw, 1.38rem)/1.1 Space, sans-serif;
  }
  .wheel-panel[data-state='completed'] .wheel-status { color: var(--spin-win); }
  .wheel-panel[data-state='completed'] .wheel-status:not([data-long-result]) {
    font-size: clamp(1.55rem, 4vw, 2.23rem); line-height: .99; letter-spacing: -.035em;
  }
  .wheel-applause { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .wheel-applause i {
    --dx: 110px; --dy: -125px; --tune: var(--spin-orange); --turn: 40deg;
    position: absolute; top: 50%; left: 50%; width: 8px; height: 19px;
    border-radius: 2px; background: var(--tune); opacity: 0;
  }
  .wheel-applause i:nth-child(2) { --dx: -117px; --dy: -93px; --turn: -80deg; --tune: var(--spin-pink); }
  .wheel-applause i:nth-child(3) { --dx: -101px; --dy: 104px; --turn: 135deg; --tune: var(--spin-accent); }
  .wheel-applause i:nth-child(4) { --dx: 107px; --dy: 117px; --turn: -120deg; --tune: var(--spin-pink); }
  .wheel-applause i:nth-child(5) { --dx: -56px; --dy: -121px; --turn: 70deg; --tune: var(--spin-orange); }
  .wheel-applause i:nth-child(6) { --dx: 126px; --dy: -26px; --turn: 220deg; --tune: var(--spin-accent); }
  @media (prefers-reduced-motion: no-preference) {
    .wheel-panel[data-celebrate] .wheel-applause i { animation: fly-out 680ms cubic-bezier(.17,.84,.39,1) both; }
  }
  @keyframes fly-out {
    0% { opacity: 0; transform: rotate(0); }
    24% { opacity: 1; }
    62% { opacity: 1; }
    100% { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--turn)); }
  }
  .wheel-actions { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .9fr); gap: 8px; width: min(100%, 400px); }
  .primary-slot { display: grid; min-width: 0; min-height: 50px; }
  .wheel-primary { min-height: 50px; padding-inline: 6px; font: 700 1.03rem/1.12 Space, sans-serif; }
  .wheel-actions button { gap: 5px; }
  .spin .wheel-primary { color: var(--spin-ink); background: var(--spin-orange); border-color: var(--spin-ink); }
  .spin .wheel-primary:hover:enabled { background: #ff8c52; }
  .spin .wheel-primary:disabled { opacity: .68; }
  .spin .wheel-actions > button { background: var(--color-field); font-weight: 700; white-space: nowrap; }
  .spin .wheel-actions > button:hover { border-color: var(--spin-accent); }
  .wheel-actions svg, .wheel-tools svg, .preset-quick button svg { flex: none; }
  .wheel-tools { display: flex; align-items: center; justify-content: flex-start; gap: 4px; min-height: 44px; flex-wrap: wrap; }
  .wheel-tools button, .wheel-tools a { gap: 5px; }
  .wheel-tools a { min-height: 44px; padding-inline: 8px; align-items: center; font-size: .85rem; }
  .wheel-tools a:not([hidden]) { display: inline-flex; }
  .spin .wheel-tools button:not(.button), .spin .wheel-tools a { color: var(--spin-stage-text); border-color: transparent; }
  .spin .wheel-tools button:not(.button):hover { background: var(--spin-stage-hover); }
  .spin .wheel-tools :is([data-finish], [data-auto], [data-edit-choices]) { border-color: var(--color-control-border); }
  .spin .wheel-tools [data-edit-choices] { font-weight: 700; margin-inline-end: 4px; }
  .spin .wheel-tools button[data-sound][aria-pressed='true'] { color: var(--spin-stage-text); background: transparent; border-color: transparent; }
  .wheel-panel [data-error] { color: var(--color-foreground); margin: 0; }
  h2 { margin: 0 0 8px; font-size: clamp(1.45rem, 3vw, 2rem); overflow-wrap: anywhere; letter-spacing: -.025em; }
  form { display: grid; gap: 10px; }
  form[hidden], [hidden] { display: none; }
  label { display: grid; gap: 2px; margin: 0; font-weight: 650; }
  input, textarea, select { font: inherit; width: 100%; min-height: 44px; padding: 7px 10px; margin: 0; color: var(--color-foreground); background: var(--color-field); border: 1px solid var(--color-border); border-radius: 7px; }
  textarea { min-height: 75px; }
   .screen-reader { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .add-entry { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 7px; }
  .order-toggle { display: flex; align-items: center; gap: 8px; min-height: 44px; }
  .order-toggle input { width: 20px; height: 20px; min-height: 0; accent-color: var(--color-brand); }
  .choice-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 7px; flex-wrap: wrap; margin-bottom: -7px; }
  .choice-heading h2 { margin: 0 0 7px; }
  .editor-shortcuts { margin-bottom: 7px; }
