---
import Base from '../layouts/Base.astro';
import { ChevronDown, Clipboard, Plus, RotateCw } from '@lucide/astro';
import { spinArtwork, spinArtworkAlt, spinDiscovery, spinOrigin } from '../lib/spin-site.mjs';
import { spinExamples } from '../lib/spin-examples.mjs';
import { spinPresetGroups } from '../lib/spin-presets.mjs';
import { spinChoiceLimit, spinLifetimeDays } from '../lib/spin-protocol.mjs';
const candidate = Astro.url.searchParams.get('example');
const sessionLink = Astro.url.searchParams.has('session');
const example = !sessionLink && candidate && Object.hasOwn(spinExamples, candidate) ? candidate : '';
const replay = Boolean(sessionLink || example);
const spinPath = Astro.url.origin === spinOrigin ? '/' : '/spin';
const title = replay ? 'Verify a replay · App Composer Spin' : 'Decision Wheel & Random Picker · App Composer Spin';
const description = replay
  ? 'Open an App Composer Spin replay and check the recorded decision.'
  : 'Make a free online decision wheel. Pick dinner, a game or who goes first, then share a replay and a result your friends can verify.';
if (replay) Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const application = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: spinDiscovery.name,
  url: spinDiscovery.href,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  inLanguage: 'en-AU',
  image: new URL(spinArtwork, spinOrigin).href,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'AUD' },
});
---
<Base {title} {description} canonical={spinDiscovery.href} shareImage={spinArtwork}
  shareAlt={spinArtworkAlt} shareType="image/jpeg" noindex={replay || undefined} focusedExperience spinProduct>
  {!replay && <script slot="head" type="application/ld+json" set:html={application} />}
  <section class="spin" data-spin data-spin-path={spinPath} data-spin-example={example || undefined}>
    <div class="play">
      <header class="spin-heading">
        <h1 data-spin-heading>{replay ? 'Spin replay' : 'What’s for dinner?'}</h1>
        <p class="note" data-spin-intro hidden></p>
      </header>
      <div class="wheel-panel" data-wheel-panel>
        <div class="wheel-frame" data-wheel-tap>
          <span class="pointer" aria-hidden="true"></span>
          <canvas width="560" height="560" aria-hidden="true" data-wheel></canvas>
        </div>
        <p class="wheel-status" role="status" data-result>{replay ? 'Opening replay…' : 'Loading wheel…'}</p>
        <div class="wheel-actions">
          <button type="submit" class="button wheel-primary" form="spin-setup" data-spin-now
            aria-describedby="spin-link-privacy" hidden={replay} disabled>Spin</button>
          <button type="button" class="button wheel-primary" data-draw hidden>Spin the wheel</button>
          <button type="button" class="button wheel-primary" data-spin-again hidden><RotateCw size={18} aria-hidden="true" /> Spin again</button>
          <button type="button" class="wheel-copy" data-share hidden><Clipboard size={17} aria-hidden="true" /> <span data-share-label>Copy link</span></button>
        </div>
        <aside class="winner-art" data-winner-art hidden>
          <img alt="" width="72" height="72" src="/spin-brand/food-20261127.webp" loading="lazy" decoding="async" />
          <a data-nearby target="_blank" rel="noopener noreferrer">Find it near you in Maps</a>
        </aside>
        <p role="alert" data-error></p>
        {replay && <p data-start-over hidden><a href={spinDiscovery.href}>Open Spin</a></p>}
      </div>
      <div class="controls">
        <form id="spin-setup" novalidate data-setup hidden={replay}>
          <div class="choice-heading">
            <h2 id="spin-choices">Choices</h2>
            <p class="note" data-choice-odds></p>
          </div>
          <ol class="choice-list" data-choices-list aria-label="Wheel choices"></ol>
          <div class="add-entry">
            <input type="text" name="entry" maxlength="56" aria-label="New choice" placeholder="Add a choice" autocomplete="off" />
            <button type="button" data-add-choice><Plus size={18} aria-hidden="true" /> Add</button>
          </div>
          <div class="preset-quick">
            <button type="button" data-quick-chains aria-pressed="false">Fast food</button>
            <button type="button" data-takeaway aria-pressed="false">Takeaway roulette</button>
            <label class="preset-picker">
              <span class="screen-reader">Choose a preset</span>
              <select data-preset-picker>
                <option value="">More presets</option>
                {spinPresetGroups.map(group => <optgroup label={group.label}>
                  {group.presets.map(preset => <option value={preset.id}>{preset.label}</option>)}
                </optgroup>)}
              </select>
              <ChevronDown size={15} aria-hidden="true" />
            </label>
          </div>
          <p class="note" data-editor-message role="status"></p>
          <details class="choice-editor">
            <summary>Paste or manage choices</summary>
            <button type="button" data-clear-wheel>Start blank</button>
            <label class="order-toggle"><input type="checkbox" data-show-order /> Show reorder controls</label>
            <label>Find a choice <input type="search" data-choice-search autocomplete="off" /></label>
            <div class="button-row">
              <button type="button" data-enable="all">Enable all</button>
              <button type="button" data-enable="none">Disable all</button>
            </div>
            <label>Paste choices <textarea name="paste" rows="2" placeholder="One choice per line"></textarea></label>
            <button type="button" data-paste-choices>Add pasted choices</button>
            <p class="note">The wheel uses 2–{spinChoiceLimit} enabled choices. The numbers match the wheel on longer lists.</p>
          </details>
          <details class="wheel-options">
            <summary>Wheel settings</summary>
            <label>Question <input name="question" required maxlength="100" value="What’s for dinner?" /></label>
            <label class="series">Best of <input name="bestOf" type="number" min="1" max="21" step="2" value="1" required /></label>
            <p class="note" data-rules></p>
            <button type="submit" data-lock-wheel aria-describedby="spin-link-privacy">Lock wheel and get link</button>
            <p class="note" id="spin-link-privacy">Anyone with a session link can see the question and choices for {spinLifetimeDays} days.</p>
          </details>
          <details class="saved-wheels">
            <summary>Saved wheels</summary>
            <div class="button-row">
              <button type="button" data-favourite aria-pressed="false">Favourite preset</button>
              <button type="button" data-reset>Reset to preset</button>
            </div>
            <div class="button-row">
              <button type="button" data-save-wheel>Save this wheel</button>
              <button type="button" data-duplicate-wheel>Save a copy</button>
              <button type="button" data-remove-wheel>Remove saved copy</button>
            </div>
            <label>Saved wheels <select data-saved-wheels></select></label>
            <label>Favourites <select data-favourites></select></label>
            <label>Recent presets <select data-recent-wheels></select></label>
          </details>
          <details>
            <summary>Find takeaway near you</summary>
            <label>Suburb, town or postcode <input name="suburb" maxlength="80" placeholder="e.g. Sunbury VIC 3429" autocomplete="off" /></label>
            <p class="note">Your area stays on this device. On a takeaway result, open Maps to look for the winning choice near you. Check store details there.</p>
          </details>
        </form>
        <section data-session hidden aria-labelledby="spin-question">
          <h2 id="spin-question">Draw details</h2>
          <p class="note" data-series></p>
          <div class="result-actions button-row">
            <button type="button" data-auto hidden>Spin full series</button>
            <button type="button" data-native-share hidden>Share…</button>
            <button type="button" data-refresh>Refresh result</button>
          </div>
          <details class="export-settings" data-exports hidden>
            <summary>Replay and download</summary>
            <div class="button-row">
            <button type="button" data-replay>Replay last spin</button>
            <button type="button" data-replay-series>Replay the series</button>
            <button type="button" data-png>Save square PNG</button>
            <button type="button" data-portrait>Save portrait PNG</button>
            <button type="button" data-story>Save story PNG</button>
            <button type="button" data-landscape>Save landscape PNG</button>
            <button type="button" data-replay-video>Download replay video</button>
            <button type="button" data-receipt>Download JSON receipt</button>
            </div>
          </details>
          <p class="note" data-export-status role="status"></p>
          <p data-verification></p>
          <details data-score-details>
            <summary>Series score</summary>
            <ol class="scores" aria-label="Series score" data-scores></ol>
          </details>
          <details>
            <summary>Commitment and round history</summary>
            <p class="note">Send the link before spinning so friends can compare the commitment. A fixed session prevents silent rerolls through the app. Someone can still create a separate session or choose which one to share.</p>
            <code data-commitment></code>
            <ol data-rounds></ol>
            <p class="note" data-expiry></p>
          </details>
          <div class="button-row secondary-actions">
            <button type="button" aria-pressed="false" data-sound>Sound</button>
            <button type="button" data-abandon hidden>Abandon session</button>
            <a data-remix>Edit this wheel</a>
            <button type="button" data-copy-template>Copy editable wheel link</button>
          </div>
        </section>
        <noscript><p>Enable JavaScript to use Spin.</p></noscript>
      </div>
    </div>
    {!replay && <nav class="spin-guide" data-spin-guide aria-label="Spin examples and help">
      {Object.entries(spinExamples).map(([key, label]) => <a href={spinOrigin + '/?example=' + key}>{label}</a>)}
      <a href="https://composer.loftwah.com/articles/why-we-built-spin">How verification works</a>
      <a href="https://composer.loftwah.com/share/spin">Spin in App Composer Share</a>
    </nav>}
  </section>
</Base>

<script>
  import '../browser/spin.mjs';
</script>

<style>
  :global(html[data-product='spin']) {
    --color-background: #171615;
    --color-foreground: #fff5e8;
    --color-muted: #c3b4aa;
    --color-border: #53483e;
    --color-accent: #ff9364;
    --spin-field: #24201c;
    --spin-selection: #39271e;
  }
  :global(html[data-product='spin'][data-theme='light']) {
    --color-background: #faf7f1;
    --color-foreground: #201a16;
    --color-muted: #62554b;
    --color-border: #c6b7a8;
    --color-accent: #aa3814;
    --spin-field: #fffdf9;
    --spin-selection: #ffe3d1;
  }
  .spin { max-width: 1150px; margin-inline: auto; }
  .play {
    display: grid;
    grid-template-columns: minmax(315px, .82fr) minmax(0, 1.18fr);
    grid-template-areas: 'heading wheel' 'editor wheel';
    grid-template-rows: auto 1fr;
    align-items: start;
    gap: 20px clamp(28px, 6vw, 88px);
    padding-top: clamp(14px, 3.2vw, 40px);
  }
  .spin-heading { grid-area: heading; padding-block: 6px; min-width: 0; }
  .spin-heading h1 { max-width: 16ch; margin: 0; font-size: clamp(2.35rem, 6vw, 5.2rem); font-weight: 720; line-height: .99; letter-spacing: -.039em; overflow-wrap: anywhere; }
  .spin-heading p { margin: 10px 0 0; }
  .controls { grid-area: editor; min-width: 0; }
  .wheel-panel {
    grid-area: wheel; min-width: 0; display: grid; justify-items: center;
    padding: clamp(6px, 1.5vw, 18px) clamp(10px, 2.25vw, 28px) clamp(13px, 2vw, 21px);
    color: var(--color-foreground); background: var(--spin-field); border: 1px solid var(--color-border);
    border-radius: 15px;
  }
  .wheel-frame { width: min(100%, 455px); position: relative; }
  .wheel-panel:has([data-spin-now]:enabled:not([hidden]), [data-draw]:enabled:not([hidden])) .wheel-frame { cursor: pointer; }
  canvas { display: block; width: 100%; height: auto; }
  .pointer {
    position: absolute; z-index: 2; top: 1%; left: 50%; width: clamp(22px, 4.2vw, 40px);
    height: clamp(27px, 5vw, 48px); translate: -50% 0;
    background: #fff0d8; clip-path: polygon(3% 0, 97% 0, 85% 53%, 50% 100%, 15% 53%);
    pointer-events: none;
  }
  .wheel-actions { display: flex; justify-content: center; gap: 8px; width: min(100%, 455px); margin-top: 10px; }
  .wheel-actions .wheel-primary { min-height: 49px; flex: 1; font: 700 1.12rem/1 Space, sans-serif; }
  .wheel-actions .wheel-copy { flex: 1; }
  .wheel-actions .wheel-copy svg { flex: none; }
  .wheel-panel [data-error] { margin: 8px 0 0; color: var(--color-foreground); }
  .wheel-status { font: 700 clamp(1rem, 2.7vw, 1.3rem)/1.2 Space, sans-serif; margin: 4px 0 0; text-align: center; text-wrap: balance; }
  [data-state='completed'] .wheel-status { font-size: clamp(1.9rem, 5vw, 3.1rem); }
  h2 { margin: 0 0 8px; font-size: clamp(1.35rem, 3vw, 1.8rem); overflow-wrap: anywhere; }
  form { display: grid; gap: 10px; }
  form[hidden], [hidden] { display: none; }
  label { display: grid; gap: 2px; margin: 0; font-weight: 650; }
  input, textarea, select { font: inherit; width: 100%; min-height: 44px; padding: 7px 10px; margin: 0; color: var(--color-foreground); background: var(--spin-field); border: 1px solid var(--color-border); border-radius: 7px; }
  textarea { min-height: 75px; }
   .screen-reader { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .add-entry { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 7px; }
  .order-toggle { display: flex; align-items: center; gap: 8px; min-height: 44px; }
  .order-toggle input { width: 20px; height: 20px; min-height: 0; accent-color: #eb5526; }
  .choice-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 7px; flex-wrap: wrap; margin-bottom: -7px; }
  .choice-heading h2 { font-size: 1.08rem; margin: 0; }
  .choice-heading p { margin: 0; font-size: .82rem; }
  .choice-list { list-style: none; display: block; margin: 0; padding: 0; max-height: 16.8rem; overflow-y: auto; }
  .choice-list :global(li) { display: grid; grid-template-columns: 38px minmax(0, 1fr) 42px; gap: 3px; align-items: center; margin: 0; padding: 1px 3px; min-height: 44px; border-bottom: 1px solid var(--color-border); }
  .choice-list :global(label) { display: flex; align-items: center; gap: 3px; min-height: 43px; margin: 0; cursor: pointer; }
  .choice-list :global(label span) { display: none; color: var(--color-muted); font-size: .69rem; }
  .choice-list[data-numbered='true'] :global(label span) { display: inline; }
  .choice-list:not([data-reorder='true']) :global(button[data-control='up']),
  .choice-list:not([data-reorder='true']) :global(button[data-control='down']) { display: none; }
  .choice-list[data-reorder='true'] :global(li) { grid-template-columns: 38px minmax(0, 1fr) 32px 32px 42px; }
  .choice-list :global(li[data-enabled='false'] input[type='text']) { color: var(--color-muted); text-decoration: line-through; }
  .choice-list :global(input[type='text']:focus) { background: var(--spin-field); }
  .choice-list :global(input[type='checkbox']) { width: 20px; height: 20px; margin: 0; accent-color: #cc4b26; }
  .choice-list :global(input[type='text']) { min-height: 41px; width: 100%; font: inherit; font-size: 1rem; padding: 2px 4px; color: var(--color-foreground); background: transparent; border: 0; margin: 0; border-radius: 4px; }
  .choice-list :global(button) { min-height: 40px; padding: 0; font: 650 1.2rem/1 system-ui; color: var(--color-foreground); background: transparent; border: 0; }
  .choice-list :global(button:hover) { background: var(--spin-field); }
  .choice-list :global(button:disabled) { opacity: .35; cursor: default; }
  .button-row { display: flex; flex-wrap: wrap; gap: 7px; }
  .spin button:not(.spin-hub, .button) { min-height: 44px; padding: 5px 10px; border: 1px solid var(--color-border); border-radius: 7px; background: transparent; color: var(--color-foreground); font-size: .9rem; }
  .spin button:not(.spin-hub, .button):hover { background: var(--spin-field); }
  .spin button:not(.spin-hub, .button)[aria-pressed='true'] { background: var(--spin-selection); border-color: var(--color-accent); color: var(--color-foreground); }
  .spin button:disabled { cursor: default; }
  .preset-quick { display: flex; flex-wrap: wrap; gap: 7px; padding-block: 3px; }
  .preset-picker { flex: 0 1 148px; position: relative; min-width: 0; }
  .preset-picker select { appearance: none; height: 44px; padding-inline-end: 29px; background: transparent; font-size: .9rem; cursor: pointer; }
  .preset-picker svg { position: absolute; top: 15px; right: 10px; pointer-events: none; }
  .preset-quick button { text-align: left; justify-content: space-between; }
  .series { grid-template-columns: max-content 79px; align-items: center; gap: 12px; }
  .note { color: var(--color-muted); font-size: .88rem; margin: 0 0 3px; }
  form details, [data-session] details { border-top: 1px solid var(--color-border); margin: 0; }
  form details > * + *, [data-session] details > * + * { margin-block-end: 8px; }
  summary { cursor: pointer; padding-block: 8px; }
  details code { overflow-wrap: anywhere; }
  .result-actions, .secondary-actions { margin-block: 12px; }
  [data-verification] { display: inline-block; color: var(--color-foreground); background: var(--spin-field); padding: 8px 12px; border-radius: 7px; }
  .scores { list-style: none; margin: 0; padding: 0; font-variant-numeric: tabular-nums; }
  .scores :global(li) { padding: 4px 0; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; gap: 12px; overflow-wrap: anywhere; }
  .scores :global(.winner) { color: var(--color-accent); font-weight: 700; }
  [data-error]:empty, [data-verification]:empty, [data-editor-message]:empty, [data-export-status]:empty { display: none; }
  .secondary-actions a, .winner-art a { align-self: center; text-decoration: underline; text-underline-offset: .22em; }
  .winner-art { margin-top: 10px; display: flex; align-items: center; justify-content: center; gap: 13px; }
  .winner-art img { display: block; width: 58px; height: 58px; border-radius: 9px; }
  .winner-art a { min-height: 44px; display: inline-flex; align-items: center; font-size: .9rem; }
  .spin-guide { margin-top: 36px; padding-top: 8px; border-top: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: 0 20px; }
  .spin-guide a { display: inline-flex; min-height: 44px; align-items: center; text-decoration: underline; text-underline-offset: .24em; font-size: .89rem; }
  :global(html[data-product='spin'] .focused-experience footer) { display: flex; flex-wrap: wrap; gap: .7rem 1.5rem; }
  @media (max-width: 760px) {
    .play { grid-template-columns: 1fr; grid-template-areas: 'heading' 'wheel' 'editor'; grid-template-rows: auto; row-gap: 13px; padding-top: 8px; }
    .spin-heading h1 { font-size: clamp(2.25rem, 10vw, 3.5rem); }
    .wheel-frame { width: min(100%, 275px); }
    .wheel-panel { padding-block-start: 5px; }
    .wheel-status { font-size: .94rem; }
    [data-state='completed'] .wheel-status { font-size: 1.95rem; }
  }
</style>
