---
import Base from '../layouts/Base.astro';
import SpinTasteCloud from '../components/SpinTasteCloud.astro';
import SpinShareDialog from '../components/SpinShareDialog.astro';
import { ArrowUpRight, CalendarDays, ChevronDown, Gamepad2, Plus, RotateCw, Share2, Utensils, Volume2, VolumeX } from '@lucide/astro';
import { spinArtwork, spinArtworkAlt, spinDiscovery, spinOrigin } from '../lib/spin-site.mjs';
import { spinExamples } from '../lib/spin-examples.mjs';
import { spinPresetGroups } from '../lib/spin-presets.mjs';
import { spinChoiceLimit, spinIdPattern, spinLifetimeDays } from '../lib/spin-protocol.mjs';
const candidate = Astro.url.searchParams.get('example');
const sharedId = Astro.url.searchParams.get('session');
const sessionLink = sharedId !== null;
const example = !sessionLink && candidate && Object.hasOwn(spinExamples, candidate) ? candidate : '';
const replay = Boolean(sessionLink || example);
const spinPath = Astro.url.origin === spinOrigin ? '/' : '/spin';
const title = replay ? 'Watch a draw · Spin by App Composer' : 'Decision Wheel & Random Picker · Spin by App Composer';
const description = replay
  ? 'Open the shared wheel to see the recorded draw and verify the result when it finishes.'
  : 'Make a free online decision wheel. Choose a single spin, a best-of series or an open session with a running tally, then share a replay your friends can verify.';
Astro.csp?.insertDirective('img-src blob:');
if (replay) Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const canonical = (example || (sharedId && spinIdPattern.test(sharedId))) ? new URL(spinPath + '?' + new URLSearchParams(
  sessionLink ? { session: sharedId ?? '' } : { example },
), Astro.url.origin).href : spinDiscovery.href;
const application = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: spinDiscovery.name,
  url: spinDiscovery.href,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  inLanguage: 'en-AU',
  image: new URL(spinArtwork, spinOrigin).href,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'AUD' },
});
---
<Base {title} {description} {canonical} shareImage={spinArtwork}
  shareAlt={spinArtworkAlt} shareType="image/jpeg" shareWidth={1200} shareHeight={630} noindex={replay || undefined} focusedExperience spinProduct>
  {!replay && <script slot="head" type="application/ld+json" set:html={application} />}
  <section class="spin" data-spin data-spin-path={spinPath} data-spin-example={example || undefined}>
    <div class="play">
      <div class="wheel-panel" data-wheel-panel>
        <header class="stage-heading">
          <h1 class="wheel-question" data-spin-heading>{replay ? 'Opening draw…' : 'What’s for dinner?'}</h1>
          <p class="note" data-spin-intro hidden></p>
        </header>
        <div class="stage-mode">
          <label class="mode-picker">
            <span>Play mode</span>
            <span class="mode-select"><select name="bestOf" form="spin-setup" aria-describedby="spin-mode-help" required disabled={replay}>
              <option value="1">Single spin · Rounds off</option>
              <option value="3">Best of 3</option>
              <option value="5">Best of 5</option>
              <option value="7">Best of 7</option>
              <option value="0">Open tally</option>
              <optgroup label="Longer series">
                {[9, 11, 13, 15, 17, 19, 21].map(count => <option value={count}>Best of {count}</option>)}
              </optgroup>
            </select><ChevronDown size={16} aria-hidden="true" /></span>
          </label>
          <p id="spin-mode-help" data-rules>One spin decides it. Every enabled choice has equal odds.</p>
        </div>
        <div class="wheel-frame" data-wheel-tap>
          <svg class="pointer" aria-hidden="true" viewBox="0 0 42 48">
            <path d="M4 4h34l-4 22-13 17L8 26z" fill="#ff4da4" stroke="#1f1b93" stroke-width="3" stroke-linejoin="round" />
          </svg>
          <canvas width="560" height="560" aria-hidden="true" data-wheel></canvas>
          <div class="wheel-applause" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="wheel-readout">
          <p class="readout-label" data-result-label>{replay ? 'Shared draw' : 'Ready to spin'}</p>
          <p class="wheel-status" role="status" data-result>{replay ? 'Opening replay…' : 'Loading wheel…'}</p>
        </div>
        <div class="wheel-actions">
          <div class="primary-slot">
            <button type="submit" class="button wheel-primary" form="spin-setup" data-spin-now
              aria-describedby="spin-link-privacy" hidden={replay} disabled>Spin</button>
            <button type="button" class="button wheel-primary" data-draw hidden>Spin</button>
            <button type="button" class="button wheel-primary" data-spin-again hidden><RotateCw size={17} aria-hidden="true" /> Spin again</button>
            <button type="button" class="button wheel-primary" data-stage-replay hidden><RotateCw size={17} aria-hidden="true" /> Replay spin</button>
            <button type="button" class="button wheel-primary" disabled data-waiting hidden>Waiting for host</button>
          </div>
          <button type="button" data-share disabled={replay}><Share2 size={17} aria-hidden="true" /> <span data-share-label>Share wheel</span></button>
        </div>
        <div class="wheel-tools">
          <button type="button" data-sound aria-pressed="true" aria-label="Wheel sound">
            <Volume2 size={18} aria-hidden="true" data-sound-on /><VolumeX size={18} aria-hidden="true" data-sound-off hidden />
            <span data-sound-label>Sound on</span>
          </button>
          {!replay && <button type="button" data-find-ideas aria-controls="spin-ideas"><Utensils size={17} aria-hidden="true" /> Food ideas</button>}
          <button class="finish-session" type="button" data-finish hidden>Finish session</button>
          <a data-nearby target="_blank" rel="noopener noreferrer" hidden>Find it nearby <ArrowUpRight size={15} aria-hidden="true" /></a>
        </div>
        <p role="alert" data-error></p>
        {replay && <p data-start-over hidden><a href={spinDiscovery.href}>Open Spin</a></p>}
      </div>
      <div class="controls">
        <form id="spin-setup" novalidate data-setup hidden={replay}>
          <div class="choice-heading">
            <h2 id="spin-choices">Build your wheel</h2>
          </div>
        <div class="preset-quick" role="group" aria-label="Wheel presets" data-spin-presets>
          <button type="button" data-quick-chains aria-pressed="false"><Utensils size={16} aria-hidden="true" /> Fast food</button>
          <button type="button" data-quick-preset="game" aria-pressed="false"><Gamepad2 size={16} aria-hidden="true" /> Game night</button>
          <button type="button" data-quick-preset="weekend" aria-pressed="false"><CalendarDays size={16} aria-hidden="true" /> Weekend</button>
          <label class="preset-picker">
            <span class="screen-reader">Choose a preset</span>
            <select form="spin-setup" data-preset-picker>
              <option value="">Presets</option>
              {spinPresetGroups.map(group => <optgroup label={group.label}>
                {group.presets.map(preset => <option value={preset.id}>{preset.label}</option>)}
              </optgroup>)}
            </select>
            <ChevronDown size={15} aria-hidden="true" />
          </label>
        </div>
          <label class="question-field">Question <input name="question" required maxlength="100" value="What’s for dinner?" /></label>
          <div class="choice-heading choice-caption">
            <h3>Choices</h3>
            <p class="note" data-choice-odds></p>
          </div>
          <ol class="choice-list" data-choices-list aria-label="Wheel choices"></ol>
          <div class="add-entry">
            <input type="text" name="entry" maxlength="56" aria-label="New choice" placeholder="Add a choice" autocomplete="off" />
            <button type="button" data-add-choice><Plus size={18} aria-hidden="true" /> Add</button>
          </div>
          <p class="note" data-editor-message role="status"></p>
          <SpinTasteCloud />
          <details class="choice-editor">
            <summary>Paste or manage choices</summary>
            <button type="button" data-clear-wheel>Start blank</button>
            <label class="order-toggle"><input type="checkbox" data-show-order /> Show reorder controls</label>
            <label>Find a choice <input type="search" data-choice-search autocomplete="off" /></label>
            <div class="button-row">
              <button type="button" data-enable="all">Enable all</button>
              <button type="button" data-enable="none">Disable all</button>
            </div>
            <label>Paste choices <textarea name="paste" rows="2" placeholder="One choice per line"></textarea></label>
            <button type="button" data-paste-choices>Add pasted choices</button>
            <p class="note">The wheel uses 2–{spinChoiceLimit} enabled choices. The numbers match the wheel on longer lists.</p>
          </details>
          <p class="screen-reader" id="spin-link-privacy">Starting creates an unlisted draw. Anyone with its link can see the question and choices for {spinLifetimeDays} days.</p>
          <details class="saved-wheels">
            <summary>Saved wheels</summary>
            <div class="button-row">
              <button type="button" data-favourite aria-pressed="false">Favourite preset</button>
              <button type="button" data-reset>Reset to preset</button>
            </div>
            <div class="button-row">
              <button type="button" data-save-wheel>Save this wheel</button>
              <button type="button" data-duplicate-wheel>Save a copy</button>
              <button type="button" data-remove-wheel>Remove saved copy</button>
            </div>
            <label>Saved wheels <select data-saved-wheels></select></label>
            <label>Favourites <select data-favourites></select></label>
            <label>Recent presets <select data-recent-wheels></select></label>
          </details>
          <details>
            <summary>Find takeaway near you</summary>
            <label>Suburb, town or postcode <input name="suburb" maxlength="80" placeholder="e.g. Sunbury VIC 3429" autocomplete="off" /></label>
            <p class="note">Your area stays on this device. On a takeaway result, open Maps to look for the winning choice near you. Check store details there.</p>
          </details>
        </form>
        <section data-session hidden aria-labelledby="spin-question">
          <h2 id="spin-question" data-session-heading>Draw details</h2>
          <p data-full-question></p>
          <p class="note" data-series></p>
          <div class="result-actions button-row">
            <button type="button" data-auto hidden>Spin full series</button>
            <button type="button" data-refresh>Refresh result</button>
          </div>
          <div class="result-actions button-row" data-playback hidden>
            <button type="button" data-replay-last>Replay last spin</button>
            <button type="button" data-replay-series>Replay the series</button>
            <a class="button" data-create-own href={spinDiscovery.href}>Make your own wheel <ArrowUpRight size={16} aria-hidden="true" /></a>
          </div>
          <p data-verification></p>
          <details data-score-details>
            <summary data-score-heading>Series score</summary>
            <ol class="scores" aria-label="Series score" data-scores></ol>
          </details>
          <details>
            <summary>Commitment and round history</summary>
            <p class="note">Send the link before spinning so friends can compare the commitment. A fixed session prevents silent rerolls through the app. Someone can still create a separate session or choose which one to share.</p>
            <code data-commitment></code>
            <p class="note" data-history-note hidden></p>
            <ol data-rounds></ol>
            <p class="note" data-expiry></p>
          </details>
          <div class="button-row secondary-actions">
            <button type="button" data-abandon hidden>Abandon session</button>
            <a data-remix>Edit a copy of this wheel</a>
          </div>
        </section>
        <noscript><p>Enable JavaScript to use Spin.</p></noscript>
      </div>
    </div>
    <SpinShareDialog />
    {!replay && <nav class="spin-guide" aria-label="Spin examples and help">
      {Object.entries(spinExamples).map(([key, label]) => <a href={spinOrigin + '/?example=' + key}>{label}</a>)}
      <a href="https://composer.loftwah.com/articles/why-we-built-spin">How verification works</a>
      <a href="https://composer.loftwah.com/share/spin">Spin in App Composer Share</a>
    </nav>}
  </section>
</Base>

<script>
  import '../browser/spin.mjs';
</script>

<style>
  .spin {
    --spin-blue: #2821b1;
    --spin-ink: #1a1542;
    --spin-acid: #edff40;
    --spin-pink: #ff6fbc;
    --spin-stage: #2821b1;
    --spin-paper: #fffaf0;
    --spin-stage-muted: #dedbfe;
    max-width: 1100px; margin-inline: auto; accent-color: var(--spin-blue);
  }
  :global(html[data-theme='dark']) .spin {
    --spin-stage: #292085;
    --spin-blue: #bdb6ff;
  }
  .play {
    display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(300px, .88fr);
    gap: clamp(26px, 5vw, 72px); align-items: start;
    padding-top: clamp(12px, 3vw, 40px);
  }
  .controls { min-width: 0; }
  .stage-heading { width: 100%; min-width: 0; text-align: center; }
  .stage-heading p { position: absolute; clip-path: inset(50%); }
  .wheel-question {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
    overflow: hidden; overflow-wrap: anywhere; text-wrap: balance;
    margin: 0; max-width: none; block-size: 2lh;
    font: 700 clamp(1.4rem, 2.7vw, 2.2rem)/1.04 Space, sans-serif;
    letter-spacing: -.035em; align-content: center;
  }
  .wheel-panel {
    min-width: 0; display: grid; justify-items: center; gap: 8px;
    padding: clamp(12px, 1.8vw, 23px);
    color: var(--spin-paper); background: var(--spin-stage);
    border: 1px solid var(--color-border); border-radius: 15px;
  }
  .stage-mode { width: min(100%, 370px); }
  .stage-mode p { margin: 4px 0 0; block-size: 2lh; overflow: auto; text-align: center; color: var(--spin-stage-muted); font-size: .78rem; line-height: 1.24; }
  .mode-picker { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 12px; font-size: .88rem; }
  .mode-select { position: relative; min-width: 0; }
  .mode-select svg { position: absolute; right: 9px; top: 14px; color: var(--spin-ink); pointer-events: none; }
  .mode-picker select { display: block; appearance: none; block-size: 44px; padding-inline-end: 27px; color-scheme: light; color: var(--spin-ink); background: var(--spin-paper); border-color: transparent; }
  .mode-picker select:disabled { opacity: 1; cursor: default; color: var(--spin-ink); }
  .wheel-frame { width: min(100%, 355px); aspect-ratio: 1; position: relative; }
  .wheel-panel:has([data-spin-now]:enabled:not([hidden]), [data-draw]:enabled:not([hidden])) .wheel-frame { cursor: pointer; }
  canvas { display: block; width: 100%; height: auto; }
  .pointer { position: absolute; z-index: 2; top: 1%; left: 50%; width: 10%; translate: -50% 0; pointer-events: none; }
  .wheel-readout {
    width: min(100%, 455px); text-align: center; display: grid; align-content: center; gap: 4px;
    min-width: 0; block-size: 5.25rem; padding-inline: 4px;
  }
  .readout-label { margin: 0; color: var(--spin-stage-muted); font-size: .79rem; font-weight: 650; }
  .wheel-status {
    max-block-size: 3lh; overflow: auto; margin: 0; overflow-wrap: anywhere; text-wrap: balance;
    font: 700 clamp(1.06rem, 2.5vw, 1.45rem)/1.12 Space, sans-serif;
  }
  .wheel-panel[data-state='completed'] .wheel-status { color: var(--spin-acid); }
  .wheel-applause { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .wheel-applause i {
    --dx: 110px; --dy: -125px; --tune: var(--spin-acid); --turn: 40deg;
    position: absolute; top: 50%; left: 50%; width: 8px; height: 19px;
    border-radius: 2px; background: var(--tune); opacity: 0;
  }
  .wheel-applause i:nth-child(2) { --dx: -117px; --dy: -93px; --turn: -80deg; --tune: var(--spin-pink); }
  .wheel-applause i:nth-child(3) { --dx: -101px; --dy: 104px; --turn: 135deg; --tune: var(--spin-blue); }
  .wheel-applause i:nth-child(4) { --dx: 107px; --dy: 117px; --turn: -120deg; --tune: var(--spin-pink); }
  .wheel-applause i:nth-child(5) { --dx: -56px; --dy: -121px; --turn: 70deg; --tune: var(--spin-acid); }
  .wheel-applause i:nth-child(6) { --dx: 126px; --dy: -26px; --turn: 220deg; --tune: var(--spin-blue); }
  @media (prefers-reduced-motion: no-preference) {
    .wheel-panel[data-state='completed'] .wheel-applause i { animation: fly-out 680ms cubic-bezier(.17,.84,.39,1) both; }
    .wheel-panel[data-state='completed'] .pointer { animation: settle-pointer 310ms ease-out both; }
  }
  @keyframes fly-out {
    0% { opacity: 0; transform: rotate(0); }
    24% { opacity: 1; }
    62% { opacity: 1; }
    100% { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--turn)); }
  }
  @keyframes settle-pointer {
    23% { transform: rotate(11deg); }
    50% { transform: rotate(-5deg); }
    100% { transform: rotate(0); }
  }
  .wheel-actions { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 8px; width: min(100%, 455px); }
  .primary-slot { display: grid; min-width: 0; min-height: 50px; }
  .wheel-primary { min-height: 50px; padding-inline: 6px; font: 700 1.03rem/1.12 Space, sans-serif; }
  .wheel-actions button { gap: 5px; }
  .spin .wheel-primary { color: var(--spin-ink); background: var(--spin-acid); border-color: var(--spin-ink); }
  .spin .wheel-primary:hover:enabled { background: #f9ff88; }
  .spin .wheel-primary:disabled { opacity: .68; }
  .spin .wheel-actions > button { background: var(--color-field); font-weight: 700; }
  .wheel-actions svg, .wheel-tools svg, .preset-quick button svg { flex: none; }
  .wheel-tools { display: flex; align-items: center; justify-content: center; gap: 4px; min-height: 44px; flex-wrap: wrap; }
  .wheel-tools button, .wheel-tools a { gap: 5px; }
  .wheel-tools a { min-height: 44px; padding-inline: 8px; align-items: center; font-size: .85rem; }
  .wheel-tools a:not([hidden]) { display: inline-flex; }
  .spin .wheel-tools button:not(.button), .spin .wheel-tools a { color: var(--spin-paper); border-color: transparent; }
  .spin .wheel-tools button:not(.button):hover { background: rgb(255 255 255 / .12); }
  .spin .wheel-tools button[data-finish] { border-color: var(--spin-stage-muted); }
  .spin .wheel-tools button[data-sound][aria-pressed='true'] { color: var(--spin-paper); background: transparent; border-color: transparent; }
  .wheel-panel [data-error] { color: var(--spin-paper); text-align: center; margin: 0; }
  h2 { margin: 0 0 8px; font-size: clamp(1.45rem, 3vw, 2rem); overflow-wrap: anywhere; letter-spacing: -.025em; }
  form { display: grid; gap: 10px; }
  form[hidden], [hidden] { display: none; }
  label { display: grid; gap: 2px; margin: 0; font-weight: 650; }
  input, textarea, select { font: inherit; width: 100%; min-height: 44px; padding: 7px 10px; margin: 0; color: var(--color-foreground); background: var(--color-field); border: 1px solid var(--color-border); border-radius: 7px; }
  textarea { min-height: 75px; }
   .screen-reader { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .add-entry { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 7px; }
  .order-toggle { display: flex; align-items: center; gap: 8px; min-height: 44px; }
  .order-toggle input { width: 20px; height: 20px; min-height: 0; accent-color: var(--color-brand); }
  .choice-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 7px; flex-wrap: wrap; margin-bottom: -7px; }
  .choice-heading h2 { margin: 0 0 7px; }
  .choice-caption { border-top: 1px solid var(--color-border); padding-top: 12px; }
  .choice-caption h3 { font-size: 1rem; margin: 0; }
  .question-field { margin-block: 6px; font-size: .9rem; }
  .question-field input { margin-top: 4px; }
  .choice-heading p { margin: 0; font-size: .82rem; }
  .choice-list { list-style: none; display: block; margin: 0; padding: 0; max-height: 16.8rem; overflow-y: auto; }
  .choice-list :global(li) { display: grid; grid-template-columns: 38px minmax(0, 1fr) 42px; gap: 3px; align-items: center; margin: 0; padding: 1px 3px; min-height: 44px; border-bottom: 1px solid var(--color-border); }
  .choice-list :global(label) { display: flex; align-items: center; gap: 3px; min-height: 43px; margin: 0; cursor: pointer; }
  .choice-list :global(label span) { display: none; color: var(--color-muted); font-size: .69rem; }
  .choice-list[data-numbered='true'] :global(label span) { display: inline; }
  .choice-list:not([data-reorder='true']) :global(button[data-control='up']),
  .choice-list:not([data-reorder='true']) :global(button[data-control='down']) { display: none; }
  .choice-list[data-reorder='true'] :global(li) { grid-template-columns: 38px minmax(0, 1fr) 32px 32px 42px; }
  .choice-list :global(li[data-enabled='false'] input[type='text']) { color: var(--color-muted); text-decoration: line-through; }
  .choice-list :global(input[type='text']:focus) { background: var(--color-field); }
  .choice-list :global(input[type='checkbox']) { width: 20px; height: 20px; margin: 0; accent-color: var(--color-brand); }
  .choice-list :global(input[type='text']) { min-height: 41px; width: 100%; font: inherit; font-size: 1rem; padding: 2px 4px; color: var(--color-foreground); background: transparent; border: 0; margin: 0; border-radius: 4px; }
  .choice-list :global(button) { min-height: 40px; padding: 0; font: 650 1.2rem/1 system-ui; color: var(--color-foreground); background: transparent; border: 0; }
  .choice-list :global(button:hover) { background: var(--color-field); }
  .choice-list :global(button:disabled) { opacity: .35; cursor: default; }
  .button-row { display: flex; flex-wrap: wrap; gap: 7px; }
  .spin button:not(.spin-hub, .button) { min-height: 44px; padding: 5px 10px; border: 1px solid var(--color-border); border-radius: 7px; background: transparent; color: var(--color-foreground); font-size: .9rem; }
  .spin button:not(.spin-hub, .button):hover { background: var(--color-field); }
  .spin button:not(.spin-hub, .button)[aria-pressed='true'] { background: var(--color-selected); border-color: var(--color-accent); color: var(--color-foreground); }
  .spin button:disabled { cursor: default; }
  .preset-quick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; }
  .preset-quick[hidden] { display: none; }
  .preset-picker { position: relative; min-width: 0; }
  .preset-picker select { appearance: none; height: 44px; padding-inline-end: 29px; background: transparent; font-size: .9rem; cursor: pointer; }
  .preset-picker svg { position: absolute; top: 15px; right: 10px; pointer-events: none; }
  .preset-quick button { text-align: left; justify-content: flex-start; }
  .note { color: var(--color-muted); font-size: .88rem; margin: 0 0 3px; }
  form details, [data-session] details { border-top: 1px solid var(--color-border); margin: 0; }
  form details > * + *, [data-session] details > * + * { margin-block-end: 8px; }
  summary { cursor: pointer; padding-block: 8px; }
  details code { overflow-wrap: anywhere; }
  .result-actions, .secondary-actions { margin-block: 12px; }
  [data-verification] { display: inline-block; color: var(--color-foreground); background: var(--color-field); padding: 8px 12px; border-radius: 7px; }
  [data-full-question] { overflow-wrap: anywhere; }
  .scores { list-style: none; margin: 0; padding: 0; font-variant-numeric: tabular-nums; }
