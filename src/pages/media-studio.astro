  table{width:100%;border-collapse:collapse;font-size:.9rem;min-width:560px}
  caption{text-align:left;font-size:.78rem;color:var(--muted,#b9b2a8);padding-bottom:10px}
  th,td{text-align:left;padding:11px 10px;border-bottom:1px solid var(--line,rgba(255,255,255,.14));vertical-align:top;line-height:1.5}
  thead th{font:600 .64rem/1.4 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--muted,#b9b2a8)}
  tfoot th,tfoot td{border-bottom:0;border-top:2px solid var(--line,rgba(255,255,255,.3));font-weight:600}
  .tag{font:600 .62rem/1 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;padding:5px 7px;border:1px solid var(--line,rgba(255,255,255,.2));display:inline-block}
  .tag.ok{color:var(--accent,#ff5a1f);border-color:currentColor}
  .tag.muted{color:var(--muted,#b9b2a8)}
  pre{background:rgba(0,0,0,.24);border:1px solid var(--line,rgba(255,255,255,.16));padding:16px;overflow-x:auto;font-size:.82rem;line-height:1.6;margin:20px 0}
  code{font-size:.88em;overflow-wrap:anywhere}
  .diagram{border:1px solid var(--line,rgba(255,255,255,.16));padding:22px;margin:24px 0 12px;display:grid;gap:10px}
  .node{border:1px solid var(--line,rgba(255,255,255,.22));padding:14px 16px}
  .node strong{display:block;margin-bottom:4px}
  .node span{font-size:.8rem;line-height:1.5;color:var(--muted,#b9b2a8);display:block}
  .node .leaves{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
  .node .leaves span{border-top:1px solid var(--line,rgba(255,255,255,.16));padding-top:8px;font-family:ui-monospace,monospace;font-size:.72rem;letter-spacing:.02em}
  .arrow{font:600 .64rem/1.4 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--muted,#b9b2a8);padding-left:16px;position:relative}
  .arrow::before{content:"↓";position:absolute;left:0;top:-2px;color:var(--accent,#ff5a1f)}
  .films{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;width:100%;margin:22px 0 14px}
  .films video{display:block;width:100%;height:auto;background:#000;border:1px solid var(--line,rgba(255,255,255,.16))}
  .small{font-size:.85rem;color:var(--muted,#b9b2a8)}
  .inline-cta{font-weight:600;font-size:.92rem}
  .art :is(a,button,summary,video):focus-visible{outline:2px solid var(--accent,#ff5a1f);outline-offset:3px}
  @media (max-width:900px){
    .art-hero{grid-template-columns:minmax(0,1fr);gap:24px}
    .art-hero-copy,.art-hero-figure{width:100%;margin-inline:auto}
    .figure.pair,.films{grid-template-columns:1fr}
    .node .leaves{grid-template-columns:1fr}
    .prose{padding-top:32px}
  }
  @media (max-width:560px){
    .art{padding:16px 16px 64px}
    .art h1{font-size:2.15rem}
    .art-hero .deck{font-size:1.03rem;line-height:1.5}
    .row{gap:10px}
    .contents ul { grid-template-columns: minmax(0, 1fr); }
    .contents a { min-height: 44px; }
  }
  @media (prefers-reduced-motion:reduce){.art *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
