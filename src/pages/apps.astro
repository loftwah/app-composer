---
import Base from '../layouts/Base.astro';
import DeviceSupport from '../components/DeviceSupport.astro';
import {appDeviceSupport} from '../lib/app-device-support';
import {deviceFilterTokens} from '../lib/device-support.mjs';
import { apps, appDetails } from '../lib/apps';
import { ArrowUpRight, Code, Search } from '@lucide/astro';
---
<Base title="App library" description="Open the shipped App Composer mini-apps, try their standalone versions and inspect the GitHub source.">
<h1>App library.</h1><p class="lede">Open an app, try it on its own, or take its source to your agent. Loftwah’s instance runs Linkarooie and Here / there alongside the shared product.</p>
<div class="library-controls"><label><span class="icon-label"><Search size={16} aria-hidden="true"/>Find an app</span><input type="search" id="app-search" placeholder="Name or purpose"/></label><label>Category<select id="app-category"><option value="">All categories</option>{[...new Set(apps.map(a=>a.category))].map(c=><option>{c}</option>)}</select></label><label>Device support<select id="app-device"><option value="">All assessments</option><option value="desktop">Desktop supported</option><option value="phone">Phone supported</option><option value="tablet">Tablet supported</option><option value="limited">Limited support</option><option value="unknown">Not checked yet</option></select></label></div>
<p id="app-results" class="small" role="status" aria-live="polite">{apps.length} apps available</p>
<p><a href="/discover">Explore the latest tools, team walkthroughs and owner workflows →</a></p>
<div class="app-library">{apps.map(app=><article data-app data-devices={deviceFilterTokens(appDeviceSupport(app.id))} data-category={app.category} data-search={`${app.name} ${app.description} ${app.category}`.toLowerCase()}><a class="app-art" href={app.href} tabindex="-1" aria-hidden="true"><img src={app.thumbnail} width="96" height="96" alt="" loading="lazy"/></a><div><h2><a href={app.href}>{app.name}</a></h2><p>{app.description}</p><span class="small">{app.category}</span><DeviceSupport support={appDeviceSupport(app.id)}/><div class="app-links"><a class="button secondary" href={app.href}>Open app <ArrowUpRight size={18} aria-hidden="true"/></a><a href={app.standalone}>Standalone</a><a href={app.source}><Code size={18} aria-hidden="true"/>GitHub source</a></div><details class="app-explanation"><summary>Real screen and what it does</summary><figure class="app-screen"><a href={app.href}><picture><source type="image/webp" srcset={`${app.preview} 960w, ${app.previewWide} 1440w`} sizes="(max-width: 800px) calc(100vw - 64px), 560px"/><img src={app.preview} width="960" height="600" alt={app.previewAlt} loading="lazy" decoding="async"/></picture></a><figcaption>Real screenshot of <a href={('previewOrigin' in app?app.previewOrigin:app.standalone)}>{app.name} at {new URL(('previewOrigin' in app?app.previewOrigin:app.standalone)).host}</a>, captured {new Date(app.previewCaptured+'T00:00:00Z').toLocaleDateString('en-AU',{day:'numeric',month:'long',year:'numeric'})}. The artwork beside the title is the app’s identity illustration, not a screen.</figcaption></figure><p>{appDetails[app.id].example}</p><ul>{appDetails[app.id].features.map(feature=><li>{feature}</li>)}</ul><p><strong>Make it yours.</strong> {appDetails[app.id].configuration}</p><p><strong>Works with.</strong> {appDetails[app.id].connection}</p></details></div></article>)}</div>
<p id="app-empty" hidden>No apps match. Try another name, choose all categories or clear the device filter. Unchecked apps are not listed as confirmed compatible.</p>
<p><a href="/activity">Explore the recorded app analytics →</a></p>
<section class="section"><h2>Make them work together.</h2><p>Here / there owns submissions and moderation. Linkarooie can feature its approved photos, and removes access when their source becomes private.</p><a href="/demo">Try the composition</a> · <a href="/review">Review a Link Check report</a> · <a href="/catalogue">Read the published app contracts</a> · <a href="/init">Configure a composition</a></section>
<script>
const search=document.querySelector<HTMLInputElement>('#app-search')!;const category=document.querySelector<HTMLSelectElement>('#app-category')!;const device=document.querySelector<HTMLSelectElement>('#app-device')!;const entries=[...document.querySelectorAll<HTMLElement>('[data-app]')];function filter(){let count=0;for(const entry of entries){entry.hidden=!(entry.dataset.search!.includes(search.value.trim().toLowerCase())&&(!category.value||entry.dataset.category===category.value)&&(!device.value||entry.dataset.devices!.split(' ').includes(device.value)));if(!entry.hidden)count++;}document.querySelector('#app-results')!.textContent=`${count} ${count===1?'app':'apps'} available`;document.querySelector<HTMLElement>('#app-empty')!.hidden=count!==0;}search.addEventListener('input',filter);category.addEventListener('change',filter);device.addEventListener('change',filter);
</script>
</Base>

<style>.library-controls{max-width:100%;flex-wrap:wrap}.library-controls label{min-width:180px}</style>
