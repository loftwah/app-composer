---
import Base from '../layouts/Base.astro';
import { apps, appDetails } from '../lib/apps';
import { ArrowUpRight, Code, Search } from '@lucide/astro';
---
<Base title="App library" description="Open the shipped App Composer mini-apps, try their standalone versions and inspect the GitHub source.">
<h1>My apps.</h1><p class="lede">The apps running in Loftwah’s App Composer. Open one, see how it works, or inspect its source.</p>
<div class="library-controls"><label><span class="icon-label"><Search size={16} aria-hidden="true"/>Find an app</span><input type="search" id="app-search" placeholder="Name or purpose"/></label><label>Category<select id="app-category"><option value="">All categories</option>{[...new Set(apps.map(a=>a.category))].map(c=><option>{c}</option>)}</select></label></div>
<p id="app-results" class="small" role="status" aria-live="polite">{apps.length} apps available</p>
<div class="app-library">{apps.map(app=><article data-app data-category={app.category} data-search={`${app.name} ${app.description} ${app.category}`.toLowerCase()}><a class="app-art" href={app.href} tabindex="-1" aria-hidden="true"><img src={app.image} width="480" height="480" alt="" loading="lazy"/></a><div><h2><a href={app.href}>{app.name}</a></h2><p>{app.description}</p><span class="small">{app.category}</span><details class="app-explanation"><summary>What can I do with this?</summary><p>{appDetails[app.id].example}</p><ul>{appDetails[app.id].features.map(feature=><li>{feature}</li>)}</ul><p><strong>Make it yours.</strong> {appDetails[app.id].configuration}</p><p><strong>Works with.</strong> {appDetails[app.id].connection}</p></details><div class="app-links"><a class="button secondary" href={app.href}>Open app <ArrowUpRight size={18} aria-hidden="true"/></a><a href={app.standalone}>Standalone</a><a href={app.source}><Code size={18} aria-hidden="true"/>GitHub source</a></div></div></article>)}</div>
<p id="app-empty" hidden>No apps match. Try another name or choose all categories.</p>
<p><a href="/activity">See which apps get used →</a></p>
<section class="section"><h2>Make them work together.</h2><p>Here / there owns submissions and moderation. Linkarooie can feature its approved photos, and removes access when their source becomes private.</p><a href="/demo">Try the composition</a> · <a href="/review">Review a Link Check report</a> · <a href="/catalogue">Read the published app contracts</a> · <a href="/init">Configure a composition</a></section>
<script>
const search=document.querySelector<HTMLInputElement>('#app-search')!;const category=document.querySelector<HTMLSelectElement>('#app-category')!;const entries=[...document.querySelectorAll<HTMLElement>('[data-app]')];function filter(){let count=0;for(const entry of entries){entry.hidden=!(entry.dataset.search!.includes(search.value.trim().toLowerCase())&&(!category.value||entry.dataset.category===category.value));if(!entry.hidden)count++;}document.querySelector('#app-results')!.textContent=`${count} ${count===1?'app':'apps'} available`;document.querySelector<HTMLElement>('#app-empty')!.hidden=count!==0;}search.addEventListener('input',filter);category.addEventListener('change',filter);
</script>
</Base>
