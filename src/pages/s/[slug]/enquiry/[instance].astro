---
import Base from '../../../../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { publishedEnquiry } from '../../../../lib/public-enquiries';
import { enquiryForm } from '../../../../lib/enquiry-form';
import { StackError } from '../../../../lib/stacks.mjs';
import type { EnquiryRuntime } from '../../../../lib/private-enquiries';

let form: Awaited<ReturnType<typeof publishedEnquiry>> | undefined;
let missing = false;
try {
  form = await publishedEnquiry(
    env as unknown as EnquiryRuntime,
    Astro.params.slug ?? '',
    Astro.params.instance ?? '',
  );
} catch (error) {
  missing = error instanceof StackError && error.status === 404;
  Astro.response.status = missing ? 404 : 503;
}
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const title = form
  ? `Private brief · ${form.selected.title}`
  : missing ? 'Private enquiries are closed' : 'Private enquiry form unavailable';
---
<Base
  title={title}
  description="A private brief delivered to the workspace through its Guestbook app. No contacts, publication or notifications."
  noindex
>
  {form ? (
    <div class="enquiry-page" set:html={enquiryForm(
      Astro.url.pathname,
      '',
      form.connection.source,
      'https://composer.loftwah.com',
      form.selected.title + ' · ' + form.selected.label,
      form.selected.key,
    )} />
  ) : (
    <>
      <h1>{missing ? 'Private enquiries are closed here.' : 'The app could not verify this form.'}</h1>
      <p>Your brief has not been sent from this page. Keep any earlier delivery intent before trying another form.</p>
    </>
  )}
  <p><a href={`/s/${Astro.params.slug}`}>Back to the published stack</a></p>
</Base>
<style>
  .enquiry-page {
    --surface: var(--color-surface);
    --border: var(--color-control-border);
    --fg: var(--color-foreground);
    --accent: var(--color-accent);
    max-width: 760px;
    margin: 24px auto 48px;
  }
  .enquiry-page :global(fieldset) { margin-bottom: 28px; min-width: 0; }
  .enquiry-page :global(label) { display: grid; gap: 8px; margin: 16px 0; }
  .enquiry-page :global(input),
  .enquiry-page :global(textarea),
  .enquiry-page :global(select) {
    font: inherit;
    font-size: 16px;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 12px;
    width: 100%;
  }
  .enquiry-page :global(.postcard-consent) { display: flex; gap: 12px; align-items: start; }
  .enquiry-page :global(.postcard-consent input) { width: 20px; height: 20px; flex: none; margin-top: 4px; }
  .enquiry-page :global(button) {
    font: inherit;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 12px 18px;
    min-height: 48px;
    cursor: pointer;
  }
  .enquiry-page :global(:focus-visible) { outline: 3px solid var(--accent); outline-offset: 3px; }
</style>
