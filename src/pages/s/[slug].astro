---
// A published creator stack. Only the exact published revision of an exact
// slug is served, and every field on the page comes from that immutable
// publication snapshot — never from the mutable draft row. Drafts, archives and
// missing stacks are indistinguishable and never leak their content.
import Base from '../../layouts/Base.astro';
import StackView from '../../components/StackView.tsx';
import StackShare from '../../components/StackShare.astro';
import {publicStack} from '../../lib/stacks.mjs';
import {noindexFor} from '../../lib/indexing.mjs';
import {stackShareDetails} from '../../lib/stack-sharing.ts';
import {env} from 'cloudflare:workers';

const runtime = env as unknown as {DB?: {prepare(sql: string): {bind(...values: unknown[]): {first(): Promise<unknown>}}}};
let stack: Awaited<ReturnType<typeof publicStack>> = null;
let unavailable = false;
if (!runtime.DB || typeof runtime.DB.prepare !== 'function') {
  unavailable = true;
} else {
  try {
    stack = await publicStack(runtime.DB, Astro.params.slug ?? '');
  } catch {
    unavailable = true;
  }
}
if (!stack && !unavailable) Astro.response.status = 404;
if (unavailable) Astro.response.status = 503;

const title = stack ? stack.name : unavailable ? 'Stack temporarily unavailable' : 'Stack not found';
const sharing = stack ? await stackShareDetails(stack) : null;
const description = sharing?.description ?? 'This App Composer stack address has no published revision.';
// SEO keeps the clean address. The social image includes the exact publication
// identity, so draft edits cannot change its pixels or metadata.
const shareUrl = sharing?.url;
---
<Base title={title} description={description} noindex={noindexFor(Astro.url.hostname, Boolean(stack))} canonical={shareUrl} shareImage={sharing?.imageUrl} shareAlt={sharing?.imageAlt} shareType={sharing ? 'image/png' : undefined}>
{unavailable ? (
  <>
    <h1>This stack is temporarily unavailable.</h1>
    <p class="lede">The workspace database did not answer, so nothing is shown in its place. The address is unchanged; try again shortly.</p>
    <div class="actions"><a class="button" href={Astro.url.pathname}>Try this page again</a><a class="button secondary" href="/studio">About creator stacks</a></div>
  </>
) : !stack ? (
  <>
    <h1>No published stack exists at this address.</h1>
    <p class="lede">Draft, archived and removed stacks read exactly like this: there is nothing to open and nothing to guess.</p>
    <div class="actions"><a class="button" href="/studio">About creator stacks</a><a class="button secondary" href="/apps">Browse the app library</a></div>
  </>
) : (
  <>
    <p class="small"><a href="/studio">Creator stacks</a> · published revision {stack.revision}{stack.publishedAt ? ` · ${new Date(String(stack.publishedAt).replace(' ', 'T') + 'Z').toLocaleDateString('en-AU', {day: 'numeric', month: 'long', year: 'numeric'})}` : ''}</p>
    <StackView document={stack.document} link titleAs="h1" outcomes={{slug:stack.slug,publication:stack.revision}} />
    <StackShare
      slug={stack.slug}
      revision={stack.revision}
      url={shareUrl ?? `https://composer.loftwah.com/s/${stack.slug}`}
      title={stack.name}
      description={description}
      imagePath={sharing!.imagePath}
      imageUrl={sharing!.imageUrl}
      imageAlt={sharing!.imageAlt}
    />
    <p class="small">This page is Composer-owned presentation. Each app keeps its own source, records and media; the links above open the live app. Published revision {stack.revision} is the exact configuration this page renders.</p>
  </>
)}
</Base>
<script>
  import { installStackActions } from '../../browser/private-stack-actions';
  installStackActions();
</script>
