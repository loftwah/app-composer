---
import Base from '../../../layouts/Base.astro';
import { ArrowLeft } from '@lucide/astro';
import { env } from 'cloudflare:workers';
import type { D1Database } from '@cloudflare/workers-types';
import ShareArtworkDetail from '../../../components/ShareArtworkDetail.astro';
import { readArtworkCuration } from '../../../lib/share-gallery.ts';
import { noindexFor } from '../../../lib/indexing.mjs';
import { publicPageCanonical } from '../../../lib/public-pages.mjs';
import { publicShareArtwork, SHARE_CATALOGUE_ORIGIN } from '../../../lib/share-catalogue-asset.ts';

const result = await publicShareArtwork(Astro.params.id ?? '');
Astro.response.status = result.status;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie');
const artwork = result.status === 200 ? result.artwork : null;
const edits = artwork ? await readArtworkCuration((env as unknown as {DB?: D1Database}).DB).catch(() => []) : [];
const tags = artwork ? [...new Set([...artwork.tags, ...(edits.find(item => item.assetId === artwork.assetId)?.tags ?? [])])] : [];
const title = artwork?.title ?? (result.status === 404 ? 'Artwork unavailable' : 'Artwork temporarily unavailable');
const canonical = artwork ? publicPageCanonical(`/share/artwork/${artwork.assetId}`).href : undefined;
const filters = new URLSearchParams();
for (const key of ['art', 'project', 'category', 'orientation', 'tag', 'sort', 'seed', 'after']) {
  const value = Astro.url.searchParams.get(key);
  if (value) filters.set(key, value.slice(0, 128));
}
const browseHref = filters.size ? `/share?${filters}#artwork-${artwork?.assetId ?? ''}` : '/share';
const format = artwork?.previewUrl.split('.').pop()?.toLowerCase();
const shareType = format === 'png' || format === 'webp' ? `image/${format}` : 'image/jpeg';
Astro.csp?.insertDirective(`img-src ${SHARE_CATALOGUE_ORIGIN}/campaign/`);
---

<Base title={title} description={artwork?.alt ?? title} canonical={canonical}
  noindex={noindexFor(Astro.url.hostname, Boolean(artwork))}
  shareImage={artwork?.previewUrl} shareType={shareType} shareAlt={artwork?.alt}
  shareWidth={null} shareHeight={null}>
  <nav class="artwork-nav" aria-label="Share">
    <a href={browseHref}><ArrowLeft size={16} aria-hidden="true" /> Browse artwork</a>
  </nav>
  {artwork ? (
    <ShareArtworkDetail artwork={artwork} signedIn={Boolean(Astro.locals.user)} tags={tags} />
  ) : (
    <section class="artwork-state">
      <h1>{title}</h1>
      <p>{result.status === 404 ? 'This piece is no longer in the public catalogue or the link is incomplete.' : 'The catalogue did not respond. Reload this page to try again.'}</p>
    </section>
  )}
  <Fragment slot="page-share" />
</Base>

<script>
  import { mountArtworkActions } from '../../../browser/share-gallery.ts';
  const piece = document.querySelector<HTMLElement>('[data-gallery-piece]');
  if (piece) mountArtworkActions(piece);
</script>

<style>
  .artwork-nav { margin-block-end: 1rem; }
  .artwork-nav a { min-height: 44px; display: inline-flex; align-items: center; gap: 0.45rem; }
</style>
