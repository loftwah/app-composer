---
import { ArrowDownToLine, ArrowLeft, ArrowUpRight, Copy } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import { spinArtwork, spinArtworkAlt, spinBrandFiles, spinDiscovery, spinOrigin } from '../../lib/spin-site.mjs';

const campaign = '/campaign/spin/';
const caption = `Dinner’s on the wheel. Give it a spin and send the result to the group chat. ${spinDiscovery.href}`;
const formats = [
  { file: 'takeaway-counter-portrait', label: 'Feed portrait', width: 1080, height: 1350 },
  { file: 'takeaway-counter-square', label: 'Square feed', width: 1080, height: 1080 },
  { file: 'takeaway-counter-story', label: 'Story', width: 1080, height: 1920 },
];
const demo = spinOrigin + '/?example=any-choice-demo';
---

<Base title="Spin by App Composer" description="Play Spin or download the artwork to share it."
  shareImage={spinArtwork} shareAlt={spinArtworkAlt} shareType="image/jpeg" shareWidth={1200} shareHeight={630}>
  <article class="spin-feature">
    <a class="back" href="/share"><ArrowLeft size={16} aria-hidden="true" /> Share</a>
    <header class="opening">
      <img src={spinArtwork} alt={spinArtworkAlt} width="1200" height="630" fetchpriority="high" />
      <div>
        <h1>Spin<span>.</span></h1>
        <p>When everyone has an opinion and nobody wants to decide, give the wheel a spin.</p>
        <div class="feature-actions">
          <a class="button" href={spinOrigin}>Play Spin <ArrowUpRight size={18} aria-hidden="true" /></a>
          <a href={demo} id="watch">See a spin <ArrowUpRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
    </header>

    <section class="launch-kit" id="social-kit" aria-labelledby="spin-social-heading">
      <div class="kit-heading">
        <div>
          <h2 id="spin-social-heading">Share Spin</h2>
          <p>Pick a format, grab the caption and post it wherever you like.</p>
        </div>
        <a class="button secondary" href={campaign + 'spin-takeaway-counter-kit-20261128.zip'} download>Download post package <ArrowDownToLine size={18} aria-hidden="true" /></a>
      </div>
      <div class="social-formats">
        {formats.map(({file, label, width, height}) => (
          <a class="social-format" href={campaign + `${file}-20261128.jpg`} download>
            <div class="format-image">
              <img src={campaign + `${file}-thumb-20261128.webp`} width={width} height={height}
                alt={spinArtworkAlt} loading="lazy" decoding="async" />
            </div>
            <span class="format-caption"><span>{label}<small>{width} × {height}</small></span><ArrowDownToLine size={18} aria-hidden="true" /></span>
          </a>
        ))}
      </div>
      <div class="promotion">
        <div>
          <h3>Post text</h3>
          <p data-spin-caption>{caption}</p>
          <div class="promotion-actions">
            <button class="button" type="button" data-copy-spin-caption><Copy size={16} aria-hidden="true" /> Copy post text</button>
            <button class="button secondary" type="button" data-copy-alt-text data-alt={spinArtworkAlt}>Copy image alt text</button>
            <a class="button secondary" href={spinArtwork} download>Save link image <ArrowDownToLine size={16} aria-hidden="true" /></a>
          </div>
          <p class="copy-status" data-spin-copy-status role="status"></p>
          <a href="/share/artwork/composer-spin-takeaway-counter">Open the artwork in Share <ArrowUpRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <section class="brand-files" id="brand-assets" aria-labelledby="spin-brand-heading">
      <h2 id="spin-brand-heading">Logos and icons</h2>
      <div class="lockups">
        <a class="lockup-item" href={spinBrandFiles.light} download>
          <span class="lockup-preview on-paper"><img src={spinBrandFiles.light} alt="" width="190" loading="lazy" /></span>
          <span>Light background <ArrowDownToLine size={16} aria-hidden="true" /></span>
        </a>
        <a class="lockup-item" href={spinBrandFiles.dark} download>
          <span class="lockup-preview on-ink"><img src={spinBrandFiles.dark} alt="" width="190" loading="lazy" /></span>
          <span>Dark background <ArrowDownToLine size={16} aria-hidden="true" /></span>
        </a>
      </div>
      <div class="feature-actions">
        <a href={spinBrandFiles.icon} download>App icon PNG <ArrowDownToLine size={16} aria-hidden="true" /></a>
        <a href={campaign + 'spin-qr-20261127d.png'} download>App QR code <ArrowDownToLine size={16} aria-hidden="true" /></a>
        <a href="/articles/why-we-built-spin">How the wheel works <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
    </section>
  </article>
</Base>

<script>
  const status = document.querySelector<HTMLElement>('[data-spin-copy-status]');
  const caption = document.querySelector('[data-spin-caption]');
  const alt = document.querySelector<HTMLButtonElement>('[data-copy-alt-text]');
  async function copy(value: string, confirmation: string) {
    if (!status) return;
    try {
      await navigator.clipboard.writeText(value);
      status.textContent = confirmation;
    } catch {
      status.textContent = 'Clipboard unavailable. Copy this text: ' + value;
    }
  }
  document.querySelector('[data-copy-spin-caption]')?.addEventListener('click', () => {
    void copy(caption?.textContent?.trim() ?? '', 'Post text copied.');
  });
  alt?.addEventListener('click', () => void copy(alt.dataset.alt ?? '', 'Image alt text copied.'));
</script>

<style>
  .spin-feature { max-width: 1150px; margin-inline: auto; }
  .back, .feature-actions a, .format-caption, .lockup-item > span + span, .promotion a { display: inline-flex; align-items: center; gap: 6px; }
  .back { min-height: 44px; margin-bottom: 14px; }
  .opening { display: grid; grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr); align-items: center; gap: clamp(22px, 4vw, 52px); }
  .opening img { display: block; width: 100%; border-radius: 12px; }
  .opening h1 { margin: 0; font: 700 clamp(3.6rem, 8vw, 6rem)/.98 Space, sans-serif; letter-spacing: -.04em; }
  .opening h1 span { color: var(--color-accent); }
  .opening p { margin: 14px 0 18px; font-size: clamp(1rem, 2.2vw, 1.22rem); line-height: 1.4; }
  .feature-actions, .promotion-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .feature-actions a:not(.button) { min-height: 44px; }
  .launch-kit, .brand-files { margin-top: clamp(32px, 6vw, 70px); border-top: 1px solid var(--color-border); padding-top: 24px; }
  .kit-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px 20px; margin-bottom: 16px; }
  h2 { margin: 0 0 4px; font-size: clamp(1.65rem, 3.4vw, 2.55rem); }
  h3 { margin: 0; font-size: 1.25rem; }
  .kit-heading p { margin: 3px 0; color: var(--color-muted); }
  .social-formats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .social-format { display: grid; gap: 6px; min-width: 0; }
  .format-image { height: clamp(170px, 30vw, 318px); padding: 12px; display: grid; place-items: center; background: var(--color-surface); border-radius: 10px; }
  .format-image img { width: 100%; height: 100%; max-height: 100%; min-height: 0; object-fit: contain; }
  .format-caption { min-height: 44px; justify-content: space-between; }
  small { display: block; color: var(--color-muted); }
  .promotion { padding-block: 24px 0; margin-top: 16px; border-top: 1px solid var(--color-border); }
  .promotion p { margin: 8px 0; overflow-wrap: anywhere; }
  .promotion .copy-status { min-height: 1lh; color: var(--color-muted); }
  .lockups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 12px 0 8px; }
  .lockup-preview { display: grid; place-items: center; min-height: 115px; border-radius: 10px; padding: 12px; }
  .on-paper { background: #fffaf0; }
  .on-ink { background: #161349; }
  .lockup-item > span + span { min-height: 44px; }
  @media (max-width: 700px) { .opening { grid-template-columns: minmax(0, 1fr); gap: 16px; } }
  @media (max-width: 470px) {
    .social-formats { grid-template-columns: minmax(0, 1fr); }
    .format-image { height: 250px; }
  }
</style>
