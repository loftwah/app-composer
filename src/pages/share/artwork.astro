---
import Base from '../../layouts/Base.astro';
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@lucide/astro';
import { noindexFor } from '../../lib/indexing.mjs';
import {
  browseShareArtwork,
  normalizeShareAssetId,
  SHARE_CATALOGUE_ORIGIN,
  SHARE_CATALOGUE_QUERY_MAX,
} from '../../lib/share-catalogue-asset.ts';

const params = Astro.url.searchParams;
const query = (params.get('q') ?? '').slice(0, SHARE_CATALOGUE_QUERY_MAX).trim();
const project = normalizeShareAssetId(params.get('project')) ?? '';
const after = normalizeShareAssetId(params.get('after')) ?? '';
const catalogue = await browseShareArtwork({ query, project, after });
if (!catalogue) Astro.response.status = 503;
Astro.csp?.insertDirective(`img-src ${SHARE_CATALOGUE_ORIGIN}/campaign/`);

const artworkPath = (values: Record<string, string>) => {
  const search = new URLSearchParams(Object.entries(values).filter(([, value]) => value));
  return search.size ? `/share/artwork?${search}` : '/share/artwork';
};
---

<Base title="Share artwork" description="Browse public artwork, credits and project share kits from the Woodhouse catalogue." noindex={noindexFor(Astro.url.hostname, Boolean(catalogue) && !query && !project && !after)}>
  <div class="artwork-library">
    <header class="artwork-heading">
      <nav aria-label="Share">
        <a href="/share"><ArrowLeft size={16} aria-hidden="true" /> Share</a>
        <a href="https://media.loftwah.com/gallery">Media Studio gallery <ArrowUpRight size={15} aria-hidden="true" /></a>
      </nav>
      <div class="artwork-toolbar">
        <h1>Artwork</h1>
        <form method="get" action="/share/artwork" role="search" aria-label="Search artwork">
          <input type="search" name="q" aria-label="Search artwork" placeholder="Search artwork" value={query} maxlength={SHARE_CATALOGUE_QUERY_MAX} />
          {project && <input type="hidden" name="project" value={project} />}
          <button type="submit">Search</button>
          {(query || project) && <a href="/share/artwork">Clear filters</a>}
        </form>
      </div>
      {project && <p class="small artwork-filter">Project: {project}</p>}
    </header>

    {!catalogue ? (
      <section aria-labelledby="artwork-unavailable">
        <h2 id="artwork-unavailable">Artwork is temporarily unavailable</h2>
        <p><a href={artworkPath({ q: query, project, after })}>Try again</a> or <a href="https://woodhouse.loftwah.com/share">open Woodhouse Share</a>.</p>
      </section>
    ) : (
      <>
        {catalogue.items.length ? (
          <div class="artwork-grid">
            {catalogue.items.map((item) => (
              <article class="artwork-card">
                <a class="artwork-card-link" href={`/share/artwork/${item.assetId}`} aria-labelledby={`artwork-${item.assetId}`}>
                  <div class="artwork-image">
                    <img src={item.thumbnailUrl} alt={item.alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  </div>
                  <div class="artwork-caption">
                    <h2 id={`artwork-${item.assetId}`}>{item.title}</h2>
                    <span class="artwork-open" aria-hidden="true">Open <ArrowUpRight size={15} /></span>
                  </div>
                </a>
                <p class="artwork-project small">
                  {project === item.project ? item.project : <a href={artworkPath({ project: item.project })}>{item.project}</a>}
                </p>
              </article>
            ))}
          </div>
        ) : (
          <section aria-labelledby="artwork-empty">
            <h2 id="artwork-empty">No artwork found</h2>
            <p><a href="/share/artwork">Browse all artwork</a></p>
          </section>
        )}
        {(after || catalogue.nextAfter) && (
          <nav class="artwork-pages" aria-label="Artwork pages">
            {after && <a href={artworkPath({ q: query, project })}>First page</a>}
            {catalogue.nextAfter && <a href={artworkPath({ q: query, project, after: catalogue.nextAfter })}>Next artwork <ArrowRight size={16} aria-hidden="true" /></a>}
          </nav>
        )}
      </>
    )}
  </div>
</Base>

<style>
  :global(main:has(> .artwork-library)) {
    max-width: none;
    padding: clamp(1rem, 2vw, 2rem) clamp(0.75rem, 1.2vw, 1.5rem) 4rem;
  }
  .artwork-heading { margin-block-end: clamp(1rem, 2vw, 1.5rem); }
  .artwork-heading nav, .artwork-pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.15rem;
  }
  .artwork-heading nav a, .artwork-pages a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
  }
  .artwork-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: end;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
  }
  .artwork-toolbar h1 { margin: 0; font-size: clamp(2.25rem, 3.3vw, 3.75rem); }
  form {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 0 1 29rem;
    margin: 0;
  }
  form input[type="search"] { flex: 1 1 11rem; min-width: 0; width: auto; min-height: 44px; margin: 0; }
  form button { min-height: 44px; margin: 0; }
  form > a { display: inline-flex; align-items: center; min-height: 44px; }
  .artwork-filter { margin: 0.75rem 0 0; }
  .artwork-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.15rem, 2vw, 2rem) clamp(0.75rem, 1.1vw, 1.25rem);
  }
  @media (min-width: 38rem) {
    .artwork-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 55rem) {
    .artwork-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 72rem) {
    .artwork-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .artwork-card { min-width: 0; }
  .artwork-image { background: var(--color-surface); border-radius: 0.65rem; overflow: clip; }
  .artwork-image img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; }
  .artwork-card-link { display: block; }
  .artwork-caption {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
  }
  .artwork-caption h2 {
    margin: 0;
    padding-block: 0.24rem;
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    line-height: 1.24;
    overflow-wrap: anywhere;
  }
  .artwork-open {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.25rem 0.65rem;
    border-radius: 1rem;
    background: var(--color-action);
    color: var(--color-on-action);
    flex: none;
    font-size: 0.83rem;
    line-height: 1.5;
  }
  .artwork-project { margin: 0; color: var(--color-muted); }
  .artwork-project a { display: inline-flex; align-items: start; min-height: 24px; overflow-wrap: anywhere; }
  @media (pointer: coarse) {
    .artwork-project a { min-height: 44px; padding-block: 0.35rem; }
  }
  .artwork-card-link:focus-visible h2, .artwork-card-link:hover h2,
  .artwork-project a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .artwork-image img { transition: transform 220ms ease-out; }
    .artwork-card-link:hover img { transform: scale(1.018); }
  }
  .artwork-pages { margin-block-start: 1.5rem; }
</style>
