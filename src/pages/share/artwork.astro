---
const previous = Astro.url.searchParams;
const params = new URLSearchParams();
for (const [oldName, newName] of [['q', 'art'], ['project', 'project'], ['after', 'after']]) {
  const value = previous.get(oldName);
  if (value) params.set(newName, value);
}
return Astro.redirect(params.size ? `/share?${params}` : '/share', 301);
