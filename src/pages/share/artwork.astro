---
import Base from '../../layouts/Base.astro';
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@lucide/astro';
import { noindexFor } from '../../lib/indexing.mjs';
import {
  browseShareArtwork,
  normalizeShareAssetId,
  SHARE_CATALOGUE_ORIGIN,
  SHARE_CATALOGUE_QUERY_MAX,
} from '../../lib/share-catalogue-asset.ts';

const params = Astro.url.searchParams;
const query = (params.get('q') ?? '').slice(0, SHARE_CATALOGUE_QUERY_MAX).trim();
const project = normalizeShareAssetId(params.get('project')) ?? '';
const after = normalizeShareAssetId(params.get('after')) ?? '';
const catalogue = await browseShareArtwork({ query, project, after });
if (!catalogue) Astro.response.status = 503;
Astro.csp?.insertDirective(`img-src ${SHARE_CATALOGUE_ORIGIN}/campaign/`);

const artworkPath = (values: Record<string, string>) => {
  const search = new URLSearchParams(Object.entries(values).filter(([, value]) => value));
  return search.size ? `/share/artwork?${search}` : '/share/artwork';
};
---

<Base title="Share artwork" description="Browse public artwork, credits and project share kits from the Woodhouse catalogue." noindex={noindexFor(Astro.url.hostname, Boolean(catalogue) && !query && !project && !after)}>
  <header class="artwork-heading">
    <nav aria-label="Share">
      <a href="/share"><ArrowLeft size={16} aria-hidden="true" /> Share</a>
      <a href="https://media.loftwah.com/gallery">Media Studio gallery</a>
    </nav>
    <h1>Artwork</h1>
    <p>Explore public artwork from our projects. Open a piece to see its credit, share it, or find its project kit.</p>
  </header>

  <form method="get" action="/share/artwork" role="search" aria-label="Search artwork">
    <label>
      Search artwork
      <input type="search" name="q" placeholder="Try Foilbury or LoftwahFM" value={query} maxlength={SHARE_CATALOGUE_QUERY_MAX} />
    </label>
    {project && <input type="hidden" name="project" value={project} />}
    <button type="submit">Search</button>
    {(query || project) && <a href="/share/artwork">Clear filters</a>}
  </form>
  {project && <p class="small">Project: {project}</p>}

  {!catalogue ? (
    <section aria-labelledby="artwork-unavailable">
      <h2 id="artwork-unavailable">Artwork is temporarily unavailable</h2>
      <p><a href={artworkPath({ q: query, project, after })}>Try again</a> or <a href="https://woodhouse.loftwah.com/share">open Woodhouse Share</a>.</p>
    </section>
  ) : (
    <>
      {catalogue.items.length ? (
        <div class="artwork-grid">
          {catalogue.items.map((item) => (
            <article class="artwork-card">
              <a class="artwork-card-link" href={`/share/artwork/${item.assetId}`} aria-labelledby={`artwork-${item.assetId}`}>
                <div class="artwork-image">
                  <img src={item.thumbnailUrl} alt={item.alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                </div>
                <h2 id={`artwork-${item.assetId}`}>{item.title} <ArrowUpRight size={15} aria-hidden="true" /></h2>
              </a>
              <p class="small">{item.credit}</p>
              <div class="artwork-links">
                <a href={item.shareUrl}>Project share kit</a>
                {project !== item.project && <a href={artworkPath({ project: item.project })}>More from {item.project}</a>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <section aria-labelledby="artwork-empty">
          <h2 id="artwork-empty">No artwork found</h2>
          <p><a href="/share/artwork">Browse all artwork</a></p>
        </section>
      )}
      {(after || catalogue.nextAfter) && (
        <nav class="artwork-pages" aria-label="Artwork pages">
          {after && <a href={artworkPath({ q: query, project })}>First page</a>}
          {catalogue.nextAfter && <a href={artworkPath({ q: query, project, after: catalogue.nextAfter })}>Next artwork <ArrowRight size={16} aria-hidden="true" /></a>}
        </nav>
      )}
    </>
  )}
</Base>

<style>
  .artwork-heading { margin-block-end: clamp(1rem, 2vw, 1.75rem); }
  .artwork-heading h1 { margin-block: 0.65rem 0.35rem; font-size: clamp(3rem, 6vw, 5.25rem); }
  .artwork-heading p { max-width: 62ch; margin-block: 0.6rem 0; color: var(--color-muted); }
  .artwork-heading nav, .artwork-links, .artwork-pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
  }
  form {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-end: 1.5rem;
  }
  form label { flex: 1 1 12rem; max-width: 28rem; margin: 0; }
  form input[type="search"] { display: block; margin: 0.3rem 0 0; width: 100%; min-height: 48px; }
  form button { min-height: 48px; margin: 0; }
  form > a { align-self: center; }
  .artwork-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(1rem, 2.1vw, 1.8rem);
  }
  .artwork-card {
    min-width: 0;
    border-block-end: 1px solid var(--color-border);
    padding-block-end: 0.75rem;
  }
  .artwork-image { display: block; background: var(--color-surface); border-radius: 0.45rem; overflow: clip; }
  .artwork-image img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: contain; }
  .artwork-card-link { display: block; }
  .artwork-card h2 { margin: 0.75rem 0 0; font-size: 1.22rem; }
  .artwork-card p { margin-block: 0.35rem 0.15rem; overflow-wrap: anywhere; }
  .artwork-heading a, .artwork-pages a, .artwork-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
  }
  .artwork-card h2 svg { vertical-align: -0.12em; color: var(--color-accent); }
  .artwork-card-link:focus-visible h2, .artwork-card-link:hover h2 { text-decoration: underline; text-underline-offset: 0.18em; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .artwork-image img { transition: transform 220ms ease-out; }
    .artwork-image:hover img { transform: scale(1.018); }
  }
  .artwork-pages { margin-block-start: 1.5rem; }
</style>
