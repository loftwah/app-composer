---
import ShareExamples from '../../../components/ShareExamples.astro';
import ShareLayout from '../../../components/ShareLayout.astro';
import { noindexFor } from '../../../lib/indexing.mjs';
import { creatorHubMedia, shareExamples } from '../../../lib/share-examples';

const id = Astro.params.example;
const example = shareExamples.find((item) => item.id === id);
if (id && !example) return new Response(null, { status: 404 });

const creatorCover = example?.id === 'creator-hub'
  ? new URL(creatorHubMedia.card, 'https://composer.loftwah.com').href
  : undefined;
---

<ShareLayout view="examples"
  title={example ? example.title + ' · Share' : 'Examples · Share'}
  description={example?.description ?? 'Open editable covers, finished PDFs and working creator apps.'}
  noindex={noindexFor(Astro.url.hostname, true)}
  shareImage={creatorCover}
  shareAlt={creatorCover ? 'Creator Hub’s working profile for fictional ceramicist Mara Quinn.' : undefined}>
  <ShareExamples example={example} />
</ShareLayout>
