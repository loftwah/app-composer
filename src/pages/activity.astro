---
import BuilderFields from "../components/BuilderFields.astro";
import Base from "../layouts/Base.astro";
import AnalyticsTrend from "../components/AnalyticsTrend.astro";
import { apps } from "../lib/apps";
import { env } from "cloudflare:workers";
import type { D1Database } from "@cloudflare/workers-types";
import { selection } from "../../lib/usage/index.mjs";
import { portfolioSummary } from "../../lib/usage/portfolio.mjs";
import build from "../lib/build.json";
import {
  appActions,
  appSignals,
  count,
  dateLabel,
  daySelection,
  signalLabels,
  type SignalKey,
  signalView,
  type PublicHistory,
} from "../lib/activity-view";
import { insightPath, insightWindowFor, type InsightSurface } from "../lib/activity-insight";
import { ArrowUpRight, Share2 } from "@lucide/astro";
import "../styles/analytics.css";

const selected = selection(Astro.url.searchParams);
const runtime = env as unknown as { DB: D1Database; PUBLIC_ORIGIN: string };
const now = new Date();
const surface = selected.surface as InsightSurface;
const scopeQuery = new URLSearchParams({ days: String(selected.days), surface });
const history = await portfolioSummary(runtime.DB, selected.days, now, build.commit, surface)
  .then((result) => result as unknown as PublicHistory)
  .catch(() => undefined);
if (!history) Astro.response.status = 503;

const rows = (history?.apps ?? []).flatMap((row) => {
  const definition = apps.find((app) => app.id === row.app);
  return definition ? [{ ...row, definition, opensLimited: row.signals.app_open?.some((day) => day.capped) }] : [];
}).sort((a, b) => b.opens - a.opens || a.app.localeCompare(b.app));
const unavailable = rows.filter((row) => row.connected === false);
const top = Math.max(1, ...rows.map((row) => row.opens));
const metricOrder: SignalKey[] = [
  "inspection_completed",
  "guest_postcards_received",
  "app_opens",
  "photo_opens",
];
const requested = Astro.url.searchParams.get("metric");
const defaultMetric = surface === "composed" ? "guest_postcards_received" : "inspection_completed";
const views = history
  ? metricOrder
      .filter((key) => key !== "inspection_completed" || surface !== "composed")
      .map((key) => signalView(history, key))
      .filter((value): value is NonNullable<typeof value> => value !== undefined)
  : [];
const view = views.find((value) => value.key === requested) ?? views.find((value) => value.key === defaultMetric);
const metric = view?.key ?? defaultMetric;
const day = history
  ? daySelection(Astro.url.searchParams.get("day"), history.period.from, history.period.to)
  : null;
const sharePageHref = insightPath(insightWindowFor(selected.days, surface, now));
const unitFor = (key: string) =>
  key === "app_opens" || key === "photo_opens"
    ? "recorded opens"
    : key === "inspection_completed"
      ? "completed inspections"
      : "postcards received";
const reportHref = `/reports/new?${scopeQuery}&metric=${metric}`;
const metricHref = (key: string) =>
  `${Astro.url.pathname}?${scopeQuery}&metric=${key}${day ? `&day=${day}` : ""}`;
const scopeNote = history
  ? `${dateLabel(history.period.from)} – ${dateLabel(history.period.to, true)} UTC · Today is partial`
  : "Daily history is unavailable.";
const outcomeFor = (app: string) =>
  app === "linkcheck" ? views.find((value) => value.key === "inspection_completed") :
  app === "guestbook" ? views.find((value) => value.key === "guest_postcards_received") : undefined;
const appHref = (app: string) => {
  const target = appSignals[app]?.includes(metric) ? metric : outcomeFor(app)?.key ?? "app_opens";
  return `/activity/${app}?${scopeQuery}&metric=${target}${day ? `&day=${day}` : ""}`;
};
const metricApp = apps.find((app) =>
  (metric === "inspection_completed" && app.id === "linkcheck") ||
  ((metric === "guest_postcards_received" || metric === "photo_opens") && app.id === "guestbook"));
const coverageCount = rows.filter((row) => row.connected).length;
const resultLabel = (outcome: NonNullable<ReturnType<typeof outcomeFor>>) => {
  if (outcome.value === null) return `${signalLabels[outcome.key]} unavailable`;
  const cap = outcome.days.some((day) => day.capped) ? "+" : "";
  const label = outcome.key === "inspection_completed"
    ? (outcome.value === 1 ? "inspection completed" : "inspections completed")
    : (outcome.value === 1 ? "postcard received" : "postcards received");
  return `${count(outcome.value)}${cap} ${label}`;
};

---
<Base
  title="App activity"
  description="Explore recorded public app opens, completed actions, guest postcards and coverage by UTC day. Bounded counts, never visitor profiles."
>
  <header class="analytics-hero activity-hero">
    <h1>App activity</h1>
    <a class="button secondary" href="/activity/portfolio">Explore portfolio analytics <ArrowUpRight size={17} aria-hidden="true"/></a>
  </header>

  <section class="activity-scope" aria-label="Filter activity">
    <form method="get" class="activity-scope-form">
      <BuilderFields/>
      {requested && <input type="hidden" name="metric" value={metric} />}
      {day && <input type="hidden" name="day" value={day} />}
      <label for="scope-days">Time window
        <select name="days" id="scope-days">
          <option value="7" selected={selected.days === 7}>Last 7 days</option>
          <option value="30" selected={selected.days === 30}>Last 30 days</option>
        </select>
      </label>
      <label for="scope-surface">App route
        <select name="surface" id="scope-surface">
          <option value="all" selected={selected.surface === "all"}>All routes</option>
          <option value="standalone" selected={selected.surface === "standalone"}>Standalone</option>
          <option value="composed" selected={selected.surface === "composed"}>Inside Composer</option>
        </select>
      </label>
      <button type="submit">Apply</button>
    </form>
    <p class="activity-period">{scopeNote}</p>
  </section>

  {history && view ? (
    <div data-activity>
      <section class="analytics-section activity-plot activity-overview-plot" aria-labelledby="chart-title">
        {requested === "inspection_completed" && surface === "composed" && (
          <p class="analytics-note">Link Check runs standalone. <a href={`/activity?days=${selected.days}&surface=standalone&metric=inspection_completed`}>See completed inspections</a>.</p>
        )}
        <nav class="trend-tabs activity-metrics" aria-label="Measure">
          {views.map((value) => (
            <a href={metricHref(value.key)} data-preserve-day aria-current={value.key === metric ? "page" : undefined}>
              {signalLabels[value.key]}
              <strong>{value.value === null ? "Unavailable" : count(value.value) + (value.days.some((day) => day.capped) ? "+" : "")}</strong>
            </a>
          ))}
        </nav>
        <div class="analytics-chart-head">
          <h2 id="chart-title">{signalLabels[view.key]} by day</h2>
          <div class="activity-chart-links">
            {metricApp && <a href={metricApp.href}>
              Open {metricApp.name} <ArrowUpRight size={16} aria-hidden="true"/>
            </a>}
            {view.value !== null && <a class="button secondary" href={reportHref}>
              <Share2 size={16} aria-hidden="true"/> Share report
            </a>}
          </div>
        </div>
        <AnalyticsTrend
          metric={view.key}
          label={signalLabels[view.key]}
          definition={view.definition}
          unit={unitFor(view.key)}
          value={view.value}
          quality={view.quality}
          days={view.days}
          from={history.period.from}
          to={history.period.to}
          surface={surface}
          windowDays={selected.days}
          selectedDay={day}
          showTotal={false}
          caption={`${view.available} of ${selected.days} days available`}
        />
      </section>

      <section class="analytics-section" aria-labelledby="apps-title">
        <div class="analytics-section-heading">
          <h2 id="apps-title">Activity by app</h2>
          <p>{coverageCount === rows.length ? `${rows.length} apps report here` : `${coverageCount} of ${rows.length} apps have this route`}. Other projects aren’t included.</p>
        </div>
        <ul class="analytics-apps" role="list">
            {rows.map((row) => {
              const outcome = outcomeFor(row.app);
              return (
                <li class:list={{ "analytics-app": true, "is-unavailable": row.connected === false }}>
                  <img src={row.definition.thumbnail} width="48" height="48" alt="" loading="lazy" />
                  <div>
                    <h3><a href={appHref(row.app)} data-preserve-day>{row.definition.name} <ArrowUpRight size={16} aria-hidden="true"/></a></h3>
                    <p>{appActions[row.app] ?? row.definition.category}</p>
                  </div>
                  <div class="analytics-app-bar" aria-hidden="true">{row.connected !== false && <svg viewBox="0 0 100 8" preserveAspectRatio="none"><rect width={(100 * row.opens) / top} height="8"/></svg>}</div>
                  <div class="analytics-app-count">
                    {row.connected === false ? (
                      <>
                        <strong aria-hidden="true">—</strong>
                        <small>No composed route</small>
                      </>
                    ) : (
                      <>
                        <strong>{count(row.opens)}{row.opensLimited ? "+" : ""}</strong>
                        <small>{row.opens === 1 ? "recorded open" : "recorded opens"}{row.opensLimited ? " · lower bound" : ""}</small>
                        {outcome && <small>{resultLabel(outcome)}</small>}
                      </>
                    )}
                  </div>
                </li>
              );
            })}
        </ul>
        {unavailable.length > 0 && (
          <p class="analytics-note"><a href={`/activity?days=${selected.days}&surface=standalone`}>See standalone apps</a></p>
        )}
      </section>

      <details class="analytics-method">
        <summary>About these counts</summary>
        <p>These are daily counts of events. They contain no visitor profiles or submitted content.</p>
        <ul>{history.coverage.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
        <div class="analytics-data-links">
          <a href={`/api/portfolio-analytics?${scopeQuery}`}>Daily data</a>
          <a href={`/api/usage?${scopeQuery}`}>App totals (JSON)</a>
          <a href={sharePageHref}>Traffic ranking (complete days)</a>
          <a href="/privacy">Privacy</a>
          <a href="/manage">Owner analytics</a>
        </div>
      </details>
    </div>
  ) : (
    <section class="analytics-empty" role="status">
      <h2>Daily history is unavailable.</h2>
      <p>Try again shortly, or open the apps directly.</p>
      <a href="/apps">Browse the apps</a>
    </section>
  )}
</Base>

<script>
  import "../browser/activity";
</script>
