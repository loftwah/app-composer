---
import Base from "../layouts/Base.astro";
import ActivityHistory from "../components/ActivityHistory.astro";
import JourneyDiagram from "../components/JourneyDiagram.astro";
import { apps } from "../lib/apps";
import { env } from "cloudflare:workers";
import type { D1Database } from "@cloudflare/workers-types";
import { usageSummary } from "../lib/usage";
import { selection } from "../../lib/usage/index.mjs";
import { portfolioSummary } from "../../lib/usage/portfolio.mjs";
import {
  count,
  dateLabel,
  signalSelection,
  type PublicHistory,
} from "../lib/activity-view";
import { ArrowUpRight } from "@lucide/astro";
import "../styles/activity.css";
const selected = selection(Astro.url.searchParams);
const metric = signalSelection(Astro.url.searchParams.get("metric"));
const runtime = env as unknown as { DB: D1Database; PUBLIC_ORIGIN: string };
const [totals, timeline] = await Promise.allSettled([
  usageSummary(runtime.DB, Astro.url.searchParams, runtime.PUBLIC_ORIGIN),
  portfolioSummary(runtime.DB, selected.days),
]);
const report = totals.status === "fulfilled" ? totals.value : undefined;
const history =
  timeline.status === "fulfilled"
    ? (timeline.value as PublicHistory)
    : undefined;
if (!report && !history) Astro.response.status = 503;
const rows = (
  report?.apps ??
  apps.map((app) => ({
    app: app.id,
    opens: 0,
    actions: 0,
    opensLimited: false,
    actionsLimited: false,
    limited: false,
  }))
).map((row) => ({
  ...row,
  definition: apps.find((app) => app.id === row.app)!,
}));
const top = Math.max(1, ...rows.map((row) => row.opens));
const where =
  selected.surface === "standalone"
    ? "Standalone apps"
    : selected.surface === "composed"
      ? "Inside Composer"
      : "All connected versions";
---

<Base
  title="App activity"
  description="Explore recorded public app requests and actions by UTC day and version. Counts, coverage and definitions without visitor profiles."
>
  <div class="activity-intro">
    <h1>What gets used.</h1>
    <p class="lede">
      Follow the recorded requests and actions moving through the apps. Pick a
      signal, inspect a day, then see where the apps were opened.
    </p>
    <form method="get" class="activity-window">
      <input type="hidden" name="surface" value={selected.surface} />
      <input type="hidden" name="metric" value={metric} />
      <label for="activity-days">
        Time window
        <select name="days" id="activity-days">
          <option value="7" selected={selected.days === 7}>
            Past 7 UTC days
          </option>
          <option value="30" selected={selected.days === 30}>
            Past 30 UTC days
          </option>
        </select>
      </label>
      <button type="submit">Update window</button>
      <p>
        Public counts, not people.
        <br />
        Refreshes can take a minute.
      </p>
    </form>
  </div>
  {history ? (
    <ActivityHistory
      report={history}
      selected={metric}
      surface={selected.surface}
      days={selected.days}
    />
  ) : (
    <section class="activity-unavailable" role="status">
      <h2>Daily history is unavailable.</h2>
      <p>
        The reporting query could not complete. This is not a zero count. Try
        this page again later; the apps remain available.
      </p>
      <a href="/apps">Browse the apps</a>
    </section>
  )}
  <section class="activity-where" aria-labelledby="activity-where-title">
    <div class="activity-section-heading">
      <div>
        <h2 id="activity-where-title">Where apps were opened.</h2>
        <p>
          Compare successful home-page requests in this view. Reloads, bots and
          unmarked demonstration traffic can count.
        </p>
      </div>
      <form method="get" class="activity-surface">
        <input type="hidden" name="days" value={selected.days} />
        <input type="hidden" name="metric" value={metric} />
        <label for="activity-surface">
          App comparison
          <select id="activity-surface" name="surface">
            <option value="all" selected={selected.surface === "all"}>
              All connected versions
            </option>
            <option
              value="standalone"
              selected={selected.surface === "standalone"}
            >
              Standalone apps
            </option>
            <option value="composed" selected={selected.surface === "composed"}>
              Inside Composer
            </option>
          </select>
        </label>
        <button type="submit" class="secondary">
          Compare
        </button>
      </form>
    </div>
    <p class="activity-scope">
      {where}
      {report &&
        ` · ${dateLabel(report.from)} – ${dateLabel(report.through, true)}, UTC`}
      . This filter changes the comparison below; the daily chart includes all
      connected versions.
    </p>
    {!report && (
      <p class="activity-unavailable" role="status">
        App totals are temporarily unavailable. A dash means the query failed,
        not that an app had no activity.
      </p>
    )}
    <ol class="activity-apps" aria-label={`Recorded app requests: ${where}`}>
      {rows.map((row) => (
        <li>
          <img
            src={row.definition.thumbnail}
            width="48"
            height="48"
            alt=""
            loading="lazy"
          />
          <div class="activity-app-copy">
            <h3>
              <a href={row.definition.href}>
                {row.definition.name}
                <ArrowUpRight size={18} aria-hidden="true" />
              </a>
            </h3>
            <p>
              {row.app === "guestbook"
                ? "Photos and postcards"
                : row.app === "linkcheck"
                  ? "Website and sharing checks"
                  : row.app === "showcase"
                    ? "Links and collections"
                    : row.app === "hello"
                      ? "First deployment"
                      : "Fictional assistant memory"}
            </p>
          </div>
          <div class="activity-app-count">
            <strong>
              {report ? count(row.opens) : "—"}
              {report && row.opensLimited && "+"}
            </strong>
            <span>recorded {row.opens === 1 ? "open" : "opens"}</span>
          </div>
          <div class="activity-app-bar" aria-hidden="true">
            <svg viewBox="0 0 100 6" preserveAspectRatio="none">
              <line x1="0" y1="3" x2="100" y2="3" />
              <rect
                x="0"
                y="0"
                width={report ? (100 * row.opens) / top : 0}
                height="6"
              />
            </svg>
          </div>
          <p class="activity-app-action">
            {!report
              ? "Other actions unavailable."
              : row.app === "guestbook"
                ? `${count(row.actions)} contribution-page ${row.actions === 1 ? "open" : "opens"} recorded`
                : row.app === "linkcheck"
                  ? `${count(row.actions)} completed ${row.actions === 1 ? "inspection" : "inspections"} recorded`
                  : row.app === "state"
                    ? "Private vault actions are never counted."
                    : "Home-page requests only."}
            {row.limited && " A daily cap was reached; this is a lower bound."}
          </p>
        </li>
      ))}
    </ol>
  </section>
  <section class="activity-method" aria-labelledby="activity-method-title">
    <h2 id="activity-method-title">An event becomes a count.</h2>
    <p>
      A public request or completed action can add one to an app’s daily total.
      The original records stay with the app. The route below explains what
      reaches this page.
    </p>
    <JourneyDiagram kind="activity" />
    <details>
      <summary>Coverage, limits and what these counts mean</summary>
      <div class="activity-definition-list">
        <p>
          Recording began on 13 October 2026. That UTC day and today are
          partial. Counts expire after 35 days. Earlier or expired days are
          unavailable; an available day with no recorded event is zero.
        </p>
        <p>
          Each app, event and version stops at 1,000 recorded events per UTC
          day. Shared recording is limited to 60 events per minute per
          app/action at each Cloudflare location. Optional publishers can lose
          events during an outage. Counts are lower bounds; they cannot
          establish exact growth, unique visitors or a conversion rate.
        </p>
        <p>
          Marked verification probes are excluded. Ordinary demonstrations,
          reloads, unmarked automation and bots can count. This public view
          cannot separate them, so it does not establish customer adoption or
          demand.
        </p>
        <p>
          App opens are successful mini-app home-page HTML requests.
          Contribution opens are successful public Guestbook contribution-page
          requests, not image downloads. Completed inspections are counted by
          Link Check after completion. Postcards received counts committed
          pending submissions after the first retained observation; it is not an
          approval or publication count.
        </p>
        <p>
          No visitor IDs, cookies, entered URLs, search text, identities,
          private creator activity or vault contents go into these counters.
          Forks report only when their operator connects them. Private workspace
          outcomes remain separate work.
        </p>
      </div>
    </details>
    <div class="activity-data-links">
      <a href={`/api/portfolio-analytics?days=${selected.days}`}>
        Daily data and definitions <ArrowUpRight size={16} aria-hidden="true" />
      </a>
      <a href={`/api/usage?days=${selected.days}&surface=${selected.surface}`}>
        App comparison as JSON <ArrowUpRight size={16} aria-hidden="true" />
      </a>
      <a href="/privacy">Privacy</a>
    </div>
  </section>
</Base>
