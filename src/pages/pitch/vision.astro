---
import { ArrowRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import VisionDownloads from '../../components/VisionDownloads.astro';
import { Content as ShortVersions, getHeadings as shortHeadings } from '../../editorial/completed-vision/short-versions.md';
import { Content as Chapters, getHeadings as chapterHeadings } from '../../editorial/completed-vision/chapters.md';
import { buildingShareArtwork } from '../../lib/site-share-artwork.mjs';

const chapters = [...shortHeadings(), ...chapterHeadings()].filter(({ depth }) => depth === 2);
const feedback = new URL('https://github.com/loftwah/app-composer/issues/new');
feedback.searchParams.set('title', 'App Composer vision feedback');
feedback.searchParams.set('body', 'What is one small thing you would build?\n\nWhere would you expect to get stuck?\n');
---

<Base
  title="App Composer — The completed product vision"
  description="Explore the Apps, Media Studio, games and engineering behind App Composer’s completed product vision. Read online, download the full document or try Creator Hub today."
  ogType="article"
  shareImage={buildingShareArtwork.path}
  shareAlt={buildingShareArtwork.alt}
>
  <article class="vision" aria-labelledby="vision-title">
    <header class="vision-opening">
      <a href="/pitch">App Composer pitch</a>
      <h1 id="vision-title">App Composer and the Loftwah project portfolio</h1>
      <p class="lede">The story, the applications, the creative studio and the engineering behind an owned project that can keep improving.</p>
      <p><strong>Completed product vision</strong> — the experience described after the accepted backlogs are delivered to a high standard. Research outcomes, project holds and retired products retain their stated boundaries.</p>
      <p class="vision-edition">Dean Lofts · Edition <time datetime="2026-11-20">2026/11/20</time> Melbourne (AEDT, UTC+11) / 2026/11/20 UTC</p>
      <div class="actions">
        <a class="button" href={`#${chapters[0].slug}`}>Read the short versions <ArrowRight size={18} aria-hidden="true" /></a>
        <a class="button secondary" href="#contents">Jump to contents</a>
      </div>
      <VisionDownloads />
    </header>

    <aside class="vision-next" aria-labelledby="vision-today">
      <h2 id="vision-today">Try a current example</h2>
      <p>Creator Hub shows a working profile and moderated guestbook. Browse it signed out, then use Learn to start with one small idea.</p>
      <ul>
        <li><a href="/creator-hub">See the Creator Hub example</a></li>
        <li><a href="/learn">Start with the Learn guide</a></li>
        <li><a href={feedback.href}>Tell us what you’d build on GitHub</a></li>
      </ul>
      <p class="small">Feedback requires a GitHub account and will be public.</p>
    </aside>

    <div class="vision-prose"><ShortVersions /></div>

    <nav class="vision-contents" id="contents" aria-labelledby="contents-title">
      <h2 id="contents-title">Contents</h2>
      <ol>
        {chapters.map(({ slug, text }) => (
          <li><a href={`#${slug}`}>{text.replace(/^\d+ /, '')}</a></li>
        ))}
      </ol>
    </nav>

    <div class="vision-prose"><Chapters /></div>
    <div class="vision-end">
      <a href={feedback.href}>What is one small thing you would build?</a>
      <a href="#contents">Back to contents</a>
    </div>
  </article>
</Base>

<style>
  .vision {
    max-width: 77ch;
    margin-inline: auto;
  }

  .vision-opening h1 {
    font-size: clamp(2.55rem, 6vw, 4.85rem);
    letter-spacing: -.035em;
    line-height: 1.02;
    margin-block: .75rem 1rem;
    text-wrap: balance;
  }

  .vision-opening .actions {
    margin-bottom: 0;
  }

  .vision-edition {
    color: var(--color-muted);
    font-size: .9rem;
  }

  .vision-next,
  .vision-contents {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: clamp(1rem, 4vw, 2rem);
    margin-block: 2.5rem;
  }

  .vision-next h2,
  .vision-contents h2 {
    font-size: clamp(1.45rem, 3vw, 2rem);
    margin-bottom: .6rem;
  }

  .vision-contents ol {
    display: grid;
    gap: .2rem 2rem;
    margin: 0;
    padding-inline-start: 1.65rem;
  }

  .vision-contents li::marker {
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .vision-contents a {
    display: inline-block;
    padding-block: .3rem;
  }

  @media (min-width: 850px) {
    .vision-contents ol {
      grid-auto-flow: column;
      grid-template: repeat(9, auto) / repeat(2, minmax(0, 1fr));
    }
  }

  .vision :global([id]) {
    scroll-margin-top: 5rem;
  }

  .vision-prose :global(h2) {
    border-top: 1px solid var(--color-border);
    margin: 3.25rem 0 1rem;
    padding-top: 1.8rem;
    font-size: clamp(1.8rem, 4vw, 2.65rem);
    text-wrap: balance;
  }

  .vision-prose :global(h3),
  .vision-prose :global(h4) {
    margin-block: 1.75rem .55rem;
    text-wrap: pretty;
  }

  .vision-prose :global(.vision-table) {
    overflow-x: auto;
    margin-block: 1.4rem;
  }

  .vision-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: .92rem;
  }

  .vision-prose :global(th),
  .vision-prose :global(td) {
    text-align: start;
    vertical-align: top;
    padding: .65rem .75rem;
    border: 1px solid var(--color-border);
    min-width: 8.5rem;
  }

  .vision-prose :global(th) {
    background: var(--color-surface);
  }

  .vision-prose :global(figure) {
    margin: 1.5rem 0;
  }

  .vision-prose :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .vision-prose :global(figcaption) {
    margin-top: .65rem;
    color: var(--color-muted);
    font-size: .9rem;
  }

  .vision-end {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .75rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.page-share),
    .vision-opening .actions,
    .vision-next,
    .vision-end {
      display: none !important;
    }

    .vision,
    .vision :global(*) {
      max-width: none;
      background: white !important;
      color: black !important;
      box-shadow: none !important;
    }

    .vision :global(h2),
    .vision :global(h3),
    .vision-prose :global(tr) {
      break-inside: avoid;
    }

    .vision :global(h2),
    .vision :global(h3) {
      break-after: avoid;
    }

    .vision-prose :global(figure) {
      break-inside: avoid;
    }

    .vision-prose :global(th),
    .vision-prose :global(td) {
      min-width: 0;
    }
  }
</style>
