---
import { ArrowDownToLine, ArrowRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import BriefingRecording from '../../components/BriefingRecording.astro';
import recordings from '../../editorial/notebooklm/recordings.json';

const [video, ...audio] = recordings;
const pdf = '/media-studio/watch/notebooklm-overview-20261120.pdf';
const slides = [
  ['App Composer', 'Turn an idea into an owned project. Source code, data, infrastructure and agent actions each have an owner.'],
  ['The work around the code', 'The slides illustrate how work gets lost between chat, code, design, hosting and later changes. The 20% figure is illustrative.'],
  ['What ownership means', 'The deck compares tools on source ownership, maintenance, portability, media integration and data sharing. These are questions to ask about a tool, since capabilities vary.'],
  ['The return visit', 'Shape the brief, build, polish, ship, then reopen the same project to make a real change.'],
  ['The Cloudflare foundation', 'Workers run applications and APIs. Workers AI handles selected inference. D1 stores structured records and R2 stores objects.'],
  ['Operating after launch', 'GitHub holds source and history. EmDash provides an editorial workspace for updates and records within its scope.'],
  ['The creative pipeline', 'Keep the brief, working media, versions and approved exports together as a project moves through Media Studio.'],
  ['Agent permissions', 'Inspection, edits, execution and publication carry separate authority. The owner can inspect the work before granting a consequential action.'],
  ['Choose the right compute', 'Use deterministic software for tasks such as a crop or calculation. Use models where a task benefits from interpretation or creative judgment.'],
  ['Utilities and connected apps', 'Paperwork, Launch Kit, and the Here / there and Linkarooie pairing illustrate local editing, portable branding and sharing across independently owned apps.'],
  ['Games and interactive state', 'Protocol 11, LOFTWAH FIGHTER and Foilbury illustrate different needs around multiplayer state, simulation and collectible records.'],
  ['How the systems fit', 'Composer connects GitHub, Cloudflare, EmDash and Media Studio. Each connected system keeps responsibility for its part.'],
  ['The cost of an accepted outcome', 'Benchmarks should include corrections, debugging and deployment effort. The chart’s percentage is an illustration.'],
  ['Paths for different teams', 'The vision describes a guided path for creators, repeatable client deployments for teams and source-level controls for engineers.'],
  ['The finish standard', 'The project should do its job, look finished, match its public claims, reach the intended destination and survive a later change.'],
];
---

<Base
  title="App Composer briefing"
  description="Watch From Idea to Operation, listen to the ownership and WordPress discussions, and download the App Composer slides and transcripts."
  ogType="article"
>
  <article class="briefing">
    <header class="opening">
      <a href="/pitch/vision">← The completed product vision</a>
      <h1>App Composer briefing</h1>
      <p class="lede">What happens between having an idea and running a project you can keep improving?</p>
      <p class="source">Generated by NotebookLM from our completed product vision. The examples and figures illustrate that vision. App Composer is independent.</p>
      <nav aria-label="Briefing formats">
        <a href="#watch">Watch the film</a>
        <a href="#listen">Listen to the discussions</a>
        <a href="#slides">Browse the slides</a>
      </nav>
    </header>

    <section class="briefing-section" id="watch" aria-label="Watch the film">
      <BriefingRecording recording={video} />
      <a class="watch-link" href="/pitch/briefing/film">Open the film and share a chapter <ArrowRight size={16} aria-hidden="true" /></a>
    </section>

    <section class="briefing-section" id="listen" aria-labelledby="listen-heading">
      <h2 id="listen-heading">Listen</h2>
      {audio.map((recording) => <BriefingRecording recording={recording} />)}
    </section>

    <section class="briefing-section" id="slides" aria-labelledby="slides-heading">
      <h2 id="slides-heading">Read the slide deck</h2>
      <div class="deck">
        <a href={pdf} aria-label="Open the original App Composer Overview PDF">
          <img src="/downloads/app-composer/notebooklm-20261120/slides-cover.webp" width="1080" height="604" loading="lazy" decoding="async" alt="Cover slide with a diagram of separate components converging into an owned app." />
        </a>
        <div>
          <h3>App Composer Overview</h3>
          <p>15 illustrated slides on ownership, the creator’s workflow and the systems behind it.</p>
          <div class="deck-links">
            <a href={pdf}>Open PDF</a>
            <a href={pdf} download="App-Composer-NotebookLM-Overview.pdf"><ArrowDownToLine size={16} aria-hidden="true" /> Download PDF</a>
          </div>
        </div>
      </div>
      <details class="reading-guide">
        <summary>Read the slide-by-slide guide</summary>
        <ol>
          {slides.map(([title, summary], index) => (
            <li>
              <h4><a href={`${pdf}#page=${index + 1}`}>{title}</a></h4>
              <p>{summary}</p>
            </li>
          ))}
        </ol>
      </details>
    </section>

    <aside class="briefing-next" aria-labelledby="next-heading">
      <h2 id="next-heading">See what’s working today</h2>
      <p>Follow a signed-out example, inspect the architecture or read the source behind this briefing.</p>
      <nav aria-label="Continue from the briefing">
        <a href="/creator-hub">Try Creator Hub <ArrowRight size={16} aria-hidden="true" /></a>
        <a href="/diagrams">Explore the diagram atlas <ArrowRight size={16} aria-hidden="true" /></a>
        <a href="/pitch/vision">Read the full product vision <ArrowRight size={16} aria-hidden="true" /></a>
        <a href="/share#briefing-cards">Get the campaign artwork and audio prompts <ArrowRight size={16} aria-hidden="true" /></a>
      </nav>
    </aside>
  </article>
</Base>

<style>
  .briefing { max-width: 1120px; margin-inline: auto; }
  .opening h1 { max-width: 19ch; font-size: clamp(2.65rem, 6vw, 5.15rem); line-height: 1.04; letter-spacing: -.035em; margin: .55rem 0 .8rem; text-wrap: balance; }
  .opening .lede { max-width: 54ch; margin: 0; }
  .source { max-width: 70ch; color: var(--color-muted); margin-block: .65rem .85rem; }
  .opening nav, .deck-links, .briefing-next nav { display: flex; flex-wrap: wrap; gap: 0 1.2rem; }
  .opening nav { border-block: 1px solid var(--color-border); }
  nav a, .deck-links a, .watch-link { display: inline-flex; align-items: center; gap: .35rem; min-height: 44px; font-weight: 650; }
  .briefing-section, .briefing-next { margin-block: clamp(2rem, 5vw, 3.5rem); scroll-margin-block-start: 6rem; }
  h2 { font-size: clamp(1.65rem, 3vw, 2.7rem); margin: 0 0 .55rem; }
  h3 { font-size: clamp(1.2rem, 2.2vw, 1.75rem); margin: 0 0 .5rem; }
  .deck { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); align-items: center; gap: clamp(1rem, 4vw, 2rem); margin-block: 1rem 1.25rem; }
  .deck img { width: 100%; height: auto; display: block; border-radius: .55rem; }
  .deck p { color: var(--color-muted); margin: 0; }
  .reading-guide { border-block: 1px solid var(--color-border); }
  .reading-guide summary { min-height: 44px; padding-block: .65rem; font-weight: 650; cursor: pointer; }
  .reading-guide ol { max-width: 70ch; padding-inline-start: 1.65rem; }
  .reading-guide h4 { margin-block: .6rem .2rem; font-size: 1rem; }
  .reading-guide p { margin-block: 0 .8rem; }
  .briefing-next { padding-block-start: 1.2rem; border-block-start: 1px solid var(--color-border); }
  .briefing-next p { color: var(--color-muted); }
  @media (max-width: 680px) {
    .deck { grid-template-columns: minmax(0, 1fr); }
  }
</style>
