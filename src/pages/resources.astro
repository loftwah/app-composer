---
import ResourceDesk from '../components/ResourceDesk.astro';
import { resourceById } from '../lib/resource-library';
const legacy = resourceById(Astro.url.searchParams.get('resource') ?? '');
if (legacy) {
  const target = new URL(`/resources/${legacy.id}`, Astro.url);
  for (const key of ['analytics', 'qa']) {
    const value = Astro.url.searchParams.get(key);
    if (value) target.searchParams.set(key, value);
  }
  target.hash = Astro.url.hash;
  return Astro.redirect(target.pathname + target.search + target.hash, 302);
}
---
<ResourceDesk />
