---
import BuilderFields from '../../components/BuilderFields.astro';
import Base from "../../layouts/Base.astro";
import AnalyticsTrend from "../../components/AnalyticsTrend.astro";
import { apps } from "../../lib/apps";
import { env } from "cloudflare:workers";
import type { D1Database } from "@cloudflare/workers-types";
import { connectedOn, selection } from "../../../lib/usage/index.mjs";
import { portfolioSummary } from "../../../lib/usage/portfolio.mjs";
import build from "../../lib/build.json";
import {
  appActions,
  appLabels,
  appSignalSelection,
  appSignals,
  count,
  dateLabel,
  daySelection,
  metricDays,
  signalLabels,
  type PublicHistory,
} from "../../lib/activity-view";
import { reportMetricView } from "../../lib/public-report";
import { ArrowLeft, ArrowUpRight, Code, Share2 } from "@lucide/astro";
import "../../styles/analytics.css";

const id = Astro.params.app ?? "";
const definition = apps.find((value) => value.id === id);
if (!definition) Astro.response.status = 404;
const selected = selection(Astro.url.searchParams);
const { metric: requested, unsupported } = appSignalSelection(id, Astro.url.searchParams.get("metric"));
const supported = appSignals[id] ?? ["app_opens"];
const routeConnected = connectedOn(id, selected.surface);
const runtime = env as unknown as { DB: D1Database };
let report: PublicHistory | undefined;
try {
  report = (await portfolioSummary(runtime.DB, selected.days, new Date(), build.commit, selected.surface as "all" | "standalone" | "composed")) as unknown as PublicHistory;
} catch {}
if (!report && definition) Astro.response.status = 503;
const entry = report?.apps?.find((value: { app: string }) => value.app === id);
const views = report && entry && routeConnected
  ? supported.flatMap((key) => {
      try {
        const value = reportMetricView(report, id, key);
        return [{
          ...value,
          key,
          label: signalLabels[key],
          days: metricDays(value.daily, value.quality, report!.generatedAt.slice(0, 10)),
        }];
      } catch {
        return [];
      }
    })
  : [];
const view = views.find((value) => value.key === requested) ?? views[0];
const metric = view?.key ?? requested;
const day = report ? daySelection(Astro.url.searchParams.get("day"), report.period.from, report.period.to) : null;
const ranked = [...(report?.apps ?? [])].sort((a, b) => b.opens - a.opens || a.app.localeCompare(b.app));
const maximum = Math.max(1, ...ranked.map((value) => value.opens));
const where = selected.surface === "standalone" ? "standalone apps" : selected.surface === "composed" ? "inside Composer" : "all connected versions";
const scopeQuery = `days=${selected.days}&surface=${selected.surface}`;
const backQuery = `${scopeQuery}&metric=${metric}${day ? `&day=${day}` : ""}`;
const standaloneQuery = `days=${selected.days}&surface=standalone`;
const from = report?.period.from ?? "";
const to = report?.period.to ?? "";
const shareHref = `/reports/new?${scopeQuery}&metric=${metric}&app=${id}`;
const metricHref = (key: string) =>
  `${Astro.url.pathname}?${scopeQuery}&metric=${key}${day ? `&day=${day}` : ""}`;
const appHref = (app: string) => {
  const target = (appSignals[app] ?? []).includes(metric) ? metric : "app_opens";
  return `/activity/${app}?${scopeQuery}&metric=${target}${day ? `&day=${day}` : ""}`;
};
---
<Base
  title={definition ? `${definition.name} analytics` : "App analytics"}
  description={definition ? `Recorded public activity for ${definition.name}: opens, supported actions, daily coverage and a frozen shareable story.` : "This app analytics page is unavailable."}
>
  {!definition ? (
    <section class="analytics-empty" role="status">
      <h1>No app exists at this address.</h1>
      <p>Choose one of the shipped App Composer mini-apps.</p>
      <p><a href="/activity">Return to analytics</a></p>
    </section>
  ) : (
    <>
      <a href={`/activity?${backQuery}`} class="report-back"><ArrowLeft size={18} aria-hidden="true"/> All app analytics</a>
      <header class="analytics-app-hero">
        <img src={definition.thumbnail} width="96" height="96" alt="" />
        <div>
          <p class="analytics-kicker">Analytics · app record</p>
          <h1>{definition.name}</h1>
          <p>{definition.description}</p>
          <div class="analytics-app-links">
            <a href={definition.href}>Open {definition.name} <ArrowUpRight size={16} aria-hidden="true"/></a>
            <a href={definition.source}><Code size={16} aria-hidden="true"/> Source</a>
            {routeConnected ? (
              <a href={shareHref}><Share2 size={16} aria-hidden="true"/> Preview the shareable report</a>
            ) : (
              <a href={`/activity/${id}?${standaloneQuery}`}>View standalone activity</a>
            )}
          </div>
        </div>
        <div class="analytics-app-count">
          <strong>{routeConnected && entry ? count(entry.opens) : "—"}</strong>
          <small>{routeConnected ? `${entry?.opens === 1 ? "recorded open" : "recorded opens"} · ${where}` : "No composed route · standalone only"}</small>
        </div>
      </header>

      {routeConnected ? (
        <>
          <section class="activity-scope" aria-labelledby="app-scope-title">
            <form method="get" class="activity-scope-form">
              <BuilderFields/>
              <h2 id="app-scope-title">Scope</h2>
              <input type="hidden" name="metric" value={metric} />
              {day && <input type="hidden" name="day" value={day} />}
              <label for="app-days">Time window
                <select name="days" id="app-days">
                  <option value="7" selected={selected.days === 7}>Past 7 UTC days</option>
                  <option value="30" selected={selected.days === 30}>Past 30 UTC days</option>
                </select>
              </label>
              <label for="app-surface">App route
                <select name="surface" id="app-surface">
                  <option value="all" selected={selected.surface === "all"}>All routes</option>
                  <option value="standalone" selected={selected.surface === "standalone"}>Standalone</option>
                  <option value="composed" selected={selected.surface === "composed"}>Inside Composer</option>
                </select>
              </label>
              <button type="submit" class="secondary">Apply scope</button>
            </form>
            <div class="activity-scope-note">
              <p>{where} · {from ? `${dateLabel(from)} – ${dateLabel(to, true)}, UTC.` : "Window unavailable."} {report?.period.complete ? "Complete UTC days." : "Today is in progress."}</p>
              <p>The day inspector, app comparison and shareable report keep this scope.</p>
            </div>
          </section>

          {unsupported && (
            <p class="analytics-note" id="app-signal-note">{definition.name} does not declare {signalLabels[unsupported]}. This record shows {signalLabels[metric]} for the same scope instead.</p>
          )}

          <div data-activity>
            <section class="analytics-section activity-plot" aria-labelledby="app-chart-title">
              <div class="analytics-chart-head">
                <div>
                  <p class="analytics-kicker">Daily record · {where}</p>
                  <h2 id="app-chart-title" data-chart-title>{view?.label ?? "Recorded signal"}</h2>
                </div>
                <div class="chart-actions">
                  <a class="button secondary" href={shareHref}><Share2 size={16} aria-hidden="true"/> Preview the shareable report</a>
                </div>
              </div>
              {views.length > 1 ? (
                <nav class="trend-tabs" aria-label="Recorded signal">
                  {views.map((value) => (
                    <a href={metricHref(value.key)} data-metric-tab={value.key} aria-current={value.key === metric ? "page" : undefined}>
                      {signalLabels[value.key]}
                      <strong>{value.value === null ? "—" : count(value.value)}</strong>
                    </a>
                  ))}
                </nav>
              ) : (
                <p class="analytics-chart-note">{definition.name} declares one public measure. The day inspector covers the whole window.</p>
              )}
              {views.map((value) => (
                <AnalyticsTrend
                  metric={value.key}
                  label={value.label}
                  definition={value.definition}
                  unit={value.unit}
                  value={value.value}
                  quality={value.quality}
                  days={value.days}
                  from={from}
                  to={to}
                  surface={selected.surface}
                  windowDays={selected.days}
                  selectedDay={day}
                  hidden={value.key !== metric}
                />
              ))}
              {!views.length && (
                <div class="analytics-empty" role="status">
                  <h2>This app has no daily series in the selected scope.</h2>
                  <p>The query failed or the app is not connected in this environment. This is not a zero count.</p>
                </div>
              )}
            </section>

            <section class="analytics-summary" aria-label={`${definition.name} summary`}>
              <div><span>Recorded opens</span><strong>{entry ? count(entry.opens) : "—"}</strong><small>Successful home-page requests</small></div>
              <div><span>{id === "guestbook" ? "Contribution opens" : id === "linkcheck" ? "Completed inspections" : "Supported actions"}</span><strong>{entry ? count(id === "guestbook" ? entry.photoOpens : id === "linkcheck" ? entry.inspections : entry.actions) : "—"}</strong><small>{id === "state" ? "Vault actions stay private" : id === "showcase" || id === "hello" ? "No separate public action is counted" : id === "guestbook" ? "Page opens, not submissions" : "Finished in the app"}</small></div>
              <div><span>Postcards received</span><strong>{!entry?.postcards || entry.postcards.value === null ? "—" : count(entry.postcards.value)}</strong><small>{entry?.postcards ? "Accepted during this period" : "No receipt measure declared"}</small></div>
              <div><span>Retained days</span><strong>{view ? `${view.days.filter((day) => day.value !== null).length}/${selected.days}` : "—"}</strong><small>Available UTC days in scope</small></div>
            </section>

            <section class="analytics-section" aria-labelledby="compare-title">
              <div class="analytics-section-heading">
                <h2 id="compare-title">Compared with the other apps</h2>
                <p>The same {where} scope and UTC window. Open another app to keep the scope and the inspected day.{selected.surface === "composed" ? " Apps without a composed route are marked unavailable, not counted as zero." : ""}</p>
              </div>
              <ol class="analytics-apps">
                {ranked.map((value) => {
                  const connected = connectedOn(value.app, selected.surface);
                  return (
                    <li class:list={{ "analytics-app": true, "is-unavailable": !connected }}>
                      <img src={apps.find((app) => app.id === value.app)?.thumbnail ?? "/brand/composer-icon-20261022b-96.png"} width="48" height="48" alt="" loading="lazy" />
                      <div>
                        <h3>
                          {value.app === id ? (
                            <span>{appLabels[value.app]} · this app</span>
                          ) : (
                            <a href={appHref(value.app)}>{appLabels[value.app]} <ArrowUpRight size={16} aria-hidden="true"/></a>
                          )}
                        </h3>
                        <p>{appActions[value.app]}</p>
                      </div>
                      <div class="analytics-app-bar" aria-hidden="true">{connected && <svg viewBox="0 0 100 8" preserveAspectRatio="none"><rect width={(100 * value.opens) / maximum} height="8"/></svg>}</div>
                      <div class="analytics-app-count">
                        {connected ? (
                          <>
                            <strong>{count(value.opens)}{value.limited ? "+" : ""}</strong>
                            <small>recorded opens{value.limited ? " · lower bound" : ""}</small>
                          </>
                        ) : (
                          <>
                            <strong aria-hidden="true">—</strong>
                            <small>No composed route</small>
                          </>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ol>
            </section>

            <section class="analytics-method" aria-labelledby="app-method-title">
              <h2 id="app-method-title">What this app record can tell you.</h2>
              <p>This page uses the same bounded public aggregate as the rest of analytics. It can show recorded demand for the app's public home page and, where the app declares one, a supported completed action. It cannot show who visited, which private record they opened, or whether an action became a customer outcome.</p>
              <ul>
                <li>Opens are successful public home-page requests. Reloads and bots can count.</li>
                <li>{id === "guestbook" ? "Contribution opens are page requests, not submissions. Received postcards are pending records after committed acceptance, not approvals or features." : id === "linkcheck" ? "Inspections are counted after the app finishes an inspection, not when the page opens." : id === "state" ? "Carry / forward vault actions remain private and are never counted." : "This app declares no separate public action measure."}</li>
                {selected.surface === "composed" && <li>Composed counts are recorded only by the apps Composer mounts inside its own site. An app without one is marked unavailable, never reported as zero.</li>}
                <li>Counters stop at 1,000 per app/event/surface per UTC day, expire after 35 days and can miss events during an outage.</li>
              </ul>
              <p>{routeConnected ? <a href={shareHref}>Preview the shareable report</a> : <a href={`/reports/new?${standaloneQuery}&metric=${metric}&app=${id}`}>Preview the standalone report</a>} · <a href={`/activity?${backQuery}`}>All analytics</a> · <a href={`/api/portfolio-analytics?${scopeQuery}`}>Daily data</a></p>
            </section>
          </div>
        </>
      ) : (
        <section class="analytics-empty" role="status">
          <h2>No composed route for {definition.name}.</h2>
          <p>Composer records composed activity only for the apps it mounts inside its own site. {definition.name} publishes as a standalone app, so there is no composed activity to measure in this window. That is an unsupported scope, not a retained zero.</p>
          <p><a href={`/activity/${id}?${standaloneQuery}`}>View {definition.name} standalone activity</a> · <a href={`/activity?days=${selected.days}&surface=composed`}>Compare the mounted apps</a> · <a href={`/activity/${id}?days=${selected.days}&surface=all`}>See all connected versions</a></p>
        </section>
      )}
    </>
  )}
</Base>

<script>
  import "../../browser/activity";
</script>
