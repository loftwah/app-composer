---
import Base from '../layouts/Base.astro';
import { ArrowRight } from '@lucide/astro';
import {
  agentTask,
  builderUrl,
  embed,
  embedHtml,
  embedJsx,
  recipeFilename,
  recipePath,
  starterFilename,
  starterPath,
  stationName,
  stationOrigin,
  widgetRecipeJson,
  widgetUrl,
} from '../lib/widget-recipe';
import {
  filmAgentTask,
  filmAgentTaskDownload,
  filmAgentTaskFilename,
  filmCaptionSrc,
  filmEmbedFragment,
  filmReactInstallSnippet,
  filmTitle,
  posterUrl,
  reactComponentFilename as filmReactFilename,
  reactComponentPath as filmReactPath,
  recipeV2Filename as filmRecipeV2Filename,
  recipeV2Path as filmRecipeV2Path,
  starterFilename as filmStarterFilename,
  starterPath as filmStarterPath,
  videoUrl,
  watchUrl,
} from '../lib/studio-film-starter';
import {
  bubblesCards,
  bubblesReport,
  topTracksReport,
  widgetIndexPath,
} from '../lib/widget-recipe-index';
---
<Base title="Widget library" description="Embed a LoftwahFM player, share listening cards or host a captioned Media Studio film.">
  <script type="application/json" id="loftwahfm-widget-recipe" set:html={widgetRecipeJson}></script>
  <header class="widget-intro">
    <h1>Widget library</h1>
    <a href="/apps">App library <ArrowRight size={17} aria-hidden="true" /></a>
  </header>

  <nav class="widget-toc" aria-label="Widgets on this page">
    <ul>
      <li><a href="#loftwahfm-station">Station player</a></li>
      <li><a href="#bubbles-listening-card">Bubbles listening card</a></li>
      <li><a href="#top-tracks-share-card">Top Tracks share card</a></li>
      <li><a href="#take-it-with-you-film">Take it with you film</a></li>
    </ul>
  </nav>
  <p><a href={widgetIndexPath} type="application/json">Widget recipes (JSON)</a></p>

  <article class="widget-entry" id="loftwahfm-station">
    <h2>LoftwahFM station player</h2>
    <p class="entry-summary">{stationName} station rotation in one iframe. Your visitor presses Play; nothing autoplays and no account is needed.</p>

    <dl class="widget-facts">
      <div><dt>Source</dt><dd><a href={builderUrl}>LoftwahFM’s public widget builder</a></dd></div>
      <div><dt>Needs</dt><dd>A page that allows iframes from fm.loftwah.com. No account, API key or build step.</dd></div>
      <div><dt>Cost</dt><dd>The public embed is free for personal listening. <a href={`${stationOrigin}/business-licence/`}>Business and venue playback terms</a> are separate.</dd></div>
      <div><dt>Recipe</dt><dd>Night Signal · compact player · {embed.width} × {embed.height} · <a href={recipePath} download={recipeFilename}>Download recipe (JSON)</a></dd></div>
      <div><dt>Starter page</dt><dd><a href={starterPath} download={starterFilename}>Download HTML starter</a>. Serve the file over HTTP or HTTPS, including on localhost.</dd></div>
    </dl>

    <section aria-labelledby="widget-preview-heading">
      <h3 id="widget-preview-heading">Preview Night Signal</h3>
      <p>Load the player from LoftwahFM, then press Play to listen.</p>
      <div class="preview-frame" data-widget-preview>
        <p class="preview-label">{stationName}<span>LoftwahFM · station rotation</span></p>
        <div data-enhanced hidden>
          <button type="button" data-load-player>Load the player</button>
        </div>
        <template data-player-template>
          <iframe src={embed.src} title={embed.title} width={embed.width} height={embed.height} allow={embed.allow}></iframe>
        </template>
      </div>
      <div class="preview-controls" data-close-player-controls hidden>
        <button type="button" class="secondary" data-close-player>Close preview</button>
      </div>
      <a href={widgetUrl}>Open the player on LoftwahFM</a>
      <p class="preview-status" role="status" data-preview-status></p>
    </section>

    <section aria-labelledby="widget-embed-heading">
      <h3 id="widget-embed-heading">The embed code</h3>
      <p>Paste this into any HTML page. LoftwahFM’s own player, sizing and Play button come with the frame; your page provides nothing else.</p>
      <pre class="widget-code" tabindex="0"><code data-embed-html>{embedHtml}</code></pre>
      <div class="copy-actions" data-enhanced hidden>
        <button type="button" data-copy-embed>Copy embed</button>
        <button type="button" class="secondary" data-copy-link data-link={widgetUrl}>Copy link</button>
        <button type="button" class="secondary" data-copy-jsx>Copy React</button>
      </div>
      <p class="copy-status" role="status" data-copy-status></p>
      <div data-manual hidden>
        <label for="widget-manual-copy">Copy this value manually<textarea id="widget-manual-copy" readonly rows="10"></textarea></label>
      </div>
      <details class="react-version">
        <summary>React version</summary>
        <p>The same iframe with the same attributes, for a React page. LoftwahFM’s builder generates the same shape.</p>
        <pre class="widget-code" tabindex="0"><code data-embed-jsx>{embedJsx}</code></pre>
      </details>
    </section>

    <section aria-labelledby="widget-agent-heading">
      <h3 id="widget-agent-heading">Have your coding agent add it</h3>
      <p>Copy this task into the coding agent you already use. It carries the exact embed, the boundaries and the checks to report back.</p>
      <pre class="widget-code" tabindex="0" data-agent-task>{agentTask}</pre>
      <div class="copy-actions" data-enhanced hidden>
        <button type="button" data-copy-agent>Copy agent task</button>
      </div>
      <p class="copy-status" role="status" data-agent-status></p>
      <div data-agent-manual hidden>
        <label for="widget-agent-manual">Manual copy — select the task and copy it<textarea id="widget-agent-manual" readonly rows="16"></textarea></label>
      </div>
    </section>

    <section aria-labelledby="widget-limits-heading">
      <h3 id="widget-limits-heading">Rights and limits</h3>
      <ul class="widget-limits">
        <li>LoftwahFM serves its public catalogue and may update the station rotation.</li>
        <li>Your site controls the frame size. Use the LoftwahFM builder to change the appearance inside it.</li>
      </ul>
    </section>
  </article>

  <article class="widget-entry" id="bubbles-listening-card">
    <h2>Bubbles listening card</h2>
    <p class="entry-summary">Download LoftwahFM’s 30-day Bubbles listening report as a share card.</p>

    <section aria-labelledby="bubbles-card-downloads">
      <h3 id="bubbles-card-downloads">Download the current card</h3>
      <ul class="card-downloads">
        {bubblesCards.map(({ label, dimensions, url }) => (
          <li><a class="button secondary" href={url}>
            {label} <span>{dimensions} PNG</span>
          </a></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="bubbles-card-snapshot">
      <h3 id="bubbles-card-snapshot">Share a dated snapshot</h3>
      <p>Open the <a href={bubblesReport}>Bubbles report on LoftwahFM</a> and select <strong>Share this snapshot</strong> to get the card, caption and link for the same snapshot. Keep the publisher’s credits with the card.</p>
    </section>
  </article>

  <article class="widget-entry" id="top-tracks-share-card">
    <h2>Top Tracks share card</h2>
    <p class="entry-summary">LoftwahFM’s public report ranks tracks by recorded listening starts over the last 30 days.</p>
    <p>Choose Square, Wide or Story on LoftwahFM, then select <strong>Download PNG</strong> to share the card. Select <strong>Download Top Tracks recipe (JSON)</strong> for the dated ranking, measurement window and image settings.</p>
    <a href={topTracksReport}>Open Top Tracks on LoftwahFM</a>
  </article>

  <article class="widget-entry" id="take-it-with-you-film">
    <h2>{filmTitle}</h2>
    <p class="entry-summary">Host this 10.5-second App Composer film on your site with English captions. Paste the fragment below into an existing page, or download the complete starter.</p>
    <div class="card-downloads">
      <a class="button secondary" href={filmRecipeV2Path} download={filmRecipeV2Filename}>Download film recipe (JSON)</a>
      <a class="button secondary" href={filmStarterPath} download={filmStarterFilename}>Download film HTML starter</a>
      <a class="button secondary" href={filmReactPath} download={filmReactFilename}>Download React + TS component</a>
      <a class="button secondary" href={watchUrl}>Watch on Media Studio</a>
    </div>
    <section aria-labelledby="film-preview-heading" data-enhanced hidden>
      <h3 id="film-preview-heading">Preview the film</h3>
      <p>Load the captioned film, then press Play. English captions are on by default.</p>
      <div class="preview-frame film-preview" data-film-preview>
        <p class="preview-label">{filmTitle}<span>App Composer · 10.5-second film</span></p>
        <button type="button" data-load-film>Load the film</button>
        <template data-film-template>
          <video controls playsinline preload="none" width="1280" height="720" poster={posterUrl} aria-label={`${filmTitle}, an App Composer commercial`}>
            <source src={videoUrl} type="video/mp4">
            <track kind="captions" src={filmCaptionSrc} srclang="en" label="English captions" default>
            Your browser does not support HTML video. <a href={watchUrl}>Watch {filmTitle} on Media Studio</a>.
          </video>
        </template>
      </div>
      <div class="preview-controls" data-close-film-controls hidden>
        <button type="button" class="secondary" data-close-film>Close film preview</button>
      </div>
      <p class="preview-status" role="status" data-film-preview-status></p>
    </section>
    <section aria-labelledby="film-embed-heading">
      <h3 id="film-embed-heading">Add it to an existing page</h3>
      <p>If your site sets a content security policy, allow <code>media.loftwah.com</code> for the video and poster, and <code>data:</code> for the caption track.</p>
      <details class="react-version">
        <summary>Show the HTML fragment</summary>
        <pre class="widget-code film-code" tabindex="0"><code data-film-embed>{filmEmbedFragment}</code></pre>
        <div class="copy-actions" data-enhanced hidden>
          <button type="button" data-copy-film>Copy fragment</button>
        </div>
        <p class="copy-status" role="status" data-film-status></p>
        <div data-manual hidden>
          <label for="film-manual-copy">Copy this value manually<textarea id="film-manual-copy" readonly rows="10"></textarea></label>
        </div>
      </details>
    </section>
    <details class="react-version">
      <summary>React and TypeScript setup</summary>
      <p>Save the downloaded component alongside your page and import it as shown. Allow the same poster, video and caption sources in your content security policy.</p>
      <pre class="widget-code film-code" tabindex="0"><code>{filmReactInstallSnippet}</code></pre>
    </details>
    <details class="react-version">
      <summary>Install with your coding agent</summary>
      <p>Give your coding agent the install links and playback checks.</p>
      <pre class="widget-code film-code" tabindex="0" data-film-agent-task>{filmAgentTask}</pre>
      <div class="copy-actions" data-enhanced hidden>
        <button type="button" data-copy-film-agent>Copy agent task</button>
      </div>
      <p class="copy-status" role="status" data-film-agent-status></p>
      <div data-film-agent-manual hidden>
        <label for="film-agent-manual">Copy this task manually<textarea id="film-agent-manual" readonly rows="16"></textarea></label>
      </div>
      <a href={filmAgentTaskDownload} download={filmAgentTaskFilename}>Download task (Markdown)</a>
    </details>
  </article>

  <p class="widget-foot">For other stations, releases, playlists and sizes, use <a href={builderUrl}>LoftwahFM’s builder</a>. For games, see <a href={`${stationOrigin}/game-music/`}>LoftwahFM’s audio SDK</a>.</p>
</Base>

<script>
  const preview = document.querySelector<HTMLElement>('[data-widget-preview]')!;
  const previewStatus = document.querySelector<HTMLElement>('[data-preview-status]')!;
  const loadButton = preview.querySelector<HTMLButtonElement>('[data-load-player]')!;
  const closeControls = document.querySelector<HTMLElement>('[data-close-player-controls]')!;
  const closeButton = closeControls.querySelector<HTMLButtonElement>('[data-close-player]')!;
  const embedText = document.querySelector<HTMLElement>('[data-embed-html]')!.textContent ?? '';
  const jsxText = document.querySelector<HTMLElement>('[data-embed-jsx]')!.textContent ?? '';
  const agentText = document.querySelector<HTMLElement>('[data-agent-task]')!.textContent ?? '';

  // Keep the initial nodes so closing restores the exact click-to-load state.
  // Captured on first load, after progressive enhancement has revealed the
  // Load button.
  let initialPreviewChildren: Element[] | null = null;

  // Click-to-load: the frame stays empty until the visitor asks for the player,
  // so the preview never starts audio and never requests LoftwahFM unprompted.
  loadButton.addEventListener('click', () => {
    const template = preview.querySelector<HTMLTemplateElement>('[data-player-template]')!;
    const frame = template.content.querySelector('iframe')!.cloneNode(true) as HTMLIFrameElement;
    initialPreviewChildren ??= Array.from(preview.children);
    preview.replaceChildren(frame);
    closeControls.hidden = false;
    frame.focus({ preventScroll: true });
    previewStatus.textContent = 'Press Play in the preview to listen.';
  });

  // Removing the frame stops playback and releases the LoftwahFM resource.
  // The visitor returns to the control that opened it, including by keyboard.
  closeButton.addEventListener('click', () => {
    if (!initialPreviewChildren) return;
    preview.replaceChildren(...initialPreviewChildren);
    initialPreviewChildren = null;
    closeControls.hidden = true;
    previewStatus.textContent = '';
    loadButton.focus();
  });

  let copyRequest = 0;
  async function copy(text: string, message: string, status: HTMLElement, manual: HTMLElement) {
    const request = ++copyRequest;
    for (const field of document.querySelectorAll<HTMLElement>('[data-manual], [data-agent-manual], [data-film-manual], [data-film-agent-manual]')) field.hidden = true;
    status.textContent = '';
    try {
      await navigator.clipboard.writeText(text);
      if (request === copyRequest) status.textContent = message;
    } catch {
      if (request !== copyRequest) return;
      status.textContent = 'Copy the selected text manually.';
      manual.hidden = false;
      const area = manual.querySelector<HTMLTextAreaElement>('textarea')!;
      area.value = text;
      area.focus();
      area.select();
    }
  }

  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]')!;
  const copyManual = document.querySelector<HTMLElement>('[data-manual]')!;
  document.querySelector<HTMLButtonElement>('[data-copy-embed]')!.addEventListener('click', () => {
    void copy(embedText, 'Embed copied. Paste it into your page.', copyStatus, copyManual);
  });
  document.querySelector<HTMLButtonElement>('[data-copy-jsx]')!.addEventListener('click', () => {
    void copy(jsxText, 'React snippet copied.', copyStatus, copyManual);
  });
  const linkButton = document.querySelector<HTMLButtonElement>('[data-copy-link]')!;
  linkButton.addEventListener('click', () => {
    void copy(linkButton.dataset.link!, 'Player link copied.', copyStatus, copyManual);
  });

  const agentStatus = document.querySelector<HTMLElement>('[data-agent-status]')!;
  const agentManual = document.querySelector<HTMLElement>('[data-agent-manual]')!;
  document.querySelector<HTMLButtonElement>('[data-copy-agent]')!.addEventListener('click', () => {
    void copy(agentText, 'Agent task copied. Paste it into your coding agent to begin.', agentStatus, agentManual);
  });

  const filmEmbedText = document.querySelector<HTMLElement>('[data-film-embed]')!.textContent ?? '';
  const filmStatus = document.querySelector<HTMLElement>('[data-film-status]')!;
  const filmManual = document.querySelector<HTMLElement>('#take-it-with-you-film [data-manual]')!;
  document.querySelector<HTMLButtonElement>('[data-copy-film]')!.addEventListener('click', () => {
    void copy(filmEmbedText, 'Fragment copied. Paste it into your page.', filmStatus, filmManual);
  });

  const filmAgentText = document.querySelector<HTMLElement>('[data-film-agent-task]')!.textContent ?? '';
  const filmAgentStatus = document.querySelector<HTMLElement>('[data-film-agent-status]')!;
  const filmAgentManual = document.querySelector<HTMLElement>('[data-film-agent-manual]')!;
  document.querySelector<HTMLButtonElement>('[data-copy-film-agent]')!.addEventListener('click', () => {
    void copy(filmAgentText, 'Agent task copied. Paste it into your coding agent to begin.', filmAgentStatus, filmAgentManual);
  });

  const filmPreview = document.querySelector<HTMLElement>('[data-film-preview]')!;
  const filmPreviewStatus = document.querySelector<HTMLElement>('[data-film-preview-status]')!;
  const loadFilmButton = filmPreview.querySelector<HTMLButtonElement>('[data-load-film]')!;
  const closeFilmControls = document.querySelector<HTMLElement>('[data-close-film-controls]')!;
  const closeFilmButton = closeFilmControls.querySelector<HTMLButtonElement>('[data-close-film]')!;
  const initialFilmPreviewChildren = Array.from(filmPreview.children);
  const filmTemplate = filmPreview.querySelector<HTMLTemplateElement>('[data-film-template]')!;

  // The template is inert HTML, so no video, poster or caption is fetched
  // before the visitor asks for the film.
  loadFilmButton.addEventListener('click', () => {
    const video = filmTemplate.content.querySelector('video')!.cloneNode(true) as HTMLVideoElement;
    filmPreview.replaceChildren(video);
    closeFilmControls.hidden = false;
    video.focus({ preventScroll: true });
    filmPreviewStatus.textContent = 'Press Play to watch. English captions are on.';
  });

  // Removing the element stops playback and drops the media element. Clear the
  // source first so nothing keeps streaming, then return focus to the trigger.
  closeFilmButton.addEventListener('click', () => {
    const video = filmPreview.querySelector('video');
    if (!video) return;
    video.pause();
    video.querySelector('source')?.remove();
    video.querySelector('track')?.remove();
    video.load();
    filmPreview.replaceChildren(...initialFilmPreviewChildren);
    closeFilmControls.hidden = true;
    filmPreviewStatus.textContent = '';
    loadFilmButton.focus();
  });

  for (const element of document.querySelectorAll<HTMLElement>('[data-enhanced]')) element.hidden = false;
</script>

<style>
  .widget-intro { display:flex; align-items:end; justify-content:space-between; flex-wrap:wrap; gap:.25rem 2rem; margin-bottom:1.5rem; }
  .widget-intro h1 { margin:0; font-size:clamp(2.65rem,6vw,5.1rem); }
  .widget-intro>a { display:inline-flex; align-items:center; gap:.5rem; min-height:44px; }
  .widget-toc { margin:0 0 1rem; border-top:1px solid var(--color-border); }
  .widget-toc ul { display:flex; flex-wrap:wrap; gap:0 1.25rem; margin:0; padding:0; list-style:none; max-width:none; }
  .widget-toc li { margin:0; }
  .widget-toc a { display:inline-flex; align-items:center; min-height:44px; font-size:.95rem; }
  .widget-entry { border-top:3px solid var(--color-accent); padding:1.5rem 0 2rem; min-width:0; scroll-margin-top:24px; }
  .widget-entry h2 { margin:0; font-size:clamp(1.45rem,3vw,2.2rem); }
  .entry-summary { max-width:60ch; margin:.6rem 0 0; }
  .widget-facts { display:grid; gap:0; margin:1.4rem 0 0; max-width:72ch; }
  .widget-facts>div { display:grid; grid-template-columns:7.5rem minmax(0,1fr); gap:.2rem 1rem; padding:.5rem 0; border-bottom:1px solid var(--color-border); }
  .widget-facts dt { font-size:.8rem; color:var(--color-muted); padding-top:.2rem; }
  .widget-facts dd { margin:0; }
  .widget-entry section { margin:2rem 0 0; scroll-margin-top:24px; }
  .widget-entry h3 { font-family:system-ui,sans-serif; font-weight:650; font-size:1rem; letter-spacing:0; margin:0 0 .7rem; }
  .widget-entry section>p { max-width:64ch; margin:.6rem 0; }
  .widget-code { max-height:none; }
  .film-code { white-space:pre-wrap; overflow-wrap:anywhere; }
  .preview-frame { max-width:560px; height:420px; border:1px solid var(--color-border); border-radius:8px; background:var(--color-field); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.8rem; text-align:center; padding:16px; overflow:hidden; margin:1.1rem 0 0; }
  .preview-frame:has(iframe) { padding:0; border:0; }
  .preview-frame iframe { width:100%; height:100%; border:0; }
  .film-preview { height:auto; aspect-ratio:16/9; }
  .film-preview:has(video) { padding:0; border:0; }
  .film-preview video { display:block; width:100%; height:100%; background:#000; }
  .preview-controls { max-width:560px; margin:.6rem 0 0; }
  .preview-controls button { font-size:.9rem; }
  .preview-label { margin:0; font:600 1.05rem/1.3 Space,sans-serif; letter-spacing:-.02em; }
  .preview-label span { display:block; margin-top:.25rem; font:400 .8rem/1.4 system-ui,sans-serif; color:var(--color-muted); }
  .preview-status, .copy-status { min-height:1.6em; font-size:.9rem; color:var(--color-accent); margin:.7rem 0 0; }
  .copy-actions { display:flex; flex-wrap:wrap; gap:.5rem 1rem; align-items:center; margin:1rem 0 0; }
  .copy-actions button { font-size:.9rem; }
  .react-version { margin-top:1.4rem; border-top:1px solid var(--color-border); }
  .widget-limits { max-width:72ch; }
  .widget-limits li { margin:12px 0; }
  .card-downloads { display:flex; flex-wrap:wrap; gap:.5rem; list-style:none; margin:0; padding:0; }
  .card-downloads a { display:flex; flex-direction:column; align-items:start; min-height:44px; }
  .card-downloads span { font-size:.8rem; font-weight:400; }
  .widget-foot { margin-top:2rem; padding-top:1rem; border-top:1px solid var(--color-border); color:var(--color-muted); max-width:none; }
  @media(max-width:600px) {
    .widget-facts>div { grid-template-columns:minmax(0,1fr); }
    .copy-actions button { flex:1 1 auto; }
  }
</style>
