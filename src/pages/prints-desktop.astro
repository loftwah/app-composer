---
import Base from '../layouts/Base.astro';
import AfterlightWall from '../components/AfterlightWall.astro';
import PrintsFirstSteps from '../components/PrintsFirstSteps.astro';
import PrintsArchive from '../components/PrintsArchive.astro';
import { isPrintsHost, printsOrigin, printsPreviewVersion as version, printsShare, printsShareAlt, printsWorkshopShareFolder, printsDownloadShareFolder, printsWorkflowShareFolder, printsPosterStudy } from '../lib/prints-site.mjs';
import { builds } from '../lib/prints-downloads.mjs';
import PrintsWalkthrough from '../components/PrintsWalkthrough.astro';
import { printsWorkshopVideo } from '../lib/prints-video.mjs';
import { ArrowDownToLine, ArrowRight, ArrowUpRight } from '@lucide/astro';

const site = 'https://github.com/loftwah/prints-desktop';
const release = `${site}/releases/tag/v${version}`;
const downloadUrl = (file: string) => `${site}/releases/download/v${version}/prints-desktop-${version}-${file}`;
const asset = '/prints-desktop/';
const archive = `${asset}archive-native-v0.4.0.webp`;
const compare = `${asset}archive-compare-v0.4.0.webp`;
const local = `${asset}local-library-v0.3.1.webp`;
const hosted = `${asset}oyster-library-demo-v0.3.1.webp`;
const canonical = printsOrigin + '/';
const packs = [
  { label: 'Workshop posters', url: printsWorkshopShareFolder + 'prints-workshop-social-kit.zip' },
  { label: 'Workflow posters', url: printsWorkflowShareFolder + 'prints-workflow-social-kit.zip' },
  { label: 'Download snapshot posters', url: printsDownloadShareFolder + 'prints-downloads-social-kit.zip' },
];
const product = isPrintsHost(Astro.url);
const routePrefix = product ? '' : '/prints-desktop';
const description = 'Explore the Loftwah Creative Archive and download Prints Desktop for macOS, Windows or Linux. Compare artwork, save favourites and export original files. Start offline or connect your Prints library through Oyster.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Prints Desktop',
  url: canonical,
  description,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'macOS 14+ (Apple Silicon), Linux (x64 and ARM64), Windows (x64)',
  softwareVersion: version,
  downloadUrl: builds.map(({ file }) => downloadUrl(file)),
  screenshot: [archive, compare].map((file) => new URL(file, canonical).href),
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', url: release },
};
---

<Base
  title="Prints Desktop"
  description={description}
  canonical={canonical}
  printsProduct={product}
  shareImage={printsShare}
  shareAlt={printsShareAlt}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="prints">
    <PrintsArchive guide={`${routePrefix}/make`} watch={`${routePrefix}/watch`} compare={compare} />
    <PrintsFirstSteps frontDoor />
    <section class="front-door-share" id="share-prints" tabindex="-1" aria-labelledby="share-prints-title">
      <h2 id="share-prints-title">Share Prints</h2>
      <p>Choose a poster for the workshop, a workflow, or the dated download snapshot. Each pack includes captions and alt text.</p>
      <ul>
        {packs.map(({ label, url }) => <li><a href={url} download>{label} <ArrowDownToLine size={16} aria-hidden="true" /></a></li>)}
      </ul>
    </section>
    {!product && <p class="product-link"><a class="quiet-link" href={printsOrigin}>Visit prints.loftwah.com <ArrowUpRight size={16} aria-hidden="true" /></a></p>}
    <section id="afterlight" aria-label="Try the Afterlight contact sheet">
      <AfterlightWall downloads="#downloads" walkthrough="#walkthrough" />
    </section>

    <section class="native" aria-labelledby="what-title">
      <div class="native-heading">
        <h2 id="what-title">Now try it with your own photos.</h2>
        <p>Prints Desktop brings the contact sheet to your Mac, Linux or Windows desktop. Star the ideas worth coming back to, turn a brief into an editable draft and keep the original file when you export.</p>
      </div>
      <figure class="workspace">
        <a href={archive} aria-label="Open the native Creative Archive screenshot at full size">
          <img src={archive} width="1440" height="885" alt="Prints Desktop opens on the Higher Than Before cover with the Loftwah Creative Archive contact sheet and original-file actions." loading="lazy" decoding="async" />
        </a>
        <figcaption><strong>Loftwah Creative Archive</strong><span>Native macOS capture · v0.4.0.</span><a class="theme-shot" href="/prints-desktop/archive-light-v0.4.0.webp">See light appearance <ArrowUpRight size={14} aria-hidden="true" /></a></figcaption>
      </figure>
    </section>

    <section class="workflow" aria-labelledby="compare-title">
      <div>
        <h2 id="compare-title">One brief, two layouts.</h2>
        <p><cite>Last Train Home</cite> starts with one idea. A railway ticket folds into a coastline under a signal lamp. The tall layout fills the feed. The wide layout lets the scene stretch out.</p>
        <a class="quiet-link" href={`${routePrefix}/make#brief`}>Read the brief <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="study-pair">
        <figure class="workspace">
          <a href={printsPosterStudy + 'wide.jpg'} aria-label="View the full-size Last Train Home wide image">
            <img src={printsPosterStudy + 'wide.jpg'} width="1200" height="630" alt="Last Train Home. Cream letters beside a folded paper railway ticket shaped like a coast under orange light." loading="lazy" decoding="async" />
          </a>
          <figcaption>Wide edition</figcaption>
        </figure>
        <figure class="workspace">
          <a href={printsPosterStudy + 'feed.jpg'} aria-label="View the full-size Last Train Home portrait poster">
            <img src={printsPosterStudy + 'feed.jpg'} width="1080" height="1350" alt="Last Train Home in cream text above a tiny folded paper coastline on a dark platform." loading="lazy" decoding="async" />
          </a>
          <figcaption>Portrait edition</figcaption>
        </figure>
      </div>
    </section>

    <section class="tour" id="walkthrough" aria-labelledby="walkthrough-title">
      <div class="tour-heading">
        <h2 id="walkthrough-title">From first look to export.</h2>
        <p>Follow the native app from the album cover and release poster to a shortlist, a byte-for-byte export and a brief for your next print.</p>
      </div>
      <PrintsWalkthrough clip={printsWorkshopVideo} />
      <a class="quiet-link" href={`${routePrefix}/watch`}>See all Prints videos <ArrowUpRight size={16} aria-hidden="true" /></a>
    </section>

    <section class="workflows" aria-labelledby="workflows-title">
      <h2 id="workflows-title">Start offline or connect Oyster.</h2>
      <div class="workflow">
        <div>
          <h3>Start with your own files.</h3>
          <p>Drop a batch of JPEG, PNG or WebP images and compare two side by side. Linked originals and favourites reopen after you quit. If a file moves, find it again from the inspector.</p>
          <p>The preview links up to 12 local originals. Afterlight, imports and saved drafts work without an account or model credits.</p>
        </div>
        <figure class="workspace">
          <a href={local} aria-label="Open the local imports screenshot at full size">
            <img src={local} width="1010" height="690" alt="Local imports shows Blue Hour Study, a blue mountain landscape, with eight linked images in the contact sheet." loading="lazy" decoding="async" />
          </a>
          <figcaption><strong>Local imports</strong><span>Example files linked on this device.</span></figcaption>
        </figure>
      </div>
      <div class="workflow">
        <div>
          <h3>Connect a Prints library.</h3>
          <p>Enter your Oyster origin, Prints installation ID and a named read key scoped to that installation. Browse indexed output, inspect prompts and export originals. Folder and model discovery depend on the host.</p>
          <p><strong>Create in web Prints</strong> opens the upstream app for generation. Generation and recovery happen in web Prints. The desktop can remember your read key in your system credential store.</p>
          <a class="quiet-link" href={`${site}/blob/v${version}/docs/oyster.md`}>Read the connection guide <ArrowUpRight size={16} aria-hidden="true" /></a>
        </div>
        <figure class="workspace">
          <a href={hosted} aria-label="Open the example hosted library screenshot at full size">
            <img src={hosted} width="1440" height="880" alt="The connected Prints library previews a ring at dusk alongside folder selection, model details, and an Export original button." loading="lazy" decoding="async" />
          </a>
          <figcaption><strong>Prints library</strong><span>Native capture using a fictional Oyster library.</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="editorial ecosystem" aria-labelledby="ecosystem-title">
      <div>
        <h2 id="ecosystem-title">Who made what?</h2>
        <p>Follow the projects behind the demo, from the local Rust app to the Fungi tools that host and generate prints.</p>
      </div>
      <dl>
        <div>
          <dt>Prints Desktop · <a href="https://github.com/anomalyco/rune">Rune</a></dt>
          <dd>Loftwah’s independent Rust and Rune app. It runs the offline workspace and talks directly to Oyster for supported, authorised reads.</dd>
        </div>
        <div>
          <dt><a href="https://docs.fungi.computer/oyster">Oyster</a> and <a href="https://docs.fungi.computer/apps/prints">Prints</a></dt>
          <dd>Oyster hosts the Fungi app and checks access to the installation and selected Computer. Prints keeps the library index, prompts and media metadata. Original files live on the selected Computer.</dd>
        </div>
        <div>
          <dt><a href="https://docs.fungi.computer/apps/prints#store-generated-images-in-r2-from-a-durable-object">Darkroom</a></dt>
          <dd>Fungi’s generation and recovery layer. When you create through web Prints, the host and model determine availability and charges. A self-hosted Oyster can run Workers AI on your Cloudflare account.</dd>
        </div>
        <div>
          <dt><a href="https://docs.fungi.computer/ecosystem">Fungi</a> and <a href="https://docs.fungi.computer/guides/use-the-terminal">Shiitake</a></dt>
          <dd>Fungi makes the connected creative tools. Shiitake is its terminal coding agent for working in a local project. Browse Afterlight or connect Oyster directly from Prints Desktop.</dd>
        </div>
        <div>
          <dt><a href="https://composer.loftwah.com/projects">App Composer</a></dt>
          <dd>The portfolio showcase, educational resources and optional publishing through Share. Prints Desktop ships from its own repository.</dd>
        </div>
      </dl>
    </section>

    <section class="editorial releases" id="downloads" tabindex="-1" aria-labelledby="downloads-title">
      <div>
        <h2 id="downloads-title">Get Prints Desktop.</h2>
        <p>Choose your v{version} preview. It includes the Loftwah Creative Archive and Afterlight, plus faster Find and safer export and library recovery.</p>
        <p><a class="quiet-link" href={printsOrigin + '/downloads'}>Download statistics <ArrowUpRight size={16} aria-hidden="true" /></a></p>
        <a class="quiet-link" href={`${routePrefix}/guide#install`}>Installation and source build <ArrowUpRight size={16} aria-hidden="true" /></a>
        <a class="quiet-link" href={release}>Release notes, signing status and checksums <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <div>
        <ul class="builds" aria-label="Platform downloads">
          {builds.map(({ label, detail, file }) => (
            <li>
              <a class="build-download" href={downloadUrl(file)}>
                <span><strong>{label}</strong><span>{detail}</span></span>
                <ArrowDownToLine size={20} aria-hidden="true" />
              </a>
              <a class="build-sha" href={downloadUrl(file) + '.sha256'} aria-label={`${label} ${detail} SHA-256 checksum`}>SHA-256</a>
            </li>
          ))}
        </ul>
        <p class="release-note">The Mac preview is ad-hoc signed and unnotarised, so macOS may block it when opened from a web download. The Windows archive is cross-built and its desktop runtime remains unverified. Check the release notes for each platform.</p>
      </div>
    </section>

    <footer class="prints-credit">
      <p>Built by Loftwah with Rust and Anomaly’s Rune. Afterlight is original ImageGen artwork. Oyster, Prints and Darkroom are projects from Fungi.</p>
      <div>
        <a class="quiet-link" href="https://composer.loftwah.com/share?tag=prints-desktop">Explore the Prints collection in Share <ArrowUpRight size={16} aria-hidden="true" /></a>
        <a class="quiet-link" href={`${routePrefix}/story`}>Why we built Prints <ArrowUpRight size={16} aria-hidden="true" /></a>
        <a class="quiet-link" href={`${site}/blob/main/PRODUCT.md`}>Product direction <ArrowUpRight size={16} aria-hidden="true" /></a>
        <a class="quiet-link" href={site}>Source on GitHub <ArrowUpRight size={16} aria-hidden="true" /></a>
        <a class="quiet-link" href="https://github.com/loftwah/app-composer/issues/1292">Follow the build <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
    </footer>
  </article>
</Base>

<style>
  .front-door-share { margin: 0 0 clamp(28px,6vw,70px); padding-block-start: 16px; border-top: 1px solid var(--color-border); }
  .front-door-share h2 { margin: 0 0 8px; }
  .front-door-share ul { display: flex; flex-wrap: wrap; gap: 6px 16px; padding: 0; list-style: none; }
  .front-door-share a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 700; }

  .prints {
    --prints-accent: var(--color-accent);
    --prints-screen: #191919;
    --prints-rule: var(--color-border);
  }

  .prints :is(section, details) { scroll-margin-top: 5rem; }
  .prints .product-link { margin-top: 12px; }
  .native-heading { margin-bottom: 15px; }
  .quiet-link { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; }
  .quiet-link, .ecosystem dt a { color: var(--prints-accent); }
  .quiet-link:hover, .ecosystem dt a:hover { color: var(--color-foreground); }
  .prints :is(a, summary):focus-visible { outline: 2px solid var(--prints-accent); outline-offset: 4px; }

  .prints figure { margin: 0; }
  .workspace > a { display: block; border-radius: 12px; }
  .workspace .theme-shot { display: inline-flex; align-items: center; gap: 5px; color: var(--prints-accent); }
  .workspace img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--prints-rule);
    border-radius: 12px;
    background: var(--prints-screen);
  }

  .prints figcaption { display: flex; flex-wrap: wrap; gap: 2px 13px; margin-top: 9px; color: var(--color-muted); font-size: .88rem; }
  .prints figcaption strong { color: var(--color-foreground); }
  .prints section { margin-top: clamp(45px, 7vw, 92px); }
  .prints h2 { margin: 0 0 12px; font-size: clamp(1.8rem, 4vw, 3.2rem); line-height: 1.08; letter-spacing: -.03em; text-wrap: balance; }
  .prints h3 { margin: 0 0 10px; font-size: clamp(1.32rem, 2.5vw, 2rem); line-height: 1.18; letter-spacing: -.02em; }
  .prints p { margin: 0 0 .8em; color: var(--color-muted); max-width: 69ch; text-wrap: pretty; }
  .study-pair { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: clamp(8px, 2vw, 17px); align-items: start; }
  .editorial, .workflow, .tour-heading { display: grid; grid-template-columns: minmax(0, .74fr) minmax(0, 1.26fr); gap: 14px clamp(25px, 6vw, 76px); align-items: start; }
  .editorial { border-top: 1px solid var(--prints-rule); padding-top: clamp(20px, 4vw, 40px); }
  .tour { border-top: 1px solid var(--prints-rule); padding-top: clamp(20px, 4vw, 40px); }
  .tour-heading { margin-bottom: 15px; }
  .workflows > h2 { margin-bottom: 19px; }
  .workflow { border-top: 1px solid var(--prints-rule); padding-top: clamp(18px, 3vw, 29px); }
  .workflow + .workflow { margin-top: clamp(28px, 4vw, 48px); }
  .ecosystem dl { margin: 0; }
  .ecosystem dl div { display: grid; grid-template-columns: minmax(125px, .52fr) minmax(0, 1.48fr); gap: 7px 14px; padding: 12px 0; border-top: 1px solid var(--prints-rule); }
  .ecosystem dt { font-weight: 650; }
  .ecosystem dd { margin: 0; color: var(--color-muted); }
  .builds { list-style: none; padding: 0; margin: 0 0 12px; }
  .builds li { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 8px; border-top: 1px solid var(--prints-rule); }
  .builds li:last-child { border-bottom: 1px solid var(--prints-rule); }
  .build-download { display: flex; justify-content: space-between; align-items: center; min-height: 60px; gap: 10px; padding: 7px 4px; color: var(--prints-accent); }
  .build-sha { display: inline-flex; min-height: 44px; align-items: center; padding-inline: 6px; color: var(--color-muted); font-size: .78rem; }
  .build-sha:hover { color: var(--color-foreground); }
  .build-download > span { display: flex; align-items: baseline; flex-wrap: wrap; gap: 2px 13px; }
  .build-download span span { color: var(--color-muted); font-size: .9rem; }
  .build-download:hover strong { color: var(--color-foreground); }
  .release-note, .prints-credit { font-size: .9rem; }
  .prints-credit { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: baseline; gap: 6px 21px; margin-top: clamp(28px, 5vw, 56px); padding-top: 17px; border-top: 1px solid var(--prints-rule); }
  .prints-credit div { display: flex; flex-wrap: wrap; gap: 4px 17px; }

  @media (max-width: 760px) {
    .editorial, .workflow, .tour-heading { grid-template-columns: minmax(0, 1fr); }
    .ecosystem dl div { grid-template-columns: minmax(0, 1fr); }
    .tour-heading { gap: 0; }
  }

</style>
