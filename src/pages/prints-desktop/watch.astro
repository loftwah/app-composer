---
import Base from '../../layouts/Base.astro';
import PrintsWalkthrough from '../../components/PrintsWalkthrough.astro';
import { isPrintsHost, printsOrigin, printsShare, printsShareAlt } from '../../lib/prints-site.mjs';
import { printsAfterlightVideo, printsArchiveVideo, printsCurrentShort, printsCurrentVideo, printsWorkshopVideo } from '../../lib/prints-video.mjs';
import { ArrowLeft } from '@lucide/astro';

const canonical = printsOrigin + '/watch';
const product = isPrintsHost(Astro.url);
const home = product ? '/' : '/prints-desktop';
const { title, description } = printsCurrentVideo;
const videos = {
  '@context': 'https://schema.org',
  '@graph': [printsCurrentVideo, printsCurrentShort, printsArchiveVideo, printsWorkshopVideo].map((clip) => ({
    '@type': 'VideoObject',
    name: clip.title,
    description: clip.description,
    thumbnailUrl: [new URL(clip.poster, canonical).href],
    contentUrl: new URL(clip.src, canonical).href,
    url: canonical,
    uploadDate: clip.uploadDate,
    duration: `PT${clip.duration}S`,
    inLanguage: 'en',
  })),
};
---

<Base title={title} description={description} canonical={canonical} printsProduct={product} shareImage={printsShare} shareAlt={printsShareAlt}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(videos)} />
  <article class="watch">
    <a class="back" href={home}><ArrowLeft size={18} aria-hidden="true" /> Prints Desktop</a>
    <h1>{title}.</h1>
    <p>{description}</p>
    <PrintsWalkthrough clip={printsCurrentVideo} eager />
    <p><a href="https://github.com/loftwah/prints-desktop/releases/tag/v0.6.1">Exact Mac release and source</a></p>
    <section aria-labelledby="short-release-art">
      <h2 id="short-release-art">{printsCurrentShort.title}</h2>
      <PrintsWalkthrough clip={printsCurrentShort} />
    </section>
    <section aria-labelledby="reproduce-current">
      <h2 id="reproduce-current">Try the same decision</h2>
      <ol>
        <li>Open the Creative Archive and choose <strong>Compare formats</strong> on Higher Than Before. Use <strong>100%</strong> for the mark and <strong>Fit</strong> for both compositions.</li>
        <li>Keep both images in the draft and write why each has a place. To follow the agent version, <a href={home === '/' ? '/guide#agent' : '/prints-desktop/guide#agent'}>open the local agent quickstart</a>.</li>
        <li>Quit, reopen the draft and export the release poster. Compare its bytes with the <a href="https://github.com/loftwah/prints-desktop/blob/v0.6.1/assets/archive/higher-than-before-poster.jpg">bundled original</a>.</li>
      </ol>
      <p>To make new artwork, choose <strong>Create in web Prints</strong>. The <a href="https://composer.loftwah.com/articles/workers-ai-to-original">Workers AI field note</a> follows a real request, retained print and exact Mac export. The native walkthrough above uses published LoftwahFM originals and needs no key or generation.</p>
      <p><a href="https://github.com/loftwah/app-composer/issues/997#issuecomment-7162591975">Earlier owner-authorised Workers AI run</a></p>
    </section>
    <section aria-labelledby="archive-preview">
      <h2 id="archive-preview">{printsArchiveVideo.title}</h2>
      <PrintsWalkthrough clip={printsArchiveVideo} />
      <a class="back" href="/prints-desktop/archive-vertical-v0.4.0.mp4" download>Download the v0.4.0 vertical cut</a>
    </section>
    <section aria-labelledby="archive-workshop">
      <h2 id="archive-workshop">{printsWorkshopVideo.title}.</h2>
      <p>{printsWorkshopVideo.description}</p>
      <PrintsWalkthrough clip={printsWorkshopVideo} />
    </section>
    <section aria-labelledby="connected-replay">
      <h2 id="connected-replay">{printsAfterlightVideo.title}.</h2>
      <p>{printsAfterlightVideo.description}</p>
      <PrintsWalkthrough clip={printsAfterlightVideo} />
    </section>
    <p><a class="back" href={`${home}#downloads`}>Get the desktop preview</a></p>
  </article>
</Base>

<style>
  .watch { max-width: 960px; margin-inline: auto; }
  .watch section { margin-block: clamp(35px, 6vw, 75px) 14px; }
  .watch h2 { margin-bottom: 6px; }
  .watch h1 { font-size: clamp(2rem, 5vw, 4rem); max-width: none; margin: 7px 0 18px; }
  .back { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--color-accent); }
  .back:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
</style>
