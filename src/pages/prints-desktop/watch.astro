---
import Base from '../../layouts/Base.astro';
import PrintsWalkthrough from '../../components/PrintsWalkthrough.astro';
import { ArrowLeft } from '@lucide/astro';

const canonical = 'https://composer.loftwah.com/prints-desktop/watch';
const title = 'Watch Prints Desktop in 28 Seconds';
const description = 'Watch Prints Desktop browse Afterlight, export an original, save an editable prompt and open a fictional Oyster library.';
const shareImage = '/prints-desktop/which-print-og-20261125.jpg';
const video = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description,
  thumbnailUrl: [new URL('/prints-desktop/afterlight-native-v0.3.1.webp', canonical).href],
  contentUrl: new URL('/prints-desktop/prints-desktop-walkthrough-v0.3.1.mp4', canonical).href,
  url: canonical,
  uploadDate: '2026-11-25',
  duration: 'PT28S',
  inLanguage: 'en',
};
---

<Base title={title} description={description} canonical={canonical} shareImage={shareImage} shareAlt="Which print gets the wall? An Afterlight contact sheet from Prints Desktop.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(video)} />
  <article class="watch">
    <a class="back" href="/prints-desktop"><ArrowLeft size={18} aria-hidden="true" /> Prints Desktop</a>
    <h1>Prints Desktop in 28 seconds.</h1>
    <PrintsWalkthrough eager />
    <p><a class="back" href="/prints-desktop#downloads">Get the desktop preview</a></p>
  </article>
</Base>

<style>
  .watch { max-width: 960px; margin-inline: auto; }
  .watch h1 { font-size: clamp(2rem, 5vw, 4rem); max-width: none; margin: 7px 0 18px; }
  .back { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--color-accent); }
  .back:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
</style>
