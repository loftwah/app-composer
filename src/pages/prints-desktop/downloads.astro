---
import { env } from 'cloudflare:workers';
import type { D1Database } from '@cloudflare/workers-types';
import { ArrowUpRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import PrintsDownloadShare from '../../components/PrintsDownloadShare.astro';
import { isPrintsHost, printsOrigin } from '../../lib/prints-site.mjs';
import { builds } from '../../lib/prints-downloads.mjs';
import { printsReleases, readFieldKitDownloads, readPrintsPackages } from '../../lib/prints-download-report';

const runtime = env as unknown as { DB: D1Database; WOODHOUSE_GITHUB_TOKEN?: string };
const [releases, kit] = await Promise.all([readPrintsPackages(runtime.WOODHOUSE_GITHUB_TOKEN), readFieldKitDownloads(runtime.DB)]);
const latest = releases?.[0];
const canonical = printsOrigin + '/downloads';
const format = new Intl.NumberFormat('en-AU');
const display = (count: number | null) => count === null ? '—' : format.format(count);
---

<Base title="Download statistics" description="Prints Desktop package downloads by release and platform, plus workshop kit ZIP activity." canonical={canonical} printsProduct={isPrintsHost(Astro.url)}
  shareImage="/prints-desktop/loftwah-archive-og-20261125.jpg" shareAlt="Prints. The Creative Archive. A selection of album covers, arcade posters and artwork from the offline library.">
  <article class="stats">
    <header>
      <h1>Download statistics</h1>
      <p>See which Prints Desktop builds people fetch and how often the workshop kit is served.</p>
      <p><a href="#share-downloads">Get the launch snapshot <ArrowUpRight size={15} aria-hidden="true" /></a></p>
    </header>

    <div class="totals">
      <section aria-labelledby="package-count">
        <h2 id="package-count">Desktop packages</h2>
        {latest ? <><strong>{display(latest.total)}</strong><p>{latest.tag} · All-time GitHub downloads</p></> : <p>GitHub counts are temporarily unavailable.</p>}
      </section>
      <section aria-labelledby="field-kit-count">
        <h2 id="field-kit-count">Workshop kit</h2>
        {kit ? <><strong>{display(kit.total)}{kit.capped ? '+' : ''}</strong><p>ZIP responses · Last 7 days including today, UTC</p></> : <p>ZIP counts are temporarily unavailable.</p>}
      </section>
    </div>

    <PrintsDownloadShare />

    <section aria-labelledby="by-release">
      <h2 id="by-release">Downloads by release</h2>
      {releases?.length ? (
        <div class="table-scroll" role="region" aria-label="Scrollable release counts" tabindex="0">
          <table>
            <thead><tr><th scope="col">Release</th>{builds.map(({ label, detail }) => <th scope="col">{label}<br /><span>{detail.split(' · ')[0]}</span></th>)}<th scope="col">Total</th></tr></thead>
            <tbody>{releases.map(({ tag, packages, total }) => <tr>
              <th scope="row"><a href={`${printsReleases}/tag/${tag}`}>{tag}</a></th>
              {builds.map(({ key }) => <td>{display(packages[key])}</td>)}
              <td>{display(total)}</td>
            </tr>)}</tbody>
          </table>
        </div>
      ) : <p>Release totals could not be loaded. <a href={printsReleases}>Open the GitHub releases</a>.</p>}
      <p class="notes">GitHub counts repeat downloads. The table covers up to 20 recent releases and excludes source archives and checksum files. A dash means the package count is unavailable for that release.</p>
    </section>

    <section aria-labelledby="install-count">
      <h2 id="install-count">Installs and first opens</h2>
      <p>The desktop app ships as a portable archive and can open offline. Prints Desktop sends no install or first-open event, so those counts are unavailable.</p>
      <p class="notes">The web kit counter stores daily totals for full ZIP responses. It excludes partial requests, identified prefetches and verification probes. Browsers and bots can make repeat requests, and a response doesn’t guarantee a completed transfer.</p>
      <p><a href={printsOrigin + '/#downloads'}>Get Prints Desktop <ArrowUpRight size={15} aria-hidden="true" /></a> <a href={printsOrigin + '/workshop-kit'}>Open the workshop kit <ArrowUpRight size={15} aria-hidden="true" /></a></p>
    </section>
  </article>
</Base>

<style>
  .stats { max-width: 920px; margin-inline: auto; }
  .stats h1 { font-size: clamp(2rem, 7vw, 4rem); line-height: 1.05; margin: 0 0 12px; }
  .stats h2 { font-size: clamp(1.25rem, 4vw, 1.7rem); line-height: 1.2; margin: 0 0 12px; }
  .stats p { max-width: 68ch; }
  .stats > section { margin-block-start: 30px; }
  .totals { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr)); gap: 12px; margin-top: 24px; }
  .totals section { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; padding: 16px; }
  .totals strong { display: block; font-size: 2.5rem; line-height: 1; }
  .totals p { margin-bottom: 0; }
  .table-scroll { max-width: 100%; overflow-x: auto; }
  .table-scroll:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .stats table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  .stats :is(th,td) { border-bottom: 1px solid var(--color-border); text-align: right; padding: 8px 10px; }
  .stats th:first-child { text-align: left; }
  .stats th span, .notes { color: var(--color-muted); font-size: .9rem; }
  .stats p a { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; margin-right: 8px; }
</style>
