---
import { getEmDashCollection } from "emdash";
import modelInput from "../content-model.json";
import branding from "../launch-kit-branding.json";
const siteTitle=branding.title??modelInput.label;
import { validateContentModel } from "../lib/content-model.mjs";
const model = validateContentModel(modelInput);
import ContentLayout from "../layouts/ContentLayout.astro";
import ContentFields from "../components/ContentFields.astro";
import { entryTitle, entryPath } from "../lib/entry.mjs";
import CollectionPages from "../components/CollectionPages.astro";
import { collectionRequest, collectionAddress } from "../lib/collection.mjs";
const { field, page, value, valid, where } = collectionRequest(
  model,
  Astro.url.searchParams,
);
const perPage = 20;
const { entries, error, hasMore } = !valid
  ? { entries: [], error: undefined, hasMore: false }
  : await getEmDashCollection(model.collection, {
      status: "published",
      where,
      limit: perPage,
      offset: (page! - 1) * perPage,
      orderBy: { published_at: "desc" },
    });
const missing = valid && page! > 1 && !error && !entries.length;
if (!valid) Astro.response.status = 400;
else if (error) Astro.response.status = 503;
else if (missing) Astro.response.status = 404;
const paginated =
  valid && !missing && !error && entries.length > 0 && (page! > 1 || hasMore);
---

<ContentLayout
  title={
    !valid || missing
      ? "Page not found · " + siteTitle
      : siteTitle +
        (value ? " · " + value : "") +
        (page! > 1 ? " · Page " + page : "")
  }
>
  <h1>{model.label}</h1>
  {field && (
    <form
      class="collection-filter"
      method="get"
      action="/#content"
      aria-label="Filter entries"
    >
      <div>
        <label for="collection-filter">{field.label}</label>
        <div class="filter-select">
          <select id="collection-filter" name="filter">
            <option value="">All entries</option>
            {field.choices!.map((choice) => (
              <option value={choice} selected={valid && choice === value}>
                {choice}
              </option>
            ))}
          </select>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </div>
      </div>
      <button type="submit">Filter entries</button>
      {valid && value && <a href="/#content">Clear filter</a>}
    </form>
  )}
  {valid && value && !error && !missing && (
    <p class="filter-context">
      Showing entries with {field!.label.toLowerCase()}:{" "}
      <strong>{value}</strong>.
    </p>
  )}
  {paginated && (
    <CollectionPages
      page={page!}
      filter={value}
      hasMore={hasMore === true}
      start={(page! - 1) * perPage + 1}
      end={(page! - 1) * perPage + entries.length}
    />
  )}
  {!valid || missing ? (
    <section class="empty">
      <h2>This page is unavailable.</h2>
      <p>
        {!valid
          ? "Choose a listed filter and a valid page, or return to all entries."
          : "The address may be incorrect, or its entries may have moved after publication changed."}
      </p>
      <a
        class="button"
        href={valid ? collectionAddress(1, value) : "/#content"}
      >
        Back to the first page
      </a>
      {valid && value && (
        <p>
          <a href="/#content">Show all entries</a>
        </p>
      )}
    </section>
  ) : error ? (
    <p role="alert">
      Content is temporarily unavailable. Your agent can inspect the local
      database and collection setup.
    </p>
  ) : entries.length ? (
    <div class="entries">
      {entries.map((entry) => (
        <article>
          <h2>
            {entryPath(entry.data.id) ? (
              <a href={entryPath(entry.data.id)!}>
                {entryTitle(model, entry.data)}
              </a>
            ) : (
              entryTitle(model, entry.data)
            )}
          </h2>
          <ContentFields values={entry.data} />
        </article>
      ))}
    </div>
  ) : value ? (
    <section class="empty">
      <h2>No published entries match this filter.</h2>
      <p>Try another choice or browse the full collection.</p>
      <a class="button" href="/#content">
        Show all entries
      </a>
    </section>
  ) : (
    <section class="empty">
      <h2>Your collection is ready for its first entry.</h2>
      <p>
        Add an entry in EmDash, keep it as a draft while you work, then publish
        when you are ready for it to appear here.
      </p>
      <a class="button" href="/_emdash/admin">
        Open EmDash
      </a>
    </section>
  )}
  {paginated && (
    <CollectionPages
      page={page!}
      filter={value}
      hasMore={hasMore === true}
      start={(page! - 1) * perPage + 1}
      end={(page! - 1) * perPage + entries.length}
    />
  )}
</ContentLayout>
