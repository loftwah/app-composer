---
import {getEmDashCollection} from 'emdash';
import model from '../content-model.json';
import ContentLayout from '../layouts/ContentLayout.astro';
import ContentFields from '../components/ContentFields.astro';
import {entryTitle,entryPath} from '../lib/entry.mjs';
import CollectionPages from '../components/CollectionPages.astro';
const selected=Astro.url.searchParams.getAll('page');
const page=selected.length===0?1:selected.length===1&&/^[1-9][0-9]{0,4}$/.test(selected[0])?Number(selected[0]):null;
const perPage=20;
const {entries,error,hasMore}=page===null?{entries:[],error:undefined,hasMore:false}:await getEmDashCollection(model.collection,{status:'published',limit:perPage,offset:(page-1)*perPage,orderBy:{published_at:'desc'}});
const missing=page!==null&&page>1&&!error&&!entries.length;
if(page===null)Astro.response.status=400;
else if(error)Astro.response.status=503;
else if(missing)Astro.response.status=404;
const paginated=page!==null&&!missing&&!error&&entries.length>0&&(page>1||hasMore);
---
<ContentLayout title={page===null||missing?'Page not found · '+model.label:model.label+(page>1?' · Page '+page:'')}>
<h1>{model.label}</h1>
{paginated&&<CollectionPages page={page!} hasMore={hasMore===true} start={(page!-1)*perPage+1} end={(page!-1)*perPage+entries.length}/>}
{page===null||missing?<section class="empty"><h2>This page is unavailable.</h2><p>The address may be incorrect, or its entries may have moved after publication changed.</p><a class="button" href="/#content">Back to the first page</a></section>:error?<p role="alert">Content is temporarily unavailable. Your agent can inspect the local database and collection setup.</p>:entries.length?<div class="entries">{entries.map(entry=><article><h2>{entryPath(entry.data.id)?<a href={entryPath(entry.data.id)!}>{entryTitle(model,entry.data)}</a>:entryTitle(model,entry.data)}</h2><ContentFields values={entry.data}/></article>)}</div>:<section class="empty"><h2>Your collection is ready for its first entry.</h2><p>Add an entry in EmDash, keep it as a draft while you work, then publish when you are ready for it to appear here.</p><a class="button" href="/_emdash/admin">Open EmDash</a></section>}
{paginated&&<CollectionPages page={page!} hasMore={hasMore===true} start={(page!-1)*perPage+1} end={(page!-1)*perPage+entries.length}/>}

</ContentLayout>
