---
import ScalarValue from './ScalarValue.astro';
interface Props {field:any;value:any}
const {field,value}=Astro.props;
---
{field.type==='repeater'&&Array.isArray(value)?<ol class="rows">{value.map(row=><li><dl>{field.fields.map((sub:any)=><div><dt>{sub.label}</dt><dd><ScalarValue field={sub} value={row?.[sub.key]}/></dd></div>)}</dl></li>)}</ol>:<ScalarValue field={field} value={value}/>}
