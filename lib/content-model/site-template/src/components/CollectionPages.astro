---
interface Props {page:number;hasMore:boolean;start:number;end:number}
const {page,hasMore,start,end}=Astro.props;
const address=(value:number)=>(value===1?'/':'/?page='+value)+'#content';
---
<nav class="collection-pages" aria-label="Collection pages">
 <p><span aria-current="page">Page {page}</span><span class="page-range">Entries {start}–{end}</span></p>
 <div>
  {page>1&&<a class="button" href={address(page-1)} rel="prev">Previous page</a>}
  {hasMore&&<a class="button" href={address(page+1)} rel="next">Next page</a>}
 </div>
</nav>
