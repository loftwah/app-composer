{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "declaration": true
  },
  "include": ["src/lib/*.mts"],
  "exclude": ["src/lib/*.d.mts"]
}
