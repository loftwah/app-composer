{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"composer-content-local",
 "main":"src/worker.ts",
 "compatibility_date":"2026-10-13",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":false,"preview_urls":false,
 "assets":{"directory":"dist/client","binding":"ASSETS"},
 "d1_databases":[{"binding":"DB","database_name":"composer-content-local","database_id":"00000000-0000-0000-0000-000000000000"}],
 "r2_buckets":[{"binding":"MEDIA","bucket_name":"composer-content-local-media"}],
 "triggers":{"crons":["* * * * *"]}
}
