          "model": "briefs/v1",
          "owner": "/api/resources/:resource/enquiries",
          "public": "/r/:resource/c/:configuration/enquiry",
          "default": "closed",
          "retentionDays": 30,
          "receiptDays": 35,
          "notifications": false
        },
        "guestInvitation": {
          "version": 1,
          "kind": "postcard",
          "route": "/r/:resource/api/invitation",
          "states": [
