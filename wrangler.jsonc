{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-composer",
  "account_id": "1003dc1d93af0ebea56b2f1252f89627",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "composer.loftwah.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-composer-emdash",
      "database_id": "1b2b29c8-4109-4a5f-901a-befc91173bc5",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://composer.loftwah.com",
    "CF_ACCESS_TEAM_DOMAIN": "jolly-cake-2b85.cloudflareaccess.com",
    "RESOURCE_ACCOUNT_ID": "1003dc1d93af0ebea56b2f1252f89627",
    "RESOURCE_ENVIRONMENT": "production"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "app-composer-media"
    }
  ],
  "services": [
    {
      "binding": "GUESTBOOK",
      "service": "composer-guestbook-c4d0f590a7dd9892"
    },
    {
      "binding": "SHOWCASE",
      "service": "composer-showcase-c4d0f590a7dd9892"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "env": {
    "preview": {
      "name": "app-composer-preview",
      "routes": [],
      "vars": {
        "PUBLIC_ORIGIN": "https://app-composer-preview.loftwah.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "app-composer-emdash-preview",
          "database_id": "bdbbe1c4-e1ff-43d3-a89d-d7dd76d13c0a",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "app-composer-media-preview"
        }
      ],
      "services": [],
      "triggers": {
        "crons": []
      },
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "2e7ac1e5417f4425be41d60d99a35de1"
        }
      ],
      "ratelimits": []
    }
  },
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "3a76800194064e498949fd7c251af7e3"
    }
  ],
  "limits": {
    "cpu_ms": 1000
  },
  "ratelimits": [
    {
      "name": "USAGE_LIMIT",
      "namespace_id": "2026101462",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
