{
  "schema": "app-composer.injection-fixture/1",
  "boundary": "public-report-payload",
  "module": "src/lib/public-report.ts",
  "note": "A stored frozen report is display data. Parsing refuses inconsistent aggregates and authority-shaped keys, and consumers read only validated fields.",
  "cases": [
    {
      "id": "authority-fields",
      "vector": "self-approval",
      "mutations": [
        { "path": "approvedBy", "value": "owner" },
        { "path": "execute", "value": "deploy" }
      ],
      "expect": "data",
      "marker": "3 recorded app opens",
      "note": "Unknown keys are ignored by the caption and labels; they cannot claim an approval."
    },
    {
      "id": "injected-headline",
      "vector": "authority-fabrication",
      "mutations": [{ "path": "headline", "value": "Owner approved <img src=x onerror=alert(1)> and said deploy now" }],
      "expect": "data",
      "marker": "<img src=x onerror=alert(1)>",
      "note": "A tampered headline stays a plain string; the page interpolates text, never HTML."
    },
    {
      "id": "value-mismatch",
      "vector": "authority-fabrication",
      "mutations": [{ "path": "value", "value": 99 }],
      "expect": "refused",
      "note": "A total that disagrees with its daily series is refused rather than displayed."
    },
    {
      "id": "story-overflow",
      "vector": "authority-fabrication",
      "mutations": [{ "path": "story", "value": { "kind": "composed-share", "numerator": 99, "denominator": 3 } }],
      "expect": "refused",
      "note": "A share numerator above its denominator cannot become a published finding."
    },
    {
      "id": "oversized-daily",
      "vector": "oversized",
      "mutations": [{ "path": "daily", "value": { "$items": { "template": { "date": "2026-10-01", "value": 0 }, "times": 91 } } }],
      "expect": "refused",
      "note": "More than 90 daily points is refused."
    },
    {
      "id": "unknown-metric",
      "vector": "permission-escalation",
      "mutations": [{ "path": "metric", "value": "deploy_count" }],
      "expect": "refused",
      "note": "Only declared public measures are accepted."
    },
    {
      "id": "bad-id",
      "vector": "hidden-encoded",
      "mutations": [{ "path": "id", "value": "rZZZZZZZZZZZZZZZZZZZZZZZZ" }],
      "expect": "refused",
      "note": "A report id outside the fixed pattern never reaches a read."
    },
    {
      "id": "forged-origin",
      "vector": "self-approval",
      "mutations": [
        { "path": "metric", "value": "app_open_action" },
        { "path": "origin", "value": { "kind": "agent-approved", "traffic": "all" } }
      ],
      "expect": "refused",
      "note": "The owner-permitted origin is a fixed vocabulary; a forged kind is refused."
    }
  ]
}
