{
  "name": "app-composer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "node scripts/package-downloads.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/identity.mjs && node scripts/package-downloads.mjs && astro build",
    "check": "pnpm check:types && pnpm test",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "ready": "node scripts/ready.mjs",
    "compose": "node scripts/compose.mjs",
    "compose:promote": "node scripts/promote.mjs",
    "check:types": "node scripts/identity.mjs && node scripts/package-downloads.mjs && astro check",
    "test:core": "node --test tests/core.test.mjs",
    "test:ready": "node --test tests/readiness-state.test.mjs tests/readiness-recovery.test.mjs tests/readiness-tools.test.mjs tests/readiness-report.test.mjs tests/readiness-storage.test.mjs tests/readiness-workspace-tools.test.mjs tests/readiness-engine.test.mjs tests/readiness-wrangler-auth.test.mjs tests/readiness-clone.test.mjs tests/readiness-ownership.test.mjs tests/readiness-owned-tools.test.mjs tests/readiness-target.test.mjs tests/readiness-owned-deploy.test.mjs tests/readiness-owned-init.test.mjs tests/readiness-maintained-release.test.mjs",
    "test:access": "node --test tests/access-boundary.test.mjs",
    "test:email": "node --test tests/resend-delivery.test.mjs",
    "test:release": "node --test tests/verify-live.test.mjs",
    "test:reports": "node --test tests/inspection-report.test.mjs",
    "init:hello": "node scripts/init-hello.mjs",
    "ready:mcp": "node scripts/get-ready-mcp.mjs",
    "test:mcp": "node --test tests/readiness-mcp.test.mjs",
    "test:models": "node --test tests/content-model.test.mjs tests/content-patterns.test.mjs tests/content-calendar.test.mjs",
    "ready:pack": "node scripts/package-downloads.mjs",
    "test:package": "node --test tests/readiness-package.test.mjs",
    "test:domain": "node --test tests/readiness-domain.test.mjs",
    "audit": "pnpm audit --audit-level low",
    "init:site": "node scripts/init-site.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/react": "7.0.0",
    "@emdash-cms/cloudflare": "1.2.0",
    "@lucide/astro": "1.56.0",
    "astro": "7.3.5",
    "emdash": "1.2.0",
    "jose": "6.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260929.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.143.1",
    "zod": "4.6.7"
  }
}
