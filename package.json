{
  "name": "app-composer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/identity.mjs && astro build",
    "check": "pnpm check:types && pnpm test",
    "test": "node --test tests/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "ready": "node scripts/ready.mjs",
    "compose": "node scripts/compose.mjs",
    "compose:promote": "node scripts/promote.mjs",
    "check:types": "node scripts/identity.mjs && astro check",
    "test:core": "node --test tests/core.test.mjs",
    "test:ready": "node --test tests/readiness-state.test.mjs tests/readiness-recovery.test.mjs tests/readiness-engine.test.mjs tests/readiness-clone.test.mjs tests/readiness-ownership.test.mjs tests/readiness-owned-tools.test.mjs",
    "test:access": "node --test tests/access-boundary.test.mjs",
    "test:email": "node --test tests/resend-delivery.test.mjs",
    "test:release": "node --test tests/verify-live.test.mjs",
    "test:reports": "node --test tests/inspection-report.test.mjs",
    "init:hello": "node scripts/init-hello.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/react": "7.0.0",
    "@emdash-cms/cloudflare": "1.2.0",
    "@lucide/astro": "1.56.0",
    "astro": "7.3.5",
    "emdash": "1.2.0",
    "jose": "6.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260929.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.143.1"
  }
}
