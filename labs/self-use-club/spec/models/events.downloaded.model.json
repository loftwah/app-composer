{
  "schema": "app-composer.content-model",
  "version": 1,
  "collection": "events",
  "label": "Club events",
  "groups": [
    "The event",
    "Practical details"
  ],
  "fields": [
    {
      "key": "title",
      "label": "Event name",
      "type": "string",
      "required": true,
      "group": "The event",
      "validation": {
        "maxLength": 90
      }
    },
    {
      "key": "summary",
      "label": "One-line summary",
      "type": "text",
      "required": true,
      "group": "The event",
      "validation": {
        "maxLength": 200
      }
    },
    {
      "key": "description",
      "label": "What happens",
      "type": "text",
      "required": true,
      "group": "The event",
      "validation": {
        "maxLength": 2000
      }
    },
    {
      "key": "event_date",
      "label": "Event day",
      "type": "date",
      "required": true,
      "group": "Practical details"
    },
    {
      "key": "start_note",
      "label": "Start time",
      "type": "string",
      "required": true,
      "group": "Practical details",
      "validation": {
        "maxLength": 60
      },
      "defaultValue": "7:00 am for a 7:30 am start"
    },
    {
      "key": "location",
      "label": "Meeting place",
      "type": "string",
      "required": true,
      "group": "Practical details",
      "validation": {
        "maxLength": 120
      }
    },
    {
      "key": "cost",
      "label": "Cost or what to bring",
      "type": "string",
      "required": false,
      "group": "Practical details",
      "validation": {
        "maxLength": 120
      }
    },
    {
      "key": "publication",
      "label": "Publication",
      "type": "select",
      "required": true,
      "group": "Practical details",
      "choices": [
        "Draft",
        "Published"
      ],
      "defaultValue": "Draft"
    }
  ]
}