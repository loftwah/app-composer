{
  "schema": "app-composer.content-model",
  "version": 1,
  "collection": "notices",
  "label": "Club notices",
  "groups": [
    "The notice"
  ],
  "fields": [
    {
      "key": "title",
      "label": "Notice heading",
      "type": "string",
      "required": true,
      "group": "The notice",
      "validation": {
        "maxLength": 90
      }
    },
    {
      "key": "body",
      "label": "Notice text",
      "type": "text",
      "required": true,
      "group": "The notice",
      "validation": {
        "maxLength": 900
      }
    },
    {
      "key": "notice_date",
      "label": "Notice date",
      "type": "date",
      "required": true,
      "group": "The notice"
    },
    {
      "key": "publication",
      "label": "Publication",
      "type": "select",
      "required": true,
      "group": "The notice",
      "choices": [
        "Draft",
        "Published"
      ],
      "defaultValue": "Draft"
    }
  ]
}