---
import { getEmDashEntry, getEmDashCollection, getSection } from "emdash";
import { Image, PortableText } from "emdash/ui";
import { Comments } from "emdash/ui/comments";
import { ownedImage } from "../lib/owned-image.mjs";
import Layout from "../layouts/ContentLayout.astro";
import routes from "../old-routes.json";
import type { ComponentProps } from "astro/types";
type Article = {
  id?: string;
  title?: string;
  slug?: string;
  excerpt?: string;
  featured_image?: ComponentProps<typeof Image>["image"];
  content?: unknown[];
  byline?: unknown;
  terms?: unknown;
  shared_note?: unknown;
  show_latest?: unknown;
};
import "../styles/publisher.css";
const path = "/" + (Astro.params.path ?? "").replace(/^\/+|\/+$/g, "") + "/";
const old = routes.find((route) => route.path === path);
const fresh = /^\/(stories|blog|posts|pages)\/([a-z0-9-]{1,200})\/$/.exec(path);
const pageSlug = /^\/([a-z0-9-]{1,200})\/$/.exec(path);
const collection =
  old?.collection ??
  (fresh
    ? fresh[1] === "pages"
      ? "pages"
      : "posts"
    : pageSlug
      ? "pages"
      : null);
const slug = old?.slug ?? fresh?.[2] ?? pageSlug?.[1];
const { entry, error } =
  collection && slug
    ? await getEmDashEntry<string, Article>(collection, slug)
    : { entry: undefined, error: undefined };
const record = (v: unknown): v is Record<string, unknown> =>
  !!v && typeof v === "object" && !Array.isArray(v);
const text = (v: unknown) => (typeof v === "string" ? v : "");
const media = await ownedImage(entry?.data.featured_image);
const title = entry ? text(entry.data.title) : "This story is unavailable.";
const byline =
  entry && record(entry.data.byline)
    ? text(entry.data.byline.displayName) ||
      text(entry.data.byline.display_name) ||
      text(entry.data.byline.name)
    : "";
const sharedSlug = collection === "posts" ? entry?.data.shared_note : undefined;
const sharedRequested =
  sharedSlug !== undefined && sharedSlug !== null && sharedSlug !== "";
let sharedNote: Awaited<ReturnType<typeof getSection>> = null;
let featureError = false;
if (sharedRequested) {
  if (typeof sharedSlug !== "string" || !/^[a-z0-9-]{1,100}$/.test(sharedSlug))
    featureError = true;
  else {
    try {
      sharedNote = await getSection(sharedSlug);
      featureError = !sharedNote;
    } catch {
      featureError = true;
    }
  }
}
const showLatest = collection === "posts" ? entry?.data.show_latest : undefined;
if (
  showLatest !== undefined &&
  showLatest !== null &&
  typeof showLatest !== "boolean"
)
  featureError = true;
const latest =
  showLatest === true
    ? await getEmDashCollection<"posts", Article>("posts", {
        status: "published",
        limit: 6,
        orderBy: { published_at: "desc" },
      })
    : { entries: [], error: undefined };
featureError ||= !!latest.error;
const latestStories = latest.entries
  .flatMap((item) => {
    const slug = text(item.data.slug);
    const title = text(item.data.title);
    if (
      slug === text(entry?.data.slug) ||
      !/^[a-z0-9-]{1,200}$/.test(slug) ||
      !title
    )
      return [];
    const href =
      routes.find(
        (route) =>
          route.collection === "posts" &&
          route.slug === slug &&
          !route.query &&
          route.path !== "/",
      )?.path ?? "/stories/" + encodeURIComponent(slug) + "/";
    return [{ title, href }];
  })
  .slice(0, 5);
if (error) Astro.response.status = 503;
else if (!entry) Astro.response.status = 404;
else if (featureError) Astro.response.status = 503;
Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout
  title={title + " · Macedon Weekender"}
  description={
    entry
      ? text(entry.data.excerpt)
      : "Browse the latest published Weekender stories."
  }
  article={!!entry}
>
  <article class="publisher publisher-detail">
    <a href="/">Back to the latest stories</a>
    <h1>{title}</h1>
    {error ? (
      <p role="alert">
        The story is temporarily unavailable. Try again after the local owner
        checks its EmDash storage.
      </p>
    ) : entry ? (
      <>
        {byline && <p class="publisher-byline">By {byline}</p>}
        {media.image && (
          <figure>
            <Image image={media.image} priority />
            {media.caption && <figcaption>{media.caption}</figcaption>}
          </figure>
        )}
        <div class="publisher-prose">
          <PortableText
            value={Array.isArray(entry.data.content) ? entry.data.content : []}
          />
        </div>
        {sharedNote && (
          <aside
            class="publisher-shared publisher-prose"
            aria-label={sharedNote.title}
          >
            <PortableText value={sharedNote.content} />
          </aside>
        )}
        {latestStories.length > 0 && (
          <section
            class="publisher-latest"
            aria-labelledby="latest-stories-title"
          >
            <h2 id="latest-stories-title">The latest from the Weekender</h2>
            <ul>
              {latestStories.map((story) => (
                <li>
                  <a href={story.href}>{story.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
        {featureError && (
          <p role="alert">
            Part of this story is temporarily unavailable. Try again later.
          </p>
        )}
        {collection === "posts" && typeof entry.data.id === "string" && (
          <Comments collection="posts" contentId={entry.data.id} threaded />
        )}
      </>
    ) : (
      <p>
        This address does not name a currently published story. Draft and
        private work remains with the editor.
      </p>
    )}
    <p class="publisher-credit">
      Macedon Weekender is a fictional publishing demonstration, built with{" "}
      <a href="https://composer.loftwah.com/">App Composer</a>.
    </p>
  </article>
</Layout>
