direction: right
style.fill: "#17181b"
*.style: { font-size: 20; bold: false; fill: "#23252a"; stroke: "#747a85"; font-color: "#f2f3f5"; border-radius: 6 }
(* -> *)[*].style: { stroke: "#fc5b05"; stroke-width: 2; font-color: "#f2f3f5"; font-size: 16 }
grid-rows: 3
grid-columns: 3
horizontal-gap: 70
vertical-gap: 70
visitor: Visitor\nopens the profile
form: Guestbook form\nonly while open
pending: Pending\nprivate item + media
review: Owner review\napprove · reject · hide
approved: Approved\npublic in Guestbook
featured: Featured in Linkarooie\nseparate explicit choice
profile: Profile card\nlinks to the source
visitor -> form: Leave a note
form -> pending: submit
pending -> review: private
review -> approved: approve
approved -> featured: feature
featured -> profile: render
review -> pending: hide / reject
pending -> profile: next render removes
