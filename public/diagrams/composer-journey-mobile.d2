direction: down
style.fill: "#17181b"
vars: { d2-config: { pad: 20 } }
*.style: { font-size: 22; bold: false; fill: "#23252a"; stroke: "#747a85"; font-color: "#f2f3f5"; border-radius: 8 }
prepare: Get Ready\nTools, accounts, HTTPS
spec: Init\nSettings and specification
build: Build\nAgent tests and deploys
compose: Compose\nShared data and actions
own: Own\nSource, updates, recovery
prepare -> spec
spec -> build
build -> compose
compose -> own
(* -> *)[*].style: { stroke: "#ff9b55"; font-color: "#f2f3f5"; font-size: 18 }
