direction: down
style.fill: "#17181b"
vars: { d2-config: { pad: 20 } }
*.style: { font-size: 22; bold: false; fill: "#23252a"; stroke: "#747a85"; font-color: "#f2f3f5"; border-radius: 8 }
profile: Fictional assistant\nOn your device
cipher: Encrypted export\nKeep your key separate
unlock: Open on your device\nEnter your passphrase
review: Select memories\nReview and consent
provider: Your chosen provider\nOnly the copied selection
profile -> cipher: Encrypt locally
cipher -> unlock: Reopen your saved file
unlock -> review
review -> provider: Copy with consent
(* -> *)[*].style: { stroke: "#fc5b05"; font-color: "#f2f3f5"; font-size: 18 }
