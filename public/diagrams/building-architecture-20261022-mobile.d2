direction: down
style.fill: "#17181b"
*.style: { font-size: 18; bold: false; fill: "#23252a"; stroke: "#747a85"; font-color: "#f2f3f5"; border-radius: 6 }
(* -> *)[*].style: { stroke: "#ff9b55"; stroke-width: 2; font-color: "#f2f3f5"; font-size: 14 }
visitor: Visitor\npublic HTTPS
owner: Owner\nAccess + role
agent: Agent\nbrief · checks
composer: Composer\nAstro + EmDash
guestbook: Here / there\nWorker · D1 · R2
linkarooie: Linkarooie\nWorker · D1
source: Source pins\nGitHub + manifests
visitor -> composer: pages
owner -> composer: admin
agent -> source: commits
source -> composer: exact pin
composer -> guestbook: binding
composer -> linkarooie: binding
linkarooie -> guestbook: source contract
