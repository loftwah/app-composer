direction: down
style.fill: "#17181b"
vars: { d2-config: { pad: 20 } }
*.style: { font-size: 20; bold: false; fill: "#23252a"; stroke: "#747a85"; font-color: "#f2f3f5"; border-radius: 8 }
(* -> *)[*].style: { stroke: "#fc5b05"; font-color: "#f2f3f5"; font-size: 16 }
dashboard: Cloudflare dashboard\nExplicit click on the extension
workspace: App Composer workspace\nGet Ready • Init • decisions
agent: Your authorised agent\nSame engine and portable spec
result: Verified deployment\nActual account • source • HTTPS
 dashboard -> workspace: optional MV3 overlay
 workspace -> agent: scoped handoff
 agent -> result: guarded build and verification
 result -> workspace: planned report return
result -> workspace: { style.stroke-dash: 5 }
