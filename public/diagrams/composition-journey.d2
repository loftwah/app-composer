direction: right
style.fill: "#17181b"
vars: { d2-config: { pad: 20 } }
*.style: { font-size: 20; bold: false; fill: "#23252a"; stroke: "#747a85"; font-color: "#f2f3f5"; border-radius: 8 }
(* -> *)[*].style: { stroke: "#ff9b55"; font-color: "#f2f3f5"; font-size: 16 }
guestbook: Here / there\nIndependent source + private photos
review: Owner review\nApprove • hide • delete
showcase: Top shelf\nIndependent source + curated cards
original: Original contribution\nCurrent visibility checked
 guestbook -> review: submission
 review -> showcase: item ID
 showcase -> original: open source
 guestbook -> original: visibility
