direction: down
style.fill: "#17181b"
*.style: { font-size: 18; bold: false; fill: "#23252a"; stroke: "#747a85"; font-color: "#f2f3f5"; border-radius: 6 }
(* -> *)[*].style: { stroke: "#ff9b55"; stroke-width: 2; font-color: "#f2f3f5"; font-size: 14 }
visitor: Visitor
form: Guestbook form\nonly while open
pending: Pending\nprivate
review: Owner review
approved: Approved\npublic source
featured: Featured\nLinkarooie
profile: Profile card
visitor -> form: note
form -> pending: submit
pending -> review: private
review -> approved: approve
approved -> featured: feature
featured -> profile: render
review -> pending: hide
pending -> profile: remove
